<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <title>{{title}}</title>
    <link
      rel='stylesheet'
      href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css'
    />
    <link
      rel='stylesheet'
      href='https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css'
    />
    <link
      href='https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Lora:wght@600&display=swap'
      rel='stylesheet'
    />
    <link rel='icon' href='/images/hrmd_logo.png' type='image/png' />
    <style>
      body {
        font-family:
          'Inter',
          -apple-system,
          sans-serif;
        background: linear-gradient(160deg, #16304a 0%, #0f2233 60%, #1f7a6c 100%);
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
      }
      .login-card {
        background: #fff;
        border-radius: 0.85rem;
        box-shadow: 0 20px 60px rgba(15, 34, 51, 0.35);
        width: 100%;
        max-width: 380px;
        padding: 2.25rem 2rem;
      }
      .form-control {
        border: 1px solid #e3e6eb;
        border-radius: 0.45rem;
        padding: 0.6rem 0.9rem;
        font-size: 0.92rem;
        transition:
          border-color 0.2s,
          box-shadow 0.2s;
      }
      .form-control:focus {
        border-color: #2e6f9e;
        box-shadow: 0 0 0 0.2rem rgba(46, 111, 158, 0.15);
      }
      .form-label {
        font-size: 0.8rem;
        font-weight: 600;
        color: #16304a;
        margin-bottom: 0.35rem;
      }
      .btn-login {
        background: #16304a;
        border: none;
        color: #fff;
        font-weight: 600;
        font-size: 0.95rem;
        padding: 0.65rem;
        border-radius: 0.45rem;
        width: 100%;
        transition: background 0.2s;
      }
      .btn-login:hover {
        background: #0f2233;
        color: #fff;
      }
      .divider {
        border-color: #e3e6eb;
        margin: 1.5rem 0;
      }
    </style>
  </head>
  <body>

    <div class='login-card'>

      <div class='text-center mb-4'>
        <img src='/images/hrmd_logo.png' alt='HRMD Logo' style='height:90px; width:auto;' />
        <p
          style='text-transform:uppercase; letter-spacing:.08em; font-size:.65rem; font-weight:600; color:#2E6F9E; margin:.75rem 0 .15rem;'
        >HRMD Portal</p>
        <h5 style='font-weight:700; color:#0F2233; margin:0;'>Sign in to your account</h5>
      </div>

      {{#if error}}
        <div
          class='alert alert-danger border-0 py-2 px-3 mb-3'
          style='border-left:3px solid #C1483D !important; border-radius:.45rem; font-size:.85rem;'
        >
          <i class='fas fa-circle-exclamation me-1'></i>
          {{error}}
        </div>
      {{/if}}

      <form action='/login' method='POST'>

        <div class='mb-3'>
          <label class='form-label'><i class='fas fa-user me-1' style='color:#2E6F9E;'></i>
            Username</label>
          <input
            type='text'
            name='username'
            class='form-control'
            required
            placeholder='Enter username'
          />
        </div>

        <div class='mb-4'>
          <label class='form-label'><i class='fas fa-lock me-1' style='color:#2E6F9E;'></i>
            Password</label>
          <input
            type='password'
            name='password'
            class='form-control'
            required
            placeholder='Enter password'
          />
        </div>

        <button type='submit' class='btn-login'>
          <i class='fas fa-right-to-bracket me-2'></i>Login
        </button>

      </form>

      <hr class='divider' />
      <p style='text-align:center; font-size:.75rem; color:#6B7686; margin:0;'>
        Human Resource Management Division
      </p>

    </div>

  </body>
</html>