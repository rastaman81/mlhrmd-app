<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Payroll Utilities</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="/css/styles.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <style>
      .text-danger {
        color: #dc3545 !important;
      }
      .table-hover tbody tr:hover {
        background-color: rgba(0, 0, 0, 0.075);
      }
      .btn-sm i {
        margin-right: 3px;
      }
      .results-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1rem;
      }
    </style>
  </head>
  <body>
    <div class="dashboard-container">
      {{> header}}

      <div class="main-content">
        <div class="search-card">
          <h2><i class="fas fa-search me-2"></i>Search Employee to Edit</h2>

          <form id="payrollUtilitiesForm">
            <div class="row g-3 mb-3">
              <div class="col-md-2">
                <label for="officeSelect" class="form-label">Office</label>
                <select name="office" id="officeSelect" class="form-select" required>
                  <option value="" disabled selected>Select Office</option>
                  {{#each offices}}
                    <option value="{{this.office_name}}">{{this.office_name}}</option>
                  {{/each}}
                </select>
              </div>

              <div class="col-md-3">
                <label for="regionSelect" class="form-label">Region</label>
                <select name="region" id="regionSelect" class="form-select" required>
                  <option value="" selected>All Regions</option>
                  {{#each regions}}
                    <option value="{{this.region_name}}">{{this.region_name}}</option>
                  {{/each}}
                </select>
              </div>

              <div class="col-md-2">
                <label for="idno" class="form-label">ID No</label>
                <input type="text" name="idno" placeholder="Enter ID Number" class="form-control" />
              </div>

              <div class="col-md-2">
                <label for="lastname" class="form-label">Last Name</label>
                <input type="text" name="lastname" placeholder="Enter last name" class="form-control" />
              </div>

              <div class="col-md-3">
                <label for="firstname" class="form-label">First Name</label>
                <input type="text" name="firstname" placeholder="Enter first name" class="form-control" />
              </div>
            </div>

            <div class="row g-3 mb-3 justify-content-center">
              <div class="col-md-4 d-flex align-items-end">
                <button type="submit" class="btn btn-primary me-2 flex-grow-1">
                  <i class="fas fa-search me-2"></i>Search
                </button>
                <button type="button" class="btn btn-secondary flex-grow-1" id="resetBtn">
                  <i class="fas fa-redo me-2"></i>Clear
                </button>
              </div>
            </div>
          </form>
        </div>

        <!-- Results Container -->
        <div class="table-container mt-4" id="reportResults" style="display: none;">
          <div class="results-header">
            <h3 id="resultsTitle">Employee Search Results</h3>
          </div>
          
          <div class="table-responsive">
            <table id="report-table" class="table table-striped table-hover">
              <thead class="table-dark">
                <tr>
                  <th>IDNO</th>
                  <th>LAST NAME</th>
                  <th>FIRST NAME</th>
                  <th>MIDDLE INITIAL</th>
                  <th>STATUS</th>
                  <th>ACTION</th>
                </tr>
              </thead>
              <tbody></tbody>
            </table>
          </div>
        </div>

        <div id="report-loading" class="text-center my-5" style="display: none">
          <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
          </div>
          <p class="mt-2 text-muted">Processing task...</p>
        </div>

        <div id="error-message" class="alert alert-danger mt-4" style="display: none"></div>
      </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="/js/scripts.js"></script>
    
    <script>
      document.addEventListener('DOMContentLoaded', function() {
        flatpickr("#dateRange", {
          mode: "range",
          dateFormat: "Y-m-d",
          allowInput: true
        });

        document.getElementById('payrollUtilitiesForm').addEventListener('submit', function(e) {
          e.preventDefault();
          executeTask();
        });

        document.getElementById('resetBtn').addEventListener('click', function() {
          document.getElementById('payrollUtilitiesForm').reset();
          document.getElementById('reportResults').style.display = 'none';
          document.getElementById('error-message').style.display = 'none';
        });

        document.getElementById('officeSelect').addEventListener('change', async function() {
          const office = this.value;
          const regionSelect = document.getElementById('regionSelect');
          
          if (!office) {
            regionSelect.innerHTML = '<option value="" selected>All Regions</option>';
            return;
          }

          try {
            regionSelect.disabled = true;
            const originalValue = regionSelect.value;
            regionSelect.innerHTML = '<option value="">Loading regions...</option>';

            const response = await fetch(`/payroll/utilities/regions?office=${encodeURIComponent(office)}`);
            const data = await response.json();

            if (data.success) {
              regionSelect.innerHTML = '<option value="" selected>All Regions</option>';
              data.regions.forEach(region => {
                const option = document.createElement('option');
                option.value = region.region_name;
                option.textContent = region.region_name;
                regionSelect.appendChild(option);
              });
              
              if (originalValue) {
                const optionExists = Array.from(regionSelect.options).some(
                  opt => opt.value === originalValue
                );
                if (optionExists) {
                  regionSelect.value = originalValue;
                }
              }
            } else {
              showError(data.message || 'Failed to load regions');
              regionSelect.innerHTML = '<option value="" selected>All Regions</option>';
            }
          } catch (error) {
            console.error('Error loading regions:', error);
            showError('Failed to load regions');
            regionSelect.innerHTML = '<option value="" selected>All Regions</option>';
          } finally {
            regionSelect.disabled = false;
          }
        });
      });

      async function executeTask() {
        const form = document.getElementById('payrollUtilitiesForm');
        const formData = new FormData(form);

        const office = formData.get('office');
        const region = formData.get('region');
        const idno = formData.get('idno');
        const lastname = formData.get('lastname');
        const firstname = formData.get('firstname');

        if (!office || !region || (!idno && !lastname && !firstname)) {
          Swal.fire({
            title: 'Validation Error!',
            text: 'Please ensure that Office, Region, and either ID No or Last Name are filled out.',
            icon: 'error',
            confirmButtonText: 'OK'
          });
          return;
        }

        const queryParams = new URLSearchParams({
          office: office,
          region: region,
          idno: idno,
          lastname: lastname,
          firstname: firstname
        });

        document.getElementById('report-loading').style.display = 'block';
        document.getElementById('reportResults').style.display = 'none';
        document.getElementById('error-message').style.display = 'none';

        try {
          const response = await fetch(`/payroll/employee/search?${queryParams.toString()}`);
          const data = await response.json();
          
          if (data.success) {
            if (data.results && data.results.length > 0) {
              displayResults(data.results);
            } else {
              Swal.fire({
                title: 'No Results',
                text: 'No employees found matching your criteria',
                icon: 'info',
                confirmButtonText: 'OK'
              });
            }
          } else {
            showError(data.message || 'Error searching employees');
          }
        } catch (error) {
          console.error('Error:', error);
          showError('Failed to search employees: ' + error.message);
        } finally {
          document.getElementById('report-loading').style.display = 'none';
        }
      }

      function showError(message) {
        const errorDiv = document.getElementById('error-message');
        errorDiv.textContent = message;
        errorDiv.style.display = 'block';
        
        if (typeof Swal !== 'undefined') {
          Swal.fire({
            title: 'Error!',
            text: message,
            icon: 'error',
            confirmButtonText: 'OK'
          });
        }
      }

      function displayResults(results) {
        const tableBody = document.querySelector('#report-table tbody');
        const resultsContainer = document.getElementById('reportResults');
        
        tableBody.innerHTML = '';
        
        results.forEach(employee => {
          const row = document.createElement('tr');
          
          // IDNO
          const idCell = document.createElement('td');
          idCell.textContent = employee.E_IDNO || '-';
          row.appendChild(idCell);
          
          // LAST NAME
          const lastNameCell = document.createElement('td');
          lastNameCell.textContent = employee.E_LN || '-';
          row.appendChild(lastNameCell);
          
          // FIRST NAME
          const firstNameCell = document.createElement('td');
          firstNameCell.textContent = employee.E_FN || '-';
          row.appendChild(firstNameCell);
          
          // MIDDLE INITIAL
          const miCell = document.createElement('td');
          miCell.textContent = employee.E_MI || '-';
          row.appendChild(miCell);
          
          // STATUS with conditional coloring
          const statusCell = document.createElement('td');
          const status = employee.E_COMPSTAT ? String(employee.E_COMPSTAT).toLowerCase() : '';
          statusCell.textContent = employee.E_COMPSTAT || '-';
          
          if (!['regular', 'contractual'].includes(status)) {
            statusCell.classList.add('text-danger');
            statusCell.classList.add('fw-bold');
          } else {
            statusCell.classList.add('text-success');
            statusCell.classList.add('fw-bold');
          }
          row.appendChild(statusCell);
          
          // ACTION (Edit button)
          const actionCell = document.createElement('td');
          const editButton = document.createElement('button');
          editButton.className = 'btn btn-sm btn-primary';
          editButton.innerHTML = '<i class="fas fa-edit me-1"></i> Edit';
          editButton.addEventListener('click', () => editEmployee(employee));
          actionCell.appendChild(editButton);
          row.appendChild(actionCell);
          
          tableBody.appendChild(row);
        });
        
        resultsContainer.style.display = 'block';
        document.getElementById('resultsTitle').textContent = `Employee Search Results (${results.length} found)`;
      }

      function editEmployee(employee) {
        // Convert employee object to base64 encoded string
  const employeeData = btoa(JSON.stringify(employee));
  // Navigate to the update page with the employee data
  window.location.href = `/payroll/employee-update?data=${encodeURIComponent(employeeData)}`;
        
        {{!-- console.log('Editing employee:', employee);
        Swal.fire({
          title: 'Edit Employee',
          html: `
            <p>ID: ${employee.E_IDNO}</p>
            <p>Name: ${employee.E_LN}, ${employee.E_FN} ${employee.E_MI} </p>
          `,
          icon: 'info',
          confirmButtonText: 'OK'
        }); --}}
      }
    </script>
  </body>
</html>