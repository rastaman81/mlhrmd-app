  const wsOperations = XLSX.utils.aoa_to_sheet(operationsData);
  wsOperations["!cols"] = autoFitColumns(operationsData);

  XLSX.utils.book_append_sheet(
    wb,
    wsOperations,
    `OPERATIONS ${monthName.monthName} ${payrollYear(endDate)}`
  );

  // -----------------------------
  // SUPPORT PAST
  // -----------------------------
  const supportPastSheet = [
    ["MONTH","REGION","LAST NAME","FIRST NAME","DEPARTMENT","BASIC PAY","TOTAL OVERTIME","TOTAL ALLOWANCE","OTHER INCOME"],
    ...supportPastData.map(item => [
      monthName.monthName,
      item.region,
      item.lastname,
      item.firstname,
      item.department,
      formatNumberCell(item.basicpay),
      formatNumberCell(item.totalot),
      formatNumberCell(item.totalallow),
