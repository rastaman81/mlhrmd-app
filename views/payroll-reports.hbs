    'PAGIBIG CONTRIBUTION', 
    'SSS LOAN', 
    'PAGIBIG LOAN', 
    'CAR-MOTOR LOAN', 
    'ML FUND', 
    'HMO', 
    'ML CELLPHONE',
    'PHILHEALTH', 
    'ML ACCOUNT', 
    'ATD', 
    'ODETTE LOAN', 
    'ML LENDING', 
    'PAYABLES',
    '', // deductionDesc1
    '', // deductionDesc2
    'TOTAL DEDUCTION', 
    'TOTAL NET',
  ];
let payrollDate = '';
  results.forEach(employee => {
    if (!groupedData[employee.region]) {
      groupedData[employee.region] = {};
    }
    if (!groupedData[employee.region][employee.department]) {
      groupedData[employee.region][employee.department] = [];
