      groupedData[emp.region] = [];
    }
    groupedData[emp.region].push(emp);
  });

  const sortedRegions = Object.keys(groupedData).sort();

  sortedRegions.forEach(region => {
    const regionEmployees = groupedData[region];
    const wsData = [];
    let columnWidths = [];

    // Report header
    const formattedEndDate = endDate ? new Date(endDate).toLocaleDateString('en-US', {
      year: 'numeric',
      month: 'long',
      day: 'numeric'
    }) : 'N/A';

    wsData.push([`Monthly Rate Report - ${region}`]);
    wsData.push([`Payroll Date: ${formattedEndDate}`]);
    wsData.push([]);
    wsData.push(headers);

    // Track column widths
    headers.forEach((header, i) => {
      columnWidths[i] = Math.max(columnWidths[i] || 0, header.length);
    });

    // Sort employees
    const sortedEmployees = [...regionEmployees].sort((a, b) => {
      return a.employee.localeCompare(b.employee);
    });

    // Add employee rows
    sortedEmployees.forEach(emp => {
      const row = [
        emp.region || '',
        emp.idno || '',
        emp.department || '',
        emp.employee || '',
        parseFloat(emp.amount) || 0
      ];

      wsData.push(row);

      // Update column widths
      row.forEach((cell, i) => {
        columnWidths[i] = Math.max(
          columnWidths[i] || 0,
          String(cell).length
        );
      });
    });

    // Add total employee count
    wsData.push([]);
    wsData.push([`TOTAL EMPLOYEES: ${sortedEmployees.length}`]);

    const ws = XLSX.utils.aoa_to_sheet(wsData);

    // Set column widths
    ws['!cols'] = columnWidths.map(w => ({
      wch: Math.min(Math.max(w + 2, 10), 50)
    }));

    // Apply number formatting to Monthly Rate column (index 4)
    Object.keys(ws).forEach(cellAddress => {
      if (cellAddress[0] === '!') return;

      const cell = ws[cellAddress];
      const colIndex = XLSX.utils.decode_cell(cellAddress).c;

      if (colIndex === 4 && typeof cell.v === 'number') {
        cell.z = '#,##0.00';
      }
    });

    const sheetName = region.substring(0, 31).replace(/[\\/*[\]:?]/g, '');
    XLSX.utils.book_append_sheet(wb, ws, sheetName);
  });

  // Generate filename
  const safeOffice = office || 'Payroll';
  const safeRegion = selectedRegion ? selectedRegion.toUpperCase().replace(/[\\/*[\]:?]/g, '').trim() : 'ALL';
  const dateStr = endDate ? new Date(endDate).toISOString().split('T')[0] : new Date().toISOString().split('T')[0];
  
  const fileName = safeRegion !== 'ALL'
    ? `${safeOffice}_${safeRegion}_Monthly_Rate_${dateStr}.xlsx`
    : `${safeOffice}_Monthly_Rate_${dateStr}.xlsx`;

  XLSX.writeFile(wb, fileName);
}


