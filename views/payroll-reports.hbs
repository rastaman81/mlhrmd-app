async function generateDirectPayroll(results, office, selectedRegion) {
  if (typeof XLSX === 'undefined') {
    await loadScript('https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js');
  }

  if (!results || results.length === 0) {
    console.warn('No data to export');
    return;
  }

  const dataArray = Array.isArray(results) ? results : (results.results || []);
  
  if (dataArray.length === 0) {
    console.warn('No data to export after extraction');
    return;
  }

  const wb = XLSX.utils.book_new();
  
  let combinedData = [];

  const ws_data = [
    [
      "*ID",
      "*NAME",
      "*MONTH",
      "*YEAR",
      "*CYCLE",
      "*DAYS WORKED",
      "*TOTAL WORKING DAYS",
      "*NET PAY",
    ],
  ];

  const formatIDForCSV = (id) => {
    const paddedID = id.toString().padStart(8, "0");
    return `="${paddedID}"`;
  };

  dataArray.forEach((item) => {
    combinedData.push([
      item.id ? formatIDForCSV(item.id) : "",
      item.name || "",
      item.month || "",
      item.year ? item.year.toString() : "",
      item.cycle || "",
      Math.round(item.daysworked || 0),      // ✅ Integer
      Math.round(item.totaldays || 0),       // ✅ Integer
      parseFloat(item.netpay) || 0,          // ✅ Raw number (no formatting)
    ]);
  });

  ws_data.push(...combinedData);

  const ws = XLSX.utils.aoa_to_sheet(ws_data);

  // ✅ Apply column-specific formatting
  ws_data.forEach((row, rIndex) => {
    row.forEach((cell, cIndex) => {
      if (typeof cell === "number") {
        const cellRef = XLSX.utils.encode_cell({
          c: cIndex,
          r: rIndex,
        });
        if (!ws[cellRef]) ws[cellRef] = {};
        
        // Column-specific formatting
        if (cIndex === 7) { // NET PAY column - raw number, no formatting
          ws[cellRef].t = "n";
          ws[cellRef].z = "General";  // ✅ No formatting - just raw number
          ws[cellRef].v = cell;
        } else if (cIndex === 5 || cIndex === 6) { // DAYS WORKED or TOTAL WORKING DAYS
          ws[cellRef].t = "n";
          ws[cellRef].z = "0";  // No decimals
          ws[cellRef].v = Math.round(cell);
        }
      }
    });
  });

  // Bold and center-align the header row
  ws_data[0].forEach((_, colIndex) => {
    const cellRef = XLSX.utils.encode_cell({ c: colIndex, r: 0 });
    const cell = ws[cellRef];
    if (cell) {
      cell.s = {
        font: { bold: true },
        alignment: { horizontal: "center" },
      };
    }
  });

  ws["!cols"] = autoFitColumns(ws_data);

  XLSX.utils.book_append_sheet(wb, ws, "Direct Payroll");
  
  const dateStr = new Date().toISOString().split('T')[0];
  const safeRegion = (selectedRegion || '').replace(/[\\/*[\]:?]/g, '') || 'ALL';
  const safeOffice = (office || 'Payroll').replace(/[\\/*[\]:?]/g, '');
  
  XLSX.writeFile(
    wb,
    `Direct_Payroll_${safeOffice}_${safeRegion}_${dateStr}.csv`
  );

  function autoFitColumns(aoa) {
    const colWidths = aoa[0].map((_, colIndex) =>
      Math.max(
        ...aoa.map((row) =>
          row[colIndex] ? row[colIndex].toString().length : 0
        )
      )
    );
    return colWidths.map((width) => ({ wch: width + 2 }));
  }
}

