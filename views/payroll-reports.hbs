async function generateMLGExcelReport(results) {
  if (typeof XLSX === 'undefined') {
    await loadScript('https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js');
  }

  const wb = XLSX.utils.book_new();
  const groupedData = {};
  
  // Define headers
  const headers = [
    'AREA/DEPARTMENT',
    'LAST NAME',
    'FIRST NAME',
    'PAYROLL TYPE',
    'DAILY RATE',
    'NO. DAYS',
    'BASIC PAY',
    'ALLOWANCES',
    'OVERTIME',
    'COLA',
    'OTHER INCOME',
