<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>{{title}}</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
  <link rel="stylesheet" href="/css/styles.css">

  <style>
    .form-label {
      font-size: .8rem;
      font-weight: 600;
      color: #16304A;
      margin-bottom: .35rem;
    }
    .form-control, .form-select {
      border-color: #E3E6EB;
      font-size: .9rem;
    }
    .form-control:focus, .form-select:focus {
      border-color: #2E6F9E;
      box-shadow: 0 0 0 .2rem rgba(46,111,158,.12);
    }
    .flatpickr-input { border-color: #E3E6EB !important; }
    .flatpickr-input:focus {
      border-color: #2E6F9E !important;
      box-shadow: 0 0 0 .2rem rgba(46,111,158,.12) !important;
    }
    #report-table thead th {
      background: #16304A;
      color: #fff;
      font-size: .72rem;
      text-transform: uppercase;
      letter-spacing: .04em;
      font-weight: 600;
      border-color: #1e3e5e;
      padding: .65rem .85rem;
      white-space: nowrap;
    }
    #report-table tbody td {
      font-size: .85rem;
      color: #0F2233;
      padding: .6rem .85rem;
      vertical-align: middle;
      border-color: #E3E6EB;
    }
    #report-table tbody tr:nth-child(odd) td  { background: #F6F7F9; }
    #report-table tbody tr:nth-child(even) td { background: #fff; }
    #report-table tbody tr:hover td           { background: #EBF3FA !important; }
  </style>
</head>
<body>

<div class="dashboard-container">

  {{> header}}

  <div class="main-content" style="font-family:'Inter',-apple-system,sans-serif; background:#F6F7F9;">
    <div class="container-fluid px-4 py-4">

      <!-- Page Header -->
      <div class="mb-4">
        <h1 style="font-size:1.65rem; font-weight:700; color:#0F2233; display:flex; align-items:center; gap:.6rem; margin:0;">
          <i class="fas fa-calculator" style="color:#2E6F9E;"></i> Payroll Reports
        </h1>
        <p style="color:#6B7686; font-size:.92rem; margin:.35rem 0 0;">Select filters and a report type to generate payroll output.</p>
      </div>

      <!-- Filter Card -->
      <div style="border:1px solid #E3E6EB; border-radius:.65rem; background:#fff; box-shadow:0 1px 2px rgba(16,24,40,.04); margin-bottom:1.25rem;">

        <div style="border-bottom:1px solid #E3E6EB; padding:.85rem 1.15rem; display:flex; align-items:center; gap:.55rem; border-radius:.65rem .65rem 0 0;">
          <i class="fas fa-filter" style="color:#2E6F9E;"></i>
          <strong style="color:#0F2233; font-weight:600; font-size:.97rem;">Report Filters</strong>
        </div>

        <div style="padding:1.15rem;">
          <form id="payrollReportsForm">

            <div class="row g-3 mb-3">

              <div class="col-md-3">
                <label class="form-label">Date Range</label>
                <input type="text" id="dateRange" class="form-control datepicker"
                  placeholder="Select date range" readonly style="border-color:#E3E6EB;">
              </div>

              <div class="col-md-3">
                <label class="form-label">Office</label>
                <select name="office" id="officeSelect" class="form-select" style="border-color:#E3E6EB;">
                  <option value="" disabled selected>Select Office</option>
                  {{#each offices}}
                    <option value="{{this.office_name}}">{{this.office_name}}</option>
                  {{/each}}
                </select>
              </div>

              <div class="col-md-3">
                <label class="form-label">Region</label>
                <select name="region" id="regionSelect" class="form-select" style="border-color:#E3E6EB;">
                  <option value="" selected>All Regions</option>
                  {{#each regions}}
                    <option value="{{this.region_name}}">{{this.region_name}}</option>
                  {{/each}}
                </select>
              </div>

              <div class="col-md-3">
                <label class="form-label">Report Type</label>
                <select name="reportType" id="reportType" class="form-select" style="border-color:#E3E6EB;">
                  <option value="" disabled selected>Select Report</option>
                  {{#each reportTypes}}
                    <option value="{{this.reporttype}}">{{this.reporttype}}</option>
                  {{/each}}
                </select>
              </div>

            </div>

            <div class="row g-3 mb-3">

              <div class="col-md-4 hidden" id="incomeTypeWrapper">
                <label class="form-label">Income Type</label>
                <select name="incomeType" id="incomeType" class="form-select" disabled style="border-color:#E3E6EB;">
                  <option value="" disabled selected>Select Income Type</option>
                  {{#each incomeTypes}}
                    <option value="{{this.income_name}}">{{this.income_description}}</option>
                  {{/each}}
                </select>
              </div>

              <div class="col-md-4 hidden" id="deductionTypeWrapper">
                <label class="form-label">Deduction Type</label>
                <select name="deductionType" id="deductionType" class="form-select" disabled style="border-color:#E3E6EB;">
                  <option value="" disabled selected>Select Deduction Type</option>
                  {{#each deductionTypes}}
                    <option value="{{this.deduction_name}}">{{this.deduction_description}}</option>
                  {{/each}}
                </select>
              </div>

            </div>

            <div class="d-flex justify-content-between align-items-center mt-2">
              <p style="font-size:.82rem; color:#6B7686; margin:0;">
                <i class="fas fa-circle-info me-1"></i>Income / Deduction type fields appear based on report type selected.
              </p>
              <div class="d-flex gap-2">
                <button type="button" id="resetBtn" class="btn btn-outline-secondary" style="font-size:.9rem;">
                  <i class="fas fa-redo me-1"></i> Reset
                </button>
                <button type="submit" class="btn" style="background:#2E6F9E; border-color:#2E6F9E; color:#fff; font-weight:500; font-size:.9rem;">
                  <i class="fas fa-file-export me-1"></i> Generate Report
                </button>
              </div>
            </div>

          </form>
        </div>

      </div>

      <!-- Loading -->
      <div id="report-loading" class="text-center py-5" style="display:none;">
        <div class="spinner-border" role="status" style="color:#2E6F9E; width:2.5rem; height:2.5rem;">
          <span class="visually-hidden">Loading...</span>
        </div>
        <p class="mt-2" style="color:#6B7686; font-size:.9rem;">Generating report...</p>
      </div>

      <!-- Error -->
      <div id="error-message" class="alert border-0 mt-3" style="display:none; border-left:4px solid #C1483D !important; border-radius:.55rem; font-size:.9rem; background:rgba(193,72,61,.07); color:#C1483D;"></div>

      <!-- Results Card -->
      <div id="reportResults" style="display:none; border:1px solid #E3E6EB; border-radius:.65rem; background:#fff; box-shadow:0 1px 2px rgba(16,24,40,.04);">

        <div style="border-bottom:1px solid #E3E6EB; padding:.85rem 1.15rem; display:flex; align-items:center; justify-content:space-between; border-radius:.65rem .65rem 0 0;">
          <div style="display:flex; align-items:center; gap:.55rem;">
            <i class="fas fa-table-list" style="color:#2E6F9E;"></i>
            <strong style="color:#0F2233; font-weight:600; font-size:.97rem;">Report Results</strong>
          </div>
          <button id="exportBtn" class="btn btn-outline-secondary btn-sm" style="font-size:.82rem;">
            <i class="fas fa-download me-1"></i> Export to Excel
          </button>
        </div>

        <div style="padding:0;">
          <div class="table-responsive">
            <table id="report-table" class="table table-bordered mb-0">
              <thead>
                <tr>
                  <th>Employee ID</th>
                  <th>Name</th>
                  <th>Office</th>
                  <th>Region</th>
                  <th>Gross Pay</th>
                  <th>Deductions</th>
                  <th>Net Pay</th>
                </tr>
              </thead>
              <tbody></tbody>
            </table>
          </div>
        </div>

      </div>

    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
<script src="/js/scripts.js"></script>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    flatpickr("#dateRange", { mode: "range", dateFormat: "Y-m-d", allowInput: true });

    document.getElementById('payrollReportsForm').addEventListener('submit', function (e) {
      e.preventDefault();
      generateReport();
    });

    document.getElementById('resetBtn').addEventListener('click', function () {
      document.getElementById('payrollReportsForm').reset();
      document.getElementById('reportResults').style.display = 'none';
    });

    document.getElementById('exportBtn').addEventListener('click', function () {
  // Get the current report type and data
  const reportType = document.getElementById('reportType').value;
  const selectedRegion = document.getElementById('regionSelect');
  const selectedOffice = document.getElementById('officeSelect').value;
  const dateRange = document.getElementById('dateRange').value;
  const { endDate } = getDates(dateRange);

  // Check if we have results data
  const resultsData = window._reportResults; // Store results when generating report
  
  if (!resultsData || resultsData.length === 0) {
    alert('No data to export. Please generate a report first.');
    return;
  }

  // Handle monthly rate export
  if (reportType.toLowerCase().trim() === 'monthly rate') {
    generateMonthlyRateExcel(
      resultsData, 
      selectedOffice, 
      selectedRegion.value || '', 
      endDate
    );
  } else {
    // Handle other report types (your existing logic)
    alert('Export functionality for this report type will be implemented');
  }
});

    const reportTypeSelect    = document.getElementById('reportType');
    const incomeTypeSelect    = document.getElementById('incomeType');
    const deductionTypeSelect = document.getElementById('deductionType');
    const incomeWrapper       = document.getElementById('incomeTypeWrapper');
    const deductionWrapper    = document.getElementById('deductionTypeWrapper');

    incomeWrapper.classList.add('hidden');
    deductionWrapper.classList.add('hidden');
    incomeTypeSelect.disabled    = true;
    deductionTypeSelect.disabled = true;

    reportTypeSelect.addEventListener('change', function () {
      const reportType = reportTypeSelect.value.toLowerCase();
      if (reportType === 'income') {
        incomeTypeSelect.disabled = false;
        incomeWrapper.classList.remove('hidden');
        deductionTypeSelect.disabled = true;
        deductionWrapper.classList.add('hidden');
        deductionTypeSelect.value = '';
      } else if (reportType === 'deduction') {
        deductionTypeSelect.disabled = false;
        deductionWrapper.classList.remove('hidden');
        incomeTypeSelect.disabled = true;
        incomeWrapper.classList.add('hidden');
        incomeTypeSelect.value = '';
      } else {
        incomeTypeSelect.disabled    = true;
        incomeWrapper.classList.add('hidden');
        incomeTypeSelect.value       = '';
        deductionTypeSelect.disabled = true;
        deductionWrapper.classList.add('hidden');
        deductionTypeSelect.value    = '';
      }
    });
  });

  document.getElementById('officeSelect').addEventListener('change', async function () {
    const office       = this.value;
    const regionSelect = document.getElementById('regionSelect');
    if (!office) { regionSelect.innerHTML = '<option value="" selected>All Regions</option>'; return; }
    try {
      regionSelect.disabled = true;
      regionSelect.innerHTML = '<option value="">Loading regions...</option>';
      const response = await fetch(`/payroll/reports/regions?office=${encodeURIComponent(office)}`);
      const data     = await response.json();
      if (data.success) {
        regionSelect.innerHTML = '<option value="" selected>All Regions</option>';
        data.regions.forEach(region => {
          const option       = document.createElement('option');
          option.value       = region.region_name;
          option.textContent = region.region_name;
          regionSelect.appendChild(option);
        });
      } else {
        showError(data.message || 'Failed to load regions');
        regionSelect.innerHTML = '<option value="" selected>All Regions</option>';
      }
    } catch (error) {
      console.error('Error loading regions:', error);
      showError('Failed to load regions');
      regionSelect.innerHTML = '<option value="" selected>All Regions</option>';
    } finally {
      regionSelect.disabled = false;
    }
  });
</script>

<!-- !! ALL EXCEL / PDF / CSV GENERATOR FUNCTIONS BELOW — UNCHANGED !! -->
<script>
async function generateReport() {
  const form = document.getElementById('payrollReportsForm');
  const generateBtn = form.querySelector('button[type="submit"]');
  const loadingText = document.querySelector('#report-loading p');
  const selectedRegion = document.getElementById('regionSelect')
  const deductionSelect = document.getElementById('deductionType');
  const incomeSelect = document.getElementById('incomeType');
  const formData = new FormData(form);
  const dateRange = document.getElementById('dateRange').value;
  const selectedOffice = officeSelect.value;
  if (reportType.value.toLowerCase() === "kp wallet (csv file)" && selectedRegion.value.toLowerCase() === "") {
    alert('Please select a specific region for this report.');
    return;
  }
  const { startDate, endDate } = getDates(dateRange);
  if (!startDate || !endDate) { alert("Invalid date range selected"); return; }
  formData.append('startDate', startDate);
  formData.append('endDate', endDate);
  const formDataObj = {};
  formData.forEach((value, key) => { formDataObj[key] = value; });
  generateBtn.disabled = true;
  const loading = document.getElementById('report-loading');
  const results = document.getElementById('reportResults');
  loading.style.display = 'block';
  results.style.display = 'none';
  document.getElementById('error-message').style.display = 'none';
  loadingText.textContent = 'Fetching report data...';
  await new Promise(resolve => requestAnimationFrame(resolve));
  await new Promise((resolve) => setTimeout(resolve, 0));
  try {
    const response = await fetch('/payroll/reports/generate-report', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(formDataObj)
    });
    const data = await response.json();
    console.log('RAW RESPONSE:', data.success, data.results);
    if (data.success) {
        window._reportResults = data.results;
      document.getElementById('reportResults').style.display = 'block';
      loadingText.textContent = 'Building your file — this may take a moment';
      await new Promise((resolve) => setTimeout(resolve, 0));
      if (!data.results || data.results.length === 0) { alert('No data found for the selected criteria'); return; }
      data.results.officeSelect = officeSelect;
      if (reportType.value.toLowerCase().trim() === "complete payroll details") {
        if (selectedOffice.toLowerCase() === 'mlinc') { generateMLGExcelReport(data.results); }
        else { await generateExcelReport(data.results); }
      } else if (reportType.value.toLowerCase().trim() === "monthly contributions") {
        generateContributionExcelReport(data.results, data.results.officeSelect.value, selectedRegion);
      } else if (reportType.value.toLowerCase() === "deduction") {
        const deductionMap = {"mlfund (xls)": { type: "mlfund (xls)", action: generateExcelMlFundLoan },"mlfund (pdf)": { type: "mlfund (pdf)", action: generatePdfReport, category: 'deduction' },"sako": { type: "sako", action: generatePdfReport, category: 'deduction' },"coated": { type: "coated", action: generatePdfReport, category: 'deduction' },"cooprecla": { type: "cooprecla", action: generatePdfReport, category: 'deduction' },"sakocommodity": { type: 'fake', action: generatePdfReport, category: 'deduction' },"deductionamount1": { type: 'gpa insurance', action: generatePdfReport, category: 'deduction' },"c_hmo": { type: 'hmo', action: generatePdfReport, category: 'deduction' },"incometax": { type: 'income tax', action: generatePdfReport, category: 'deduction' },"installaccount": { type: 'install account', action: generatePdfReport, category: 'deduction' },"lates": { type: 'lates', action: generatePdfReport, category: 'deduction' },"leaves": { type: 'leaves', action: generatePdfReport, category: 'deduction' },"sakoprovi": { type: 'mortuary', action: generatePdfReport, category: 'deduction' },"sakopettycash": { type: 'motor loan', action: generatePdfReport, category: 'deduction' },"opec": { type: 'opec', action: generatePdfReport, category: 'deduction' },"canteen": { type: 'opec support', action: generatePdfReport, category: 'deduction' },"ticket": { type: 'opec ticket', action: generatePdfReport, category: 'deduction' },"sakoprime": { type: 'sako deductions', action: generatePdfReport, category: 'deduction' },"overappraisal": { type: 'over appraisal', action: generatePdfReport, category: 'deduction' },"deductionamount2": { type: 'over payments', action: generatePdfReport, category: 'deduction' },"pagibigloan": { type: 'pagibig loan', action: generatePdfReport, category: 'deduction' },"sssloan": { type: 'sss loan', action: generatePdfReport, category: 'deduction' },"mobilebill": { type: 'telecoms', action: generatePdfReport, category: 'deduction' },"atd": { type: 'atd', action: generatePdfReport, category: 'deduction' },"ssscontri": { type: 'ssscontri', action: generatePdfReport, category: 'deduction' },"pagibigcontri": { type: 'pagibigcontri', action: generatePdfReport, category: 'deduction' },"car_motorloan": { type: 'car_motorloan', action: generatePdfReport, category: 'deduction' },"mlfund": { type: 'mlfund', action: generatePdfReport, category: 'deduction' },"mlcellphone": { type: 'mlcellphone', action: generatePdfReport, category: 'deduction' },"mlaccount": { type: 'mlaccount', action: generatePdfReport, category: 'deduction' },"odetteloan": { type: 'odetteloan', action: generatePdfReport, category: 'deduction' },"mllending": { type: 'mllending', action: generatePdfReport, category: 'deduction' },"payables": { type: 'payables', action: generatePdfReport, category: 'deduction' },"filmalending": { type: 'filmalending', action: generatePdfReport, category: 'deduction' },     // NEW: Add the three new deduction reports
    'deduction_report_1': { type: "deduction_report_1", action: generatePdfReport, category: 'deduction' },
    'deduction_report_2': { type: "deduction_report_2", action: generatePdfReport, category: 'deduction' },
    'deduction_report_3': { type: "deduction_report_3", action: generatePdfReport, category: 'deduction' },
};
        const selectedDeduction = deductionSelect.value.toLowerCase();
        if (deductionMap[selectedDeduction]) {
          const { type, action, category } = deductionMap[selectedDeduction];
          if (selectedDeduction === "mlfund (xls)") { await action(data.results); }
          else { action(data.results, type, category, selectedRegion.value, selectedOffice); }
        }
      } else if (reportType.value.toLowerCase() === "income") {
        const incomeMap = {"basicpay": { type: "basic pay", action: generatePdfReport, category: 'income' },"cola": { type: "cola", action: generatePdfReport, category: 'income' },"abmallow": { type: "hazard allowance", action: generatePdfReport, category: 'income' },"houseallow": { type: "housing allowance", action: generatePdfReport, category: 'income' },"incomeamount1": { type: "pb/excess pb", action: generatePdfReport, category: 'income' },"incomeamount2": { type: "other income", action: generatePdfReport, category: 'income' },"supervisoryallow2": { type: "location allowance", action: generatePdfReport, category: 'income' },"managementallow": { type: "management allowance", action: generatePdfReport, category: 'income' },"bmallow": { type: "positional allowance", action: generatePdfReport, category: 'income' },"auditorsallow": { type: "single post allowance", action: generatePdfReport, category: 'income' },"totalot": { type: "total overtime", action: generatePdfReport, category: 'income' },"travelallow": { type: "transportation allowance", action: generatePdfReport, category: 'income' }};
        const selectedIncome = incomeSelect.value.toLowerCase();
        if (incomeMap[selectedIncome]) { const { type, action, category } = incomeMap[selectedIncome]; action(data.results, type, category, selectedRegion.value); }
      } else if (reportType.value.toLowerCase() === "kp") {
        generatePdfReport(data.results, "kp", "kp category", selectedRegion.value || "", selectedOffice);
      } else if (reportType.value.toLowerCase() === "monthly rate") {
        generatePdfReport(data.results, "monthly rate", "monthly rate", selectedRegion.value || "", selectedOffice);
      }
      
      
      
      else if (reportType.value.toLowerCase().trim() === "income report") {
        generatePdfReport(data.results, "income report", "income report", selectedRegion.value || "", selectedOffice);
      } else if (reportType.value.toLowerCase() === "kp wallet") {
        generatePdfReport(data.results, "kp wallet", "kp wallet", selectedRegion.value || "", selectedOffice);
      } else if (reportType.value.toLowerCase() === "payroll summary (net)") {
        generatePdfReport(data.results, "payroll summary (net)", "payroll net pay", selectedRegion.value || "", selectedOffice);
      } else if (reportType.value.toLowerCase() === "payroll summary (region)") {
        generatePdfReport(data.results, "payroll summary (region)", "payroll net pay", selectedRegion.value || "", selectedOffice);
      } else if (reportType.value.toLowerCase() === "kp wallet (csv file)") {
        const regionVal = selectedRegion.value || "";
        const regions   = [...new Set(data.results.map(item => item.region))];
        const { endDate } = getDates(dateRange);
        regions.forEach(region => {
          const regionData  = data.results.filter(item => item.region === region);
          const csvContent  = convertToCSV(regionData);
          const fileName    = `KPWallet_${regionVal}_${endDate}.csv`;
          downloadCSV(csvContent, fileName);
        });
      } else if (reportType.value.toLowerCase().trim() === "payslip") {
        generatePdfReport(data.results, "payslip", "payslip", selectedRegion.value || "", selectedOffice);
      } else if (reportType.value.toLowerCase().trim() === "wage increase") {
        await generateWageIncreaseExcelReport(data.results, data.results.officeSelect.value, selectedRegion, endDate);
      } else if (reportType.value.toLowerCase().trim() === "edi payroll") {
        await generateEDIPayrollExcelReport(data.results, selectedOffice, endDate);
      } else if (reportType.value.toLowerCase().trim() === "edi remittance report") {
        await generateRemittanceExcelReport(data.results, selectedOffice, endDate);
      } else if (reportType.value.toLowerCase().trim() === "edi deduction details") {
        await generateEDIDeductionDetailsExcelReport(data.results, selectedOffice, endDate);
      } else if (reportType.value.toLowerCase().trim() === "fs payroll") {
        if (!selectedRegion.value || selectedRegion.value.trim() === "") { alert('Please select a specific region for FS Payroll.'); return; }
        await generateFSPayrollExcelReport(data.results, selectedOffice, selectedRegion.value, endDate);
      } else if (reportType.value.toLowerCase().trim() === "payroll comparison") {
        await generatePayrollComparison(data.results, selectedOffice, endDate);
      } else if (reportType.value.toLowerCase().trim() === "ot report") {
        await generateOTReport(data.results, selectedOffice, endDate);
      } else if (reportType.value.toLowerCase().trim() === "payroll data") {
        await generatePayrollData(data.results, selectedOffice, endDate);
      } else if (reportType.value.toLowerCase().trim() === "direct payroll") {
        await generateDirectPayroll(data.results, selectedOffice, endDate);
      } 
      
      else {
        console.log(deductionSelect.value, deductionSelect.text);
      }
    } else {
      showError(data.message || 'Error generating report');
    }
  } catch (error) {
    console.error('Error:', error);
    showError('Failed to generate report: ' + error.message);
  } finally {
    document.getElementById('report-loading').style.display = 'none';
    generateBtn.disabled = false;
  }
}

function sanitizeLastName(str) { if (str) { return str.replace(/[Ññ]/g, 'N'); } return str; }
function convertToCSV(data) { if (data.length === 0) return ''; const header = Object.keys(data[0]); const rows = data.map(item => header.map(field => { if (field.toLowerCase() === 'last name') { return `"${sanitizeLastName(item[field] || "")}"`;} return `"${item[field] || ""}"`;}).join(",")); return [header.join(","), ...rows].join("\n");}
function downloadCSV(content, fileName) { const blob = new Blob([content], { type: 'text/csv;charset=utf-8;' }); const link = document.createElement("a"); if (link.download !== undefined) { const url = URL.createObjectURL(blob); link.setAttribute("href", url); link.setAttribute("download", fileName); link.style.visibility = 'hidden'; document.body.appendChild(link); link.click(); document.body.removeChild(link);}}
function getDates(dateRange) { if (!dateRange) return { startDate: null, endDate: null }; let startDate, endDate; if (dateRange.includes(" to ")) { [startDate, endDate] = dateRange.split(" to "); } else { startDate = dateRange; endDate = dateRange; } const start = new Date(`${startDate}T00:00:00`); const end = new Date(`${endDate}T23:59:59`); if (isNaN(start.getTime()) || isNaN(end.getTime())) return { startDate: null, endDate: null }; return { startDate: start.toISOString().split("T")[0], endDate: end.toISOString().split("T")[0] };}
function decodeMonth(month) { if (!month) return ''; if (typeof month === 'string') return month; if (month.type === 'Buffer' && Array.isArray(month.data)) { return new TextDecoder().decode(new Uint8Array(month.data)); } return String(month);}
const formatNumber = (num) => new Intl.NumberFormat('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }).format(num);
function formatDate(dateStr) { const date = new Date(dateStr); return new Intl.DateTimeFormat('en-US', { year: 'numeric', month: 'long', day: 'numeric' }).format(date); }
function loadScript(src) { return new Promise((resolve, reject) => { const script = document.createElement('script'); script.src = src; script.onload = resolve; script.onerror = reject; document.head.appendChild(script); });}
function populateReportTable(data) { const tableBody = document.querySelector('#report-table tbody'); tableBody.innerHTML = ''; data.forEach(row => { const tr = document.createElement('tr'); tr.innerHTML = `<td>${row.employeeid}</td><td>${row.name}</td><td>${row.office}</td><td>${row.region}</td><td>${formatCurrency(row.gross_pay)}</td><td>${formatCurrency(row.deductions)}</td><td>${formatCurrency(row.net_pay)}</td>`; tableBody.appendChild(tr); });}
function formatCurrency(amount) { return amount ? parseFloat(amount).toLocaleString('en-PH', { style: 'currency', currency: 'PHP' }) : '₱0.00'; }
function showError(message) { const errorDiv = document.getElementById('error-message'); errorDiv.textContent = message; errorDiv.style.display = 'block'; }
const numberDate = (dateString) => new Date(dateString).toISOString().slice(0, 10);
function capitalizeFirstLetter(word) {  if (typeof word === 'string' && word.length > 0) {    return word.charAt(0).toUpperCase() + word.slice(1).toLowerCase();  }  return word; }
const formatDateString = (dateString) => {  if (!dateString) return "N/A";  const date = new Date(dateString);  return date.toLocaleDateString("en-US", {    year: "numeric",    month: "2-digit",    day: "2-digit",  });};

async function generateExcelMlFund(results) {
  if (typeof XLSX === 'undefined') {
    await loadScript('https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js');
  }

  const wb = XLSX.utils.book_new();
  const groupedData = {};

  // Define headers
  const headers = [
    'REGION CODE', 
    'REGION DESCRIPTION', 
    '#', 
    'IDNO', 
    'EMPLOYEE NAME', 
    'AMOUNT'
  ];

  // Group data by region_description
  results.forEach(employee => {
    if (!groupedData[employee.region]) {
      groupedData[employee.region] = {};
    }
    if (!groupedData[employee.region][employee.department]) {
      groupedData[employee.region][employee.department] = [];
    }
    groupedData[employee.region][employee.department].push(employee);
  });

  // Sort regions alphabetically
  const sortedRegionDescriptions = Object.keys(groupedData).sort();

  sortedRegionDescriptions.forEach(regionDescription => {
    const regionData = groupedData[regionDescription];
    const wsData = [];
    let columnWidths = headers.map(header => header.length); // Initialize with header widths
    let rowIndex = 1;

    // Add report headers
    wsData.push([`Payroll Date: ${formatDate(results[0].enddate)}`]);
    wsData.push(['ML FUND DEDUCTION']);
    wsData.push(headers); // This is row 3 (0-based index 2)

    // Process each department
    Object.keys(regionData).forEach(department => {
      const departmentEmployees = regionData[department];

      departmentEmployees.forEach(emp => {
        const row = [
          emp.region_code || '',
          emp.region_description || '',
          rowIndex++,
          emp.idno || '',
          emp.employee || '',
          Number(emp.mlfund) || 0
        ];

        // Update column widths based on content
        row.forEach((cell, index) => {
          const cellWidth = String(cell).length;
          if (cellWidth > columnWidths[index]) {
            columnWidths[index] = cellWidth;
          }
        });

        wsData.push(row);
      });

      // Add department summary
      const totals = Array(headers.length).fill(0);
      const numericColumns = [5];
      departmentEmployees.forEach(emp => {
        numericColumns.forEach(col => {
          totals[col] += parseFloat(emp.mlfund) || 0;
        });
      });

      const summaryRow = new Array(headers.length).fill('');
      summaryRow[0] = 'TOTAL EMPLOYEES:';
      summaryRow[2] = departmentEmployees.length;
      numericColumns.forEach(col => {
        summaryRow[col] = totals[col];
      });

      // Update widths for summary row
      summaryRow.forEach((cell, index) => {
        const cellWidth = String(cell).length;
        if (cellWidth > columnWidths[index]) {
          columnWidths[index] = cellWidth;
        }
      });

      wsData.push(summaryRow);
      wsData.push([]); // Empty row between departments
    });

    // Create worksheet
    const ws = XLSX.utils.aoa_to_sheet(wsData);
    
    // Set column widths based on widest content (headers + data)
    ws['!cols'] = columnWidths.map(width => ({
      wch: Math.min(width + 2, 50) // Add 2 chars padding, max 50 chars wide
    }));

    // Format numeric columns
    Object.keys(ws).forEach(cellAddress => {
      const cell = ws[cellAddress];
      const colIndex = XLSX.utils.decode_cell(cellAddress).c;
      
      // Format amount column (5th column)
      if (colIndex === 5) {
        cell.z = '#,##0.00';
      }
      
      // Style header row (row 3 in 0-based index)
      if (XLSX.utils.decode_cell(cellAddress).r === 2) {
        cell.s = {
          font: { bold: true },
          fill: { fgColor: { rgb: "D3D3D3" } } // Light gray background
        };
      }
      
      // Style totals row
      const lastDataRow = wsData.length - 2; // -2 because we added empty row
      if (XLSX.utils.decode_cell(cellAddress).r === lastDataRow) {
        cell.s = {
          font: { bold: true },
          border: { top: { style: 'thin', color: { rgb: '000000' } } }
        };
      }
    });

    // Add worksheet to workbook
    const sheetName = regionDescription.substring(0, 31).replace(/[\\/*[\]:?]/g, '');
    XLSX.utils.book_append_sheet(wb, ws, sheetName);
  });

  // Generate filename with current date
  const date = new Date().toISOString().slice(0, 10);
  XLSX.writeFile(wb, `MLFund_Report_${date}.xlsx`);
}

