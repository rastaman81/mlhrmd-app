      "July","August","September","October","November","December"
    ];

    return {
      formattedDate: `${String(date.getMonth() + 1).padStart(2, "0")}/${String(date.getDate()).padStart(2, "0")}/${date.getFullYear()}`,
      monthName: monthNames[date.getMonth()]
    };
  };

  const nonSupportData = Array.isArray(results.nonSupportGroup) ? results.nonSupportGroup : [];
  const supportData = Array.isArray(results.supportGroup) ? results.supportGroup : [];
