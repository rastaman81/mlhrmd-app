    ["MONTH","REGION","LAST NAME","FIRST NAME","DEPARTMENT","BASIC PAY","TOTAL OVERTIME","TOTAL ALLOWANCE","OTHER INCOME"],
    ...supportData.map(item => [
      monthName.monthName,
      item.region,
      item.lastname,
      item.firstname,
      item.department,
      formatNumberCell(item.basicpay),
      formatNumberCell(item.totalot),
      formatNumberCell(item.totalallow),
      formatNumberCell(item.income),
    ])
  ];

  const wsSupport = XLSX.utils.aoa_to_sheet(supportSheet);
  wsSupport["!cols"] = autoFitColumns(supportSheet);

  XLSX.utils.book_append_sheet(
    wb,
    wsSupport,
    `SUPPORT ${monthName.monthName} ${payrollYear(endDate)}`
  );

  // -----------------------------
  // SUMMARY
  // -----------------------------
  const combinedSummaryData = [
    ["REGION","BASIC PAY","TOTAL OVERTIME","TOTAL ALLOWANCE","TOTAL INCOME","","","","REGION","BASIC PAY","TOTAL OVERTIME","TOTAL ALLOWANCE","TOTAL INCOME"],
    ...summaryPastData.map(item => {
      const match = summaryData.find(d => d.region === item.region) || {};
      return [
        item.region,
        formatNumberCell(item.basicpay),
        formatNumberCell(item.totalot),
        formatNumberCell(item.totalallow),
        formatNumberCell(item.income),
        "",
        "",
        "",
        match.region || "",
        formatNumberCell(match.basicpay || 0),
        formatNumberCell(match.totalot || 0),
        formatNumberCell(match.totalallow || 0),
        formatNumberCell(match.income || 0),
      ];
    })
  ];

  const wsSummary = XLSX.utils.aoa_to_sheet(combinedSummaryData);
  wsSummary["!cols"] = autoFitColumns(combinedSummaryData);

  XLSX.utils.book_append_sheet(wb, wsSummary, "SUMMARY");

  // -----------------------------
  // EXPORT FILE
  // -----------------------------
  XLSX.writeFile(
    wb,
    `Payroll Comparison ${office} ${endDate}.xlsx`
  );
}

