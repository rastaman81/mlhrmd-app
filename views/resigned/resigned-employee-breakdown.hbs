<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>{{title}}</title>

  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/styles.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">

  <style>
    :root{
      --rb-navy:      #16304A;
      --rb-navy-deep: #0F2233;
      --rb-blue:      #2E6F9E;
      --rb-teal:      #1F7A6C;
      --rb-gold:      #A8762A;
      --rb-bg:        #F6F7F9;
      --rb-surface:   #FFFFFF;
      --rb-border:    #E3E6EB;
      --rb-muted:     #6B7686;
      --rb-danger:    #C1483D;
    }

    .main-content{
      font-family:'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
      background:var(--rb-bg);
    }

    /* ---- Page header ---- */
    .rb-title{
      font-size:1.65rem;
      font-weight:700;
      color:var(--rb-navy-deep);
      display:flex;
      align-items:center;
      gap:.6rem;
      margin:0;
    }
    .rb-title i{ color:var(--rb-danger); }
    .rb-subtitle{ color:var(--rb-muted); font-size:.92rem; margin:.35rem 0 0; }

    /* ---- Shared card ---- */
    .rb-card{
      border:1px solid var(--rb-border);
      border-radius:.65rem;
      background:var(--rb-surface);
      box-shadow:0 1px 2px rgba(16,24,40,.04);
      margin-bottom:1.25rem;
      overflow:hidden;
    }
    .rb-card-header{
      border-bottom:1px solid var(--rb-border);
      padding:.85rem 1.15rem;
      display:flex;
      align-items:center;
      gap:.55rem;
    }
    .rb-card-header i{ color:var(--rb-blue); }
    .rb-card-header strong{ color:var(--rb-navy-deep); font-weight:600; font-size:.97rem; }
    .rb-card-header-between{
      justify-content:space-between;
    }
    .rb-card-count{ font-size:.82rem; color:var(--rb-muted); }
    .rb-card-body{ padding:1.15rem; }

    /* ---- Form labels / inputs ---- */
    .form-label{
      font-size:.8rem;
      font-weight:600;
      color:var(--rb-navy);
      margin-bottom:.35rem;
    }
    .form-control,
    .form-select{
      border-color:var(--rb-border);
      font-size:.9rem;
    }
    .form-control:focus,
    .form-select:focus{
      border-color:var(--rb-blue);
      box-shadow:0 0 0 .2rem rgba(46,111,158,.12);
    }
    .rb-help{
      font-size:.82rem;
      color:var(--rb-muted);
      margin:0;
    }

    /* ---- Buttons ---- */
    .btn-rb-blue{
      background:var(--rb-blue); border-color:var(--rb-blue); color:#fff; font-weight:500; font-size:.9rem;
    }
    .btn-rb-blue:hover{ background:#255e87; border-color:#255e87; color:#fff; }

    /* ---- Loading ---- */
    #loading .spinner-border{ color:var(--rb-blue) !important; width:2rem; height:2rem; }
    #loading p{ color:var(--rb-muted); font-size:.9rem; }

    /* ---- Error ---- */
    #errorMessage{
      border:none !important;
      border-left:4px solid var(--rb-danger) !important;
      border-radius:.55rem !important;
      font-size:.9rem;
      background:rgba(193,72,61,.07);
      color:var(--rb-danger);
    }

    /* ---- Employee list cards ---- */
    .employee-card{
      cursor:pointer;
      transition:all .2s ease;
      border:1px solid var(--rb-border);
      border-radius:8px;
      padding:10px 15px;
      margin-bottom:8px;
      display:flex;
      justify-content:space-between;
      align-items:center;
    }
    .employee-card:hover{
      background-color:#EBF3FA;
      border-color:var(--rb-blue);
      transform:translateX(3px);
    }
    .employee-card.selected{
      background-color:#EBF3FA;
      border-color:var(--rb-blue);
      border-left:4px solid var(--rb-blue);
    }
    .employee-card .badge-resigned{
      background:var(--rb-danger);
      color:#fff;
      font-size:.7rem;
      padding:2px 8px;
      border-radius:12px;
    }
    .employee-card .rb-chevron{
      color:#C1C7CD;
      margin-left:10px;
    }
    .employee-badge{ font-size:.75rem; color:var(--rb-muted); }

    #employeeList{
      max-height:300px;
      overflow-y:auto;
    }
    #employeeList::-webkit-scrollbar{ width:6px; }
    #employeeList::-webkit-scrollbar-track{ background:#F1F1F1; border-radius:3px; }
    #employeeList::-webkit-scrollbar-thumb{ background:#C1C7CD; border-radius:3px; }
    #employeeList::-webkit-scrollbar-thumb:hover{ background:#A0A7AE; }

    /* ---- Employee name in card ---- */
    .rb-emp-name{ font-weight:600; font-size:1rem; color:var(--rb-navy-deep); }
    .rb-emp-meta{ display:flex; flex-wrap:wrap; gap:8px 15px; margin-top:4px; }

    /* ---- Info grid (breakdown header) ---- */
    .info-grid{
      display:grid;
      grid-template-columns:1fr 1fr;
      gap:8px 30px;
      background:var(--rb-bg);
      padding:15px 20px;
      border-radius:8px;
      border:1px solid var(--rb-border);
    }
    .info-item{
      display:flex;
      align-items:baseline;
      padding:2px 0;
    }
    .info-item.grid-full{ grid-column:span 2; }
    .info-label{
      font-weight:600;
      color:var(--rb-navy);
      font-size:.85rem;
      min-width:140px;
      flex-shrink:0;
    }
    .info-value{ color:var(--rb-navy-deep); font-size:.9rem; word-break:break-word; }

    /* ---- Breakdown cards (no-border edges for seamless stack) ---- */
    .rb-breakdown-top{
      border:1px solid var(--rb-border);
      border-radius:.65rem .65rem 0 0;
      background:var(--rb-surface);
      box-shadow:0 1px 2px rgba(16,24,40,.04);
    }
    .rb-breakdown-mid{
      border-left:1px solid var(--rb-border);
      border-right:1px solid var(--rb-border);
      background:var(--rb-surface);
      box-shadow:0 1px 2px rgba(16,24,40,.04);
    }
    .rb-breakdown-bot{
      border:1px solid var(--rb-border);
      border-radius:0 0 .65rem .65rem;
      background:var(--rb-surface);
      box-shadow:0 1px 2px rgba(16,24,40,.04);
    }

    /* ---- Table wrapper ---- */
    .table-wrapper{
      position:relative;
      max-height:520px;
      overflow-y:auto;
      border:1px solid var(--rb-border);
      border-radius:8px;
    }
    .table-wrapper::-webkit-scrollbar{ width:8px; height:8px; }
    .table-wrapper::-webkit-scrollbar-track{ background:#F1F1F1; border-radius:4px; }
    .table-wrapper::-webkit-scrollbar-thumb{ background:#C1C7CD; border-radius:4px; }
    .table-wrapper::-webkit-scrollbar-thumb:hover{ background:#A0A7AE; }

    /* ---- Breakdown table ---- */
    #breakdown-table{
      width:100%;
      table-layout:fixed;
      margin-bottom:0;
      border-collapse:collapse;
      font-size:.85rem;
    }
    #breakdown-table thead th{
      background:var(--rb-navy) !important;
      color:#fff !important;
      font-size:.72rem;
      text-transform:uppercase;
      letter-spacing:.04em;
      font-weight:600;
      border-color:#1e3e5e !important;
      padding:.5rem .3rem;
      white-space:nowrap;
      text-align:center;
      vertical-align:middle;
      position:sticky;
      top:0;
      z-index:10;
    }
    /* Subtle shadow under sticky header */
    #breakdown-table thead th::after{
      content:'';
      position:absolute;
      left:0; right:0; bottom:-4px;
      height:4px;
      background:linear-gradient(to bottom, rgba(0,0,0,.1), transparent);
      pointer-events:none;
    }
    #breakdown-table thead th span{ display:block; line-height:1.3; }
    #breakdown-table thead th span:first-child{ font-weight:600; font-size:.7rem; }
    #breakdown-table thead th span:last-child{ font-weight:400; font-size:.65rem; opacity:.9; }
    #breakdown-table thead th:first-child{ text-align:center; width:16%; }

    #breakdown-table tbody td{
      color:var(--rb-navy-deep);
      padding:.6rem .5rem;
      vertical-align:middle;
      border-color:var(--rb-border);
      text-align:right;
      word-break:break-word;
    }
    #breakdown-table tbody td:first-child{ text-align:left; font-weight:500; }
    #breakdown-table tbody tr:nth-child(odd) td{ background:var(--rb-bg); }
    #breakdown-table tbody tr:nth-child(even) td{ background:var(--rb-surface); }
    #breakdown-table tbody tr:hover td{ background:#EBF3FA !important; }

    @media (max-width:768px){
      .table-wrapper{ overflow-x:auto !important; overflow-y:auto; }
      #breakdown-table{ min-width:600px; }
    }

    /* ---- Summary grid ---- */
    .summary-grid{
      display:flex;
      justify-content:space-between;
      align-items:center;
      padding:15px 20px;
      border-top:2px solid var(--rb-border);
      margin-top:10px;
      flex-wrap:wrap;
      gap:10px;
    }
    .summary-item{ display:flex; align-items:center; gap:10px; }
    .summary-label{ font-weight:600; color:var(--rb-navy); font-size:.9rem; }
    .summary-value{ font-weight:700; font-size:1rem; color:var(--rb-navy-deep); }
    .summary-value.highlight{ color:var(--rb-blue); }

    .rb-thirteenth{
      text-align:right;
      padding:0 20px 15px;
    }
    .rb-action-bar{
      padding:0 20px 15px;
      border-top:1px solid var(--rb-border);
      padding-top:15px;
    }
    .action-buttons{
      display:flex;
      gap:10px;
      margin-top:15px;
      justify-content:flex-end;
    }

    .search-hint{ font-size:.8rem; color:var(--rb-muted); margin-top:5px; }
    .text-amount{ text-align:right; font-weight:500; }

    @media (max-width:576px){
      .info-grid{ grid-template-columns:1fr; }
      .info-label{ min-width:100px; }
      .summary-grid{ flex-direction:column; align-items:stretch; }
      .summary-item{ justify-content:space-between; }
      .action-buttons{ flex-direction:column; }
      .action-buttons .btn{ width:100%; }
    }
  </style>
</head>
<body>

<div class="dashboard-container">
  {{> header}}

  <div class="main-content">
    <div class="container-fluid px-4 py-4">

      <!-- Page Header -->
      <div class="mb-4">
        <h1 class="rb-title">
          <i class="fas fa-user-slash"></i> Payroll Breakdown for Resigned Employee
        </h1>
        <p class="rb-subtitle">Search for a resigned employee to view their detailed payroll breakdown history.</p>
      </div>

      <!-- Search Card -->
      <div class="rb-card">
        <div class="rb-card-header">
          <i class="fas fa-search"></i>
          <strong>Search Resigned Employee</strong>
        </div>

        <div class="rb-card-body">
          <form id="searchForm">
            <div class="row g-3">

              <div class="col-md-3">
                <label class="form-label">Office</label>
                <select name="office" id="officeSelect" class="form-select" required>
                  <option value="" disabled selected>Select Office</option>
                  {{#each offices}}
                    <option value="{{this.office_name}}">{{this.office_name}}</option>
                  {{/each}}
                </select>
              </div>

              <div class="col-md-3">
                <label class="form-label">ID Number</label>
                <input type="text" id="idno" class="form-control" placeholder="Enter ID Number">
              </div>

              <div class="col-md-3">
                <label class="form-label">Last Name</label>
                <input type="text" id="lastName" class="form-control" placeholder="Enter Last Name">
              </div>

              <div class="col-md-3">
                <label class="form-label">First Name</label>
                <input type="text" id="firstName" class="form-control" placeholder="Enter First Name">
              </div>

            </div>

            <div class="d-flex justify-content-between align-items-center mt-3 flex-wrap gap-2">
              <p class="rb-help">
                <i class="fas fa-circle-info me-1"></i>Search by ID number OR by name (resigned employees only)
              </p>
              <div class="d-flex gap-2">
                <button type="button" id="resetBtn" class="btn btn-outline-secondary" style="font-size:.9rem;">
                  <i class="fas fa-redo me-1"></i> Reset
                </button>
                <button type="submit" class="btn btn-rb-blue">
                  <i class="fas fa-search me-1"></i> Search
                </button>
              </div>
            </div>

          </form>
        </div>
      </div>

      <!-- Loading -->
      <div id="loading" class="text-center py-4" style="display:none;">
        <div class="spinner-border" role="status">
          <span class="visually-hidden">Loading...</span>
        </div>
        <p class="mt-2">Searching...</p>
      </div>

      <!-- Error -->
      <div id="errorMessage" class="alert mt-3" style="display:none;"></div>

      <!-- Employee List -->
      <div id="employeeListContainer" class="rb-card" style="display:none;">
        <div class="rb-card-header rb-card-header-between">
          <div class="d-flex align-items-center gap-2">
            <i class="fas fa-users"></i>
            <strong>Select Resigned Employee</strong>
          </div>
          <span id="employeeCount" class="rb-card-count"></span>
        </div>
        <div class="rb-card-body">
          <div id="employeeList"></div>
        </div>
      </div>

      <!-- Breakdown Results -->
      <div id="breakdownResults" style="display:none;">

        <!-- Employee Info -->
        <div class="rb-breakdown-top">
          <div style="padding:1.15rem 1.15rem 0;">
            <div class="info-grid" id="employeeInfo">
              <div class="info-item" style="grid-column:span 2;">
                <span class="info-label">Date of Transaction:</span>
                <span class="info-value" id="transactionDate"></span>
              </div>
              <div class="info-item">
                <span class="info-label">ID No:</span>
                <span class="info-value" id="employeeId"></span>
              </div>
              <div class="info-item">
                <span class="info-label">Length of Service:</span>
                <span class="info-value" id="employeeLengthOfService"></span>
              </div>
              <div class="info-item">
                <span class="info-label">Employee Name:</span>
                <span class="info-value" id="employeeName"></span>
              </div>
              <div class="info-item">
                <span class="info-label">Region:</span>
                <span class="info-value" id="employeeRegion"></span>
              </div>
              <div class="info-item">
                <span class="info-label">Date Hired:</span>
                <span class="info-value" id="employeeDateHired"></span>
              </div>
              <div class="info-item">
                <span class="info-label">Date Resigned:</span>
                <span class="info-value" id="employeeDateResigned"></span>
              </div>
              <div class="info-item">
                <span class="info-label">Designation:</span>
                <span class="info-value" id="employeeDesignation"></span>
              </div>
              <div class="info-item">
                <span class="info-label">Basic Rate:</span>
                <span class="info-value" id="employeeBasicRate"></span>
              </div>
            </div>
          </div>
        </div>

        <!-- Table -->
        <div class="rb-breakdown-mid">
          <div style="padding:1.15rem;">
            <div class="table-wrapper">
              <table id="breakdown-table" class="table table-bordered mb-0">
                <thead>
                  <tr>
                    <th style="text-align:center; vertical-align:middle; width:16%;">
                      <span style="display:block; font-size:0.72rem; text-transform:uppercase; letter-spacing:.04em;">Month</span>
                    </th>
                    <th style="text-align:center; vertical-align:middle; width:21%;">
                      <span style="display:block; font-size:0.7rem; text-transform:uppercase; letter-spacing:.04em; line-height:1.2;">Payroll Covered</span>
                      <span style="display:block; font-size:0.7rem; text-transform:uppercase; letter-spacing:.04em; line-height:1.2; font-weight:normal;">1 - 15</span>
                    </th>
                    <th style="text-align:center; vertical-align:middle; width:21%;">
                      <span style="display:block; font-size:0.7rem; text-transform:uppercase; letter-spacing:.04em; line-height:1.2;">Payroll Covered</span>
                      <span style="display:block; font-size:0.7rem; text-transform:uppercase; letter-spacing:.04em; line-height:1.2; font-weight:normal;">16 - 30/31</span>
                    </th>
                    <th style="text-align:center; vertical-align:middle; width:21%;">
                      <span style="display:block; font-size:0.7rem; text-transform:uppercase; letter-spacing:.04em; line-height:1.2;">Tardiness /</span>
                      <span style="display:block; font-size:0.7rem; text-transform:uppercase; letter-spacing:.04em; line-height:1.2; font-weight:normal;">Leave without Pay</span>
                    </th>
                    <th style="text-align:center; vertical-align:middle; width:21%;">
                      <span style="display:block; font-size:0.72rem; text-transform:uppercase; letter-spacing:.04em; line-height:1.2;">Total</span>
                      <span style="display:block; font-size:0.7rem; text-transform:uppercase; letter-spacing:.04em; line-height:1.2; font-weight:normal;">Income</span>
                    </th>
                  </tr>
                </thead>
                <tbody id="breakdownBody"></tbody>
              </table>
            </div>
          </div>
        </div>

        <!-- Summary -->
        <!-- Summary -->
<!-- Summary -->
<div class="rb-breakdown-bot">
  <div class="summary-grid" style="display:grid; grid-template-columns: 1fr 1fr; gap: 10px 30px; padding:15px 20px; border-top:2px solid var(--rb-border); margin-top:10px;">
    
    <!-- Left Column: 13th Month Payout Info -->
<div style="display:flex; flex-direction:column; gap:8px;">
  <div class="summary-item" style="display:flex; align-items:center; gap:10px;">
    <span class="summary-label" style="font-weight:600; color:var(--rb-navy); font-size:.9rem; min-width:180px;">Last 13th Month Date :</span>
    <span class="summary-value" id="thirteenthMonthDate" style="font-weight:500; font-size:.9rem; color:var(--rb-navy-deep);">No data</span>
  </div>
  <!-- NEW: Gross Amount -->
  <div class="summary-item" style="display:flex; align-items:center; gap:10px;">
    <span class="summary-label" style="font-weight:600; color:var(--rb-navy); font-size:.9rem; min-width:180px;">Last 13th Month Gross Amount :</span>
    <span class="summary-value highlight" id="thirteenthMonthGross" style="font-weight:700; font-size:1rem; color:var(--rb-blue);">₱0.00</span>
  </div>
  <div class="summary-item" style="display:flex; align-items:center; gap:10px;">
    <span class="summary-label" style="font-weight:600; color:var(--rb-navy); font-size:.9rem; min-width:180px;">Last 13th Month Amount :</span>
    <span class="summary-value highlight" id="thirteenthMonthAmount" style="font-weight:700; font-size:1rem; color:var(--rb-blue);">₱0.00</span>
  </div>
</div>
<div style="display:flex; flex-direction:column; gap:8px;">
      <div class="summary-item" style="display:flex; align-items:center; gap:10px; justify-content:flex-end;">
        <span class="summary-label" style="font-weight:600; color:var(--rb-navy); font-size:.9rem;">Total Summary :</span>
        <span class="summary-value highlight" id="totalSummary" style="font-weight:700; font-size:1rem; color:var(--rb-blue);">0.00</span>
      </div>
      <div class="summary-item" style="display:flex; align-items:center; gap:10px; justify-content:flex-end;">
        <span class="summary-label" style="font-weight:600; color:var(--rb-navy); font-size:.9rem;">13th Month :</span>
        <span class="summary-value highlight" id="thirteenthMonth" style="font-weight:700; font-size:1rem; color:var(--rb-blue);">0.00</span>
      </div>
    </div>
    
  </div>

  <div class="rb-action-bar" style="padding:0 20px 15px; border-top:1px solid var(--rb-border); padding-top:15px;">
    <div class="action-buttons" style="display:flex; gap:10px; margin-top:15px; justify-content:flex-end;">
      <button id="showListBtn" class="btn btn-outline-secondary" style="font-size:.9rem; display:none;">
        <i class="fas fa-list me-1"></i> Show Employee List
      </button>
      <button id="printBtn" class="btn btn-outline-primary" style="font-size:.9rem;">
        <i class="fas fa-print me-1"></i> Print / Download
      </button>
    </div>
  </div>
</div>
<!-- Add this inside the breakdownResults div -->
<div id="breakdownResults" style="display:none;">
  <input type="hidden" id="currentDisplayYear" value="">
  <!-- ... rest of the breakdown results content ... -->
</div>
      </div><!-- /#breakdownResults -->

    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="/js/scripts.js"></script>

<script>


  // ============= DOWNLOAD PDF =============
  // In the downloadPDF function, add the year parameter
document.addEventListener('DOMContentLoaded', function() {
  const searchForm = document.getElementById('searchForm');
  const officeSelect = document.getElementById('officeSelect');
  const idnoInput = document.getElementById('idno');
  const lastNameInput = document.getElementById('lastName');
  const firstNameInput = document.getElementById('firstName');
  const resetBtn = document.getElementById('resetBtn');
  const loading = document.getElementById('loading');
  const errorMessage = document.getElementById('errorMessage');
  const employeeListContainer = document.getElementById('employeeListContainer');
  const employeeList = document.getElementById('employeeList');
  const employeeCount = document.getElementById('employeeCount');
  const breakdownResults = document.getElementById('breakdownResults');
  const printBtn = document.getElementById('printBtn');
  const showListBtn = document.getElementById('showListBtn');

  let selectedEmployeeId = null;

  // Show list button handler
  if (showListBtn) {
    showListBtn.addEventListener('click', function() {
      if (employeeListContainer) {
        employeeListContainer.style.display = 'block';
      }
      if (breakdownResults) {
        breakdownResults.style.display = 'none';
      }
      showListBtn.style.display = 'none';
      employeeListContainer.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  }

  // Search form submit
  searchForm.addEventListener('submit', async function(e) {
    e.preventDefault();
    await searchEmployees();
  });

  // Reset button
  resetBtn.addEventListener('click', function() {
    searchForm.reset();
    employeeListContainer.style.display = 'none';
    breakdownResults.style.display = 'none';
    errorMessage.style.display = 'none';
    selectedEmployeeId = null;
    employeeList.innerHTML = '';
    document.getElementById('currentDisplayYear').value = '';
    if (showListBtn) {
      showListBtn.style.display = 'none';
    }
    const yearNote = document.getElementById('yearNote');
    if (yearNote) {
      yearNote.remove();
    }
  });

  // Print button
  printBtn.addEventListener('click', async function() {
    if (!selectedEmployeeId) {
      showError('Please select an employee first');
      return;
    }
    await downloadPDF();
  });

  // ============= SEARCH EMPLOYEES =============
  async function searchEmployees() {
    const office = officeSelect.value;
    const idno = idnoInput.value.trim();
    const lastName = lastNameInput.value.trim();
    const firstName = firstNameInput.value.trim();

    if (!office) {
      showError('Please select an office');
      return;
    }

    if (!idno && !lastName && !firstName) {
      showError('Please enter at least one search criteria');
      return;
    }

    loading.style.display = 'block';
    employeeListContainer.style.display = 'none';
    breakdownResults.style.display = 'none';
    errorMessage.style.display = 'none';

    try {
      const params = new URLSearchParams({ office });
      if (idno) params.append('idno', idno);
      if (lastName) params.append('lastName', lastName);
      if (firstName) params.append('firstName', firstName);

      const response = await fetch(`/resigned/resigned-employee/search?${params.toString()}`);
      const result = await response.json();

      if (result.success && result.data.length > 0) {
        displayEmployeeList(result.data);
      } else {
        showError('No resigned employees found matching your criteria');
        employeeListContainer.style.display = 'none';
      }
    } catch (error) {
      console.error('Error:', error);
      showError('Error searching employees');
    } finally {
      loading.style.display = 'none';
    }
  }

  // ============= DISPLAY EMPLOYEE LIST =============
  function displayEmployeeList(employees) {
    employeeList.innerHTML = '';
    employeeCount.textContent = `Found ${employees.length} employee(s)`;

    employees.forEach(emp => {
      const card = document.createElement('div');
      card.className = 'employee-card';
      card.innerHTML = `
        <div>
          <div class="rb-emp-name">
            ${emp.lastname || ''}, ${emp.firstname || ''}
          </div>
          <div class="rb-emp-meta">
            <span class="employee-badge"><strong>ID:</strong> ${emp.idno}</span>
            <span class="employee-badge"><strong>Region:</strong> ${emp.region || 'N/A'}</span>
            <span class="employee-badge"><strong>Area:</strong> ${emp.department || 'N/A'}</span>
            <span class="employee-badge"><strong>Resigned:</strong> ${formatDate(emp.dateresign)}</span>
          </div>
        </div>
        <div>
          <span class="badge-resigned">Resigned</span>
          <i class="fas fa-chevron-right rb-chevron"></i>
        </div>
      `;
      card.dataset.idno = emp.idno;
      card.addEventListener('click', function() {
        selectEmployee(emp.idno);
      });
      employeeList.appendChild(card);
    });

    employeeListContainer.style.display = 'block';
  }

  // ============= SELECT EMPLOYEE =============
  async function selectEmployee(idno) {
    const office = officeSelect.value;
    selectedEmployeeId = idno;

    // Clear previous year
    document.getElementById('currentDisplayYear').value = '';

    // Highlight selected card
    document.querySelectorAll('.employee-card').forEach(card => {
      card.classList.remove('selected');
      if (card.dataset.idno === idno) {
        card.classList.add('selected');
      }
    });

    // Hide employee list
    if (employeeListContainer) {
      employeeListContainer.style.display = 'none';
    }

    loading.style.display = 'block';
    breakdownResults.style.display = 'none';
    errorMessage.style.display = 'none';

    try {
      const url = `/resigned/resigned-employee/breakdown?office=${encodeURIComponent(office)}&idno=${encodeURIComponent(idno)}`;
      console.log('Fetching breakdown from:', url);
      
      const response = await fetch(url);
      
      if (!response.ok) {
        const text = await response.text();
        console.error('Server response:', text);
        throw new Error(`Server returned ${response.status}: ${response.statusText}`);
      }
      
      const result = await response.json();

      // Check if we need to select a year
      if (result.needsYearSelection && result.data && result.data.availableYears) {
        loading.style.display = 'none';
        
        const availableYear = result.data.availableYears[0];
        const currentYear = result.data.currentYear;
        
        const yearResult = await Swal.fire({
          title: 'No Data for Current Year',
          html: `
            <span style="color:#6B7686; font-size:.92rem;">
              No payroll data found for <strong style="color:#0F2233;">${currentYear}</strong>.<br>
              Would you like to view data from <strong style="color:#0F2233;">${availableYear}</strong> instead?
            </span>
          `,
          icon: 'question',
          showCancelButton: true,
          confirmButtonText: `Yes, view ${availableYear}`,
          cancelButtonText: 'Cancel',
          confirmButtonColor: '#2E6F9E',
          cancelButtonColor: '#6B7686',
        });

        if (yearResult.isConfirmed) {
          await selectEmployeeWithYear(idno, availableYear);
        } else {
          showError('No payroll data available for the selected year');
          // Show employee list again
          if (employeeListContainer) {
            employeeListContainer.style.display = 'block';
          }
        }
        return;
      }

      if (result.success) {
        displayBreakdown(result.data);
        breakdownResults.style.display = 'block';
        breakdownResults.scrollIntoView({ behavior: 'smooth', block: 'start' });
      } else {
        showError(result.message || 'Error loading breakdown');
        // Show employee list again
        if (employeeListContainer) {
          employeeListContainer.style.display = 'block';
        }
      }
    } catch (error) {
      console.error('Error:', error);
      showError('Error loading breakdown: ' + error.message);
      // Show employee list again
      if (employeeListContainer) {
        employeeListContainer.style.display = 'block';
      }
    } finally {
      loading.style.display = 'none';
    }
  }

  // ============= SELECT EMPLOYEE WITH YEAR =============
  async function selectEmployeeWithYear(idno, year) {
    const office = officeSelect.value;
    
    // Store the year being viewed
    document.getElementById('currentDisplayYear').value = year;
    
    if (employeeListContainer) {
      employeeListContainer.style.display = 'none';
    }
    
    loading.style.display = 'block';
    breakdownResults.style.display = 'none';
    errorMessage.style.display = 'none';

    try {
      const url = `/resigned/resigned-employee/breakdown?office=${encodeURIComponent(office)}&idno=${encodeURIComponent(idno)}&year=${year}`;
      console.log('Fetching breakdown for year:', year, 'from:', url);
      
      const response = await fetch(url);
      
      if (!response.ok) {
        const text = await response.text();
        console.error('Server response:', text);
        throw new Error(`Server returned ${response.status}: ${response.statusText}`);
      }
      
      const result = await response.json();

      if (result.success) {
        displayBreakdown(result.data);
        
        // Add year note
        const yearNote = document.createElement('div');
        yearNote.className = 'alert alert-info mt-2';
        yearNote.id = 'yearNote';
        yearNote.textContent = `Showing payroll data from ${year}`;
        
        const resultsContainer = document.getElementById('breakdownResults');
        const existingNote = document.getElementById('yearNote');
        if (existingNote) existingNote.remove();
        resultsContainer.insertBefore(yearNote, resultsContainer.firstChild);
        
        breakdownResults.style.display = 'block';
        breakdownResults.scrollIntoView({ behavior: 'smooth', block: 'start' });
      } else {
        showError(result.message || 'Error loading breakdown');
        // Show employee list again
        if (employeeListContainer) {
          employeeListContainer.style.display = 'block';
        }
      }
    } catch (error) {
      console.error('Error:', error);
      showError('Error loading breakdown: ' + error.message);
      // Show employee list again
      if (employeeListContainer) {
        employeeListContainer.style.display = 'block';
      }
    } finally {
      loading.style.display = 'none';
    }
  }

// ============= DISPLAY BREAKDOWN =============
function displayBreakdown(data) {
  const { employee, breakdown, summary } = data;
  const today = new Date();

  // Store the current year being displayed
  if (summary && summary.yearUsed) {
    document.getElementById('currentDisplayYear').value = summary.yearUsed;
  }

  // Determine basic rate: monthlyrate if available, otherwise dailyrate
  let basicRate = 0;
  let basicRateLabel = 'N/A';
  
  if (employee.monthlyrate && parseFloat(employee.monthlyrate) > 0) {
    basicRate = employee.monthlyrate;
    basicRateLabel = formatCurrency(basicRate) + ' (Monthly)';
  } else if (employee.dailyrate && parseFloat(employee.dailyrate) > 0) {
    basicRate = employee.dailyrate;
    basicRateLabel = formatCurrency(basicRate) + ' (Daily)';
  }

  // Calculate Length of Service
  let lengthOfService = 'N/A';
  if (employee.datehired && employee.dateresign) {
    const hired = new Date(employee.datehired);
    const resigned = new Date(employee.dateresign);
    const diffTime = Math.abs(resigned - hired);
    const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));
    const years = Math.floor(diffDays / 365);
    const months = Math.floor((diffDays % 365) / 30);
    
    if (years > 0 && months > 0) {
      lengthOfService = `${years} year${years > 1 ? 's' : ''} and ${months} month${months > 1 ? 's' : ''}`;
    } else if (years > 0) {
      lengthOfService = `${years} year${years > 1 ? 's' : ''}`;
    } else if (months > 0) {
      lengthOfService = `${months} month${months > 1 ? 's' : ''}`;
    } else {
      lengthOfService = 'Less than a month';
    }
  }

  // Employee info - safely set text content
  setElementText('transactionDate', today.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric'
  }));
  setElementText('employeeId', employee.idno || 'N/A');
  setElementText('employeeLengthOfService', lengthOfService);
  setElementText('employeeName', employee.fullname || 'N/A');
  setElementText('employeeRegion', employee.region || 'N/A');
  setElementText('employeeDateHired', formatDate(employee.datehired));
  setElementText('employeeDateResigned', formatDate(employee.dateresign));
  setElementText('employeeDesignation', employee.designation || 'N/A');
  setElementText('employeeBasicRate', basicRateLabel);

  // 13th Month Payout - safely set text content
const payout = summary.thirteenthMonthPayout;
const dateElement = document.getElementById('thirteenthMonthDate');
const grossElement = document.getElementById('thirteenthMonthGross');  // NEW
const amountElement = document.getElementById('thirteenthMonthAmount');

if (dateElement && grossElement && amountElement) {
  if (payout && payout.date && payout.amount > 0) {
    dateElement.textContent = formatDate(payout.date);
    grossElement.textContent = `₱${formatCurrency(payout.gross || 0)}`;  // NEW
    amountElement.textContent = `₱${formatCurrency(payout.amount)}`;
  } else {
    dateElement.textContent = 'No 13th month payout found';
    grossElement.textContent = '₱0.00';  // NEW
    amountElement.textContent = '₱0.00';
  }
}

  // Breakdown table
  const tbody = document.getElementById('breakdownBody');
  if (tbody) {
    tbody.innerHTML = '';

    if (breakdown.length === 0) {
      tbody.innerHTML = '<tr><td colspan="5" class="text-center">No payroll records found</td></tr>';
    } else {
      breakdown.forEach(item => {
        const tr = document.createElement('tr');
        tr.innerHTML = `
          <td>${item.month || 'N/A'}</td>
          <td style="text-align:right;">${formatCurrency(item.payrollCovered1)}</td>
          <td style="text-align:right;">${formatCurrency(item.payrollCovered2)}</td>
          <td style="text-align:right;">${formatCurrency(item.tardinessLeave)}</td>
          <td style="text-align:right; font-weight:600;">${formatCurrency(item.totalIncome)}</td>
        `;
        tbody.appendChild(tr);
      });
    }
  }

  // Summary - safely set text content
  setElementText('totalSummary', formatCurrency(summary.totalSummary));
  setElementText('thirteenthMonth', formatCurrency(summary.thirteenthMonth));
  
  if (showListBtn) {
    showListBtn.style.display = 'inline-block';
  }
}

// Helper function to safely set text content
function setElementText(elementId, text) {
  const element = document.getElementById(elementId);
  if (element) {
    element.textContent = text;
  } else {
    console.warn(`Element with ID '${elementId}' not found`);
  }
}

// Helper function to safely set text content
function setElementText(elementId, text) {
  const element = document.getElementById(elementId);
  if (element) {
    element.textContent = text;
  } else {
    console.warn(`Element with ID '${elementId}' not found`);
  }
}

  // ============= DOWNLOAD PDF =============
  async function downloadPDF() {
    const office = officeSelect.value;
    
    if (!selectedEmployeeId) {
      showError('Please select an employee first');
      return;
    }

    // Get the current year from the hidden input or year note
    let year = document.getElementById('currentDisplayYear').value;
    if (!year) {
      const yearNote = document.getElementById('yearNote');
      if (yearNote) {
        const match = yearNote.textContent.match(/\d{4}/);
        if (match) {
          year = match[0];
        }
      }
    }

    loading.style.display = 'block';
    
    try {
      const requestBody = {
        office: office,
        idno: selectedEmployeeId
      };
      
      // Only add year if we have one
      if (year) {
        requestBody.year = parseInt(year);
      }
      
      const response = await fetch('/resigned/resigned-employee/generate-pdf', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify(requestBody)
      });

      if (response.ok) {
        const blob = await response.blob();
        const url = window.URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `Payroll_Breakdown_Resigned_${selectedEmployeeId}_${new Date().toISOString().slice(0, 10)}.pdf`;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        window.URL.revokeObjectURL(url);
      } else {
        const text = await response.text();
        console.error('Server response:', text);
        let errorMsg = 'Error generating PDF';
        try {
          const error = JSON.parse(text);
          errorMsg = error.message || errorMsg;
        } catch (e) {
          errorMsg = text || errorMsg;
        }
        showError(errorMsg);
      }
    } catch (error) {
      console.error('Error:', error);
      showError('Error generating PDF: ' + error.message);
    } finally {
      loading.style.display = 'none';
    }
  }

  // ============= HELPER FUNCTIONS =============
  function formatDate(date) {
    if (!date) return 'N/A';
    const d = new Date(date);
    return d.toLocaleDateString('en-US', {
      year: 'numeric',
      month: 'long',
      day: 'numeric'
    });
  }

  function formatCurrency(amount) {
    return parseFloat(amount || 0).toLocaleString('en-US', {
      minimumFractionDigits: 2,
      maximumFractionDigits: 2
    });
  }

  function showError(message) {
    errorMessage.textContent = message;
    errorMessage.style.display = 'block';
    setTimeout(() => {
      errorMessage.style.display = 'none';
    }, 5000);
  }
});
