<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Error — {{title}}</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

  <style>
    body {
      font-family: 'Inter', -apple-system, sans-serif;
      background: linear-gradient(160deg, #16304A 0%, #0F2233 60%, #1F7A6C 100%);
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .error-card {
      background: #fff;
      border-radius: .85rem;
      box-shadow: 0 20px 60px rgba(15,34,51,.35);
      width: 100%;
      max-width: 480px;
      padding: 2.5rem 2rem;
      text-align: center;
    }
    .error-icon {
      width: 72px;
      height: 72px;
      border-radius: 50%;
      background: rgba(193,72,61,.1);
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 1.25rem;
    }
    .error-icon i {
      font-size: 2rem;
      color: #C1483D;
    }
  </style>
</head>
<body>

  <div class="error-card">

    <div class="error-icon">
      <i class="fas fa-circle-exclamation"></i>
    </div>

    <p style="text-transform:uppercase; letter-spacing:.08em; font-size:.65rem; font-weight:600; color:#2E6F9E; margin:0 0 .4rem;">HRMD Portal</p>

    <h1 style="font-size:1.4rem; font-weight:700; color:#0F2233; margin:0 0 .75rem;">Something went wrong</h1>

    <p style="font-size:.92rem; color:#6B7686; margin:0 0 1.75rem; line-height:1.6;">
      {{#if error}}{{error}}{{else}}An unexpected error occurred. Please try again or contact support.{{/if}}
    </p>

    <hr style="border-color:#E3E6EB; margin:0 0 1.5rem;">

    <div class="d-flex gap-2 justify-content-center">
      <a href="/" style="background:#16304A; border:none; color:#fff; font-weight:500; font-size:.9rem; padding:.55rem 1.25rem; border-radius:.45rem; text-decoration:none; display:inline-flex; align-items:center; gap:.4rem;">
        <i class="fas fa-home"></i> Return to Home
      </a>
      <a href="javascript:history.back()" style="background:transparent; border:1px solid #E3E6EB; color:#16304A; font-weight:500; font-size:.9rem; padding:.55rem 1.25rem; border-radius:.45rem; text-decoration:none; display:inline-flex; align-items:center; gap:.4rem;">
        <i class="fas fa-arrow-left"></i> Go Back
      </a>
    </div>

  </div>

</body>
</html>