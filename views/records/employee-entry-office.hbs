<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>{{title}}</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body>

<div class="dashboard-container">

  {{> header}}

  <div class="main-content" style="font-family:'Inter',-apple-system,sans-serif; background:#F6F7F9;">
    <div class="container-fluid px-4 py-4">

      <!-- Page Header -->
      <div class="mb-4">
        <h1 style="font-size:1.65rem; font-weight:700; color:#0F2233; display:flex; align-items:center; gap:.6rem; margin:0;">
          <i class="fas fa-user-plus" style="color:#2E6F9E;"></i> Employee Entry
        </h1>
        <p style="color:#6B7686; font-size:.92rem; margin:.35rem 0 0;">Select the office where the employee will be encoded.</p>
      </div>

      <!-- Office Selection Card -->
      <div style="border:1px solid #E3E6EB; border-radius:.65rem; background:#fff; box-shadow:0 1px 2px rgba(16,24,40,.04); margin-bottom:1.25rem;">

        <div style="border-bottom:1px solid #E3E6EB; padding:.85rem 1.15rem; display:flex; align-items:center; gap:.55rem; border-radius:.65rem .65rem 0 0;">
          <i class="fas fa-building" style="color:#2E6F9E;"></i>
          <strong style="color:#0F2233; font-weight:600; font-size:.97rem;">Office Selection</strong>
        </div>

        <div style="padding:1.15rem;">
          <form method="GET" action="/records/employee-entry/select-office">
            <div class="row g-3 align-items-end">

              <div class="col-md-6">
                <label style="font-size:.8rem; font-weight:600; color:#16304A; display:block; margin-bottom:.35rem;">
                  Office <span style="color:#C1483D;">*</span>
                </label>
                <select name="office" class="form-select" style="border-color:#E3E6EB;" required>
                  <option value="">Select Office</option>
                  {{#each offices}}
                    <option value="{{this.office_name}}">{{this.office_name}}</option>
                  {{/each}}
                </select>
              </div>

              <div class="col-md-3">
                <button type="submit" class="btn w-100" style="background:#2E6F9E; border-color:#2E6F9E; color:#fff; font-weight:500; font-size:.9rem;">
                  Continue <i class="fas fa-arrow-right ms-1"></i>
                </button>
              </div>

            </div>
          </form>
        </div>

      </div>

      <!-- Info Notice -->
      <div style="border:1px solid #BFDBF7; border-radius:.55rem; background:#EBF4FD; padding:.85rem 1.1rem; display:flex; align-items:flex-start; gap:.65rem;">
        <i class="fas fa-circle-info" style="color:#2E6F9E; margin-top:.1rem;"></i>
        <p style="font-size:.88rem; color:#16304A; margin:0;">
          <strong>Note:</strong> VISMIN uses applicant search. Luzon and ML Group proceed to manual encoding.
        </p>
      </div>

    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>