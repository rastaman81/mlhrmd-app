<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>{{title}}</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/styles.css">

  <style>
    #regionTable thead th {
      background: #16304A;
      color: #fff;
      font-size: .72rem;
      text-transform: uppercase;
      letter-spacing: .04em;
      font-weight: 600;
      border-color: #1e3e5e;
      padding: .75rem 1rem;
      white-space: nowrap;
    }
    #regionTable tbody td {
      font-size: .88rem;
      color: #0F2233;
      padding: .7rem 1rem;
      vertical-align: middle;
      border-color: #E3E6EB;
    }
    #regionTable tbody tr:nth-child(odd) td  { background: #F6F7F9; }
    #regionTable tbody tr:nth-child(even) td { background: #fff; }
    #regionTable tbody tr:hover td           { background: #EBF3FA !important; }
  </style>
</head>
<body>

<div class="dashboard-container">

  {{> header}}

  <div class="main-content" style="font-family:'Inter',-apple-system,sans-serif; background:#F6F7F9;">
    <div class="container-fluid px-4 py-4">

      <!-- Page Header -->
      <div class="d-flex justify-content-between align-items-end flex-wrap gap-3 mb-4">
        <div>
          <h1 style="font-size:1.65rem; font-weight:700; color:#0F2233; display:flex; align-items:center; gap:.6rem; margin:0;">
            <i class="fas fa-sitemap" style="color:#2E6F9E;"></i> Region Management
          </h1>
          <p style="color:#6B7686; font-size:.92rem; margin:.35rem 0 0;">Manage regions, support groups, areas, and departments.</p>
        </div>
        <a href="/records/regions/create" class="btn" style="background:#1F7A6C; border-color:#1F7A6C; color:#fff; font-weight:500; font-size:.9rem;">
          <i class="fas fa-plus me-1"></i> Add Region
        </a>
      </div>

      <!-- Filter + Table Card -->
      <div style="border:1px solid #E3E6EB; border-radius:.65rem; background:#fff; box-shadow:0 1px 2px rgba(16,24,40,.04);">

        <div style="border-bottom:1px solid #E3E6EB; padding:.85rem 1.15rem; display:flex; align-items:center; justify-content:space-between; gap:1rem; border-radius:.65rem .65rem 0 0; flex-wrap:wrap;">
          <div style="display:flex; align-items:center; gap:.55rem;">
            <i class="fas fa-table-list" style="color:#2E6F9E;"></i>
            <strong style="color:#0F2233; font-weight:600; font-size:.97rem;">Regions</strong>
          </div>

          <!-- Office filter inline in header -->
          <div style="display:flex; align-items:center; gap:.65rem;">
            <label style="font-size:.8rem; font-weight:600; color:#16304A; white-space:nowrap; margin:0;">Office</label>
            <select id="officeFilter" class="form-select form-select-sm" style="border-color:#E3E6EB; min-width:180px; font-size:.88rem;">
              <option value="">Select Office</option>
              {{#each offices}}
                <option
                  value="{{this.office_name}}"
                  {{#ifCond ../selectedOffice this.office_name}}selected{{/ifCond}}
                >
                  {{this.office_name}}
                </option>
              {{/each}}
            </select>
          </div>
        </div>

        <div style="padding:0;">
          <div class="table-responsive">
            <table class="table mb-0" id="regionTable">
              <thead>
                <tr>
                  <th>Region ID</th>
                  <th>Region / Group Name</th>
                  <th>Type</th>
                  <th>Region / Division Head</th>
                  <th style="text-align:center;">Action</th>
                </tr>
              </thead>
              <tbody>
                {{#if regions.length}}
                  {{#each regions}}
                    <tr>
                      <td style="font-variant-numeric:tabular-nums;">{{this.regionid}}</td>
                      <td style="font-weight:600;">{{this.regionname}}</td>
                      <td>
                        <span style="background:rgba(46,111,158,.1); color:#2E6F9E; font-size:.75rem; font-weight:600; padding:.25rem .65rem; border-radius:1rem; display:inline-block;">
                          {{this.region_type}}
                        </span>
                      </td>
                      <td>{{this.region_manager}}</td>
                      <td style="text-align:center;">
                        
                          <a href="/records/regions/edit/{{this.regionid}}?office={{../selectedOffice}}"
                          class="btn btn-sm"
                          style="background:transparent; border:1px solid #2E6F9E; color:#2E6F9E; font-size:.78rem; font-weight:500;"
                        >
                          <i class="fas fa-pen me-1"></i> Edit
                        </a>
                      </td>
                    </tr>
                  {{/each}}
                {{else}}
                  <tr>
                    <td colspan="5" style="text-align:center; color:#6B7686; padding:2.5rem 1rem; font-size:.9rem;">
                      <i class="fas fa-sitemap" style="color:#E3E6EB; font-size:1.5rem; display:block; margin-bottom:.5rem;"></i>
                      {{#if selectedOffice}}
                        No regions found for the selected office.
                      {{else}}
                        Select an office above to view regions.
                      {{/if}}
                    </td>
                  </tr>
                {{/if}}
              </tbody>
            </table>
          </div>
        </div>

      </div>

    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
  document.getElementById("officeFilter").addEventListener("change", function () {
    const office = this.value;
    if (!office) {
      window.location.href = "/records/regions";
      return;
    }
    window.location.href = `/records/regions?office=${encodeURIComponent(office)}`;
  });
</script>

</body>
</html>