<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>{{title}}</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/styles.css">

  <style>
    #applicantsTable thead th {
      background: #16304A;
      color: #fff;
      font-size: .72rem;
      text-transform: uppercase;
      letter-spacing: .04em;
      font-weight: 600;
      border-color: #1e3e5e;
      padding: .75rem 1rem;
    }
    #applicantsTable tbody td {
      font-size: .88rem;
      color: #0F2233;
      padding: .7rem 1rem;
      vertical-align: middle;
      border-color: #E3E6EB;
    }
    #applicantsTable tbody tr:nth-child(odd) td { background: #F6F7F9; }
    #applicantsTable tbody tr:nth-child(even) td { background: #fff; }
    #applicantsTable tbody tr:hover td { background: #EBF3FA !important; }
  </style>
</head>
<body>

<div class="dashboard-container">

  {{> header}}

  <div class="main-content" style="font-family:'Inter',-apple-system,sans-serif; background:#F6F7F9;">
    <div class="container-fluid px-4 py-4">

      <!-- Page Header -->
      <div class="d-flex justify-content-between align-items-end flex-wrap gap-3 mb-4">
        <div>
          <h1 style="font-size:1.65rem; font-weight:700; color:#0F2233; display:flex; align-items:center; gap:.6rem; margin:0;">
            <i class="fas fa-search" style="color:#2E6F9E;"></i> Applicant Search
          </h1>
          <p style="color:#6B7686; font-size:.92rem; margin:.35rem 0 0;">
            Office: <strong style="color:#16304A;">{{office}}</strong>
          </p>
        </div>
        <a href="/records/employee-entry" class="btn btn-outline-secondary" style="font-size:.88rem;">
          <i class="fas fa-arrow-left me-1"></i> Back
        </a>
      </div>

      <!-- Search Card -->
      <div style="border:1px solid #E3E6EB; border-radius:.65rem; background:#fff; box-shadow:0 1px 2px rgba(16,24,40,.04); margin-bottom:1.25rem;">

        <div style="border-bottom:1px solid #E3E6EB; padding:.85rem 1.15rem; display:flex; align-items:center; gap:.55rem; border-radius:.65rem .65rem 0 0;">
          <i class="fas fa-magnifying-glass" style="color:#2E6F9E;"></i>
          <strong style="color:#0F2233; font-weight:600; font-size:.97rem;">Search Applicant</strong>
        </div>

        <div style="padding:1.15rem;">
          <form method="GET" action="/records/employee-entry/applicants">
            <input type="hidden" name="office" value="{{office}}">
            <div class="row g-3 align-items-end">

              <div class="col-md-7">
                <label style="font-size:.8rem; font-weight:600; color:#16304A; display:block; margin-bottom:.35rem;">Applicant Name</label>
                <input
                  type="text"
                  name="keyword"
                  class="form-control"
                  placeholder="Search by first name or last name"
                  value="{{keyword}}"
                  required
                  style="border-color:#E3E6EB;"
                >
              </div>

              <div class="col-md-2">
                <button type="submit" class="btn w-100" style="background:#2E6F9E; border-color:#2E6F9E; color:#fff; font-weight:500; font-size:.9rem;">
                  <i class="fas fa-search me-1"></i> Search
                </button>
              </div>

              <div class="col-md-3">
                <a href="/records/employee-entry/form?office={{office}}" class="btn w-100" style="background:#1F7A6C; border-color:#1F7A6C; color:#fff; font-weight:500; font-size:.9rem;">
                  <i class="fas fa-pen-to-square me-1"></i> Manual Entry
                </a>
              </div>

            </div>
          </form>
        </div>

      </div>

      <!-- Results Card -->
      <div style="border:1px solid #E3E6EB; border-radius:.65rem; background:#fff; box-shadow:0 1px 2px rgba(16,24,40,.04);">

        <div style="border-bottom:1px solid #E3E6EB; padding:.85rem 1.15rem; display:flex; align-items:center; gap:.55rem; border-radius:.65rem .65rem 0 0;">
          <i class="fas fa-table-list" style="color:#2E6F9E;"></i>
          <strong style="color:#0F2233; font-weight:600; font-size:.97rem;">Applicants</strong>
        </div>

        <div style="padding:0;">
          <div class="table-responsive">
            <table class="table mb-0" id="applicantsTable">
              <thead>
                <tr>
                  <th>Last Name</th>
                  <th>First Name</th>
                  <th>Middle Name</th>
                  <th>Status</th>
                  <th style="text-align:center;">Action</th>
                </tr>
              </thead>
              <tbody>
                {{#if applicants.length}}
                  {{#each applicants}}
                    <tr>
                      <td>{{this.lastname}}</td>
                      <td>{{this.firstname}}</td>
                      <td>{{this.middlename}}</td>
                      <td>
                        {{#if this.canProceed}}
                          <span style="background:rgba(31,122,108,.1); color:#1F7A6C; font-size:.78rem; font-weight:600; padding:.3rem .75rem; border-radius:1rem; display:inline-block;">
                            For On-Boarding
                          </span>
                        {{else}}
                          <span style="background:rgba(107,118,134,.1); color:#6B7686; font-size:.78rem; font-weight:600; padding:.3rem .75rem; border-radius:1rem; display:inline-block;">
                            Already On-Boarded
                          </span>
                        {{/if}}
                      </td>
                      <td style="text-align:center;">
                        {{#if this.canProceed}}
                          <a href="/records/employee-entry/form?office={{../office}}&applicantId={{this.applicantid}}"
                            class="btn btn-sm"
                            style="background:#1F7A6C; border-color:#1F7A6C; color:#fff; font-size:.8rem; font-weight:500;">
                            <i class="fas fa-arrow-right me-1"></i> Proceed
                          </a>
                        {{else}}
                          <button class="btn btn-sm" style="background:#E3E6EB; border-color:#E3E6EB; color:#6B7686; font-size:.8rem;" disabled>
                            <i class="fas fa-check me-1"></i> Completed
                          </button>
                        {{/if}}
                      </td>
                    </tr>
                  {{/each}}
                {{else}}
                  <tr>
                    <td colspan="5" style="text-align:center; color:#6B7686; padding:2.5rem 1rem; font-size:.9rem;">
                      <i class="fas fa-magnifying-glass me-2" style="color:#E3E6EB; font-size:1.5rem; display:block; margin-bottom:.5rem;"></i>
                      Search for an applicant above to see results.
                    </td>
                  </tr>
                {{/if}}
              </tbody>
            </table>
          </div>
        </div>

      </div>

    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>