<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>{{title}}</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/styles.css">
  
  <style>
    .form-label {
      font-size: .8rem;
      font-weight: 600;
      color: #16304A;
      margin-bottom: .35rem;
    }
    .form-control, .form-select {
      border-color: #E3E6EB;
      font-size: .9rem;
    }
    .form-control:focus, .form-select:focus {
      border-color: #2E6F9E;
      box-shadow: 0 0 0 .2rem rgba(46,111,158,.12);
    }
    
    .filter-card {
      border: 1px solid #E3E6EB;
      border-radius: .65rem;
      background: #fff;
      box-shadow: 0 1px 2px rgba(16,24,40,.04);
      margin-bottom: 1.25rem;
    }
    .filter-card-header {
      border-bottom: 1px solid #E3E6EB;
      padding: .85rem 1.15rem;
      display: flex;
      align-items: center;
      gap: .55rem;
      border-radius: .65rem .65rem 0 0;
    }
    .filter-card-body {
      padding: 1.15rem;
    }
    
    #employee-table {
      width: 100%;
      table-layout: auto;
      border-collapse: collapse;
    }
    #employee-table thead th {
      background: #16304A;
      color: #fff;
      font-size: .72rem;
      text-transform: uppercase;
      letter-spacing: .04em;
      font-weight: 600;
      border-color: #1e3e5e;
      padding: .65rem .85rem;
      white-space: nowrap;
      position: sticky;
      top: 0;
      z-index: 10;
      box-shadow: 0 2px 4px rgba(0,0,0,.08);
    }
    #employee-table tbody td {
      font-size: .83rem;
      color: #0F2233;
      padding: .6rem .85rem;
      vertical-align: middle;
      border-color: #E3E6EB;
    }
    #employee-table tbody tr:nth-child(odd) td { background: #F6F7F9; }
    #employee-table tbody tr:nth-child(even) td { background: #fff; }
    #employee-table tbody tr:hover td { background: #EBF3FA !important; }
    
    .results-card {
      border: 1px solid #E3E6EB;
      border-radius: .65rem;
      background: #fff;
      box-shadow: 0 1px 2px rgba(16,24,40,.04);
      display: none;
    }
    .results-card-header {
      border-bottom: 1px solid #E3E6EB;
      padding: .85rem 1.15rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      border-radius: .65rem .65rem 0 0;
    }
    .results-card-body {
      padding: 0;
      max-height: 600px;
      overflow-y: auto;
    }
    .results-card-footer {
      border-top: 1px solid #E3E6EB;
      padding: .75rem 1.15rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      border-radius: 0 0 .65rem .65rem;
      font-size: .8rem;
      color: #6B7686;
    }
    
    .selection-info {
      background: #EBF3FA;
      border-radius: .5rem;
      padding: .6rem 1rem;
      font-size: .85rem;
      color: #16304A;
    }
    .selection-info strong {
      color: #2E6F9E;
    }
    
    .no-data {
      text-align: center;
      color: #6B7686;
      padding: 3rem;
    }
    .no-data i {
      font-size: 3rem;
      color: #D1D5DB;
      display: block;
      margin-bottom: 1rem;
    }
    
    select:disabled {
      cursor: not-allowed;
      opacity: 0.6;
    }
  </style>
</head>
<body>

<div class="dashboard-container">
  {{> header}}
  
  <div class="main-content" style="font-family:'Inter',-apple-system,sans-serif; background:#F6F7F9;">
    <div class="container-fluid px-4 py-4">
      
      <!-- Page Header -->
      <div class="mb-4">
        <h1 style="font-size:1.65rem; font-weight:700; color:#0F2233; display:flex; align-items:center; gap:.6rem; margin:0;">
          <i class="fas fa-eye" style="color:#2E6F9E;"></i> Employee View
        </h1>
        <p style="color:#6B7686; font-size:.92rem; margin:.35rem 0 0;">
          Select filters to view employee records. This is a view-only page.
        </p>
      </div>
      
      <!-- Filter Card -->
      <div class="filter-card">
        <div class="filter-card-header">
          <i class="fas fa-sliders-h" style="color:#2E6F9E;"></i>
          <strong style="color:#0F2233; font-weight:600; font-size:.97rem;">Filters</strong>
        </div>
        <div class="filter-card-body">
          <form id="filterForm">
            <div class="row g-3">
              <!-- Office -->
              <div class="col-md-3">
                <label class="form-label">Office <span class="text-danger">*</span></label>
                <select class="form-select" name="office" id="officeSelect" required>
                  <option value="" disabled selected>Select Office</option>
                  {{#each offices}}
                    <option value="{{this.office_name}}">{{this.office_name}}</option>
                  {{/each}}
                </select>
              </div>
              
              <!-- Region -->
              <div class="col-md-3">
                <label class="form-label">Region</label>
                <select class="form-select" name="region" id="regionSelect" disabled>
                  <option value="">Select Office First</option>
                </select>
              </div>
              
              <!-- Area/Department -->
              <div class="col-md-3">
                <label class="form-label">Area / Department</label>
                <select class="form-select" name="area" id="areaSelect" disabled>
                  <option value="">Select Region First</option>
                </select>
              </div>
              
              <!-- Branch -->
              <div class="col-md-3">
                <label class="form-label">Branch</label>
                <select class="form-select" name="branch" id="branchSelect" disabled>
                  <option value="">Select Area First</option>
                </select>
              </div>
            </div>
            
            <!-- Buttons -->
            <div class="d-flex justify-content-between align-items-center mt-3">
              <div class="selection-info" id="selectionInfo">
                <i class="fas fa-info-circle me-1"></i>
                <span id="filterSummary">Select an office first, then region, area, and branch to filter employees</span>
              </div>
              <div class="d-flex gap-2">
                <button type="button" id="resetBtn" class="btn btn-outline-secondary" style="font-size:.9rem;">
                  <i class="fas fa-redo me-1"></i> Reset
                </button>
                <button type="submit" class="btn" style="background:#2E6F9E; border-color:#2E6F9E; color:#fff; font-weight:500; font-size:.9rem;">
                  <i class="fas fa-eye me-1"></i> View
                </button>
              </div>
            </div>
          </form>
        </div>
      </div>
      
      <!-- Loading -->
      <div id="loadingIndicator" class="text-center py-5" style="display:none;">
        <div class="spinner-border" role="status" style="color:#2E6F9E; width:2.5rem; height:2.5rem;">
          <span class="visually-hidden">Loading...</span>
        </div>
        <p class="mt-2" style="color:#6B7686; font-size:.9rem;">Loading employees...</p>
      </div>
      
      <!-- Error -->
      <div id="errorMessage" class="alert border-0" style="display:none; border-left:4px solid #C1483D !important; border-radius:.55rem; font-size:.9rem; background:rgba(193,72,61,.07); color:#C1483D;"></div>
      
      <!-- Results Card -->
      <div class="results-card" id="resultsCard">
        <div class="results-card-header">
          <div style="display:flex; align-items:center; gap:.55rem;">
            <i class="fas fa-users" style="color:#2E6F9E;"></i>
            <strong style="color:#0F2233; font-weight:600; font-size:.97rem;">Employees</strong>
            <span class="badge" style="background:#2E6F9E; font-weight:400;" id="employeeCount">0</span>
          </div>
        </div>
        <div class="results-card-body">
          <table id="employee-table" class="table table-bordered mb-0">
            <thead>
              <tr>
                <th>ID No.</th>
                <th>Last Name</th>
                <th>First Name</th>
                <th>Middle Name</th>
                <th>Designation</th>
              </tr>
            </thead>
            <tbody id="employeeTableBody">
              <tr>
                <td colspan="5" class="no-data">
                  <i class="fas fa-search"></i>
                  <p>Select filters and click View to see employees.</p>
                </td>
              </tr>
            </tbody>
          </table>
        </div>
        <div class="results-card-footer">
          <span id="recordInfo">Total: 0 records</span>
        </div>
      </div>
      
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<script>
  document.addEventListener("DOMContentLoaded", function() {
    const officeSelect = document.getElementById("officeSelect");
    const regionSelect = document.getElementById("regionSelect");
    const areaSelect = document.getElementById("areaSelect");
    const branchSelect = document.getElementById("branchSelect");
    const filterForm = document.getElementById("filterForm");
    const resetBtn = document.getElementById("resetBtn");
    const resultsCard = document.getElementById("resultsCard");
    const loadingIndicator = document.getElementById("loadingIndicator");
    const errorMessage = document.getElementById("errorMessage");
    const employeeTableBody = document.getElementById("employeeTableBody");
    const employeeCount = document.getElementById("employeeCount");
    const recordInfo = document.getElementById("recordInfo");
    const filterSummary = document.getElementById("filterSummary");
    
    const clientCache = new Map();

    // ── HELPER: Reset dependent dropdowns ──────────────────────────────────
    function resetRegionDropdowns() {
      regionSelect.innerHTML = '<option value="">Select Office First</option>';
      regionSelect.disabled = true;
      areaSelect.innerHTML = '<option value="">Select Region First</option>';
      areaSelect.disabled = true;
      branchSelect.innerHTML = '<option value="">Select Area First</option>';
      branchSelect.disabled = true;
    }
    
    function resetAreaDropdowns() {
      areaSelect.innerHTML = '<option value="">Select Region First</option>';
      areaSelect.disabled = true;
      branchSelect.innerHTML = '<option value="">Select Area First</option>';
      branchSelect.disabled = true;
    }
    
    function resetBranchDropdowns() {
      branchSelect.innerHTML = '<option value="">Select Area First</option>';
      branchSelect.disabled = true;
    }
    
    // ── CASCADING DROPDOWNS ──────────────────────────────────────────────────
    
    // 1. Office → Regions (with counts)
    // Office → Regions (with counts) - OPTIMIZED
    let regionController = null, areaController = null, branchController = null;
officeSelect.addEventListener("change", function() {
  const office = this.value;
  
  resetRegionDropdowns();
  
  if (!office) {
    filterSummary.textContent = 'Please select an office';
    return;
  }

  const cacheKey = `regions:${office}`;

  // ── Serve from cache if we have it ──
  if (clientCache.has(cacheKey)) {
    const regions = clientCache.get(cacheKey);
    regionSelect.innerHTML = '<option value="">All Regions</option>';
    regions.forEach(region => {
      const option = document.createElement("option");
      option.value = region.regionid;
      option.textContent = `${region.regionname} (${region.employee_count || 0})`;
      regionSelect.appendChild(option);
    });
    regionSelect.disabled = false;
    filterSummary.textContent = `Office selected: ${office}. Select a region to continue.`;
    return; // skip the fetch entirely
  }
  
  regionSelect.disabled = true;
  regionSelect.innerHTML = '<option value="">Loading regions...</option>';
  
  const controller = new AbortController();
  const timeoutId = setTimeout(() => controller.abort(), 15000);
  
  fetch(`/records/viewer/regions?office=${encodeURIComponent(office)}`, {
    signal: controller.signal
  })
    .then(res => {
      clearTimeout(timeoutId);
      if (!res.ok) throw new Error(`HTTP error! status: ${res.status}`);
      return res.json();
    })
    .then(data => {
      if (data.success && data.regions && data.regions.length > 0) {
        clientCache.set(cacheKey, data.regions); // ── SAVE TO CACHE ──

        regionSelect.innerHTML = '<option value="">All Regions</option>';
        data.regions.forEach(region => {
          const option = document.createElement("option");
          option.value = region.regionid;
          option.textContent = `${region.regionname} (${region.employee_count || 0})`;
          regionSelect.appendChild(option);
        });
        regionSelect.disabled = false;
        filterSummary.textContent = `Office selected: ${office}. Select a region to continue.`;
      } else {
        regionSelect.innerHTML = '<option value="">No regions found</option>';
        regionSelect.disabled = false;
        filterSummary.textContent = `No regions found for ${office}`;
      }
    })
    .catch(err => {
      clearTimeout(timeoutId);
      console.error("Error loading regions:", err);
      
      if (err.name === 'AbortError') {
        regionSelect.innerHTML = '<option value="">Request timed out - Please try again</option>';
        showError("Request timed out. Please try again.");
      } else {
        regionSelect.innerHTML = '<option value="">Error loading regions</option>';
        showError("Failed to load regions. Please try again.");
      }
      regionSelect.disabled = false;
    });
});
    
    // 2. Region → Areas (with counts)
    // Region → Areas (with counts) - OPTIMIZED
regionSelect.addEventListener("change", function() {
  const office = officeSelect.value;
  const region = this.value;
  
  resetAreaDropdowns();
  
  if (!region || !office) {
    if (!region) filterSummary.textContent = 'Please select a region';
    return;
  }

  const cacheKey = `areas:${office}:${region}`;

  if (clientCache.has(cacheKey)) {
    const areas = clientCache.get(cacheKey);
    areaSelect.innerHTML = '<option value="">All Areas</option>';
    areas.forEach(area => {
      const option = document.createElement("option");
      option.value = area.areaid;
      option.textContent = `${area.area_name} (${area.employee_count || 0})`;
      areaSelect.appendChild(option);
    });
    areaSelect.disabled = false;
    const regionName = regionSelect.options[regionSelect.selectedIndex]?.text || region;
    filterSummary.textContent = `Office: ${office} → Region: ${regionName}. Select an area to continue.`;
    return;
  }
  
  areaSelect.disabled = true;
  areaSelect.innerHTML = '<option value="">Loading areas...</option>';
  
  const controller = new AbortController();
  const timeoutId = setTimeout(() => controller.abort(), 15000);
  
  fetch(`/records/viewer/areas?office=${encodeURIComponent(office)}&regionId=${encodeURIComponent(region)}`, {
    signal: controller.signal
  })
    .then(res => {
      clearTimeout(timeoutId);
      if (!res.ok) throw new Error(`HTTP error! status: ${res.status}`);
      return res.json();
    })
    .then(data => {
      if (data.success && data.areas && data.areas.length > 0) {
        clientCache.set(cacheKey, data.areas); // ── SAVE TO CACHE ──

        areaSelect.innerHTML = '<option value="">All Areas</option>';
        data.areas.forEach(area => {
          const option = document.createElement("option");
          option.value = area.areaid;
          option.textContent = `${area.area_name} (${area.employee_count || 0})`;
          areaSelect.appendChild(option);
        });
        areaSelect.disabled = false;
        const regionName = regionSelect.options[regionSelect.selectedIndex]?.text || region;
        filterSummary.textContent = `Office: ${office} → Region: ${regionName}. Select an area to continue.`;
      } else {
        areaSelect.innerHTML = '<option value="">No areas found</option>';
        areaSelect.disabled = false;
        filterSummary.textContent = `No areas found for this region`;
      }
    })
    .catch(err => {
      clearTimeout(timeoutId);
      console.error("Error loading areas:", err);
      
      if (err.name === 'AbortError') {
        areaSelect.innerHTML = '<option value="">Request timed out - Please try again</option>';
      } else {
        areaSelect.innerHTML = '<option value="">Error loading areas</option>';
      }
      areaSelect.disabled = false;
      showError("Failed to load areas. Please try again.");
    });
});
    
    // 3. Area → Branches (with counts)
    // Area → Branches (with counts) - OPTIMIZED
areaSelect.addEventListener("change", function() {
  const office = officeSelect.value;
  const region = regionSelect.value;
  const area = this.value;
  
  resetBranchDropdowns();
  
  if (!area || !region || !office) {
    if (!area) filterSummary.textContent = 'Please select an area';
    return;
  }

  const cacheKey = `branches:${office}:${region}:${area}`;

  // ── Serve from cache if we have it ──
  if (clientCache.has(cacheKey)) {
    const branches = clientCache.get(cacheKey);
    branchSelect.innerHTML = '<option value="">All Branches</option>';
    branches.forEach(branch => {
      const option = document.createElement("option");
      option.value = branch.branchcode;
      option.textContent = `${branch.branchname} (${branch.employee_count || 0})`;
      branchSelect.appendChild(option);
    });
    branchSelect.disabled = false;
    const regionName = regionSelect.options[regionSelect.selectedIndex]?.text || region;
    const areaName = areaSelect.options[areaSelect.selectedIndex]?.text || area;
    filterSummary.textContent = `Office: ${office} → Region: ${regionName} → Area: ${areaName}. Select a branch or click View.`;
    return; // skip the fetch entirely
  }
  
  branchSelect.disabled = true;
  branchSelect.innerHTML = '<option value="">Loading branches...</option>';
  
  const controller = new AbortController();
  const timeoutId = setTimeout(() => controller.abort(), 15000);
  
  fetch(`/records/viewer/branches?office=${encodeURIComponent(office)}&regionId=${encodeURIComponent(region)}&areaId=${encodeURIComponent(area)}`, {
    signal: controller.signal
  })
    .then(res => {
      clearTimeout(timeoutId);
      if (!res.ok) throw new Error(`HTTP error! status: ${res.status}`);
      return res.json();
    })
    .then(data => {
      if (data.success && data.branches && data.branches.length > 0) {
        clientCache.set(cacheKey, data.branches); // ── SAVE TO CACHE ──

        branchSelect.innerHTML = '<option value="">All Branches</option>';
        data.branches.forEach(branch => {
          const option = document.createElement("option");
          option.value = branch.branchcode;
          option.textContent = `${branch.branchname} (${branch.employee_count || 0})`;
          branchSelect.appendChild(option);
        });
        branchSelect.disabled = false;
        const regionName = regionSelect.options[regionSelect.selectedIndex]?.text || region;
        const areaName = areaSelect.options[areaSelect.selectedIndex]?.text || area;
        filterSummary.textContent = `Office: ${office} → Region: ${regionName} → Area: ${areaName}. Select a branch or click View.`;
      } else {
        branchSelect.innerHTML = '<option value="">No branches found</option>';
        branchSelect.disabled = false;
        filterSummary.textContent = `No branches found for this area`;
      }
    })
    .catch(err => {
      clearTimeout(timeoutId);
      console.error("Error loading branches:", err);
      
      if (err.name === 'AbortError') {
        branchSelect.innerHTML = '<option value="">Request timed out - Please try again</option>';
      } else {
        branchSelect.innerHTML = '<option value="">Error loading branches</option>';
      }
      branchSelect.disabled = false;
      showError("Failed to load branches. Please try again.");
    });
});
    
    // ── UPDATE FILTER SUMMARY ──────────────────────────────────────────────
    
    function updateFilterSummary() {
      const office = officeSelect.options[officeSelect.selectedIndex]?.text || '';
      const region = regionSelect.options[regionSelect.selectedIndex]?.text || '';
      const area = areaSelect.options[areaSelect.selectedIndex]?.text || '';
      const branch = branchSelect.options[branchSelect.selectedIndex]?.text || '';
      
      let parts = [];
      if (office && office !== 'Select Office') parts.push(`<strong>Office:</strong> ${office}`);
      if (region && region !== 'All Regions' && region !== 'Select Office First' && region !== 'Loading regions...') {
        parts.push(`<strong>Region:</strong> ${region}`);
      }
      if (area && area !== 'All Areas' && area !== 'Select Region First' && area !== 'Loading areas...') {
        parts.push(`<strong>Area:</strong> ${area}`);
      }
      if (branch && branch !== 'All Branches' && branch !== 'Select Area First' && branch !== 'Loading branches...') {
        parts.push(`<strong>Branch:</strong> ${branch}`);
      }
      
      if (parts.length === 0) {
        filterSummary.innerHTML = 'Select an office first, then region, area, and branch to filter employees';
      } else {
        filterSummary.innerHTML = parts.join(' &middot; ');
      }
    }
    
    [officeSelect, regionSelect, areaSelect, branchSelect].forEach(select => {
      select.addEventListener('change', updateFilterSummary);
    });
    
    // ── VIEW EMPLOYEES ──────────────────────────────────────────────────────
    
    filterForm.addEventListener("submit", function(e) {
      e.preventDefault();
      fetchEmployees();
    });
    
    function fetchEmployees() {
      const office = officeSelect.value;
      const region = regionSelect.value;
      const area = areaSelect.value;
      const branch = branchSelect.value;
      
      if (!office) {
        showError("Please select an office.");
        return;
      }
      
      // Show loading
      loadingIndicator.style.display = "block";
      resultsCard.style.display = "none";
      errorMessage.style.display = "none";
      
      // Build URL
      let url = `/records/viewer/employees?office=${encodeURIComponent(office)}`;
      if (region && region !== '') url += `&region=${encodeURIComponent(region)}`;
      if (area && area !== '') url += `&area=${encodeURIComponent(area)}`;
      if (branch && branch !== '') url += `&branch=${encodeURIComponent(branch)}`;
      
      fetch(url)
        .then(res => res.json())
        .then(data => {
          loadingIndicator.style.display = "none";
          
          if (data.success) {
            renderEmployees(data.employees);
            employeeCount.textContent = data.count || 0;
            recordInfo.textContent = `Total: ${data.count || 0} records`;
            resultsCard.style.display = "block";
          } else {
            showError(data.message || "Failed to fetch employees.");
          }
        })
        .catch(err => {
          loadingIndicator.style.display = "none";
          showError("An error occurred while fetching employees.");
          console.error(err);
        });
    }
    
    // ── RENDER EMPLOYEES ────────────────────────────────────────────────────
    
    function renderEmployees(employees) {
      employeeTableBody.innerHTML = "";
      
      if (!employees || employees.length === 0) {
        employeeTableBody.innerHTML = `
          <tr>
            <td colspan="5" class="no-data">
              <i class="fas fa-users-slash"></i>
              <p>No employees found matching the selected filters.</p>
            </td>
          </tr>
        `;
        return;
      }
      
      employees.forEach(emp => {
        const row = document.createElement("tr");
        row.innerHTML = `
          <td>${emp.idno || '-'}</td>
          <td>${emp.lastname || '-'}</td>
          <td>${emp.firstname || '-'}</td>
          <td>${emp.middlename || '-'}</td>
          <td>${emp.designation || '-'}</td>
        `;
        employeeTableBody.appendChild(row);
      });
    }
    
    // ── ERROR HANDLING ──────────────────────────────────────────────────────
    
    function showError(message) {
      errorMessage.textContent = message;
      errorMessage.style.display = "block";
      resultsCard.style.display = "none";
      loadingIndicator.style.display = "none";
    }
    
    // ── RESET ───────────────────────────────────────────────────────────────
    
    resetBtn.addEventListener("click", function() {
      // Reset all selects to their first option
      officeSelect.selectedIndex = 0;
      resetRegionDropdowns();
      
      // Hide results
      resultsCard.style.display = "none";
      errorMessage.style.display = "none";
      
      // Update summary
      filterSummary.innerHTML = 'Select an office first, then region, area, and branch to filter employees';
      
      // Reset table
      employeeTableBody.innerHTML = `
        <tr>
          <td colspan="5" class="no-data">
            <i class="fas fa-search"></i>
            <p>Select filters and click View to see employees.</p>
          </td>
        </tr>
      `;
      employeeCount.textContent = "0";
      recordInfo.textContent = "Total: 0 records";
    });
    
    // Initial summary
    filterSummary.innerHTML = 'Select an office first, then region, area, and branch to filter employees';
  });
</script>

</body>
</html>