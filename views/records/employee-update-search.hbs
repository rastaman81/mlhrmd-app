<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>{{title}}</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
  
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/styles.css">

  <style>
    #employeeTable thead th {
      background: #16304A;
      color: #fff;
      font-size: .72rem;
      text-transform: uppercase;
      letter-spacing: .04em;
      font-weight: 600;
      border-color: #1e3e5e;
      padding: .75rem 1rem;
      white-space: nowrap;
    }
    #employeeTable tbody td {
      font-size: .88rem;
      color: #0F2233;
      padding: .7rem 1rem;
      vertical-align: middle;
      border-color: #E3E6EB;
    }
    #employeeTable tbody tr:nth-child(odd) td  { background: #F6F7F9; }
    #employeeTable tbody tr:nth-child(even) td { background: #fff; }
    #employeeTable tbody tr:hover td           { background: #EBF3FA !important; }
  </style>
</head>
<body>

<div class="dashboard-container">

  {{> header}}

  <div class="main-content" style="font-family:'Inter',-apple-system,sans-serif; background:#F6F7F9;">
    <div class="container-fluid px-4 py-4">

      <!-- Page Header -->
      <div class="mb-4">
        <h1 style="font-size:1.65rem; font-weight:700; color:#0F2233; display:flex; align-items:center; gap:.6rem; margin:0;">
          <i class="fas fa-user-edit" style="color:#2E6F9E;"></i> Employee Update
        </h1>
        <p style="color:#6B7686; font-size:.92rem; margin:.35rem 0 0;">Search an employee record to update.</p>
      </div>

      <!-- Search Card -->
      <div style="border:1px solid #E3E6EB; border-radius:.65rem; background:#fff; box-shadow:0 1px 2px rgba(16,24,40,.04); margin-bottom:1.25rem;">

        <div style="border-bottom:1px solid #E3E6EB; padding:.85rem 1.15rem; display:flex; align-items:center; gap:.55rem; border-radius:.65rem .65rem 0 0;">
          <i class="fas fa-search" style="color:#2E6F9E;"></i>
          <strong style="color:#0F2233; font-weight:600; font-size:.97rem;">Search Filters</strong>
        </div>

        <div style="padding:1.15rem;">
          <div class="row g-3 align-items-end">

            <div class="col-md-3">
              <label style="font-size:.8rem; font-weight:600; color:#16304A; display:block; margin-bottom:.35rem;">Office</label>
              <select id="officeSelect" class="form-select" style="border-color:#E3E6EB;" required>
                <option value="">Select Office</option>
                {{#each offices}}
                  <option value="{{this.office_name}}">{{this.office_name}}</option>
                {{/each}}
              </select>
            </div>

            <div class="col-md-3">
              <label style="font-size:.8rem; font-weight:600; color:#16304A; display:block; margin-bottom:.35rem;">Last Name</label>
              <input
                type="text"
                id="lastNameInput"
                class="form-control"
                placeholder="Enter last name"
                style="border-color:#E3E6EB;"
              >
            </div>

            <div class="col-md-3">
              <label style="font-size:.8rem; font-weight:600; color:#16304A; display:block; margin-bottom:.35rem;">First Name</label>
              <input
                type="text"
                id="firstNameInput"
                class="form-control"
                placeholder="Enter first name"
                style="border-color:#E3E6EB;"
              >
            </div>

            <div class="col-md-3">
              <button id="searchBtn" class="btn w-100" style="background:#2E6F9E; border-color:#2E6F9E; color:#fff; font-weight:500; font-size:.9rem;">
                <i class="fas fa-search me-1"></i> Search
              </button>
            </div>

          </div>

          <p style="font-size:.82rem; color:#6B7686; margin:.75rem 0 0;">
            <i class="fas fa-circle-info me-1"></i>Select an office and enter last name and/or first name, then press <strong>Search</strong> or hit <strong>Enter</strong>.
          </p>
        </div>

      </div>

      <!-- Results Card -->
      <div style="border:1px solid #E3E6EB; border-radius:.65rem; background:#fff; box-shadow:0 1px 2px rgba(16,24,40,.04);">

        <div style="border-bottom:1px solid #E3E6EB; padding:.85rem 1.15rem; display:flex; align-items:center; gap:.55rem; border-radius:.65rem .65rem 0 0;">
          <i class="fas fa-table-list" style="color:#2E6F9E;"></i>
          <strong style="color:#0F2233; font-weight:600; font-size:.97rem;">Results</strong>
        </div>

        <div style="padding:0;">
          <div class="table-responsive">
            <table class="table mb-0" id="employeeTable">
              <thead>
                <tr>
                  <th>Employee ID</th>
                  <th>Name</th>
                  <th>Designation</th>
                  <th>Region</th>
                  <th>Area</th>
                  <th>Branch</th>
                  <th>Status</th>
                  <th style="text-align:center;">Action</th>
                </tr>
              </thead>
              <tbody id="employeeResults">
                <tr>
                  <td colspan="8" style="text-align:center; color:#6B7686; padding:2.5rem 1rem; font-size:.9rem;">
                    <i class="fas fa-magnifying-glass" style="color:#E3E6EB; font-size:1.5rem; display:block; margin-bottom:.5rem;"></i>
                    Search for an employee above to see results.
                  </td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>

      </div>

    </div>
  </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<script>
document.addEventListener("DOMContentLoaded", function () {
  const officeSelect    = document.getElementById("officeSelect");
  const lastNameInput   = document.getElementById("lastNameInput");
  const firstNameInput  = document.getElementById("firstNameInput");
  const searchBtn       = document.getElementById("searchBtn");
  const employeeResults = document.getElementById("employeeResults");

  // Set default office to "vismin"
  if (officeSelect) {
    let found = false;
    for (let i = 0; i < officeSelect.options.length; i++) {
      if (officeSelect.options[i].value.toLowerCase() === "vismin") {
        officeSelect.selectedIndex = i;
        found = true;
        break;
      }
    }
    
    if (!found && officeSelect.options.length > 0) {
      const startIndex = officeSelect.options[0].value === "" ? 1 : 0;
      if (officeSelect.options.length > startIndex) {
        officeSelect.selectedIndex = startIndex;
      }
    }
  }

  function setLoading() {
    employeeResults.innerHTML = `
      <tr>
        <td colspan="8" style="text-align:center; color:#6B7686; padding:2.5rem 1rem; font-size:.9rem;">
          <div class="spinner-border spinner-border-sm me-2" role="status" style="color:#2E6F9E;"></div>
          Searching...
        </td>
      </tr>`;
  }

  function setEmpty(message, isError) {
    employeeResults.innerHTML = `
      <tr>
        <td colspan="8" style="text-align:center; color:${isError ? '#C1483D' : '#6B7686'}; padding:2.5rem 1rem; font-size:.9rem;">
          <i class="fas fa-${isError ? 'circle-exclamation' : 'magnifying-glass'}" style="color:${isError ? '#C1483D' : '#E3E6EB'}; font-size:1.5rem; display:block; margin-bottom:.5rem;"></i>
          ${message}
        </td>
      </tr>`;
  }

  function performSearch() {
    const office = officeSelect.value;
    const lastName = lastNameInput.value.trim();
    const firstName = firstNameInput.value.trim();

    if (!office) {
      setEmpty("Please select an office.", true);
      return;
    }

    if (!lastName && !firstName) {
      setEmpty("Please enter a last name and/or first name to search.", true);
      return;
    }

    setLoading();

    // Build query parameters
    const params = new URLSearchParams();
    params.append('office', office);
    if (lastName) params.append('lastName', lastName);
    if (firstName) params.append('firstName', firstName);

    fetch(`/employee/update/search?${params.toString()}`)
      .then(response => response.json())
      .then(result => {
        if (!result.success || !Array.isArray(result.employees) || result.employees.length === 0) {
          setEmpty("No employees found matching your search.", false);
          return;
        }

        employeeResults.innerHTML = result.employees.map((emp) => `
          <tr>
            <td>${emp.employeeid || ""}</td>
            <td style="font-weight:600;">${emp.employeelname || ""}, ${emp.employeefname || ""} ${emp.employeemi || ""}</td>
            <td>${emp.employeedesignation || ""}</td>
            <td>${emp.regionname || ""}</td>
            <td>${emp.area_name || ""}</td>
            <td>${emp.branchname || ""}</td>
            <td>
              <span style="
                background: ${emp.employmentstatus?.toUpperCase() === 'ACTIVE' ? 'rgba(31,122,108,.1)' : 'rgba(107,118,134,.1)'};
                color: ${emp.employmentstatus?.toUpperCase() === 'ACTIVE' ? '#1F7A6C' : '#6B7686'};
                font-size: .75rem;
                font-weight: 600;
                padding: .25rem .65rem;
                border-radius: 1rem;
                display: inline-block;
              ">${emp.employmentstatus || ""}</span>
            </td>
            <td style="text-align:center;">
              <a
                href="/employee/update/form/${emp.employeeid}?office=${encodeURIComponent(office)}"
                class="btn btn-sm"
                style="background:#2E6F9E; border-color:#2E6F9E; color:#fff; font-size:.78rem; font-weight:500;"
              >
                <i class="fas fa-pen me-1"></i> Edit
              </a>
            </td>
          </tr>
        `).join("");
      })
      .catch(error => {
        console.error("Search error:", error);
        setEmpty("An error occurred while searching. Please try again.", true);
      });
  }

  // Event Listeners
  searchBtn.addEventListener("click", performSearch);

  // Allow Enter key on either input field
  lastNameInput.addEventListener("keydown", function(e) {
    if (e.key === "Enter") {
      e.preventDefault();
      performSearch();
    }
  });

  firstNameInput.addEventListener("keydown", function(e) {
    if (e.key === "Enter") {
      e.preventDefault();
      performSearch();
    }
  });

  // Optional: Auto-search when office selection changes
  officeSelect.addEventListener("change", function() {
    if (lastNameInput.value.trim() || firstNameInput.value.trim()) {
      // Uncomment the line below to auto-search when office changes
      // performSearch();
    }
  });
});
</script>

</body>
</html>