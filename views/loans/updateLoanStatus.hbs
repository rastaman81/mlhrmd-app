<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>{{title}}</title>

  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Lora:wght@500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/styles.css">

  <style>
    :root{
      --nla-navy: #16304A;
      --nla-navy-deep: #0F2233;
      --nla-blue: #2E6F9E;
      --nla-teal: #1F7A6C;
      --nla-gold: #A8762A;
      --nla-bg: #F6F7F9;
      --nla-surface: #FFFFFF;
      --nla-border: #E3E6EB;
      --nla-muted: #6B7686;
      --nla-danger: #C1483D;
      --nla-slate: #64748B;
      --nla-violet: #7C5CBF;
      --nla-rust: #C2703D;
      --nla-indigo: #4F6FBA;
    }

    .main-content{
      font-family:'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
      background:var(--nla-bg);
    }

    .main-content .nla-page-head{
      display:flex; align-items:flex-end; justify-content:space-between;
      flex-wrap:wrap; gap:.75rem; margin-bottom:1.75rem;
    }
    .main-content .nla-title{
      font-size:1.65rem; font-weight:700; color:var(--nla-navy-deep); margin:0;
      display:flex; align-items:center; gap:.6rem;
    }
    .main-content .nla-title i{ color:var(--nla-blue); }
    .main-content .nla-subtitle{ margin:.35rem 0 0; color:var(--nla-muted); font-size:.92rem; }

    .main-content .nla-flow{ display:flex; flex-direction:column; gap:1.25rem; }
    .main-content .nla-card{
      border:1px solid var(--nla-border); border-radius:.65rem;
      background:var(--nla-surface); box-shadow:0 1px 2px rgba(16,24,40,.04);
    }
    .main-content .nla-card .card-header{
      background:var(--nla-surface); border-bottom:1px solid var(--nla-border);
      padding:.65rem 1rem; display:flex; align-items:center; gap:.55rem;
      border-radius:.65rem .65rem 0 0;
    }
    .main-content .nla-card .card-header i{ color:var(--nla-blue); }
    .main-content .nla-card .card-header strong{ color:var(--nla-navy-deep); font-weight:600; font-size:.92rem; }
    .main-content .nla-card .card-body{ padding:1rem; }

    .main-content .form-label{ font-size:.75rem; font-weight:600; color:var(--nla-navy); margin-bottom:.25rem; }
    .main-content .form-select, .main-content .form-control{
      border-color:var(--nla-border); font-size:.875rem; padding:.35rem .65rem;
    }
    .main-content .form-select:focus, .main-content .form-control:focus{
      border-color:var(--nla-blue); box-shadow:0 0 0 .2rem rgba(46,111,158,.12);
    }
    .main-content .nla-help{ font-size:.78rem; color:var(--nla-muted); margin:.4rem 0 0; }

    .main-content .nla-locked-hint{
      font-size:.7rem; font-weight:600; color:var(--nla-muted);
      background:var(--nla-bg); border:1px solid var(--nla-border);
      border-radius:1rem; padding:.2rem .6rem; display:inline-flex; align-items:center;
    }

    /* ---- Employee profile ---- */
    .main-content .nla-profile{ display:flex; gap:.75rem; align-items:flex-start; }
    .main-content .nla-avatar{
      width:44px; height:44px; flex-shrink:0; border-radius:50%;
      background:linear-gradient(145deg, var(--nla-blue), var(--nla-navy));
      color:#fff; display:flex; align-items:center; justify-content:center; font-size:1.1rem;
    }
    .main-content .nla-profile-grid{
      flex:1; display:grid; grid-template-columns:repeat(4, minmax(100px,1fr)); gap:.5rem 1rem;
    }
    .main-content .nla-field-label{
      display:block; font-size:.65rem; font-weight:600; text-transform:uppercase;
      letter-spacing:.04em; color:var(--nla-muted); margin-bottom:.1rem;
    }
    .main-content .nla-field-value{
      display:block; font-size:.88rem; font-weight:600; color:var(--nla-navy-deep);
    }
    @media (max-width:767px){ .main-content .nla-profile-grid{ grid-template-columns:repeat(2,1fr); } }

    /* ---- Loan detail readonly panel ---- */
    .main-content .nla-detail-grid{
      display:grid; grid-template-columns:repeat(3, minmax(140px,1fr)); gap:1rem 1.25rem;
    }
    @media (max-width:900px){ .main-content .nla-detail-grid{ grid-template-columns:repeat(2,1fr); } }
    @media (max-width:576px){ .main-content .nla-detail-grid{ grid-template-columns:1fr; } }
    .main-content .nla-detail-item .nla-field-label{ margin-bottom:.15rem; }
    .main-content .nla-detail-item .nla-field-value{ font-size:.92rem; }
    .main-content .nla-detail-divider{ border-top:1px dashed var(--nla-border); margin:1rem 0; }

    /* ---- Action bar ---- */
    .main-content .nla-action-bar{
      position:sticky; bottom:0; background:rgba(255,255,255,.97);
      border:1px solid var(--nla-border); border-radius:.65rem; padding:.75rem 1rem;
      box-shadow:0 -4px 16px rgba(16,24,40,.06); display:flex; align-items:center;
      justify-content:flex-end; flex-wrap:wrap; gap:.65rem; margin-top:1.5rem !important;
    }
    .main-content .btn-nla-navy{ background:var(--nla-navy); border-color:var(--nla-navy); color:#fff; }
    .main-content .btn-nla-navy:hover{ background:var(--nla-navy-deep); border-color:var(--nla-navy-deep); color:#fff; }

    /* ---- Modal ---- */
    #employeeModal{ font-family:'Inter', -apple-system, BlinkMacSystemFont, sans-serif; }
    #employeeModal .modal-content{
      border-radius:.65rem; border:none; box-shadow: 0 12px 32px rgba(15,34,51,.18);
    }
    #employeeModal .modal-header{
      background-color:#fff !important; border-bottom:1px solid var(--nla-border) !important; padding:.85rem 1.15rem;
    }
    #employeeModal .modal-title{
      display:flex; align-items:center; gap:.55rem; color:var(--nla-navy-deep) !important;
      font-weight:600; font-size:1rem;
    }
    #employeeModal .modal-title i{ color:var(--nla-blue) !important; }
    #employeeModal .modal-body{ padding:1.15rem; }
    #employeeModal .form-control, #employeeModal .input-group-text{ border-color:var(--nla-border); }
    #employeeModal .form-control:focus{ border-color:var(--nla-blue); box-shadow:0 0 0 .2rem rgba(46,111,158,.12); }
    #employeeModal .table{ --bs-table-border-color: var(--nla-border); }
    #employeeModal .table thead th{
      background:var(--nla-navy-deep); font-size:.7rem; text-transform:uppercase;
      letter-spacing:.04em; color:var(--nla-surface); border-bottom:1px solid var(--nla-border);
      font-weight:600; white-space:nowrap;
    }
    #employeeModal .table tbody td{ vertical-align:middle; }
    #employeeModal .table tbody tr:hover{ background:var(--nla-bg); }
    #employeeModal .btn-nla-navy{
      background: var(--nla-navy); border: 1px solid var(--nla-navy); color: #fff;
      padding: 0.35rem 0.65rem; font-size: 0.875rem; border-radius: 0.375rem;
      font-weight: 500; transition: all 0.2s ease; height: 38px;
      display: inline-flex; align-items: center; justify-content: center; gap: 0.25rem;
    }
    #employeeModal .btn-nla-navy:hover{ background: var(--nla-navy-deep); border-color: var(--nla-navy-deep); color: #fff; }
    #employeeModal .btn-link{ color: var(--nla-muted); text-decoration: none; font-size: 0.8rem; padding: 0.25rem 0.5rem; }
    #employeeModal .btn-link:hover{ color: var(--nla-navy); text-decoration: underline; }
    #employeeModal .search-filters{
      background: var(--nla-bg); padding: 1rem; border-radius: 0.5rem; border: 1px solid var(--nla-border);
    }
    #employeeModal .search-filters .row{ align-items: flex-end; }

    /* Pagination */
    #pageNumbers span{ padding: 0.25rem 0.5rem; border-radius: 0.25rem; transition: all 0.2s ease; }
    #pageNumbers span:hover:not(.fw-bold){ background-color: var(--nla-bg); }
    #pageNumbers .fw-bold{ background-color: var(--nla-blue); color: white !important; }
    #resultCount{ font-size: 0.85rem; }

    /* Status badges */
    .badge{ font-weight:600; font-size:.72rem; padding:.3rem .6rem; border-radius:.4rem; }
    .badge.nla-badge-approved      { background:var(--nla-teal);   color:#fff; }
    .badge.nla-badge-cancelled     { background:var(--nla-gold);   color:#fff; }
    .badge.nla-badge-disapproved   { background:var(--nla-danger); color:#fff; }
    .badge.nla-badge-pending       { background:var(--nla-slate);  color:#fff; }
    .badge.nla-badge-signature     { background:var(--nla-violet); color:#fff; }
    .badge.nla-badge-hold          { background:var(--nla-rust);   color:#fff; }
    .badge.nla-badge-verification  { background:var(--nla-indigo); color:#fff; }

    /* No-loan-loaded state */
    #noLoanState{
      text-align:center; padding:2.5rem 1rem; color:var(--nla-muted);
    }
    #noLoanState i{ font-size:2.25rem; color:var(--nla-border); margin-bottom:.75rem; display:block; }

    #appToast{
  border-radius:.55rem;
  box-shadow:0 8px 24px rgba(15,34,51,.18);
  color:#fff;
  min-width:280px;
}
#appToast.toast-success{ background:var(--nla-teal); }
#appToast.toast-warning{ background:var(--nla-gold); }
#appToast.toast-danger { background:var(--nla-danger); }
#appToast.toast-info   { background:var(--nla-navy); }
  </style>
</head>

<body>

<div class="dashboard-container">

  {{> header}}

  <div class="main-content">
    <div class="container-fluid px-4 py-3">

      <!-- PAGE HEADER -->
      <div class="nla-page-head">
        <div>
          <h1 class="nla-title"><i class="fas fa-clipboard-check"></i> Update Loan Status</h1>
          <p class="nla-subtitle">Find a loan by Control No. or by employee name, then update its remarks and status.</p>
        </div>
      </div>

      <div class="nla-flow">

        <!-- =========================
             STEP 1: FIND LOAN
        ========================== -->
        <div class="card nla-card mb-0">
          <div class="card-header">
            <i class="fas fa-magnifying-glass"></i>
            <strong>Find Loan</strong>
          </div>
          <div class="card-body">
            <div class="row g-2 align-items-end">
              <div class="col-md-5">
                <label class="form-label">Control No.</label>
                <input type="text" class="form-control" id="controlNoInput" placeholder="Enter control number" inputmode="numeric">
              </div>
              <div class="col-md-3">
                <button type="button" class="btn btn-nla-navy w-100" id="btnSearchControlNo">
                  <i class="fas fa-search me-1"></i> Search
                </button>
              </div>
              <div class="col-md-4">
                <button type="button" class="btn btn-outline-primary w-100" id="btnSearchEmployee">
                  <i class="fas fa-user-search me-1"></i> Search by Employee Name
                </button>
              </div>
            </div>
            <p class="nla-help mt-2"><i class="fas fa-circle-info me-1"></i>Don't know the control number? Use Search by Employee Name to find it.</p>
          </div>
        </div>

        <!-- =========================
             STEP 2: LOAN DETAILS
        ========================== -->
        <div class="card nla-card mb-0">
          <div class="card-header d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center gap-2">
              <i class="fas fa-file-invoice-dollar"></i>
              <strong>Loan Details</strong>
            </div>
            <span class="nla-locked-hint" id="loanDetailsHint">
              <i class="fas fa-lock me-1"></i>No loan loaded
            </span>
          </div>

          <div class="card-body">

            <!-- Empty state -->
            <div id="noLoanState">
              <i class="fas fa-folder-open"></i>
              <p class="mb-0">Search by Control No. or Employee Name to load a loan.</p>
            </div>

            <!-- Populated state -->
            <div id="loanDetailsContent" class="d-none">

              <div class="nla-profile mb-3">
                <div class="nla-avatar"><i class="fas fa-user"></i></div>
                <div class="nla-profile-grid">
                  <div>
                    <span class="nla-field-label">ID No.</span>
                    <span class="nla-field-value" id="dIdno">---</span>
                  </div>
                  <div>
                    <span class="nla-field-label">Name</span>
                    <span class="nla-field-value" id="dName">---</span>
                  </div>
                  <div>
                    <span class="nla-field-label">Branch</span>
                    <span class="nla-field-value" id="dBranch">---</span>
                  </div>
                  <div>
                    <span class="nla-field-label">Region</span>
                    <span class="nla-field-value" id="dRegion">---</span>
                  </div>
                </div>
              </div>

              <div class="nla-detail-divider"></div>

              <div class="nla-detail-grid">
                <div class="nla-detail-item">
                  <span class="nla-field-label">Control No.</span>
                  <span class="nla-field-value" id="dControlNo">---</span>
                </div>
                <div class="nla-detail-item">
                  <span class="nla-field-label">Office</span>
                  <span class="nla-field-value" id="dOffice">---</span>
                </div>
                <div class="nla-detail-item">
                  <span class="nla-field-label">Loan Type</span>
                  <span class="nla-field-value" id="dLoanType">---</span>
                </div>

                <div class="nla-detail-item">
                  <span class="nla-field-label">Current Status</span>
                  <span class="nla-field-value"><span class="badge nla-badge-pending" id="dCurrentStatus">---</span></span>
                </div>
                <div class="nla-detail-item">
                  <span class="nla-field-label">Loan Amount</span>
                  <span class="nla-field-value" id="dLoanAmount">---</span>
                </div>
                <div class="nla-detail-item">
                  <span class="nla-field-label">Loan Deduction</span>
                  <span class="nla-field-value" id="dLoanDeduction">---</span>
                </div>

                <div class="nla-detail-item">
                  <span class="nla-field-label">Net Proceeds</span>
                  <span class="nla-field-value" id="dNetProceeds">---</span>
                </div>
                <div class="nla-detail-item">
                  <span class="nla-field-label">Date Received</span>
                  <span class="nla-field-value" id="dDateReceived">---</span>
                </div>
                <div class="nla-detail-item">
                  <span class="nla-field-label">Date Approved</span>
                  <span class="nla-field-value" id="dDateApproved">---</span>
                </div>

                <div class="nla-detail-item">
                  <span class="nla-field-label">Prepared By</span>
                  <span class="nla-field-value" id="dPreparedBy">---</span>
                </div>
                <div class="nla-detail-item" style="grid-column: span 2;">
                  <span class="nla-field-label">Co-Makers</span>
                  <span class="nla-field-value" id="dComakers">None</span>
                </div>
              </div>

              <div class="nla-detail-divider"></div>

              <!-- EDITABLE: Remarks + Status -->
              <div class="row g-3">
                <div class="col-md-8">
                  <label class="form-label">Remarks</label>
                  <textarea class="form-control" id="remarksInput" rows="3" placeholder="Enter remarks (optional)"></textarea>
                </div>
                <div class="col-md-4">
  <label class="form-label">Status</label>
  <select class="form-select" id="statusSelect">
    <option value="" disabled>Select status</option>
    {{#each loan_statuses}}
      <option value="{{loan_status}}">{{loan_status}}</option>
    {{/each}}
  </select>
</div>
              </div>

            </div>
          </div>
        </div>

      </div>

      <!-- ACTION BAR -->
      <div class="nla-action-bar mt-3">
        <button type="button" class="btn btn-outline-secondary" id="btnClear">
          <i class="fas fa-eraser me-1"></i> Clear
        </button>
        <button type="button" class="btn btn-nla-navy" id="btnUpdate" disabled>
          <i class="fas fa-check me-1"></i> Update Status
        </button>
      </div>

    </div>
  </div>
  <!-- Toast container -->
<div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 1080;">
  <div id="appToast" class="toast align-items-center border-0" role="alert" aria-live="assertive" aria-atomic="true">
    <div class="d-flex">
      <div class="toast-body d-flex align-items-center gap-2">
        <i id="appToastIcon" class="fas fa-circle-check"></i>
        <span id="appToastMessage">Message</span>
      </div>
      <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
    </div>
  </div>
</div>
</div>

<!-- =========================
     EMPLOYEE SEARCH MODAL
========================== -->
<div id="employeeModal" class="modal fade" tabindex="-1" aria-hidden="true" aria-labelledby="employeeModalLabel">
  <div class="modal-dialog modal-xl">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="employeeModalLabel">
          <i class="fas fa-magnifying-glass"></i> Search by Employee Name
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">

        <div class="search-filters">
          <div class="row g-2 mb-3">
            <div class="col-md-3">
              <label class="form-label">Office</label>
              <select class="form-select" id="officeSelectModal">
                <option value="" disabled selected>Select Office</option>
                {{#each offices}}
                  <option value="{{office_name}}">{{office_name}}</option>
                {{/each}}
              </select>
            </div>
            <div class="col-md-3">
              <label class="form-label">Last Name</label>
              <input type="text" id="searchLastName" class="form-control" placeholder="Enter last name">
            </div>
            <div class="col-md-3">
              <label class="form-label">First Name</label>
              <input type="text" id="searchFirstName" class="form-control" placeholder="Enter first name">
            </div>
            <div class="col-md-3 d-flex align-items-end">
              <button class="btn btn-nla-navy w-100" id="btnSearch" style="height: 38px;">
                <i class="fas fa-search me-1"></i> Search
              </button>
            </div>
          </div>
          <div class="text-end mb-2">
            <button type="button" class="btn btn-link btn-sm text-muted" id="clearSearchFilters">
              <i class="fas fa-undo me-1"></i> Clear Filters
            </button>
          </div>
        </div>

        <div class="d-flex justify-content-between align-items-center mb-2">
          <span id="resultCount" class="text-muted small">0 results found</span>
          <span id="pageInfo" class="text-muted small"></span>
        </div>

        <div class="table-responsive">
          <table class="table table-hover align-middle">
            <thead>
              <tr>
                <th>Control No</th>
                <th>ID No</th>
                <th>Last Name</th>
                <th>First Name</th>
                <th>Loan Type</th>
                <th>Status</th>
                <th>Select</th>
              </tr>
            </thead>
            <tbody id="searchResults"></tbody>
          </table>
        </div>

        <div class="d-flex justify-content-between align-items-center mt-3">
          <button class="btn btn-outline-secondary btn-sm" id="prevPage" disabled>
            <i class="fas fa-chevron-left"></i> Previous
          </button>
          <span id="pageNumbers" class="small"></span>
          <button class="btn btn-outline-secondary btn-sm" id="nextPage" disabled>
            Next <i class="fas fa-chevron-right"></i>
          </button>
        </div>

      </div>
    </div>
  </div>
</div>

<!-- Bootstrap JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<script>
document.addEventListener('DOMContentLoaded', () => {

  // ─────────────────────────────────────────────
  // STATE
  // ─────────────────────────────────────────────
  let loadedLoan = null;

  const STATUS_BADGE_CLASS = {
    'approved': 'nla-badge-approved',
    'cancelled': 'nla-badge-cancelled',
    'canceled': 'nla-badge-cancelled',
    'disapproved': 'nla-badge-disapproved',
    'disapprove': 'nla-badge-disapproved',
    'pending': 'nla-badge-pending',
    'for signature': 'nla-badge-signature',
    'temporary hold': 'nla-badge-hold',
    'for verification': 'nla-badge-verification',
  };

   // ─────────────────────────────────────────────
  // TOAST NOTIFICATIONS  ← PASTE THE NEW BLOCK HERE
  // ─────────────────────────────────────────────
  const appToastEl = document.getElementById('appToast');
  const appToast = bootstrap.Toast.getOrCreateInstance(appToastEl, { delay: 3500 });
  const appToastIcon = document.getElementById('appToastIcon');
  const appToastMessage = document.getElementById('appToastMessage');

  const TOAST_ICON = {
    success: 'fas fa-circle-check',
    warning: 'fas fa-triangle-exclamation',
    danger: 'fas fa-circle-xmark',
    info: 'fas fa-circle-info',
  };

  function showToast(message, type = 'info') {
    console.log(`[${type.toUpperCase()}] ${message}`);
    appToastEl.classList.remove('toast-success', 'toast-warning', 'toast-danger', 'toast-info');
    appToastEl.classList.add(`toast-${type}`);
    appToastIcon.className = TOAST_ICON[type] || TOAST_ICON.info;
    appToastMessage.textContent = message.replace(/^[✅⚠️❌🔄]\s*/u, '');
    appToast.show();
  }

  // ─────────────────────────────────────────────
  // ELEMENT REFERENCES
  // ─────────────────────────────────────────────
  const controlNoInput = document.getElementById('controlNoInput');
  const btnSearchControlNo = document.getElementById('btnSearchControlNo');
  const btnSearchEmployee = document.getElementById('btnSearchEmployee');

  const noLoanState = document.getElementById('noLoanState');
  const loanDetailsContent = document.getElementById('loanDetailsContent');
  const loanDetailsHint = document.getElementById('loanDetailsHint');

  const remarksInput = document.getElementById('remarksInput');
  const statusSelect = document.getElementById('statusSelect');
  const btnUpdate = document.getElementById('btnUpdate');
  const btnClear = document.getElementById('btnClear');

  const employeeModalEl = document.getElementById('employeeModal');
  const employeeModal = bootstrap.Modal.getOrCreateInstance(employeeModalEl);
  const officeSelectModal = document.getElementById('officeSelectModal');
  const searchLastName = document.getElementById('searchLastName');
  const searchFirstName = document.getElementById('searchFirstName');
  const btnSearch = document.getElementById('btnSearch');
  const clearSearchFilters = document.getElementById('clearSearchFilters');
  const searchResults = document.getElementById('searchResults');
  const resultCount = document.getElementById('resultCount');
  const pageInfo = document.getElementById('pageInfo');
  const pageNumbers = document.getElementById('pageNumbers');
  const prevPage = document.getElementById('prevPage');
  const nextPage = document.getElementById('nextPage');

  // ─────────────────────────────────────────────
  // HELPERS
  // ─────────────────────────────────────────────
  //function showToast(message, type = 'info') {
  //  console.log(`[${type.toUpperCase()}] ${message}`);
  //}

  function formatCurrencyDisplay(value) {
    if (value === null || value === undefined || isNaN(value)) return '₱0.00';
    return `₱${parseFloat(value).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
  }

  function formatDate(value) {
    if (!value) return '---';
    const d = new Date(value);
    if (isNaN(d.getTime())) return '---';
    return d.toLocaleDateString('en-PH', { year: 'numeric', month: 'long', day: 'numeric' });
  }

  function applyStatusBadge(element, status) {
    if (!element) return;
    const key = (status || '').toLowerCase().trim();
    const cssClass = STATUS_BADGE_CLASS[key] || 'nla-badge-pending';
    element.textContent = status || '---';
    element.className = `badge ${cssClass}`;
  }

  function escapeHtml(str) {
    return String(str ?? '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  function setStatusSelectValue(status) {
  const options = Array.from(statusSelect.options);
  const match = options.find(
    (opt) => opt.value.toLowerCase().trim() === (status || '').toLowerCase().trim()
  );
  statusSelect.value = match ? match.value : '';
}

  // ─────────────────────────────────────────────
  // RENDER LOADED LOAN INTO THE DETAILS PANEL
  // ─────────────────────────────────────────────
  function renderLoanDetails(loan) {
    loadedLoan = loan;

    noLoanState.classList.add('d-none');
    loanDetailsContent.classList.remove('d-none');
    loanDetailsHint.style.display = 'none';

    document.getElementById('dIdno').textContent = loan.idno || '---';
    document.getElementById('dName').textContent = `${loan.lastname || ''}, ${loan.firstname || ''}`.trim();
    document.getElementById('dBranch').textContent = loan.branch || '---';
    document.getElementById('dRegion').textContent = loan.region || '---';

    document.getElementById('dControlNo').textContent = loan.controlno || '---';
    document.getElementById('dOffice').textContent = loan.office || '---';
    document.getElementById('dLoanType').textContent = loan.loantype || '---';
    applyStatusBadge(document.getElementById('dCurrentStatus'), loan.status);

    document.getElementById('dLoanAmount').textContent = formatCurrencyDisplay(loan.loanamount);
    document.getElementById('dLoanDeduction').textContent = formatCurrencyDisplay(loan.loandeduction);
    document.getElementById('dNetProceeds').textContent = formatCurrencyDisplay(loan.netproceeds);

    document.getElementById('dDateReceived').textContent = formatDate(loan.datereceived);
    document.getElementById('dDateApproved').textContent = formatDate(loan.dateforwarded);
    document.getElementById('dPreparedBy').textContent = loan.preparedby || '---';

    const comakers = [loan.comaker1, loan.comaker2, loan.comaker3, loan.comaker4]
      .filter(c => c && c.trim());
    document.getElementById('dComakers').textContent = comakers.length ? comakers.join(', ') : 'None';

    remarksInput.value = loan.remarks || '';
    setStatusSelectValue(loan.status);

    btnUpdate.disabled = false;
  }

  function resetLoanDetails() {
    loadedLoan = null;
    noLoanState.classList.remove('d-none');
    loanDetailsContent.classList.add('d-none');
    loanDetailsHint.style.display = 'inline-flex';
    remarksInput.value = '';
    statusSelect.value = '';
    btnUpdate.disabled = true;
  }

  // ─────────────────────────────────────────────
  // SEARCH BY CONTROL NO. (no office needed — controlno is a global PK)
  // ─────────────────────────────────────────────
  btnSearchControlNo.addEventListener('click', async () => {
    const controlNo = controlNoInput.value.trim();

    if (!controlNo) {
      showToast('⚠️ Please enter a control number.', 'warning');
      controlNoInput.focus();
      return;
    }

    btnSearchControlNo.disabled = true;
    const originalText = btnSearchControlNo.innerHTML;
    btnSearchControlNo.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i> Searching...';

    try {
      const url = new URL('/loan/status/by-control', window.location.origin);
      url.searchParams.append('controlNo', controlNo);

      const res = await fetch(url);
      const data = await res.json();

      if (!data.success || !data.loan) {
        showToast(data.message || 'No loan found for that control number.', 'warning');
        resetLoanDetails();
        return;
      }

      renderLoanDetails(data.loan);
      showToast('✅ Loan loaded.', 'success');

    } catch (err) {
      console.error('Control No. search error:', err);
      showToast('❌ Something went wrong. Please try again.', 'danger');
    } finally {
      btnSearchControlNo.disabled = false;
      btnSearchControlNo.innerHTML = originalText;
    }
  });

  controlNoInput.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') {
      e.preventDefault();
      btnSearchControlNo.click();
    }
  });

  // ─────────────────────────────────────────────
  // EMPLOYEE NAME SEARCH MODAL
  // ─────────────────────────────────────────────
  const PAGE_SIZE = 20;
  let currentPage = 1;
  let totalPages = 1;
  let currentTotal = 0;

  function showMessageRow(message, variant = 'muted') {
    searchResults.innerHTML = '';
    const row = document.createElement('tr');
    const td = document.createElement('td');
    td.colSpan = 7;
    td.className = `text-center text-${variant} py-3`;
    td.textContent = message;
    row.appendChild(td);
    searchResults.appendChild(row);
  }

  function renderResults(loans) {
    searchResults.innerHTML = '';

    if (!loans || loans.length === 0) {
      showMessageRow('No loans found matching your search criteria.');
      return;
    }

    loans.forEach((loan) => {
      const row = document.createElement('tr');
      row.style.cursor = 'pointer';

      const statusBadgeClass = STATUS_BADGE_CLASS[(loan.status || '').toLowerCase().trim()] || 'nla-badge-pending';

      row.innerHTML = `
        <td>${escapeHtml(loan.controlno)}</td>
        <td>${escapeHtml(loan.idno)}</td>
        <td>${escapeHtml(loan.lastname)}</td>
        <td>${escapeHtml(loan.firstname)}</td>
        <td>${escapeHtml(loan.loantype)}</td>
        <td><span class="badge ${statusBadgeClass}">${escapeHtml(loan.status || '---')}</span></td>
        <td><button type="button" class="btn btn-outline-primary btn-sm">Select</button></td>
      `;

      row.addEventListener('click', (e) => {
        if (e.target.tagName !== 'BUTTON') selectLoan(loan);
      });
      row.querySelector('button').addEventListener('click', (e) => {
        e.stopPropagation();
        selectLoan(loan);
      });

      searchResults.appendChild(row);
    });
  }

  function updatePaginationControls() {
    if (currentTotal === 0) {
      pageInfo.textContent = '';
      pageNumbers.textContent = '';
      prevPage.disabled = true;
      nextPage.disabled = true;
      return;
    }

    const start = (currentPage - 1) * PAGE_SIZE + 1;
    const end = Math.min(currentPage * PAGE_SIZE, currentTotal);
    pageInfo.textContent = `Showing ${start}-${end} of ${currentTotal}`;

    let html = '';
    const maxVisiblePages = 5;
    let startPage = Math.max(1, currentPage - Math.floor(maxVisiblePages / 2));
    let endPage = Math.min(totalPages, startPage + maxVisiblePages - 1);
    if (endPage - startPage < maxVisiblePages - 1) startPage = Math.max(1, endPage - maxVisiblePages + 1);

    if (startPage > 1) html += `<span class="px-1">...</span>`;
    for (let i = startPage; i <= endPage; i++) {
      const activeClass = i === currentPage ? 'fw-bold text-primary' : '';
      html += `<span class="px-1 ${activeClass}" style="cursor:pointer" data-page="${i}">${i}</span>`;
    }
    if (endPage < totalPages) html += `<span class="px-1">...</span>`;

    pageNumbers.innerHTML = html;
    pageNumbers.querySelectorAll('span[data-page]').forEach(el => {
      el.addEventListener('click', () => {
        const page = parseInt(el.dataset.page);
        if (page !== currentPage) {
          currentPage = page;
          performSearch();
        }
      });
    });

    prevPage.disabled = currentPage <= 1;
    nextPage.disabled = currentPage >= totalPages;
  }

  async function performSearch() {
    const office = officeSelectModal.value;
    const lastName = searchLastName.value.trim();
    const firstName = searchFirstName.value.trim();

    if (!office) {
      showToast('⚠️ Please select an office first.', 'warning');
      officeSelectModal.focus();
      return;
    }
    if (!lastName && !firstName) {
      showToast('⚠️ Please enter a last name or first name.', 'warning');
      searchLastName.focus();
      return;
    }

    showMessageRow('Searching…');
    resultCount.textContent = 'Searching...';
    prevPage.disabled = true;
    nextPage.disabled = true;

    try {
      const url = new URL('/loan/status/search-by-name', window.location.origin);
      url.searchParams.append('office', office);
      url.searchParams.append('page', currentPage);
      url.searchParams.append('limit', PAGE_SIZE);
      if (lastName) url.searchParams.append('lastname', lastName);
      if (firstName) url.searchParams.append('firstname', firstName);

      const res = await fetch(url);
      const data = await res.json();

      if (!data.success) {
        showMessageRow(data.message || 'Search failed.', 'danger');
        resultCount.textContent = '0 results found';
        return;
      }

      const loans = data.data || [];
      const pagination = data.pagination;

      currentTotal = pagination?.total || loans.length;
      totalPages = pagination?.totalPages || Math.ceil(loans.length / PAGE_SIZE);
      currentPage = pagination?.page || 1;

      resultCount.textContent = `${currentTotal} result${currentTotal !== 1 ? 's' : ''} found`;
      renderResults(loans);
      updatePaginationControls();

    } catch (err) {
      console.error('Loan search error:', err);
      showMessageRow('Something went wrong. Please try again.', 'danger');
      resultCount.textContent = 'Error occurred';
    }
  }

  async function selectLoan(loan) {
    if (!loan.controlno) {
      showToast('⚠️ This loan record has no control number.', 'warning');
      return;
    }

    employeeModal.hide();

    try {
      const url = new URL('/loan/status/by-control', window.location.origin);
      url.searchParams.append('controlNo', loan.controlno);

      const res = await fetch(url);
      const data = await res.json();

      if (!data.success || !data.loan) {
        showToast(data.message || 'Could not load full loan details.', 'warning');
        return;
      }

      renderLoanDetails(data.loan);
      controlNoInput.value = data.loan.controlno || '';
      showToast('✅ Loan loaded.', 'success');

    } catch (err) {
      console.error('Error loading full loan details:', err);
      showToast('❌ Something went wrong loading this loan.', 'danger');
    }
}

  btnSearchEmployee.addEventListener('click', () => {
    officeSelectModal.value = 'VISMIN';
    searchLastName.value = '';
    searchFirstName.value = '';
    showMessageRow('Select an office, enter a last name and/or first name, then click Search.');
    resultCount.textContent = '0 results found';
    pageInfo.textContent = '';
    pageNumbers.textContent = '';
    prevPage.disabled = true;
    nextPage.disabled = true;
    currentPage = 1;
    currentTotal = 0;

    employeeModal.show();
  });

  btnSearch.addEventListener('click', () => { currentPage = 1; performSearch(); });
  searchLastName.addEventListener('keydown', (e) => { if (e.key === 'Enter') { e.preventDefault(); currentPage = 1; performSearch(); } });
  searchFirstName.addEventListener('keydown', (e) => { if (e.key === 'Enter') { e.preventDefault(); currentPage = 1; performSearch(); } });

  clearSearchFilters.addEventListener('click', () => {
    searchLastName.value = '';
    searchFirstName.value = '';
    showMessageRow('Select an office, enter a last name and/or first name, then click Search.');
    resultCount.textContent = '0 results found';
    pageInfo.textContent = '';
    pageNumbers.textContent = '';
    prevPage.disabled = true;
    nextPage.disabled = true;
    currentPage = 1;
    currentTotal = 0;
    searchLastName.focus();
  });

  employeeModalEl.addEventListener('shown.bs.modal', () => searchLastName.focus());

  prevPage.addEventListener('click', () => { if (currentPage > 1) { currentPage--; performSearch(); } });
  nextPage.addEventListener('click', () => { if (currentPage < totalPages) { currentPage++; performSearch(); } });

  // ─────────────────────────────────────────────
  // UPDATE BUTTON
  // ─────────────────────────────────────────────
  btnUpdate.addEventListener('click', async () => {
    if (!loadedLoan) {
      showToast('⚠️ Please load a loan first.', 'warning');
      return;
    }

    const status = statusSelect.value;
    if (!status) {
      showToast('⚠️ Please select a status.', 'warning');
      statusSelect.focus();
      return;
    }

    const remarks = remarksInput.value.trim();

    const originalText = btnUpdate.innerHTML;
    btnUpdate.disabled = true;
    btnUpdate.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i> Updating...';

    try {
      const res = await fetch('/loan/status/update', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          controlNo: loadedLoan.controlno,
          remarks: remarks,
          status: status
        })
      });

      const result = await res.json();

      if (!result.success) {
        throw new Error(result.message || 'Failed to update loan status');
      }

      showToast('✅ Loan status updated successfully.', 'success');

      loadedLoan.status = status;
      loadedLoan.remarks = remarks;
      applyStatusBadge(document.getElementById('dCurrentStatus'), status);

    } catch (err) {
      console.error('Update error:', err);
      showToast(`❌ Error updating loan: ${err.message}`, 'danger');
    } finally {
      btnUpdate.disabled = false;
      btnUpdate.innerHTML = originalText;
    }
  });

  // ─────────────────────────────────────────────
  // CLEAR BUTTON
  // ─────────────────────────────────────────────
  btnClear.addEventListener('click', () => {
    controlNoInput.value = '';
    resetLoanDetails();
    showToast('🔄 Form cleared.', 'info');
  });

  // ─────────────────────────────────────────────
  // INIT
  // ─────────────────────────────────────────────
  resetLoanDetails();

});
</script>

</body>
</html>