      <h5 class="text-center mb-3">Co-Maker Does Not Meet Requirements</h5>
      <div class="alert alert-danger">
        <p><strong>Co-maker:</strong> ${escapeHtml(emp.firstname)} ${escapeHtml(emp.lastname)} (${escapeHtml(emp.idno)})</p>
        <p><strong>Co-maker LOS:</strong> ${comakerLos} year(s)</p>
        <p><strong>Required LOS:</strong> ${requiredLos} year(s)</p>
