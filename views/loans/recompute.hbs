  function selectComaker(emp) {
    const fieldIndex = comakerSearchData.comakerFieldIndex;
    const fieldInput = document.querySelectorAll('#comakerFields .comaker-field input')[fieldIndex];
    const fieldLabel = document.querySelectorAll('#comakerFields .comaker-field label')[fieldIndex];
    if (!fieldInput) return;

    const comakerLos = emp.service_years || 0;
    const loanType = loanTypeDisplay.value;
    const requiredLos = selectedEmployeeData.selectedBracketRow?.losRequired || 0;

    if (emp.idno === selectedEmployeeData.idno) { showToast('⚠️ The borrower cannot be a co-maker.', 'warning'); return; }
    const existing = getSelectedComakers();
    if (existing.some(c => c.idno === emp.idno)) { showToast('⚠️ This co-maker is already added.', 'warning'); return; }

    let isEligible = true;
    if (loanType.toLowerCase().includes('ml fund regular') && requiredLos > 0 && comakerLos < requiredLos) isEligible = false;

    if (!isEligible) { showCoMakerEligibilityErrorModal(emp, comakerLos, requiredLos); return; }

    const fullName = `${emp.lastname}, ${emp.firstname}`;
    fieldInput.value = fullName;
    fieldInput.dataset.idno = emp.idno;
    fieldInput.dataset.los = comakerLos;
    if (fieldLabel) fieldLabel.textContent = `Co-Maker ${fieldIndex + 1} (LOS: ${comakerLos} yrs)`;
