  async function performComakerSearch() {
    const query = document.getElementById('comakerSearchInput').value.trim();
    const office = selectedEmployeeData.office;
    const field = document.getElementById('comakerSearchField').value;
    const excludeIdno = selectedEmployeeData.idno;
    if (!query) { document.getElementById('comakerSearchInput').focus(); return; }

    const resultsBody = document.getElementById('comakerSearchResults');
    resultsBody.innerHTML = `<tr><td colspan="8" class="text-center text-muted py-3">Searching...</td></tr>`;
    try {
      const url = new URL('/loan/recompute/search-comaker', window.location.origin);
      url.searchParams.append('query', query);
      url.searchParams.append('office', office);
      url.searchParams.append('excludeIdno', excludeIdno);
      url.searchParams.append('field', field);
      url.searchParams.append('page', comakerSearchData.currentPage);
      url.searchParams.append('limit', 20);
      const res = await fetch(url);
      const data = await res.json();
      if (!data.success) { resultsBody.innerHTML = `<tr><td colspan="8" class="text-center text-danger py-3">${data.message || 'Search failed.'}</td></tr>`; return; }
      comakerSearchData.currentData = data.data || [];
      comakerSearchData.totalPages = data.pagination?.totalPages || 1;
      document.getElementById('comakerResultCount').textContent = `${data.pagination?.total || 0} result(s) found`;
      renderComakerResults(data.data || []);
      updateComakerPaginationControls();
    } catch (err) {
      console.error('Co-maker search error:', err);
      resultsBody.innerHTML = `<tr><td colspan="8" class="text-center text-danger py-3">Something went wrong. Please try again.</td></tr>`;
    }
  }
  function renderComakerResults(employees) {
    const resultsBody = document.getElementById('comakerSearchResults');
    resultsBody.innerHTML = '';
    if (!employees || employees.length === 0) {
      resultsBody.innerHTML = `<tr><td colspan="8" class="text-center text-muted py-3">No employees found.</td></tr>`;
      return;
    }
    employees.forEach((emp) => {
      const row = document.createElement('tr');
      row.style.cursor = 'pointer';
      const fields = [emp.idno, emp.lastname, emp.firstname, emp.middlename || '-', emp.region || '-', emp.branch || '-', `${emp.service_years || 0} year(s)`];
      fields.forEach((value) => { const td = document.createElement('td'); td.textContent = value || '-'; row.appendChild(td); });
      const tdSelect = document.createElement('td');
      const btn = document.createElement('button');
      btn.type = 'button'; btn.className = 'btn btn-outline-primary btn-sm'; btn.textContent = 'Select';
      tdSelect.appendChild(btn); row.appendChild(tdSelect);
      row.addEventListener('click', (e) => { if (e.target.tagName !== 'BUTTON') selectComaker(emp); });
      btn.addEventListener('click', (e) => { e.stopPropagation(); selectComaker(emp); });
      resultsBody.appendChild(row);
    });
  }
  function updateComakerPaginationControls() {
    const currentPage = comakerSearchData.currentPage;
    const totalPages = comakerSearchData.totalPages;
    document.getElementById('comakerPrevPage').disabled = currentPage <= 1;
    document.getElementById('comakerNextPage').disabled = currentPage >= totalPages;
    let html = '';
    const maxVisible = 5;
    let startPage = Math.max(1, currentPage - Math.floor(maxVisible / 2));
    let endPage = Math.min(totalPages, startPage + maxVisible - 1);
    if (endPage - startPage < maxVisible - 1) startPage = Math.max(1, endPage - maxVisible + 1);
    if (startPage > 1) html += `<span class="px-1">...</span>`;
    for (let i = startPage; i <= endPage; i++) html += `<span class="px-1 ${i === currentPage ? 'fw-bold text-primary' : ''}" style="cursor:pointer" data-page="${i}">${i}</span>`;
    if (endPage < totalPages) html += `<span class="px-1">...</span>`;
    const pn = document.getElementById('comakerPageNumbers');
    pn.innerHTML = html;
    pn.querySelectorAll('span[data-page]').forEach(el => el.addEventListener('click', () => {
      const page = parseInt(el.dataset.page);
      if (page !== currentPage) { comakerSearchData.currentPage = page; performComakerSearch(); }
    }));
  }
  function showCoMakerEligibilityErrorModal(emp, comakerLos, requiredLos) {
