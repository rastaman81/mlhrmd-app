  function renderBracketTable(columns, rows) {
    if (!columns.length) {
      bracketModalBody.innerHTML = '<p class="text-center text-muted py-3">No data available.</p>';
      return;
    }
    const isMlFund = activeBracket && activeBracket.key === 'ml_fund';
    const isSakoPetty = activeBracket && activeBracket.key === 'sako_petty';
    const isSakoMaxi = activeBracket && activeBracket.key === 'sako_maxi';
    const usesCellSelection = isSakoPetty || isSakoMaxi;

    const ths = columns.map((col) => `<th>${escapeHtml(col)}</th>`).join('');

    const trs = rows
      .map((row, idx) => {
        const tds = columns
          .map((col) => {
            const value = row[col] ?? '';
            if (usesCellSelection && col !== 'LOAN AMOUNT') {
              const isZero = parseBracketNumber(value) === 0;
              if (isZero) {
                // Not selectable — no deduction amount available for this term/column.
                return `<td class="text-muted" style="cursor:not-allowed;">${escapeHtml(value)}</td>`;
              }
              return `<td data-row-index="${idx}" data-col="${escapeHtml(col)}" class="nla-bracket-cell" style="cursor:pointer;">${escapeHtml(value)}</td>`;
            }
            return `<td>${escapeHtml(value)}</td>`;
          })
          .join('');

        const losRequired = row['LENGTH OF SERVICE'] ? parseBracketNumber(row['LENGTH OF SERVICE']) : 0;
        const attrs = isMlFund ? `data-row-index="${idx}" data-los="${losRequired}" style="cursor:pointer;"` : '';
        return `<tr ${attrs}>${tds}</tr>`;
      })
      .join('');

    bracketModalBody.innerHTML = `
      <div class="table-responsive">
        <table class="table table-bordered align-middle mb-0 ${usesCellSelection ? 'nla-no-row-hover' : 'table-hover'}">
          <thead><tr>${ths}</tr></thead>
          <tbody>${trs}</tbody>
        </table>
      </div>
      ${isMlFund ? '<p class="nla-help mb-0 mt-2"><i class="fas fa-circle-info me-1"></i>Click a row to apply that bracket.</p>' : ''}
      ${isSakoPetty ? '<p class="nla-help mb-0 mt-2"><i class="fas fa-circle-info me-1"></i>Click the deduction amount under the number of months.</p>' : ''}
      ${isSakoMaxi ? '<p class="nla-help mb-0 mt-2"><i class="fas fa-circle-info me-1"></i>Click the deduction amount under the payment term.</p>' : ''}
    `;

    if (isMlFund) {
      bracketModalBody.querySelectorAll('tbody tr[data-row-index]').forEach((tr) => {
        tr.addEventListener('click', () => {
          const idx = parseInt(tr.dataset.rowIndex, 10);
          const losRequired = parseInt(tr.dataset.los, 10);
          applyMlFundBracketRow(rows[idx], losRequired);
        });
      });
    }
    if (isSakoPetty) {
      bracketModalBody.querySelectorAll('td.nla-bracket-cell[data-row-index]').forEach((td) => {
        td.addEventListener('click', () => applySakoPettyCashBracketCell(rows[parseInt(td.dataset.rowIndex, 10)], td.dataset.col));
      });
    }
    if (isSakoMaxi) {
      bracketModalBody.querySelectorAll('td.nla-bracket-cell[data-row-index]').forEach((td) => {
        td.addEventListener('click', () => applySakoMaxiBracketCell(rows[parseInt(td.dataset.rowIndex, 10)], td.dataset.col));
      });
    }
  }

