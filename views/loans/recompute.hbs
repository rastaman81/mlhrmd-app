  async function handleMLFundMonthsBased(employeeData, loanAmount) {
    const loanType = loanTypeDisplay.value;
    const monthsSelect = document.getElementById('monthsToPay');
    const months = parseFloat(monthsSelect?.value);

    if (!months || months < 1) {
        return { success: false, needsMonths: true, message: 'Please select the number of months to pay.', data: null };
    }

    const config = await getLoanTypeConfig(loanType);
    const monthlyDeductionCount = config.monthly_deduction_count || 2;
    const interestRate = parseFloat(config.interest_rate) || 0;

    let existingLoanForType = 0;
    const existingLoanInput = document.getElementById('existingLoan');
    if (existingLoanInput) {
        const parsed = parseLoanAmount(existingLoanInput.value);
        if (!isNaN(parsed) && parsed > 0) existingLoanForType = parsed;
    }
    if (existingLoanForType === 0) {
        existingLoanForType = calculateExistingLoanTotal(employeeData.payrollRecords, loanType.toLowerCase());
    }
    selectedEmployeeData.existingLoanTotal = existingLoanForType;
    document.getElementById('existingLoan').value = formatCurrencyDisplay(existingLoanForType);

    const loanComputation = employeeData.loanComputation || {};
    const totalNetPay = (loanComputation.firstCycleNetPay || 0) + (loanComputation.secondCycleNetPay || 0);
    const percent35 = loanComputation.percentage || 0;

    let loanDeduction = 0;  // This is the per-period deduction
    let monthlyDeduction = 0;  // This is the total monthly deduction
    const loanTypeLower = loanType.toLowerCase();
    
    if (loanTypeLower === 'ml fund pettycash' || loanTypeLower === 'ml fund pettycash reloan') {
        // For pettycash, no interest, just divide by months
        const totalMonthlyDeduction = round2(loanAmount / months);
        loanDeduction = round2(totalMonthlyDeduction / monthlyDeductionCount);
        monthlyDeduction = totalMonthlyDeduction;
    } else {
        // For jewelry loan and OPI, apply interest rate
        const effectiveInterestRate = interestRate > 0 ? interestRate : 0.01;
        // Formula: (loan_amount * (1 + interest_rate * months)) / months
        const totalMonthlyDeduction = round2((loanAmount * (1 + effectiveInterestRate * months)) / months);
        // Per-period deduction = total monthly deduction / monthly_deduction_count
        loanDeduction = round2(totalMonthlyDeduction / monthlyDeductionCount);
        monthlyDeduction = totalMonthlyDeduction;
    }
    console.log('loan deduction: ',loanDeduction, 'monthly deduction: ', monthlyDeduction)

    // Net proceeds = (totalNetPay + existingLoan) - 35% - monthlyDeduction
    const netProceeds = (totalNetPay + existingLoanForType) - percent35 - monthlyDeduction;

    // Display the per-period deduction in the loan deduction field
    document.getElementById('loanDeduction').value = formatCurrencyDisplay(loanDeduction);
    document.getElementById('netProceeds').value = formatCurrencyDisplay(netProceeds);

    return {
        success: true,
        message: `✅ ${loanType} calculated. Net proceeds: ${formatCurrencyDisplay(netProceeds)}`,
        data: {
            netProceeds: parseFloat(netProceeds.toFixed(2)), 
            loanAmount: parseFloat(loanAmount), 
            loanDeduction: loanDeduction,  // Per-period deduction (displayed)
            monthlyDeduction: monthlyDeduction,  // Total monthly deduction (used for net proceeds)
            existingLoan: parseFloat(existingLoanForType), 
            percent35: parseFloat(percent35), 
            months, 
            monthlyDeductionCount, 
            interestRate, 
            loanType
        }
    };
}

