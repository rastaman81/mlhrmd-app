<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>{{title}}</title>

  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Lora:wght@500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/styles.css">

  <style>
    :root{
      --nla-navy: #16304A;
      --nla-navy-deep: #0F2233;
      --nla-blue: #2E6F9E;
      --nla-teal: #1F7A6C;
      --nla-gold: #A8762A;
      --nla-bg: #F6F7F9;
      --nla-surface: #FFFFFF;
      --nla-border: #E3E6EB;
      --nla-muted: #6B7686;
      --nla-danger: #C1483D;
      --nla-slate: #64748B;
      --nla-violet: #7C5CBF;
      --nla-rust: #C2703D;
      --nla-indigo: #4F6FBA;
    }

    .main-content{ font-family:'Inter', -apple-system, BlinkMacSystemFont, sans-serif; background:var(--nla-bg); }

    .main-content .nla-page-head{ display:flex; align-items:flex-end; justify-content:space-between; flex-wrap:wrap; gap:.75rem; margin-bottom:1.75rem; }
    .main-content .nla-title{ font-size:1.65rem; font-weight:700; color:var(--nla-navy-deep); margin:0; display:flex; align-items:center; gap:.6rem; }
    .main-content .nla-title i{ color:var(--nla-blue); }
    .main-content .nla-subtitle{ margin:.35rem 0 0; color:var(--nla-muted); font-size:.92rem; }

    .main-content .nla-flow{ display:flex; flex-direction:column; gap:1.25rem; }
    .main-content .nla-card{ border:1px solid var(--nla-border); border-radius:.65rem; background:var(--nla-surface); box-shadow:0 1px 2px rgba(16,24,40,.04); }
    .main-content .nla-card .card-header{ background:var(--nla-surface); border-bottom:1px solid var(--nla-border); padding:.65rem 1rem; display:flex; align-items:center; gap:.55rem; border-radius:.65rem .65rem 0 0; }
    .main-content .nla-card .card-header i{ color:var(--nla-blue); }
    .main-content .nla-card .card-header strong{ color:var(--nla-navy-deep); font-weight:600; font-size:.92rem; }
    .main-content .nla-card .card-body{ padding:1rem; }

    .main-content .form-label{ font-size:.75rem; font-weight:600; color:var(--nla-navy); margin-bottom:.25rem; }
    .main-content .form-select, .main-content .form-control{ border-color:var(--nla-border); font-size:.875rem; padding:.35rem .65rem; }
    .main-content .form-select:focus, .main-content .form-control:focus{ border-color:var(--nla-blue); box-shadow:0 0 0 .2rem rgba(46,111,158,.12); }
    .main-content .nla-help{ font-size:.78rem; color:var(--nla-muted); margin:.4rem 0 0; }
    .main-content .nla-locked-hint{ font-size:.7rem; font-weight:600; color:var(--nla-muted); background:var(--nla-bg); border:1px solid var(--nla-border); border-radius:1rem; padding:.2rem .6rem; display:inline-flex; align-items:center; }

    /* ---- Employee profile ---- */
    .main-content .nla-profile{ display:flex; gap:.75rem; align-items:flex-start; }
    .main-content .nla-avatar{ width:44px; height:44px; flex-shrink:0; border-radius:50%; background:linear-gradient(145deg, var(--nla-blue), var(--nla-navy)); color:#fff; display:flex; align-items:center; justify-content:center; font-size:1.1rem; }
    .main-content .nla-profile-grid{ flex:1; display:grid; grid-template-columns:repeat(4, minmax(100px,1fr)); gap:.5rem 1rem; }
    .main-content .nla-field-label{ display:block; font-size:.65rem; font-weight:600; text-transform:uppercase; letter-spacing:.04em; color:var(--nla-muted); margin-bottom:.1rem; }
    .main-content .nla-field-value{ display:block; font-size:.88rem; font-weight:600; color:var(--nla-navy-deep); }
    @media (max-width:767px){ .main-content .nla-profile-grid{ grid-template-columns:repeat(2,1fr); } }

    /* ---- Loan computation panel ---- */
    .main-content .nla-compute-panel{ margin-top:.75rem; background:var(--nla-bg); border:1px solid var(--nla-border); border-radius:.5rem; padding:.75rem 1rem; }
    .main-content .nla-compute-row{ display:flex; align-items:center; justify-content:space-between; gap:.75rem; padding:.2rem 0; }
    .main-content .nla-compute-label{ font-size:.8rem; color:var(--nla-muted); font-weight:500; }
    .main-content .nla-compute-value{ border:none !important; background:transparent !important; text-align:right; font-weight:600; font-size:.9rem; color:var(--nla-navy-deep); font-variant-numeric:tabular-nums; padding:0 !important; max-width:170px; }
    .main-content .nla-compute-value:focus{ box-shadow:none; }
    .main-content .nla-compute-divider{ border-top:1px dashed var(--nla-border); margin:.35rem 0; }
    .main-content .nla-net-row .nla-compute-label{ font-weight:700; color:var(--nla-navy-deep); font-size:.85rem; }
    .main-content .nla-net-value{ border:none !important; background:transparent !important; text-align:right; font-family:'Lora', serif; font-weight:700; font-size:1.35rem; color:var(--nla-gold); font-variant-numeric:tabular-nums; padding:0 !important; max-width:200px; }
    .main-content .nla-net-value:focus{ box-shadow:none; }

    /* ---- Co-makers ---- */
    .main-content .nla-comaker-label{ font-size:.75rem; font-weight:600; color:var(--nla-navy); margin-bottom:.2rem; display:block; }
    .main-content .nla-comaker-count{ font-size:.72rem; font-weight:600; color:var(--nla-muted); background:var(--nla-bg); border:1px solid var(--nla-border); border-radius:1rem; padding:.15rem .6rem; }
    .main-content .comaker-field{ transition:opacity .2s ease; }
    .main-content .comaker-field.d-none{ display:none !important; }
    .main-content .comaker-field.nla-fade-init{ opacity:0; }
    .main-content .nla-comaker-remove{ color:var(--nla-muted); }
    .main-content .nla-comaker-remove:hover{ color:var(--nla-danger); }

    /* ---- Action bar ---- */
    .main-content .nla-action-bar{ position:sticky; bottom:0; background:rgba(255,255,255,.97); border:1px solid var(--nla-border); border-radius:.65rem; padding:.75rem 1rem; box-shadow:0 -4px 16px rgba(16,24,40,.06); display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:.65rem; margin-top:1.5rem !important; }
    .main-content .nla-quick-label{ font-size:.7rem; font-weight:600; text-transform:uppercase; letter-spacing:.04em; color:var(--nla-muted); margin-right:.25rem; }
    .main-content .nla-main-actions{ display:flex; gap:.5rem; flex-wrap:wrap; }
    .main-content .btn-nla-navy{ background:var(--nla-navy); border-color:var(--nla-navy); color:#fff; }
    .main-content .btn-nla-navy:hover{ background:var(--nla-navy-deep); border-color:var(--nla-navy-deep); color:#fff; }
    .main-content .btn-nla-navy:disabled{ opacity:0.5; cursor:not-allowed; }

    /* ---- Dynamic bracket button ---- */
    .main-content .nla-bracket-btn-wrap{ display:flex; align-items:center; gap:.5rem; }
    #btnViewBracket{ transition: opacity .2s ease, transform .15s ease; }
    #btnViewBracket.nla-btn-appear{ animation: nla-pop-in .2s ease forwards; }
    @keyframes nla-pop-in{ from{ opacity:0; transform:scale(.92); } to{ opacity:1; transform:scale(1); } }

    /* ---- Modals ---- */
    #bracketModal, #comakerSearchModal, #loanNameSearchModal{ font-family:'Inter', -apple-system, BlinkMacSystemFont, sans-serif; }
    #bracketModal .modal-content, #comakerSearchModal .modal-content, #loanNameSearchModal .modal-content{ border-radius:.65rem; border:none; box-shadow: 0 12px 32px rgba(15,34,51,.18); }
    #bracketModal .modal-header, #comakerSearchModal .modal-header, #loanNameSearchModal .modal-header{ background-color:#fff !important; border-bottom:1px solid var(--nla-border) !important; padding:.85rem 1.15rem; }
    #bracketModal .modal-title, #comakerSearchModal .modal-title, #loanNameSearchModal .modal-title{ display:flex; align-items:center; gap:.55rem; color:var(--nla-navy-deep) !important; font-weight:600; font-size:1rem; }
    #bracketModal .modal-title i, #comakerSearchModal .modal-title i, #loanNameSearchModal .modal-title i{ color:var(--nla-blue) !important; }
    #bracketModal .modal-body, #comakerSearchModal .modal-body, #loanNameSearchModal .modal-body{ padding:1.15rem; }
    #comakerSearchModal .form-control, #loanNameSearchModal .form-control{ border-color:var(--nla-border); }
    #comakerSearchModal .form-control:focus, #loanNameSearchModal .form-control:focus{ border-color:var(--nla-blue); box-shadow:0 0 0 .2rem rgba(46,111,158,.12); }
    #bracketModal .table, #comakerSearchModal .table, #loanNameSearchModal .table{ --bs-table-border-color: var(--nla-border); }
    #bracketModal .table thead th, #comakerSearchModal .table thead th, #loanNameSearchModal .table thead th{ background:var(--nla-navy-deep); font-size:.7rem; text-transform:uppercase; letter-spacing:.04em; color:var(--nla-surface); border-bottom:1px solid var(--nla-border); font-weight:600; white-space:nowrap; }
    #bracketModal .table tbody td, #comakerSearchModal .table tbody td, #loanNameSearchModal .table tbody td{ vertical-align:middle; }
    #comakerSearchModal .table tbody tr:hover, #loanNameSearchModal .table tbody tr:hover{ background:var(--nla-bg); }
    .btn-nla-navy{ background: var(--nla-navy); border: 1px solid var(--nla-navy); color: #fff; font-weight: 500; }
    .btn-nla-navy:hover{ background: var(--nla-navy-deep); border-color: var(--nla-navy-deep); color: #fff; }

    #bracketModal .modal-dialog{ max-width: 92%; width: 92%; margin: 1.75rem auto; }
    #bracketModal .nla-bracket-loading{ display:flex; align-items:center; justify-content:center; gap:.6rem; padding:2rem; color:var(--nla-muted); font-size:.9rem; }
    #bracketModal .nla-bracket-error{ padding:1.5rem; text-align:center; color:var(--nla-danger); font-size:.9rem; }
    #bracketModal .table-responsive{ max-height:420px; overflow-y:auto; overflow-x: hidden; }
    #bracketModal .table tbody td{ font-size:.85rem; font-variant-numeric:tabular-nums; }

    #bracketModal table.nla-no-row-hover tbody tr:hover { background: transparent; }
    #bracketModal td.nla-bracket-cell:hover { background: var(--nla-blue); color: #fff; cursor: pointer; }

    .badge{ font-weight:600; font-size:.72rem; padding:.3rem .6rem; border-radius:.4rem; }
    .badge.nla-badge-approved      { background:var(--nla-teal);   color:#fff; }
    .badge.nla-badge-cancelled     { background:var(--nla-gold);   color:#fff; }
    .badge.nla-badge-disapproved   { background:var(--nla-danger); color:#fff; }
    .badge.nla-badge-pending       { background:var(--nla-slate);  color:#fff; }
    .badge.nla-badge-signature     { background:var(--nla-violet); color:#fff; }
    .badge.nla-badge-hold          { background:var(--nla-rust);   color:#fff; }
    .badge.nla-badge-verification  { background:var(--nla-indigo); color:#fff; }

    #pageNumbers span{ padding: 0.25rem 0.5rem; border-radius: 0.25rem; transition: all 0.2s ease; }
    #pageNumbers span:hover:not(.fw-bold){ background-color: var(--nla-bg); }
    #pageNumbers .fw-bold{ background-color: var(--nla-blue); color: white !important; }

    #eligibilityErrorModal .modal-header, #comakerEligibilityErrorModal .modal-header, #payrollDateMismatchModal .modal-header{ background: #dc3545 !important; color: white !important; }
    #eligibilityErrorModal .modal-header .modal-title, #comakerEligibilityErrorModal .modal-header .modal-title, #payrollDateMismatchModal .modal-header .modal-title{ color: white !important; }
    #eligibilityErrorModal .btn-close-white, #comakerEligibilityErrorModal .btn-close-white, #payrollDateMismatchModal .btn-close-white{ filter: brightness(0) invert(1); }
    #eligibilityErrorModal .alert-danger, #payrollDateMismatchModal .alert-danger{ background-color: #f8d7da; border-color: #f5c6cb; color: #721c24; }

    /* No-loan-loaded state */
    #noLoanState{ text-align:center; padding:2.5rem 1rem; color:var(--nla-muted); }
    #noLoanState i{ font-size:2.25rem; color:var(--nla-border); margin-bottom:.75rem; display:block; }

    /* Bonus-loan-not-supported state */
    #notSupportedState{ text-align:center; padding:1.5rem 1rem; color:var(--nla-danger); }
    #notSupportedState i{ font-size:1.75rem; margin-bottom:.5rem; display:block; }

    /* Payroll mismatch state */
    #payrollMismatchState{ text-align:center; padding:1.5rem 1rem; color:var(--nla-danger); }
    #payrollMismatchState i{ font-size:1.75rem; margin-bottom:.5rem; display:block; }

    /* Toast */
    #appToast{ border-radius:.55rem; box-shadow:0 8px 24px rgba(15,34,51,.18); color:#fff; min-width:280px; }
    #appToast.toast-success{ background:var(--nla-teal); }
    #appToast.toast-warning{ background:var(--nla-gold); }
    #appToast.toast-danger { background:var(--nla-danger); }
    #appToast.toast-info   { background:var(--nla-navy); }

    /* Loan Type Display - read-only text styling */
    #loanTypeDisplay {
      background-color: #f8f9fa;
      cursor: not-allowed;
      font-weight: 500;
      color: var(--nla-navy-deep);
    }
    #loanTypeDisplay:focus {
      box-shadow: none;
      border-color: var(--nla-border);
    }
  </style>
</head>

<body>

<div class="dashboard-container">

  {{> header}}

  <div class="main-content">
    <div class="container-fluid px-4 py-3">

      <!-- PAGE HEADER -->
      <div class="nla-page-head">
        <div>
          <h1 class="nla-title"><i class="fas fa-calculator"></i> Recompute Loan</h1>
          <p class="nla-subtitle">Find an existing loan, recompute using the current payroll cycle, and save.</p>
        </div>
      </div>

      <div class="nla-flow">

        <!-- =========================
             STEP 1: FIND LOAN
        ========================== -->
        <div class="card nla-card mb-0">
          <div class="card-header">
            <i class="fas fa-magnifying-glass"></i>
            <strong>Find Loan</strong>
          </div>
          <div class="card-body">
            <div class="row g-2 align-items-end">
              <div class="col-md-5">
                <label class="form-label">Control No.</label>
                <input type="text" class="form-control" id="controlNoInput" placeholder="Enter control number" inputmode="numeric">
              </div>
              <div class="col-md-3">
                <button type="button" class="btn btn-nla-navy w-100" id="btnSearchControlNo">
                  <i class="fas fa-search me-1"></i> Search
                </button>
              </div>
              <div class="col-md-4">
                <button type="button" class="btn btn-outline-primary w-100" id="btnSearchLoanByName">
                  <i class="fas fa-user-search me-1"></i> Search by Employee Name
                </button>
              </div>
            </div>
            <p class="nla-help mt-2"><i class="fas fa-circle-info me-1"></i>Loan is recomputed using the employee's current payroll cycle.</p>
          </div>
        </div>

        <!-- =========================
             STEP 2: EMPLOYEE INFO
        ========================== -->
        <div class="card nla-card mb-0" id="employeeInfoCard" style="display:none;">
          <div class="card-header">
            <i class="fas fa-id-badge"></i>
            <strong>Employee Information</strong>
          </div>
          <div class="card-body">
            <div class="nla-profile">
              <div class="nla-avatar"><i class="fas fa-user"></i></div>
              <div class="nla-profile-grid">
                <div><span class="nla-field-label">ID No.</span><span class="nla-field-value" id="empIdno">---</span></div>
                <div><span class="nla-field-label">Last Name</span><span class="nla-field-value" id="empLast">---</span></div>
                <div><span class="nla-field-label">First Name</span><span class="nla-field-value" id="empFirst">---</span></div>
                <div><span class="nla-field-label">Branch</span><span class="nla-field-value" id="empBranch">---</span></div>
                <div><span class="nla-field-label">Region</span><span class="nla-field-value" id="empRegion">---</span></div>
                <div><span class="nla-field-label">Office</span><span class="nla-field-value" id="empOffice">---</span></div>
                <div><span class="nla-field-label">Length of Service</span><span class="nla-field-value" id="empLos">---</span></div>
                <div><span class="nla-field-label">Control No.</span><span class="nla-field-value" id="empControlNo">---</span></div>
              </div>
            </div>
          </div>
        </div>

        <!-- =========================
             NOT SUPPORTED STATE (bonus loan types)
        ========================== -->
        <div class="card nla-card mb-0" id="notSupportedCard" style="display:none;">
          <div class="card-body">
            <div id="notSupportedState">
              <i class="fas fa-triangle-exclamation"></i>
              <p class="mb-0"><strong id="notSupportedLoanType">This loan type</strong> is a bonus payout and is not eligible for recompute here. Please use Update Loan Status for this record instead.</p>
            </div>
          </div>
        </div>

        <!-- =========================
             PAYROLL MISMATCH STATE
        ========================== -->
        <div class="card nla-card mb-0" id="payrollMismatchCard" style="display:none;">
          <div class="card-body">
            <div id="payrollMismatchState">
              <i class="fas fa-calendar-times"></i>
              <p class="mb-0"><strong>Payroll Cycle Mismatch</strong></p>
              <p class="mb-0" id="payrollMismatchMessage">This loan was created with a different payroll cycle. Please create a new loan instead.</p>
              <div class="mt-2 text-start" style="font-size:0.85rem; max-width:500px; margin:0 auto; background:var(--nla-bg); padding:1rem; border-radius:0.5rem;">
                <p class="mb-1"><strong>Loan's Payroll Dates:</strong></p>
                <p class="mb-1" id="loanPayrollDates">First: -- | Second: --</p>
                <p class="mb-1"><strong>Current Payroll Dates:</strong></p>
                <p class="mb-0" id="currentPayrollDates">First: -- | Second: --</p>
              </div>
            </div>
          </div>
        </div>

        <!-- =========================
             STEP 3: LOAN DETAILS
        ========================== -->
        <div class="card nla-card mb-0" id="loanDetailsCard" style="display:none;">
          <div class="card-header">
            <i class="fas fa-file-invoice-dollar"></i>
            <strong>Loan Details</strong>
          </div>

          <div class="card-body">

            <div class="row g-2">
              <div class="col-md-6">
                <label class="form-label">Loan Type</label>
                <input type="text" class="form-control" id="loanTypeDisplay" readonly>
              </div>

              <div class="col-md-6">
                <label class="form-label">Loan Amount</label>
                <div class="input-group">
                  <span class="input-group-text">₱</span>
                  <input type="text" class="form-control" id="loanAmount" placeholder="0.00">
                </div>
              </div>
            </div>

            <div class="row g-2 mt-2 d-none" id="monthsToPayRow">
              <div class="col-12">
                <label class="form-label"><i class="fas fa-calendar-alt me-1"></i>Months to Pay</label>
                <select class="form-select" id="monthsToPay">
                  <option value="">Select number of months</option>
                </select>
              </div>
            </div>

            <div class="nla-compute-panel">
              <div class="nla-compute-row">
                <span class="nla-compute-label">Existing Loan</span>
                <input type="text" class="nla-compute-value" id="existingLoan" >
              </div>
              <div class="nla-compute-row">
                <span class="nla-compute-label">Loan Deduction</span>
                <input type="text" class="nla-compute-value" id="loanDeduction">
              </div>
              <div class="nla-compute-divider"></div>
              <div class="nla-compute-row nla-net-row">
                <span class="nla-compute-label">Net Proceeds</span>
                <input type="text" class="nla-net-value" id="netProceeds" readonly>
              </div>
            </div>

          </div>
        </div>

        <!-- =========================
             STEP 4: COMAKERS
        ========================== -->
        <div class="card nla-card mb-0" id="comakerCard" style="display:none;">
          <div class="card-header d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center gap-2">
              <i class="fas fa-user-friends"></i>
              <strong>Co-Makers</strong>
            </div>
            <span class="nla-comaker-count" id="comakerCount">0 of 4 added</span>
          </div>

          <div class="card-body">
            <div class="row g-3" id="comakerFields">
              <div class="col-md-3 comaker-field d-none">
                <label class="nla-comaker-label">Co-Maker 1</label>
                <div class="input-group">
                  <input class="form-control" placeholder="Click to search co-maker">
                  <button type="button" class="btn btn-outline-secondary nla-comaker-remove" aria-label="Remove Co-Maker 1"><i class="fas fa-xmark"></i></button>
                </div>
              </div>
              <div class="col-md-3 comaker-field d-none">
                <label class="nla-comaker-label">Co-Maker 2</label>
                <div class="input-group">
                  <input class="form-control" placeholder="Click to search co-maker">
                  <button type="button" class="btn btn-outline-secondary nla-comaker-remove" aria-label="Remove Co-Maker 2"><i class="fas fa-xmark"></i></button>
                </div>
              </div>
              <div class="col-md-3 comaker-field d-none">
                <label class="nla-comaker-label">Co-Maker 3</label>
                <div class="input-group">
                  <input class="form-control" placeholder="Click to search co-maker">
                  <button type="button" class="btn btn-outline-secondary nla-comaker-remove" aria-label="Remove Co-Maker 3"><i class="fas fa-xmark"></i></button>
                </div>
              </div>
              <div class="col-md-3 comaker-field d-none">
                <label class="nla-comaker-label">Co-Maker 4</label>
                <div class="input-group">
                  <input class="form-control" placeholder="Click to search co-maker">
                  <button type="button" class="btn btn-outline-secondary nla-comaker-remove" aria-label="Remove Co-Maker 4"><i class="fas fa-xmark"></i></button>
                </div>
              </div>
            </div>

            <button type="button" class="btn btn-outline-primary btn-sm mt-2" id="btnAddComaker">
              <i class="fas fa-plus me-1"></i> Add Co-Maker
            </button>
            <p class="nla-help mb-0">Add up to 4 co-makers for this loan. Click the <strong>×</strong> on a field to remove it.</p>
          </div>
        </div>

      </div>

      <!-- ACTION BAR -->
      <div class="nla-action-bar mt-3">
        <div class="nla-bracket-btn-wrap">
          <span class="nla-quick-label" id="bracketBtnLabel" style="display:none;">Loan Table</span>
