  // ─────────────────────────────────────────────
  // FIND LOAN — BY EMPLOYEE NAME
  // ─────────────────────────────────────────────
  const LOAN_PAGE_SIZE = 20;
  let loanCurrentPage = 1;
  let loanTotalPages = 1;
  let loanCurrentTotal = 0;

  function showLoanMessageRow(message, variant = 'muted') {
    loanSearchResults.innerHTML = `<tr><td colspan="7" class="text-center text-${variant} py-3">${escapeHtml(message)}</td></tr>`;
  }

  function renderLoanSearchResults(loans) {
    loanSearchResults.innerHTML = '';
    if (!loans || loans.length === 0) { showLoanMessageRow('No loans found matching your search criteria.'); return; }
    loans.forEach((loan) => {
      const row = document.createElement('tr');
      row.style.cursor = 'pointer';
      const statusBadgeClass = STATUS_BADGE_CLASS[(loan.status || '').toLowerCase().trim()] || 'nla-badge-pending';
      row.innerHTML = `
        <td>${escapeHtml(loan.controlno)}</td>
        <td>${escapeHtml(loan.idno)}</td>
        <td>${escapeHtml(loan.lastname)}</td>
        <td>${escapeHtml(loan.firstname)}</td>
        <td>${escapeHtml(loan.loantype)}</td>
        <td><span class="badge ${statusBadgeClass}">${escapeHtml(loan.status || '---')}</span></td>
        <td><button type="button" class="btn btn-outline-primary btn-sm">Select</button></td>
      `;
      row.addEventListener('click', (e) => { if (e.target.tagName !== 'BUTTON') pickLoanFromSearch(loan); });
      row.querySelector('button').addEventListener('click', (e) => { e.stopPropagation(); pickLoanFromSearch(loan); });
      loanSearchResults.appendChild(row);
    });
  }

  function updateLoanPaginationControls() {
    if (loanCurrentTotal === 0) {
      loanPageInfo.textContent = ''; loanPageNumbers.textContent = '';
      loanPrevPage.disabled = true; loanNextPage.disabled = true;
      return;
    }
    const start = (loanCurrentPage - 1) * LOAN_PAGE_SIZE + 1;
    const end = Math.min(loanCurrentPage * LOAN_PAGE_SIZE, loanCurrentTotal);
    loanPageInfo.textContent = `Showing ${start}-${end} of ${loanCurrentTotal}`;

    let html = '';
    const maxVisible = 5;
    let startPage = Math.max(1, loanCurrentPage - Math.floor(maxVisible / 2));
    let endPage = Math.min(loanTotalPages, startPage + maxVisible - 1);
    if (endPage - startPage < maxVisible - 1) startPage = Math.max(1, endPage - maxVisible + 1);
    if (startPage > 1) html += `<span class="px-1">...</span>`;
    for (let i = startPage; i <= endPage; i++) html += `<span class="px-1 ${i === loanCurrentPage ? 'fw-bold text-primary' : ''}" style="cursor:pointer" data-page="${i}">${i}</span>`;
    if (endPage < loanTotalPages) html += `<span class="px-1">...</span>`;
    loanPageNumbers.innerHTML = html;
    loanPageNumbers.querySelectorAll('span[data-page]').forEach(el => el.addEventListener('click', () => {
      const page = parseInt(el.dataset.page);
      if (page !== loanCurrentPage) { loanCurrentPage = page; performLoanNameSearch(); }
    }));
    loanPrevPage.disabled = loanCurrentPage <= 1;
    loanNextPage.disabled = loanCurrentPage >= loanTotalPages;
  }

  async function performLoanNameSearch() {
    const office = loanSearchOffice.value;
    const lastName = loanSearchLastName.value.trim();
    const firstName = loanSearchFirstName.value.trim();

    if (!office) { showToast('⚠️ Please select an office first.', 'warning'); loanSearchOffice.focus(); return; }
    if (!lastName && !firstName) { showToast('⚠️ Please enter a last name or first name.', 'warning'); loanSearchLastName.focus(); return; }

    showLoanMessageRow('Searching…');
    loanResultCount.textContent = 'Searching...';
    loanPrevPage.disabled = true; loanNextPage.disabled = true;

    try {
      const url = new URL('/loan/recompute/search-by-name-recompute', window.location.origin);
      url.searchParams.append('office', office);
      url.searchParams.append('page', loanCurrentPage);
      url.searchParams.append('limit', LOAN_PAGE_SIZE);
      if (lastName) url.searchParams.append('lastname', lastName);
      if (firstName) url.searchParams.append('firstname', firstName);

      const res = await fetch(url);
      const data = await res.json();
      if (!data.success) { showLoanMessageRow(data.message || 'Search failed.', 'danger'); loanResultCount.textContent = '0 results found'; return; }

      const loans = data.data || [];
      console.log(loans);
      loanCurrentTotal = data.pagination?.total || loans.length;
      loanTotalPages = data.pagination?.totalPages || Math.ceil(loans.length / LOAN_PAGE_SIZE);
      loanCurrentPage = data.pagination?.page || 1;

      loanResultCount.textContent = `${loanCurrentTotal} result(s) found`;
      renderLoanSearchResults(loans);
      updateLoanPaginationControls();
    } catch (err) {
      console.error('Loan search error:', err);
      showLoanMessageRow('Something went wrong. Please try again.', 'danger');
      loanResultCount.textContent = 'Error occurred';
    }
  }

  async function pickLoanFromSearch(loan) {
    if (!loan.controlno) { showToast('⚠️ This loan record has no control number.', 'warning'); return; }
    loanNameSearchModal.hide();
    try {
      const url = new URL('/loan/recompute/by-control', window.location.origin);
      url.searchParams.append('controlNo', loan.controlno);
      const res = await fetch(url);
      const data = await res.json();
      if (!data.success || !data.loan) { showToast(data.message || 'Could not load full loan details.', 'warning'); return; }
      controlNoInput.value = data.loan.controlno || '';
      await loadLoanForRecompute(data.loan);
    } catch (err) {
      console.error('Error loading full loan details:', err);
      showToast('❌ Something went wrong loading this loan.', 'danger');
    }
  }

  btnSearchLoanByName.addEventListener('click', () => {
    loanSearchOffice.value = 'VISMIN';
    loanSearchLastName.value = ''; loanSearchFirstName.value = '';
    showLoanMessageRow('Select an office, enter a last name and/or first name, then click Search.');
    loanResultCount.textContent = '0 results found';
    loanPageInfo.textContent = ''; loanPageNumbers.textContent = '';
    loanPrevPage.disabled = true; loanNextPage.disabled = true;
    loanCurrentPage = 1; loanCurrentTotal = 0;
    loanNameSearchModal.show();
  });
  loanSearchBtn.addEventListener('click', () => { loanCurrentPage = 1; performLoanNameSearch(); });
  loanSearchLastName.addEventListener('keydown', (e) => { if (e.key === 'Enter') { e.preventDefault(); loanCurrentPage = 1; performLoanNameSearch(); } });
  loanSearchFirstName.addEventListener('keydown', (e) => { if (e.key === 'Enter') { e.preventDefault(); loanCurrentPage = 1; performLoanNameSearch(); } });
  loanPrevPage.addEventListener('click', () => { if (loanCurrentPage > 1) { loanCurrentPage--; performLoanNameSearch(); } });
  loanNextPage.addEventListener('click', () => { if (loanCurrentPage < loanTotalPages) { loanCurrentPage++; performLoanNameSearch(); } });

  // ─────────────────────────────────────────────
  // LOAD LOAN → BUILD selectedEmployeeData → FETCH PAYROLL → PREFILL
  // ─────────────────────────────────────────────
  async function loadLoanForRecompute(loan) {
    loadedLoan = loan;
    payrollDatesValid = false;

    // Basic employee info display
    employeeInfoCard.style.display = '';
    document.getElementById('empIdno').textContent = loan.idno || '---';
    document.getElementById('empLast').textContent = loan.lastname || '---';
    document.getElementById('empFirst').textContent = loan.firstname || '---';
    document.getElementById('empBranch').textContent = loan.branch || '---';
    document.getElementById('empRegion').textContent = loan.region || '---';
    document.getElementById('empOffice').textContent = loan.office || '---';
    document.getElementById('empLos').textContent = `${loan.lengthofservice || 0} year(s)`;
    document.getElementById('empControlNo').textContent = loan.controlno || '---';

    const loanTypeLower = (loan.loantype || '').toLowerCase().trim();

    // Guard: bonus loan types aren't supported on this page
    if (RECOMPUTE_EXCLUDED_LOAN_TYPES.includes(loanTypeLower)) {
        notSupportedCard.style.display = '';
        payrollMismatchCard.style.display = 'none';
        document.getElementById('notSupportedLoanType').textContent = loan.loantype;
        loanDetailsCard.style.display = 'none';
        comakerCard.style.display = 'none';
        btnSave.disabled = true;
        selectedEmployeeData = null;
        showToast(`⚠️ "${loan.loantype}" is not eligible for recompute here.`, 'warning');
        return;
    }

    notSupportedCard.style.display = 'none';
    payrollMismatchCard.style.display = 'none';
    loanDetailsCard.style.display = '';
    comakerCard.style.display = '';

    // Build employee data shell
    selectedEmployeeData = {
        idno: loan.idno,
        lastname: loan.lastname,
        firstname: loan.firstname,
        branch: loan.branch,
        region: loan.region,
        office: loan.office,
        service_years: loan.lengthofservice || 0,
        monthly_rate: loan.monthly_rate || 0,
        selectedBracketRow: null,
        existingLoanTotal: 0,
    };

    // Fetch CURRENT payroll cycle for this employee
    try {
        const url = new URL('/loan/recompute/employee-payroll', window.location.origin);
        url.searchParams.append('employeeId', loan.idno);
        url.searchParams.append('office', loan.office);
        const response = await fetch(url);
        const result = await response.json();

        if (!result.success) throw new Error(result.message || 'Failed to load employee payroll data');

        selectedEmployeeData.payrollRecords = result.data;

        if (result.data && result.data.length > 0) {
            const currentPayrollDates = getCurrentPayrollDates(result.data);
            const loanFirstDate = loan.first_cycle;
            const loanSecondDate = loan.second_cycle;

            // Validate dates match
            const datesMatch = comparePayrollDates(
                loanFirstDate, 
                loanSecondDate,
                currentPayrollDates.firstCycle,
                currentPayrollDates.secondCycle
            );
            
            if (!datesMatch) {
                showPayrollDateMismatchError(
                    loanFirstDate,
                    loanSecondDate,
                    currentPayrollDates.firstCycle,
                    currentPayrollDates.secondCycle
                );
                btnSave.disabled = true;
                showToast('⚠️ Payroll cycle has changed. Cannot recompute this loan.', 'warning');
                return;
            }
            
            payrollDatesValid = true;
            
            // Process payroll records
            const sortedRecords = [...result.data].sort((a, b) => new Date(b.enddate) - new Date(a.enddate));
            let firstCycleRecord = null;
            let secondCycleRecord = null;

            sortedRecords.forEach(record => {
                const endDate = new Date(record.enddate);
                const day = endDate.getDate();
                const lastDayOfMonth = new Date(endDate.getFullYear(), endDate.getMonth() + 1, 0).getDate();
                const isLastDayOfMonth = day === lastDayOfMonth;

                if (day === 15 && !firstCycleRecord) firstCycleRecord = record;
                else if (isLastDayOfMonth && !secondCycleRecord) secondCycleRecord = record;
            });

            if (!firstCycleRecord || !secondCycleRecord) {
                if (sortedRecords.length >= 2) { secondCycleRecord = sortedRecords[0]; firstCycleRecord = sortedRecords[1]; }
                else if (sortedRecords.length === 1) { firstCycleRecord = sortedRecords[0]; secondCycleRecord = sortedRecords[0]; }
            }
            if (!firstCycleRecord && sortedRecords.length > 0) firstCycleRecord = sortedRecords[0];
            if (!secondCycleRecord && sortedRecords.length > 0) secondCycleRecord = sortedRecords[0];

            const firstCycleRawNetPay = firstCycleRecord ? parseFloat(firstCycleRecord.netpay) || 0 : 0;
            const firstCycleOvertime = firstCycleRecord ? parseFloat(firstCycleRecord.ot_total) || 0 : 0;
            const firstCycleAllowance = firstCycleRecord ? parseFloat(firstCycleRecord.allowance_total) || 0 : 0;
            const firstCycleOtherIncome = firstCycleRecord ? parseFloat(firstCycleRecord.otherincome) || 0 : 0;

            const secondCycleRawNetPay = secondCycleRecord ? parseFloat(secondCycleRecord.netpay) || 0 : 0;
            const secondCycleOvertime = secondCycleRecord ? parseFloat(secondCycleRecord.ot_total) || 0 : 0;
            const secondCycleAllowance = secondCycleRecord ? parseFloat(secondCycleRecord.allowance_total) || 0 : 0;
            const secondCycleOtherIncome = secondCycleRecord ? parseFloat(secondCycleRecord.otherincome) || 0 : 0;

            const firstCycleNetPay = firstCycleRawNetPay - (firstCycleOvertime + firstCycleOtherIncome);
            const secondCycleNetPay = secondCycleRawNetPay - (secondCycleOvertime + secondCycleOtherIncome);
            const totalAllowance = firstCycleAllowance + secondCycleAllowance;

            const monthlyRate = selectedEmployeeData.monthly_rate;

            // ✅ CRITICAL FIX: Use the stored 35% from the loan record
            // DO NOT recalculate it - use what's already in the database
            let percentage = parseFloat(loan['35percent']);
if (isNaN(percentage) || percentage <= 0) {
    // Stored value is missing/zero — recalculate from the CURRENT monthly
    // rate so recompute actually reflects live data (same as netpay1/netpay2),
    // instead of silently perpetuating a bad/zero value.
    const monthlyRate = parseFloat(loan.monthlyrate) || parseFloat(selectedEmployeeData.monthly_rate) || 0;
    percentage = round2(monthlyRate * 0.35); // ⚠️ confirm this matches the formula used in newLoan.hbs
    console.warn('⚠️ Loan had no valid stored 35% — recalculated from monthly rate:', percentage);
} else {
    console.log('📊 Using stored 35% from loan record:', percentage);
}
            console.log('📊 Using stored 35% from loan record:', percentage);

            selectedEmployeeData.loanComputation = {
                firstCycleNetPay,
                secondCycleNetPay,
                totalAllowance,
                percentage,  // ← Use the stored value
                monthlyRate,
                hasFirstCycle: !!firstCycleRecord,
                hasSecondCycle: !!secondCycleRecord,
                isSameCycle: firstCycleRecord === secondCycleRecord,
            };

            if (firstCycleRecord === secondCycleRecord) {
                showToast('⚠️ Only one payroll record found. Using it for both cycles.', 'warning');
            }
        } else {
            selectedEmployeeData.loanComputation = {};
            showToast('⚠️ No current payroll data found for this employee.', 'warning');
        }
    } catch (err) {
        console.error('Error loading employee payroll:', err);
        showToast('❌ Failed to load current payroll data.', 'danger');
        selectedEmployeeData.loanComputation = {};
        selectedEmployeeData.payrollRecords = [];
    }

    // Pre-fill co-makers
    document.querySelectorAll('#comakerFields .comaker-field input').forEach(input => { input.value = ''; delete input.dataset.idno; delete input.dataset.los; });
    document.querySelectorAll('#comakerFields .comaker-field label').forEach((label, index) => { label.textContent = `Co-Maker ${index + 1}`; });
    document.querySelectorAll('#comakerFields .comaker-field').forEach(field => field.classList.add('d-none'));

    const existingComakers = [loan.comaker1, loan.comaker2, loan.comaker3, loan.comaker4].filter(c => c && c.trim());
    existingComakers.forEach((name, idx) => {
        const field = comakerFieldsArr[idx];
        if (!field) return;
        field.classList.remove('d-none');
        const input = field.querySelector('input');
        if (input) input.value = name;
    });
    refreshComakerUI();

    // Prefill the loan type and values
    prefillLoanType(loan);
}

  function prefillLoanType(loan) {
    const loanTypeLower = (loan.loantype || '').toLowerCase().trim();

    // 1. Set loan type in read-only display
    loanTypeDisplay.value = loan.loantype;
    
    // 2. Update UI states
    updateDeductionEditable();
    updateLoanAmountEditable(loanTypeLower);
        updateExistingLoanEditable(loanTypeLower); 

    // 3. Handle bracket button
    const match = BRACKET_MAP.find((b) => b.test(loanTypeLower));
    if (match) {
        activeBracket = match;
        bracketBtnIcon.className = `${match.icon} me-1`;
        bracketBtnText.textContent = match.label;
        btnViewBracket.classList.remove('d-none');
        bracketBtnLabel.style.display = '';
    } else {
        activeBracket = null;
        btnViewBracket.classList.add('d-none');
        bracketBtnLabel.style.display = 'none';
    }

    // 4. Handle months-to-pay dropdown
    const isMonthsBasedLoan = MONTHS_BASED_LOAN_TYPES.includes(loanTypeLower);
    if (isMonthsBasedLoan) {
        showMonthsToPayRow(true);
        populateMonthsToPay(loanTypeLower);
    } else {
        showMonthsToPayRow(false);
        resetMonthsToPay();
    }

    // 5. ✅ DISPLAY ONLY - All data from database, NO COMPUTATIONS
    setLoanAmountValue(loan.loanamount);
    document.getElementById('existingLoan').value = formatCurrencyDisplay(loan.existingloan || 0);
    document.getElementById('loanDeduction').value = formatCurrencyDisplay(loan.loandeduction);
    document.getElementById('netProceeds').value = formatCurrencyDisplay(loan.netproceeds);
    
    // 6. Store the existing loan value from database
    if (selectedEmployeeData) {
        selectedEmployeeData.existingLoanTotal = loan.existingloan || 0;
    }
    
    // 7. Show info message if dates are valid
    if (payrollDatesValid) {
      showToast('ℹ️ Loan data loaded. Click "Recompute & Save" to recalculate with current payroll.', 'info');
    }

    // 8. Update button states
    updateActionButtonsState();
  }

  // ─────────────────────────────────────────────
  // AMOUNT / DEDUCTION / EXISTING LOAN INPUT HANDLERS
  // ─────────────────────────────────────────────
  const loanAmountInput = document.getElementById('loanAmount');
  loanAmountInput.addEventListener('blur', function () {
    if (!payrollDatesValid) {
      showToast('⚠️ Cannot modify - payroll cycle has changed.', 'warning');
      return;
    }
    const rawValue = this.value;
    if (!rawValue || rawValue.trim() === '') { this.value = ''; updateActionButtonsState(); return; }
    const numericValue = parseLoanAmount(rawValue);
    if (isNaN(numericValue)) { this.value = ''; showToast('⚠️ Please enter a valid number', 'warning'); updateActionButtonsState(); return; }
    this.value = formatLoanAmount(numericValue);
    triggerLoanRecalculation();
    updateActionButtonsState();
  });
  loanAmountInput.addEventListener('keydown', function (e) { if (e.key === 'Enter') { e.preventDefault(); this.blur(); } });
  loanAmountInput.addEventListener('input', function () {
    const start = this.selectionStart, end = this.selectionEnd;
    let cleaned = this.value.replace(/[^0-9.]/g, '');
    const parts = cleaned.split('.');
    if (parts.length > 2) cleaned = parts[0] + '.' + parts.slice(1).join('');
    if (parts.length === 2 && parts[1].length > 2) cleaned = parts[0] + '.' + parts[1].substring(0, 2);
    if (this.value !== cleaned) { this.value = cleaned; if (start && end) { const newPos = Math.min(start, cleaned.length); this.setSelectionRange(newPos, newPos); } }
    updateActionButtonsState();
  });

  document.getElementById('monthsToPay')?.addEventListener('change', function () {
    const loanName = loanTypeDisplay.value.toLowerCase();
    if (!MONTHS_BASED_LOAN_TYPES.includes(loanName)) return;
    if (!selectedEmployeeData || !selectedEmployeeData.idno) return;
    if (!payrollDatesValid) {
      showToast('⚠️ Cannot modify - payroll cycle has changed.', 'warning');
      return;
    }
    triggerLoanRecalculation();
    updateActionButtonsState();
  });

  const existingLoanInput = document.getElementById('existingLoan');
  existingLoanInput.addEventListener('blur', function () {
    const loanType = loanTypeDisplay.value;
    const editable = isExistingLoanEditable(loanType);

    const rawValue = this.value;

    if (!rawValue || rawValue.trim() === '' || rawValue === '₱0.00' || rawValue === '0.00') {
      this.value = formatCurrencyDisplay(0);
      if (selectedEmployeeData) selectedEmployeeData.existingLoanTotal = 0;
      if (editable) {
        if (!payrollDatesValid) { showToast('⚠️ Cannot modify - payroll cycle has changed.', 'warning'); return; }
        triggerLoanRecalculation();
      }
      return;
    }

    const numericValue = parseLoanAmount(rawValue);
    if (!isNaN(numericValue)) {
      this.value = formatCurrencyDisplay(numericValue);
      if (editable) {
        if (!payrollDatesValid) { showToast('⚠️ Cannot modify - payroll cycle has changed.', 'warning'); return; }
        if (selectedEmployeeData) selectedEmployeeData.existingLoanTotal = numericValue;
        triggerLoanRecalculation();
      }
    } else {
      showToast('⚠️ Please enter a valid number', 'warning');
    }
  });
  existingLoanInput.addEventListener('keydown', function (e) { if (e.key === 'Enter') { e.preventDefault(); this.blur(); } });
  existingLoanInput.addEventListener('focus', function () { if (isExistingLoanEditable(loanTypeDisplay.value)) this.select(); });

  const loanDeductionInput = document.getElementById('loanDeduction');
  loanDeductionInput.addEventListener('blur', function () {
    if (!payrollDatesValid) {
      showToast('⚠️ Cannot modify - payroll cycle has changed.', 'warning');
      return;
    }
    const loanType = loanTypeDisplay.value;
    if (!isDeductionEditable(loanType)) return;
    const rawValue = this.value;
    if (!rawValue || rawValue.trim() === '' || rawValue === '₱0.00' || rawValue === '0.00') {
      this.value = formatCurrencyDisplay(0);
      if (selectedEmployeeData) updateNetProceedsOnly();
      return;
    }
    const numericValue = parseLoanAmount(rawValue);
    if (!isNaN(numericValue)) { this.value = formatCurrencyDisplay(numericValue); if (selectedEmployeeData) updateNetProceedsOnly(); }
    else { showToast('⚠️ Please enter a valid number', 'warning'); }
  });
  loanDeductionInput.addEventListener('keydown', function (e) { if (e.key === 'Enter') { e.preventDefault(); this.blur(); } });
  loanDeductionInput.addEventListener('input', function () {
    const loanType = loanTypeDisplay.value;
    if (!isDeductionEditable(loanType)) return;
  });
  loanDeductionInput.addEventListener('focus', function () { if (isDeductionEditable(loanTypeDisplay.value)) this.select(); });

  // ─────────────────────────────────────────────
  // SAVE (RECOMPUTE & UPDATE)
  // ─────────────────────────────────────────────
  btnSave.addEventListener('click', async function () {
    if (!loadedLoan || !selectedEmployeeData) { showToast('⚠️ Please load a loan first.', 'warning'); return; }
    if (!payrollDatesValid) {
      showToast('⚠️ Cannot recompute - payroll cycle has changed. Please create a new loan instead.', 'warning');
      return;
    }

    const loanType = loanTypeDisplay.value;
    if (!loanType) { showToast('⚠️ No loan type loaded.', 'warning'); return; }

    const loanAmount = parseLoanAmount(document.getElementById('loanAmount').value);
    if (isNaN(loanAmount) || loanAmount <= 0) { showToast('⚠️ Please enter a valid loan amount.', 'warning'); return; }

    const loanComputation = selectedEmployeeData.loanComputation || {};
    const bracket = selectedEmployeeData.selectedBracketRow || {};
    const netpay1 = loanComputation.firstCycleNetPay || 0;
    const netpay2 = loanComputation.secondCycleNetPay || 0;
    const percent35 = loanComputation.percentage || 0;

    let existingLoan = parseLoanAmount(document.getElementById('existingLoan').value) || 0;
    const loanDeductionValue = bracket.loanDeduct !== undefined
      ? bracket.loanDeduct
      : parseFloat(document.getElementById('loanDeduction').value.replace(/[₱,]/g, '')) || 0;

    const isMonthsBasedType = MONTHS_BASED_LOAN_TYPES.includes(loanType.toLowerCase());
let deductionPerMonth;
if (isMonthsBasedType) {
  const computed = selectedEmployeeData.lastComputedData;
  if (computed && computed.monthlyDeduction !== undefined) {
    deductionPerMonth = computed.monthlyDeduction;       // ✅ 4120
  } else {
    // Fallback if Save is clicked before any recompute happened —
    // don't assume per-period === monthly, refetch the real multiplier.
    const config = await getLoanTypeConfig(loanType);
    deductionPerMonth = round2(loanDeductionValue * (config.monthly_deduction_count || 2));
  }
} else if (bracket.monthlyDeductionCount !== undefined) {
  deductionPerMonth = loanDeductionValue * bracket.monthlyDeductionCount;
} else {
  const count = (loanType.toLowerCase() === 'sss' || loanType.toLowerCase() === 'pagibig') ? 1 : 2;
  deductionPerMonth = loanDeductionValue * count;
}

    const netproceeds = bracket.netProceeds !== undefined
      ? bracket.netProceeds
      : parseFloat(document.getElementById('netProceeds').value.replace(/[₱,]/g, '')) || 0;

    const comakerInputs = document.querySelectorAll('#comakerFields .comaker-field:not(.d-none) input');
    const comakers = [];
    comakerInputs.forEach((input) => { if (input.value.trim()) comakers.push(input.value.trim()); });
console.log('@@@@@@@@@@@@@@@@@@@@@ ', percent35)
    const payload = {
      controlNo: loadedLoan.controlno,
      loantype: loanType,
      loanamount: loanAmount,
      loandeduction: loanDeductionValue,
      netpay1, netpay2,
      existingloan: existingLoan,
      percent35: percent35,
      deductionpermonth: deductionPerMonth,
      netproceeds,
      comaker1: comakers[0] || null,
      comaker2: comakers[1] || null,
      comaker3: comakers[2] || null,
      comaker4: comakers[3] || null,
      lengthofservice: selectedEmployeeData.service_years || 0,
      monthly_rate: selectedEmployeeData.monthly_rate || 0,
    };

    const originalText = btnSave.innerHTML;
    btnSave.disabled = true;
    btnSave.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i> Saving...';

    try {
      const response = await fetch('/loan/recompute/update', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });
      const result = await response.json();
      if (!result.success) throw new Error(result.message || 'Failed to recompute loan');

      showToast('✅ Loan recomputed and saved successfully.', 'success');
      loadedLoan.loantype = loanType;
      loadedLoan.loanamount = loanAmount;
      loadedLoan.loandeduction = loanDeductionValue;
      loadedLoan.netproceeds = netproceeds;

      const pdfUrl = `/loan/generate-pdf/${loadedLoan.controlno}?office=${selectedEmployeeData.office}`;
      window.open(pdfUrl, '_blank');

    } catch (err) {
      console.error('Error recomputing loan:', err);
      showToast(`❌ Error recomputing loan: ${err.message}`, 'danger');
    } finally {
      btnSave.disabled = false;
      btnSave.innerHTML = originalText;
      updateActionButtonsState();
    }
  });

  // ─────────────────────────────────────────────
  // CLEAR
  // ─────────────────────────────────────────────
  btnClear.addEventListener('click', () => {
    controlNoInput.value = '';
    loadedLoan = null;
    selectedEmployeeData = null;
    activeBracket = null;
    payrollDatesValid = false;
    if (selectedEmployeeData) selectedEmployeeData.lastComputedData = null;

    employeeInfoCard.style.display = 'none';
    notSupportedCard.style.display = 'none';
    payrollMismatchCard.style.display = 'none';
    loanDetailsCard.style.display = 'none';
    comakerCard.style.display = 'none';

    loanTypeDisplay.value = '';
    setLoanAmountValue('');
    document.getElementById('existingLoan').value = '';
    document.getElementById('loanDeduction').value = '';
    document.getElementById('netProceeds').value = '';

    document.querySelectorAll('#comakerFields .comaker-field input').forEach(input => { input.value = ''; delete input.dataset.idno; delete input.dataset.los; });
    document.querySelectorAll('#comakerFields .comaker-field label').forEach((label, index) => { label.textContent = `Co-Maker ${index + 1}`; });
    document.querySelectorAll('#comakerFields .comaker-field').forEach(field => field.classList.add('d-none'));
    refreshComakerUI();

    btnViewBracket.classList.add('d-none');
    bracketBtnLabel.style.display = 'none';
    showMonthsToPayRow(false);
    resetMonthsToPay();

    btnSave.disabled = true;
    showToast('🔄 Form cleared.', 'info');
  });

  // ─────────────────────────────────────────────
  // INIT
  // ─────────────────────────────────────────────
  refreshComakerUI();

});
</script>

</body>
</html>