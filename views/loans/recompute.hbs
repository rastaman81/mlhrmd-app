  function updateActionButtonsState() {
    const hasLoanType = !!loanTypeDisplay.value;
    const loanAmount = parseLoanAmount(document.getElementById('loanAmount').value);
    const hasLoanAmount = !isNaN(loanAmount) && loanAmount > 0;
    const hasEmployee = !!selectedEmployeeData && !!selectedEmployeeData.idno;
    const loanName = loanTypeDisplay.value.toLowerCase();

    const requiresBracket = BRACKET_MAP.some((b) => b.test(loanName));
    let hasBracketSelected = true;
    if (requiresBracket) hasBracketSelected = !!(selectedEmployeeData && selectedEmployeeData.selectedBracketRow);

    const requiresMonths = MONTHS_BASED_LOAN_TYPES.includes(loanName);
    let hasMonthsSelected = true;
    if (requiresMonths) hasMonthsSelected = !!document.getElementById('monthsToPay')?.value;

    const shouldEnable = hasLoanType && hasLoanAmount && hasEmployee && hasBracketSelected && hasMonthsSelected && payrollDatesValid;
    btnSave.disabled = !shouldEnable;
  }

  function triggerLoanRecalculation() {
    const loanType = loanTypeDisplay.value;
    const loanAmount = parseFloat(document.getElementById('loanAmount').value.replace(/[₱,]/g, '')) || 0;
    if (!selectedEmployeeData || !selectedEmployeeData.idno || !loanType || loanAmount <= 0) return;
    if (!payrollDatesValid) {
      showToast('⚠️ Cannot recompute - payroll cycle has changed.', 'warning');
      return;
    }

    const existingLoanInput = document.getElementById('existingLoan');
    let userExistingLoan = null;
    if (existingLoanInput) {
      const parsed = parseLoanAmount(existingLoanInput.value);
      if (!isNaN(parsed)) { userExistingLoan = parsed; selectedEmployeeData.existingLoanTotal = parsed; }
    }

    const deductionInput = document.getElementById('loanDeduction');
    let userLoanDeduction = null;
    if (deductionInput && isDeductionEditable(loanType)) {
      const parsed = parseLoanAmount(deductionInput.value);
      if (!isNaN(parsed) && parsed > 0) userLoanDeduction = parsed;
    }

    const handler = LOAN_TYPE_HANDLERS[loanType.toLowerCase()];
    if (!handler) return;

    handler(selectedEmployeeData, loanAmount).then(result => {
      if (result.success) {
            selectedEmployeeData.lastComputedData = result.data;
        if (result.data && result.data.netProceeds !== undefined) {
          document.getElementById('netProceeds').value = formatCurrencyDisplay(result.data.netProceeds);
        }
        if (userExistingLoan !== null && userExistingLoan >= 0) {
          document.getElementById('existingLoan').value = formatCurrencyDisplay(userExistingLoan);
          selectedEmployeeData.existingLoanTotal = userExistingLoan;
          if (selectedEmployeeData.selectedBracketRow) selectedEmployeeData.selectedBracketRow.existingLoan = userExistingLoan;
        } else if (result.data && result.data.existingLoan !== undefined) {
          document.getElementById('existingLoan').value = formatCurrencyDisplay(result.data.existingLoan);
          selectedEmployeeData.existingLoanTotal = result.data.existingLoan;
        }
        if (userLoanDeduction !== null && userLoanDeduction > 0 && isDeductionEditable(loanType)) {
          document.getElementById('loanDeduction').value = formatCurrencyDisplay(userLoanDeduction);
        } else if (result.data && result.data.loanDeduction !== undefined) {
          document.getElementById('loanDeduction').value = formatCurrencyDisplay(result.data.loanDeduction);
        }
        updateActionButtonsState();
      } else if (result.needsBracket) {
        showToast('ℹ️ Please select a bracket amount.', 'info');
      } else if (result.needsMonths) {
        showToast('ℹ️ Please select the number of months to pay.', 'info');
      } else {
        showToast(result.message || 'Recalculation failed', 'warning');
      }
    }).catch(err => console.error('Error during recalculation:', err));
  }

  function updateNetProceedsOnly() {
    const loanType = loanTypeDisplay.value;
    const loanAmount = parseFloat(document.getElementById('loanAmount').value.replace(/[₱,]/g, '')) || 0;
    if (!selectedEmployeeData || !selectedEmployeeData.idno || !loanType || loanAmount <= 0) return;
    if (!payrollDatesValid) {
      showToast('⚠️ Cannot recompute - payroll cycle has changed.', 'warning');
      return;
    }

    let existingLoan = selectedEmployeeData.existingLoanTotal || 0;
    const existingLoanInput = document.getElementById('existingLoan');
    if (existingLoanInput) {
      const parsed = parseLoanAmount(existingLoanInput.value);
      if (!isNaN(parsed) && parsed > 0) { existingLoan = parsed; selectedEmployeeData.existingLoanTotal = parsed; }
    }

    let loanDeduction = 0;
    const deductionInput = document.getElementById('loanDeduction');
    if (deductionInput && isDeductionEditable(loanType)) {
      const parsed = parseLoanAmount(deductionInput.value);
      if (!isNaN(parsed) && parsed > 0) {
        loanDeduction = parsed;
      } else {
        loanDeduction = loanAmount;
        document.getElementById('loanDeduction').value = formatCurrencyDisplay(loanDeduction);
      }
    } else {
      loanDeduction = loanAmount;
      document.getElementById('loanDeduction').value = formatCurrencyDisplay(loanDeduction);
    }

    const loanComputation = selectedEmployeeData.loanComputation || {};
    const totalNetPay = (loanComputation.firstCycleNetPay || 0) + (loanComputation.secondCycleNetPay || 0);
    const percent35 = loanComputation.percentage || 0;
    const monthlyDeductionCount = EDITABLE_DEDUCTION_MONTHLY_COUNT[loanType.toLowerCase()] ?? 2;
    const deductionPerMonth = loanDeduction * monthlyDeductionCount;
    const netProceeds = (totalNetPay + existingLoan) - percent35 - deductionPerMonth;

    document.getElementById('netProceeds').value = formatCurrencyDisplay(netProceeds);
  }

