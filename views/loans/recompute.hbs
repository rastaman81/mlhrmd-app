  let comakerSearchData = { currentPage: 1, totalPages: 1, currentData: [], comakerFieldIndex: null };
  const comakerSearchModalEl = document.getElementById('comakerSearchModal');
  const comakerSearchModal = bootstrap.Modal.getOrCreateInstance(comakerSearchModalEl);

  function getSelectedComakers() {
    const comakers = [];
    document.querySelectorAll('#comakerFields .comaker-field:not(.d-none) input').forEach((input, index) => {
      if (input.value.trim()) comakers.push({ index, idno: input.dataset.idno || '', name: input.value.trim(), los: parseInt(input.dataset.los) || 0 });
    });
    return comakers;
  }
  function updateComakerCount() {
    const count = getSelectedComakers().length;
    const countLabel = document.getElementById('comakerCount');
    if (countLabel) countLabel.textContent = `${count} of 4 added`;
  }
  function openComakerSearch(fieldIndex) {
    if (!selectedEmployeeData || !selectedEmployeeData.idno) {
      showToast('⚠️ Please load a loan first.', 'warning');
      return;
    }
    if (!payrollDatesValid) {
      showToast('⚠️ Cannot add co-makers - payroll cycle has changed.', 'warning');
      return;
    }
    document.getElementById('comakerBorrowerId').textContent = selectedEmployeeData.idno;
    comakerSearchData.comakerFieldIndex = fieldIndex;
    comakerSearchData.currentPage = 1;
    comakerSearchModal.show();
    document.getElementById('comakerSearchInput').focus();
