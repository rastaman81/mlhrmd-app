    const totalNetPay = (loanComputation.firstCycleNetPay || 0) + (loanComputation.secondCycleNetPay || 0);
    const percent35 = loanComputation.percentage || 0;
    const deductionPerMonth = loanDeduct * monthlyDeductionCount;
