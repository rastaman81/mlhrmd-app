  // ─────────────────────────────────────────────
  // CALCULATE EXISTING LOAN TOTAL
  // ─────────────────────────────────────────────
  function calculateExistingLoanTotal(payrollRecords, loanType = null) {
    if (!payrollRecords || payrollRecords.length === 0) return 0;

    const LOAN_FIELDS = {
      'ml fund regular': ['mlfund_regular'],
      'ml fund regular reloan': ['mlfund_regular'],
      'ml fund pettycash': ['mlfund_pcl'],
      'ml fund pettycash reloan': ['mlfund_pcl'],
      'ml fund jewelry loan': ['mlfund_jewelry'],
      'ml fund o.p.i.': ['mlfund_opi'],
      'ml fund emergency': ['mlfund_emergency'],
      'ml lending motor loan': ['motor_loan'],
      'sako maxi': ['sako'],
      'sako pettycash': ['sako'],
      'sako emergency': ['sako'],
      'sako preferential': ['sako'],
      'sako commodity': ['sako'],
      'sako retirement': ['sako'],
      'sss': ['sssloan'],
      'pagibig': ['pagibigloan']
    };

    let fieldsToSum = [];
    if (loanType) {
      const normalizedType = loanType.toLowerCase().trim();
      if (LOAN_FIELDS[normalizedType]) {
        fieldsToSum = LOAN_FIELDS[normalizedType];
      } else if (normalizedType.includes('ml fund')) {
        fieldsToSum = ['mlfund_total'];
      } else if (normalizedType.includes('sako')) {
        fieldsToSum = ['sako'];
      } else {
        return 0;
      }
    } else {
      return 0;
    }

    let total = 0;
    payrollRecords.forEach((record) => {
      total += fieldsToSum.reduce((sum, field) => sum + (parseFloat(record[field]) || 0), 0);
    });
    return total;
  }

