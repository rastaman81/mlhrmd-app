  // 4. LOAN HANDLER FUNCTIONS
  // ─────────────────────────────────────────────

  async function handleMLFundRegular(employeeData, loanAmount) {
  console.log('🎯 Processing ML Fund Regular:', {
    employee: employeeData.idno,
    loanAmount: loanAmount
  });
  
  // Get existing loan for ML Fund Regular
  const existingLoanForType = calculateExistingLoanTotal(
    employeeData.payrollRecords, 
    'ml fund regular'
  );
  
  selectedEmployeeData.existingLoanTotal = existingLoanForType;
  document.getElementById('existingLoan').value = formatCurrencyDisplay(existingLoanForType);
  
  // Check if bracket is already selected
  if (selectedEmployeeData && selectedEmployeeData.selectedBracketRow) {
    // Bracket already applied, use it
    const bracket = selectedEmployeeData.selectedBracketRow;
    const loanComputation = employeeData.loanComputation || {};
    
    const netpay1 = loanComputation.firstCycleNetPay || 0;
    const netpay2 = loanComputation.secondCycleNetPay || 0;
    const totalNetPay = netpay1 + netpay2;
    const percent35 = loanComputation.percentage || 0;
    const monthlyDeductionCount = 2;
    const deductionPerMonth = bracket.loanDeduct * monthlyDeductionCount;
    
    //const netProceeds = (totalNetPay + existingLoanForType) - percent35 - deductionPerMonth;
    const netProceeds = (totalNetPay + (existingLoanForType * monthlyDeductionCount)) - percent35 - deductionPerMonth;
    
    
    return {
      success: true,
      message: `✅ ML Fund Regular calculated successfully. Net proceeds: ${formatCurrencyDisplay(netProceeds)}`,
      data: {
        netProceeds: parseFloat(netProceeds.toFixed(2)),
        loanAmount: parseFloat(bracket.bracketLoanAmount),
        loanDeduction: parseFloat(bracket.loanDeduct),
        existingLoan: parseFloat(existingLoanForType),
        percent35: parseFloat(percent35),
        deductionPerMonth: parseFloat(deductionPerMonth),
        loanType: 'ML Fund Regular'
      }
    };
  }
  
  // No bracket selected yet
  showToast('ℹ️ Please select a bracket amount from the ML Fund table.', 'info');
  
  return {
    success: false,
    needsBracket: true,
    message: 'Please select a bracket amount from the ML Fund table.',
    data: null
  };
}

