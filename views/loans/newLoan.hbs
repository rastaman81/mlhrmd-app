async function processLoanType(loanType, employeeData, loanAmount) {
  console.log('🎯 processLoanType called with:', { 
    loanType, 
    employeeId: employeeData?.idno, 
    loanAmount 
  });

  if (!employeeData || !employeeData.idno) {
    return {
      success: false,
      message: 'Employee data is required',
      data: null
    };
  }

  // ─── NON-BONUS LOANS: use frontend handler if one exists ───
  const handler = LOAN_TYPE_HANDLERS[loanType.toLowerCase()];

  if (handler) {
    try {
      const result = await handler(employeeData, loanAmount);
      return result;
    } catch (error) {
      console.error('Error in loan handler:', error);
      return {
        success: false,
        message: `Error processing loan: ${error.message}`,
        data: null
      };
    }
  }

  // ─── FALLBACK: Try API call ───
  try {
    console.log('🎯 No frontend handler, calling API for:', loanType);
    const response = await fetch('/loan/process', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        loanType,
        employeeId: employeeData.idno,
        office: officeSelectModal.value,
        loanAmount: loanAmount || 0
      })
    });

    const result = await response.json();
    console.log('📊 Loan processing result from API:', result);
    return result;
  } catch (error) {
    console.error('Error processing loan via API:', error);
    return {
      success: false,
      message: `Error processing loan: ${error.message}`,
      data: null
    };
  }
}

