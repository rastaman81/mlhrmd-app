  function selectComaker(emp) {
    const fieldIndex = comakerSearchData.comakerFieldIndex;
    const fieldInput = document.querySelectorAll('#comakerFields .comaker-field input')[fieldIndex];
    const fieldLabel = document.querySelectorAll('#comakerFields .comaker-field label')[fieldIndex];

    if (!fieldInput) return;

    const comakerLos = emp.service_years || 0;
    const loanType = document.getElementById('loanType').value;
    const requiredLos = selectedEmployeeData.selectedBracketRow?.losRequired || 0;

    console.log('🔍 Co-maker Eligibility Check:');
    console.log('  - Co-maker:', emp.firstname, emp.lastname);
    console.log('  - Co-maker LOS:', comakerLos);
    console.log('  - Required LOS for this loan:', requiredLos);
    console.log('  - Loan Type:', loanType);

    if (emp.idno === selectedEmployeeData.idno) {
      showToast('⚠️ The borrower cannot be a co-maker.', 'warning');
      return;
    }

    const existingComakers = getSelectedComakers();
    if (existingComakers.some(c => c.idno === emp.idno)) {
      showToast('⚠️ This co-maker is already added.', 'warning');
      return;
    }

    let isEligible = true;
    let eligibilityMessage = '';

    if (loanType.toLowerCase().includes('ml fund regular') && requiredLos > 0) {
      if (comakerLos < requiredLos) {
        isEligible = false;
        eligibilityMessage = `Co-maker does not qualify.\n\n` +
                            `Co-maker: ${emp.firstname} ${emp.lastname}\n` +
                            `Co-maker Length of Service: ${comakerLos} year(s)\n` +
                            `Required Length of Service: ${requiredLos} year(s)`;
      }
    }

    if (loanType.toLowerCase().includes('bonus') || 
        loanType.toLowerCase().includes('13th month')) {
      if (comakerLos < 5) {
        isEligible = false;
        eligibilityMessage = `Co-maker does not qualify.\n\n` +
                            `Co-maker: ${emp.firstname} ${emp.lastname}\n` +
                            `Co-maker Length of Service: ${comakerLos} year(s)\n` +
                            `Required Length of Service: 5 year(s)`;
      }
    }

    if (!isEligible) {
      showToast(`⚠️ ${eligibilityMessage}`, 'warning');
      showCoMakerEligibilityErrorModal(emp, comakerLos, requiredLos);
      return;
    }

    const fullName = `${emp.lastname}, ${emp.firstname}`;
    fieldInput.value = fullName;
    fieldInput.dataset.idno = emp.idno;
    fieldInput.dataset.los = comakerLos;

    if (!selectedEmployeeData.comakers) {
      selectedEmployeeData.comakers = [];
    }
    selectedEmployeeData.comakers[fieldIndex] = {
      idno: emp.idno,
      name: fullName,
      los: comakerLos
    };

    if (fieldLabel) {
      fieldLabel.textContent = `Co-Maker ${fieldIndex + 1} (LOS: ${comakerLos} yrs)`;
    }

    console.log('✅ Co-maker added:', {
      index: fieldIndex,
      name: fullName,
      idno: emp.idno,
      los: comakerLos
    });

    const modalEl = document.getElementById('comakerSearchModal');
    const modal = bootstrap.Modal.getInstance(modalEl);
