async function checkEmployeeEligibility(loanTypeToCheck) {
  try {
    const employeeId = selectedEmployeeData.idno;
    const employeeName = `${selectedEmployeeData.firstname} ${selectedEmployeeData.lastname}`;
    
    console.log(`🔍 Checking eligibility for ${employeeName} - Loan Type: "${loanTypeToCheck}"`);

    const url = new URL('/loan/check-existing-loan', window.location.origin);
    url.searchParams.append('employeeId', employeeId);
    url.searchParams.append('loanType', loanTypeToCheck);
    url.searchParams.append('office', officeSelectModal.value);   // ← ADD

    const response = await fetch(url);
    const result = await response.json();

    if (!result.success) {
      console.error('Eligibility check failed:', result.message);
      showToast('❌ Failed to check eligibility. Please try again.', 'danger');
      clearLoanFields();
      btnSavePrint.disabled = true;
      
      // Store eligibility result
      if (selectedEmployeeData) {
        const bonusEligibilityKey = `bonusEligible_${loanTypeToCheck}`;
        selectedEmployeeData[bonusEligibilityKey] = false;
      }
      
      updateActionButtonsState();
      return false;
    }

    if (result.hasExisting) {
      const loan = result.loan;
      console.log('⚠️ Existing loan found:', loan);
      showExistingLoanWarning(loan);
      btnSavePrint.disabled = true;
      loanTypeSelect.classList.add('is-invalid');
      clearLoanFields();
      
      // Store eligibility result
      if (selectedEmployeeData) {
        const bonusEligibilityKey = `bonusEligible_${loanTypeToCheck}`;
        selectedEmployeeData[bonusEligibilityKey] = false;
      }
      
      updateActionButtonsState();
      return false;
    } else {
      console.log(`✅ Employee is eligible for "${loanTypeToCheck}"`);
      showToast(`✅ ${selectedEmployeeData.firstname} ${selectedEmployeeData.lastname} is eligible for ${loanTypeToCheck}`, 'success');
      loanTypeSelect.classList.remove('is-invalid');
      
      // Store eligibility result
      if (selectedEmployeeData) {
        const bonusEligibilityKey = `bonusEligible_${loanTypeToCheck}`;
        selectedEmployeeData[bonusEligibilityKey] = true;
      }
      
      updateActionButtonsState();
      return true;
    }

  } catch (error) {
    console.error('Error checking eligibility:', error);
    showToast('❌ Error checking eligibility. Please try again.', 'danger');
    clearLoanFields();
    btnSavePrint.disabled = true;
    
    if (selectedEmployeeData) {
      const bonusEligibilityKey = `bonusEligible_${loanTypeToCheck}`;
      selectedEmployeeData[bonusEligibilityKey] = false;
    }
    
    updateActionButtonsState();
    return false;
  }
}

