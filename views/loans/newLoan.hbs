  // ─────────────────────────────────────────────
// 13. TRIGGER LOAN RECALCULATION
// ─────────────────────────────────────────────
function triggerLoanRecalculation() {
  const loanType = document.getElementById('loanType').value;
  const loanAmount = parseFloat(document.getElementById('loanAmount').value.replace(/[₱,]/g, '')) || 0;
  
  if (!selectedEmployeeData || !selectedEmployeeData.idno) {
    console.log('⚠️ No employee selected, skipping recalculation');
    return;
  }
  
  if (!loanType) {
    console.log('⚠️ No loan type selected, skipping recalculation');
    return;
  }
  
  if (loanAmount <= 0) {
    console.log('⚠️ No loan amount entered, skipping recalculation');
    return;
  }
  
  console.log('🔄 Triggering recalculation for:', { loanType, loanAmount });
  
  // Save existing loan value
  const existingLoanInput = document.getElementById('existingLoan');
  let userExistingLoan = null;
  if (existingLoanInput) {
    const parsed = parseLoanAmount(existingLoanInput.value);
    if (!isNaN(parsed)) {
      userExistingLoan = parsed;
      selectedEmployeeData.existingLoanTotal = parsed;
      console.log('💰 Saved user existing loan:', userExistingLoan);
    }
  }
  
  // Save loan deduction value
  const deductionInput = document.getElementById('loanDeduction');
  let userLoanDeduction = null;
  if (deductionInput && isDeductionEditable(loanType)) {
    const parsed = parseLoanAmount(deductionInput.value);
    if (!isNaN(parsed) && parsed > 0) {
      userLoanDeduction = parsed;
      selectedEmployeeData.loanDeductionValue = parsed;
      console.log('💰 Saved user loan deduction:', userLoanDeduction);
    }
  }
  
  const handler = LOAN_TYPE_HANDLERS[loanType.toLowerCase()];
  if (handler) {
    handler(selectedEmployeeData, loanAmount).then(result => {
      if (result.success) {
        console.log('✅ Recalculation result:', result);
        
        if (result.data) {
          if (result.data.netProceeds !== undefined) {
            document.getElementById('netProceeds').value = formatCurrencyDisplay(result.data.netProceeds);
          }
          
          if (userExistingLoan !== null && userExistingLoan >= 0) {
            document.getElementById('existingLoan').value = formatCurrencyDisplay(userExistingLoan);
            selectedEmployeeData.existingLoanTotal = userExistingLoan;
            if (selectedEmployeeData.selectedBracketRow) {
              selectedEmployeeData.selectedBracketRow.existingLoan = userExistingLoan;
            }
            console.log('🔄 Restored user existing loan:', userExistingLoan);
          } else if (result.data.existingLoan !== undefined) {
            document.getElementById('existingLoan').value = formatCurrencyDisplay(result.data.existingLoan);
            selectedEmployeeData.existingLoanTotal = result.data.existingLoan;
          }
          
          if (userLoanDeduction !== null && userLoanDeduction > 0 && isDeductionEditable(loanType)) {
            document.getElementById('loanDeduction').value = formatCurrencyDisplay(userLoanDeduction);
            selectedEmployeeData.loanDeductionValue = userLoanDeduction;
            console.log('🔄 Restored user loan deduction:', userLoanDeduction);
          } else if (result.data.loanDeduction !== undefined) {
            document.getElementById('loanDeduction').value = formatCurrencyDisplay(result.data.loanDeduction);
          }
        }
        
        updateActionButtonsState();
      } else if (result.needsBracket) {
        showToast('ℹ️ Please select a bracket amount from the ML Fund table.', 'info');
      } else if (result.needsMonths) {
        // ── NEW ──
        showToast('ℹ️ Please select the number of months to pay.', 'info');
      }else {
        showToast(result.message || 'Recalculation failed', 'warning');
      }
    }).catch(error => {
      console.error('Error during recalculation:', error);
    });
  } else {
    console.log('ℹ️ No handler found for loan type:', loanType);
  }
}

  // ─────────────────────────────────────────────
  // 14. DEDUCTION EDITABLE FUNCTIONS
  // ─────────────────────────────────────────────
  const BRACKET_DRIVEN_LOAN_TYPES = [
  'ml fund regular',
  'sako maxi',
  'sako pettycash'
];

function isLoanAmountEditable(loanType) {
  if (!loanType) return true;
  return !BRACKET_DRIVEN_LOAN_TYPES.includes(loanType.toLowerCase().trim());
}

function updateLoanAmountEditable(loanType) {
  const loanAmountInput = document.getElementById('loanAmount');
  if (!loanAmountInput) return;

  const editable = isLoanAmountEditable(loanType);

  if (editable) {
    loanAmountInput.removeAttribute('readonly');
    loanAmountInput.style.backgroundColor = '#fff';
    loanAmountInput.style.cursor = 'text';
    loanAmountInput.placeholder = '0.00';
  } else {
    loanAmountInput.setAttribute('readonly', true);
    loanAmountInput.style.backgroundColor = 'transparent';
    loanAmountInput.style.cursor = 'default';
    loanAmountInput.placeholder = 'Select from bracket table';
  }
}

  const EDITABLE_DEDUCTION_LOANS = [
    'sss',
    'pagibig',
    'sako commodity',
    'sako emergency',
    'sako preferential',
    'ml lending motor loan',
    'ml fund emergency'   // ← ADD THIS
  ];

  function isDeductionEditable(loanType) {
    if (!loanType) return false;
    const normalized = loanType.toLowerCase().trim();
    return EDITABLE_DEDUCTION_LOANS.includes(normalized);
  }

  function updateDeductionEditable() {
    const loanDeductionInput = document.getElementById('loanDeduction');
    if (!loanDeductionInput) return;
    
    const loanType = document.getElementById('loanType').value;
    const isEditable = isDeductionEditable(loanType);
    
    if (isEditable) {
      loanDeductionInput.removeAttribute('readonly');
      loanDeductionInput.style.backgroundColor = '#fff';
      loanDeductionInput.style.cursor = 'text';
      loanDeductionInput.placeholder = 'Enter deduction amount';
    } else {
      loanDeductionInput.setAttribute('readonly', true);
      loanDeductionInput.style.backgroundColor = 'transparent';
      loanDeductionInput.style.cursor = 'default';
      loanDeductionInput.placeholder = '';
    }
    
    console.log(`🔧 Loan deduction ${isEditable ? 'editable' : 'read-only'} for:`, loanType);
  }

  function updateNetProceedsOnly() {
    const loanType = document.getElementById('loanType').value;
    const loanAmount = parseFloat(document.getElementById('loanAmount').value.replace(/[₱,]/g, '')) || 0;
    
    if (!selectedEmployeeData || !selectedEmployeeData.idno) {
      return;
    }
    
    if (!loanType || loanAmount <= 0) {
      return;
    }
    
    let existingLoan = selectedEmployeeData.existingLoanTotal || 0;
    const existingLoanInput = document.getElementById('existingLoan');
    if (existingLoanInput) {
      const parsed = parseLoanAmount(existingLoanInput.value);
      if (!isNaN(parsed) && parsed > 0) {
        existingLoan = parsed;
        selectedEmployeeData.existingLoanTotal = parsed;
      }
    }
    
    let loanDeduction = 0;
    const deductionInput = document.getElementById('loanDeduction');
    if (deductionInput && isDeductionEditable(loanType)) {
      const parsed = parseLoanAmount(deductionInput.value);
      if (!isNaN(parsed) && parsed > 0) {
        loanDeduction = parsed;
        selectedEmployeeData.loanDeductionValue = parsed;
      } else {
        loanDeduction = loanAmount;
        document.getElementById('loanDeduction').value = formatCurrencyDisplay(loanDeduction);
      }
    } else {
      loanDeduction = loanAmount;
      document.getElementById('loanDeduction').value = formatCurrencyDisplay(loanDeduction);
    }
    
    const loanComputation = selectedEmployeeData.loanComputation || {};
    const netpay1 = loanComputation.firstCycleNetPay || 0;
    const netpay2 = loanComputation.secondCycleNetPay || 0;
    const totalNetPay = netpay1 + netpay2;
    const percent35 = loanComputation.percentage || 0;
    const monthlyDeductionCount = isDeductionEditable(loanType) ? 1 : 2;
    const deductionPerMonth = loanDeduction * monthlyDeductionCount;
    //const netProceeds = (totalNetPay + existingLoan) - percent35 - deductionPerMonth;
    const netProceeds = (totalNetPay + (existingLoan * monthlyDeductionCount)) - percent35 - deductionPerMonth;
    
    
    document.getElementById('netProceeds').value = formatCurrencyDisplay(netProceeds);
    console.log('🔄 Net proceeds updated only:', { existingLoan, loanDeduction, netProceeds });
  }

