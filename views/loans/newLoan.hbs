  function showMessageRow(message, variant = 'muted') {
    searchResults.innerHTML = '';
    const row = document.createElement('tr');
    const td = document.createElement('td');
    td.colSpan = 6;
    td.className = `text-center text-${variant} py-3`;
    td.textContent = message;
    row.appendChild(td);
    searchResults.appendChild(row);
  }

  function renderPage() {
    renderResults(filteredData);
    updatePaginationControls();
  }

  function renderResults(employees) {
    searchResults.innerHTML = '';

    if (!employees || employees.length === 0) {
      showMessageRow('No employees on this page.');
      return;
    }

    employees.forEach((emp) => {
      const row = document.createElement('tr');
      row.style.cursor = 'pointer';

      const fields = [
        emp.idno,
        emp.lastname,
        emp.firstname,
        emp.branch || '-',
        emp.region || '-'
      ];

      fields.forEach((value) => {
        const td = document.createElement('td');
        td.textContent = value || '-';
        row.appendChild(td);
      });

      const tdSelect = document.createElement('td');
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'btn btn-outline-primary btn-sm';
      btn.textContent = 'Select';
      tdSelect.appendChild(btn);
      row.appendChild(tdSelect);

      row.addEventListener('click', (e) => {
        if (e.target.tagName !== 'BUTTON') {
          selectEmployee(emp);
        }
      });

      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        selectEmployee(emp);
      });

      searchResults.appendChild(row);
    });
  }

  function updatePaginationControls() {
    if (currentTotal === 0) {
      pageInfo.textContent = '';
      pageNumbers.textContent = '';
      prevPage.disabled = true;
      nextPage.disabled = true;
      return;
    }

    const start = (currentPage - 1) * PAGE_SIZE + 1;
    const end = Math.min(currentPage * PAGE_SIZE, currentTotal);
    pageInfo.textContent = `Showing ${start}-${end} of ${currentTotal}`;

    let pageNumbersHtml = '';
    const maxVisiblePages = 5;
    let startPage = Math.max(1, currentPage - Math.floor(maxVisiblePages / 2));
    let endPage = Math.min(totalPages, startPage + maxVisiblePages - 1);
    
    if (endPage - startPage < maxVisiblePages - 1) {
      startPage = Math.max(1, endPage - maxVisiblePages + 1);
    }

    if (startPage > 1) {
      pageNumbersHtml += `<span class="px-1">...</span>`;
    }

    for (let i = startPage; i <= endPage; i++) {
      const activeClass = i === currentPage ? 'fw-bold text-primary' : '';
      pageNumbersHtml += `<span class="px-1 ${activeClass}" style="cursor:pointer" data-page="${i}">${i}</span>`;
    }

    if (endPage < totalPages) {
      pageNumbersHtml += `<span class="px-1">...</span>`;
    }

    pageNumbers.innerHTML = pageNumbersHtml;

    pageNumbers.querySelectorAll('span[data-page]').forEach(el => {
      el.addEventListener('click', () => {
        const page = parseInt(el.dataset.page);
        if (page !== currentPage) {
          currentPage = page;
          performSearch();
        }
      });
    });

    prevPage.disabled = currentPage <= 1;
    nextPage.disabled = currentPage >= totalPages;
  }

  async function performSearch() {
    const office = officeSelectModal.value;
    const lastName = searchLastName.value.trim();
    const firstName = searchFirstName.value.trim();

    if (!office) {
      showToast('⚠️ Please select an office first.', 'warning');
      officeSelectModal.focus();
      return;
    }

    if (!lastName && !firstName) {
      showToast('⚠️ Please enter a last name or first name to search.', 'warning');
      searchLastName.focus();
      return;
    }

    showMessageRow('Searching…');
    resultCount.textContent = 'Searching...';
    prevPage.disabled = true;
    nextPage.disabled = true;
    pageInfo.textContent = '';
    pageNumbers.textContent = '';

    try {
      const url = new URL('/loan/search-employee', window.location.origin);
      url.searchParams.append('office', office);
      url.searchParams.append('page', currentPage);
      url.searchParams.append('limit', PAGE_SIZE);
      
      if (lastName && firstName) {
        url.searchParams.append('lastname', lastName);
        url.searchParams.append('firstname', firstName);
      } else if (lastName) {
        url.searchParams.append('lastname', lastName);
      } else if (firstName) {
        url.searchParams.append('firstname', firstName);
      }

      const res = await fetch(url);
      const data = await res.json();

      if (!data.success) {
        showMessageRow(data.message || 'Search failed.', 'danger');
        resultCount.textContent = '0 results found';
        return;
      }

      const employees = data.data || [];
      const pagination = data.pagination;

      globalPayrollDates = data.payrollDates || [];
      console.log('📅 Payroll Dates loaded:', globalPayrollDates);

      if (!Array.isArray(employees)) {
        showMessageRow('Invalid response format.', 'danger');
        resultCount.textContent = '0 results found';
        return;
      }

      if (employees.length === 0) {
        showMessageRow('No employees found matching your search criteria.');
        resultCount.textContent = '0 results found';
        pageInfo.textContent = '';
        pageNumbers.textContent = '';
        prevPage.disabled = true;
        nextPage.disabled = true;
        currentData = [];
        filteredData = [];
        currentTotal = 0;
        return;
      }

      currentData = employees;
      filteredData = employees;
      currentTotal = pagination?.total || employees.length;
      totalPages = pagination?.totalPages || Math.ceil(employees.length / PAGE_SIZE);
      currentPage = pagination?.page || 1;

      resultCount.textContent = `${currentTotal} result${currentTotal > 1 ? 's' : ''} found`;
      renderPage();
      
    } catch (err) {
