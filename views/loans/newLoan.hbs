    'sako a.l.l. bonus': 'a.l.l. bonus'
  };

  const BRACKET_MAP = [
    {
      test: (name) => /^ml\s+fund\s+regular(?:\s+reloan)?$/i.test(name.trim()),
      key: 'ml_fund',
      label: 'ML Fund Table',
      icon: 'fas fa-university',
    },
    {
      test: (name) => /sako\s*maxi/i.test(name),
      key: 'sako_maxi',
      label: 'Sako Maxi Table',
      icon: 'fas fa-piggy-bank',
    },
    {
      test: (name) => /sako\s*petty/i.test(name),
      key: 'sako_petty',
      label: 'Sako Petty Cash Table',
      icon: 'fas fa-coins',
    },
  ];

  const STATUS_BADGE_CLASS = {
    'approved': 'nla-badge-approved',
    'cancelled': 'nla-badge-cancelled',
    'canceled': 'nla-badge-cancelled',
    'disapproved': 'nla-badge-disapproved',
    'disapprove': 'nla-badge-disapproved',
    'pending': 'nla-badge-pending',
    'for signature': 'nla-badge-signature',
    'temporary hold': 'nla-badge-hold',
    'for verification': 'nla-badge-verification',
  };

  let activeBracket = null;

  // ─────────────────────────────────────────────
  // 2. HELPER FUNCTIONS
  // ─────────────────────────────────────────────

  function formatCurrencyDisplay(value) {
    if (value === null || value === undefined || isNaN(value)) {
      return '₱0.00';
    }
    return `₱${parseFloat(value).toLocaleString('en-US', {
      minimumFractionDigits: 2,
      maximumFractionDigits: 2
    })}`;
  }

  function formatLoanAmount(value) {
    if (value === null || value === undefined || isNaN(value)) {
      return '';
    }
    const num = parseFloat(value);
    if (isNaN(num)) return '';
    return num.toLocaleString('en-US', {
      minimumFractionDigits: 2,
      maximumFractionDigits: 2
    });
  }

  function parseLoanAmount(formattedValue) {
    if (!formattedValue || typeof formattedValue !== 'string') {
      return NaN;
    }
    const cleaned = formattedValue.replace(/[^0-9.]/g, '');
    return parseFloat(cleaned);
  }

  function setLoanAmountValue(value) {
    const loanAmountInput = document.getElementById('loanAmount');
    if (!loanAmountInput) return;
    
    let numericValue = value;
    if (typeof value === 'string') {
      if (value.includes(',') || value.includes('₱')) {
        numericValue = parseLoanAmount(value);
      } else {
        numericValue = parseFloat(value);
      }
    }
    
    if (!isNaN(numericValue) && numericValue !== null && numericValue !== undefined) {
      loanAmountInput.value = formatLoanAmount(numericValue);
    } else if (value === '' || value === null || value === undefined) {
      loanAmountInput.value = '';
    } else {
      loanAmountInput.value = value;
    }
  }

  function showToast(message, type = 'info') {
    console.log(`[${type.toUpperCase()}] ${message}`);
  }

// ─────────────────────────────────────────────
// UPDATE ACTION BUTTONS STATE (ENABLED/DISABLED)
// ─────────────────────────────────────────────
function updateActionButtonsState() {
  const hasLoanType = !!loanTypeSelect.value;
  const loanAmount = parseLoanAmount(document.getElementById('loanAmount').value);
  const hasLoanAmount = !isNaN(loanAmount) && loanAmount > 0;
  const hasEmployee = !!selectedEmployeeData && !!selectedEmployeeData.idno;
  
  // ─── CHECK IF LOAN TYPE REQUIRES BRACKET SELECTION ───
  const loanName = loanTypeSelect.value.toLowerCase();
  
  // Only handle visibility of months row, don't reset values here
  if (MONTHS_BASED_LOAN_TYPES.includes(loanName)) {
    showMonthsToPayRow(true);
    // Only populate if the dropdown is empty or loan type changed
    const monthsSelect = document.getElementById('monthsToPay');
    if (monthsSelect && monthsSelect.options.length <= 1) {
      populateMonthsToPay(loanName);
    }
    // NEVER reset the value here - preserve user selection
  } else {
    showMonthsToPayRow(false);
    // Don't reset or clear the value here - let clear functions handle it
  }
  
  const requiresBracket = BRACKET_MAP.some((b) => b.test(loanName));
  
  let hasBracketSelected = true;
  if (requiresBracket) {
    hasBracketSelected = !!(selectedEmployeeData && selectedEmployeeData.selectedBracketRow);
  }

  const requiresMonths = MONTHS_BASED_LOAN_TYPES.includes(loanName);
  let hasMonthsSelected = true;
  if (requiresMonths) {
    hasMonthsSelected = !!document.getElementById('monthsToPay')?.value;
  }
  
  let isEligible = true;
  const isBonusLoan = EXISTING_LOAN_MODAL_TYPES.includes(loanName);
  
  if (isBonusLoan && selectedEmployeeData) {
    const bonusEligibilityKey = `bonusEligible_${loanName}`;
    isEligible = selectedEmployeeData[bonusEligibilityKey] !== false;
    
    if (selectedEmployeeData[bonusEligibilityKey] === undefined) {
      isEligible = false;
    }
  }
  
  const shouldEnable = hasLoanType && hasLoanAmount && hasEmployee && hasBracketSelected && hasMonthsSelected && isEligible;
  btnSavePrint.disabled = !shouldEnable;
  
  console.log('🔘 Save/Print button state:', {
    hasLoanType,
    hasLoanAmount,
    loanAmount,
    hasEmployee,
    requiresBracket,
    hasBracketSelected,
    isBonusLoan,
    isEligible,
    shouldEnable,
    disabled: btnSavePrint.disabled
  });
}

