  // 9. SELECT EMPLOYEE
  // ─────────────────────────────────────────────
  async function selectEmployee(emp) {
    document.getElementById('empIdno').textContent = '⏳ Loading...';
    document.getElementById('empLast').textContent = '⏳ Loading...';
    document.getElementById('empFirst').textContent = '⏳ Loading...';
    document.getElementById('empMiddle').textContent = '⏳ Loading...';
    document.getElementById('empRegion').textContent = '⏳ Loading...';
    document.getElementById('empBranch').textContent = '⏳ Loading...';
    document.getElementById('empArea').textContent = '⏳ Loading...';
    document.getElementById('empLos').textContent = '⏳ Loading...';

    try {
      const office = officeSelectModal.value;
      
      const url = new URL('/loan/employee-payroll', window.location.origin);
      url.searchParams.append('employeeId', emp.idno);
      url.searchParams.append('office', office);
      
      const response = await fetch(url);
      const result = await response.json();

      if (!result.success) {
        throw new Error(result.message || 'Failed to load employee payroll data');
      }

      selectedEmployeeData = {
        ...emp,
        payrollRecords: result.data,
        payrollDates: result.payrollDates
      };
      
      console.log('📅 Raw Employee Data Loaded:', selectedEmployeeData);
      console.log('📊 Payroll Records Count:', result.data?.length || 0);

      if (result.data && result.data.length > 0) {
        const sortedRecords = [...result.data].sort((a, b) => {
          const dateA = new Date(a.enddate);
          const dateB = new Date(b.enddate);
          return dateB - dateA;
        });

        let firstCycleRecord = null;
        let secondCycleRecord = null;
        
        //sortedRecords.forEach(record => {
        //  const endDate = new Date(record.enddate);
        //  const day = endDate.getDate();
          
        //  if (day === 15 && !firstCycleRecord) {
        //    firstCycleRecord = record;
        //  } else if (day >= 28 && day <= 31 && !secondCycleRecord) {
        //    secondCycleRecord = record;
        //  }
        //});

        sortedRecords.forEach(record => {
  const endDate = new Date(record.enddate);
  const day = endDate.getDate();

  // Get the actual last day of the month
  const lastDayOfMonth = new Date(
    endDate.getFullYear(),
    endDate.getMonth() + 1,
    0
  ).getDate();

  const isLastDayOfMonth = day === lastDayOfMonth;

  // First payroll cycle (15th)
  if (day === 15 && !firstCycleRecord) {
    firstCycleRecord = record;
  }

  // Second payroll cycle (actual last day of month)
  else if (isLastDayOfMonth && !secondCycleRecord) {
    secondCycleRecord = record;
  }
});

        if (!firstCycleRecord || !secondCycleRecord) {
          if (sortedRecords.length >= 2) {
            secondCycleRecord = sortedRecords[0];
            firstCycleRecord = sortedRecords[1];
          } else if (sortedRecords.length === 1) {
            firstCycleRecord = sortedRecords[0];
            secondCycleRecord = sortedRecords[0];
          }
        }

        if (!firstCycleRecord && sortedRecords.length > 0) {
          firstCycleRecord = sortedRecords[0];
        }
        if (!secondCycleRecord && sortedRecords.length > 0) {
          secondCycleRecord = sortedRecords[0];
        }

        const firstCycleRawNetPay = firstCycleRecord ? parseFloat(firstCycleRecord.netpay) || 0 : 0;
        const firstCycleOvertime = firstCycleRecord ? parseFloat(firstCycleRecord.ot_total) || 0 : 0;
        const firstCycleAllowance = firstCycleRecord ? parseFloat(firstCycleRecord.allowance_total) || 0 : 0;
        const firstCycleOtherIncome = firstCycleRecord ? parseFloat(firstCycleRecord.otherincome) || 0 : 0;

        const secondCycleRawNetPay = secondCycleRecord ? parseFloat(secondCycleRecord.netpay) || 0 : 0;
        const secondCycleOvertime = secondCycleRecord ? parseFloat(secondCycleRecord.ot_total) || 0 : 0;
        const secondCycleAllowance = secondCycleRecord ? parseFloat(secondCycleRecord.allowance_total) || 0 : 0;
        const secondCycleOtherIncome = secondCycleRecord ? parseFloat(secondCycleRecord.otherincome) || 0 : 0;

        const firstCycleNetPay = firstCycleRawNetPay - (firstCycleOvertime + firstCycleOtherIncome);
        const secondCycleNetPay = secondCycleRawNetPay - (secondCycleOvertime + secondCycleOtherIncome);
        
        const totalOvertime = firstCycleOvertime + secondCycleOvertime;
        const totalAllowance = firstCycleAllowance + secondCycleAllowance;
        const totalOtherIncome = firstCycleOtherIncome + secondCycleOtherIncome;
        const totalNetPay = firstCycleNetPay + secondCycleNetPay;
        
        const monthlyRate = parseFloat(emp.monthly_rate) || 0;
        const percentage = (monthlyRate + totalAllowance) * 0.35;
        
        selectedEmployeeData.loanComputation = {
          firstCycleRawNetPay,
          firstCycleOvertime,
          firstCycleAllowance,
          firstCycleOtherIncome,
          firstCycleNetPay,
          firstCycleRecord: firstCycleRecord ? firstCycleRecord.enddate : null,
          secondCycleRawNetPay,
          secondCycleOvertime,
          secondCycleAllowance,
          secondCycleOtherIncome,
          secondCycleNetPay,
          secondCycleRecord: secondCycleRecord ? secondCycleRecord.enddate : null,
          totalOvertime,
          totalAllowance,
          totalOtherIncome,
          totalNetPay,
          percentage,
          monthlyRate,
          hasFirstCycle: !!firstCycleRecord,
          hasSecondCycle: !!secondCycleRecord,
          firstCycleDate: firstCycleRecord ? firstCycleRecord.enddate : null,
          secondCycleDate: secondCycleRecord ? secondCycleRecord.enddate : null,
          isSameCycle: firstCycleRecord === secondCycleRecord
        };
        
        document.getElementById('existingLoan').value = formatCurrencyDisplay(0);
        selectedEmployeeData.existingLoanTotal = 0;

        if (firstCycleRecord === secondCycleRecord) {
          console.warn('⚠️ WARNING: Both cycles are using the same record!');
          showToast('⚠️ Only one payroll record found. Using it for both cycles.', 'warning');
        }
      }

      document.getElementById('empIdno').textContent = emp.idno;
      document.getElementById('empLast').textContent = emp.lastname;
      document.getElementById('empFirst').textContent = emp.firstname;
      document.getElementById('empMiddle').textContent = emp.middlename || '-';
      document.getElementById('empRegion').textContent = emp.region || '-';
      document.getElementById('empBranch').textContent = emp.branch || '-';
      document.getElementById('empArea').textContent = emp.area || '-';
      document.getElementById('empLos').textContent = `${emp.service_years || 0} year(s)`;

      updateActionButtonsState();
      setLoanFormEnabled(true);
      showToast('✅ Employee data loaded successfully!', 'success');
      employeeModal.hide();

    } catch (error) {
      console.error('Error loading employee payroll:', error);
      alert('Failed to load employee data. Please try again.');
      
      document.getElementById('empIdno').textContent = '---';
      document.getElementById('empLast').textContent = '---';
      document.getElementById('empFirst').textContent = '---';
      document.getElementById('empMiddle').textContent = '---';
      document.getElementById('empRegion').textContent = '---';
      document.getElementById('empBranch').textContent = '---';
      document.getElementById('empArea').textContent = '---';
      document.getElementById('empLos').textContent = '---';
    }
  }

