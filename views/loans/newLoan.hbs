  function getSelectedComakers() {
    const comakers = [];
    const inputs = document.querySelectorAll('#comakerFields .comaker-field:not(.d-none) input');
    inputs.forEach((input, index) => {
      if (input.value.trim()) {
        comakers.push({
          index: index,
          idno: input.dataset.idno || '',
          name: input.value.trim(),
          los: parseInt(input.dataset.los) || 0
        });
      }
    });
    return comakers;
  }

  function updateComakerCount() {
    const count = getSelectedComakers().length;
    const countLabel = document.getElementById('comakerCount');
    if (countLabel) {
      countLabel.textContent = `${count} of 4 added`;
    }
  }

  function openComakerSearch(fieldIndex) {
    const office = officeSelectModal.value;
    if (!office) {
      showToast('⚠️ Please select an office first.', 'warning');
      return;
    }

    if (!selectedEmployeeData || !selectedEmployeeData.idno) {
      showToast('⚠️ Please select a borrower first.', 'warning');
      return;
    }

    document.getElementById('comakerBorrowerId').textContent = selectedEmployeeData.idno;

    comakerSearchData.comakerFieldIndex = fieldIndex;
    comakerSearchData.currentPage = 1;

    const modalEl = document.getElementById('comakerSearchModal');
    const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
    modal.show();

    document.getElementById('comakerSearchInput').focus();
  }

  async function performComakerSearch() {
    const query = document.getElementById('comakerSearchInput').value.trim();
    const office = officeSelectModal.value;
    const field = document.getElementById('comakerSearchField').value;
    const excludeIdno = selectedEmployeeData.idno;

    if (!query) {
      document.getElementById('comakerSearchInput').focus();
      return;
    }

    const resultsBody = document.getElementById('comakerSearchResults');
    resultsBody.innerHTML = `
      <tr>
        <td colspan="8" class="text-center text-muted py-3">Searching...</td>
      </tr>
    `;

    try {
      const url = new URL('/loan/search-comaker', window.location.origin);
      url.searchParams.append('query', query);
      url.searchParams.append('office', office);
      url.searchParams.append('excludeIdno', excludeIdno);
      url.searchParams.append('field', field);
      url.searchParams.append('page', comakerSearchData.currentPage);
      url.searchParams.append('limit', 20);

      const res = await fetch(url);
      const data = await res.json();

      if (!data.success) {
        resultsBody.innerHTML = `
          <tr>
            <td colspan="8" class="text-center text-danger py-3">${data.message || 'Search failed.'}</td>
          </tr>
        `;
        return;
      }

      const employees = data.data || [];
      const pagination = data.pagination;

      comakerSearchData.currentData = employees;
      comakerSearchData.totalPages = pagination?.totalPages || 1;

      document.getElementById('comakerResultCount').textContent = 
        `${pagination?.total || 0} result${pagination?.total !== 1 ? 's' : ''} found`;

      renderComakerResults(employees);
      updateComakerPaginationControls();

    } catch (err) {
      console.error('Co-maker search error:', err);
      resultsBody.innerHTML = `
        <tr>
          <td colspan="8" class="text-center text-danger py-3">Something went wrong. Please try again.</td>
        </tr>
      `;
    }
  }

  function renderComakerResults(employees) {
    const resultsBody = document.getElementById('comakerSearchResults');
    resultsBody.innerHTML = '';

    if (!employees || employees.length === 0) {
      resultsBody.innerHTML = `
        <tr>
          <td colspan="8" class="text-center text-muted py-3">No employees found.</td>
        </tr>
      `;
      return;
    }

    employees.forEach((emp) => {
      const row = document.createElement('tr');
      row.style.cursor = 'pointer';

      const fields = [
        emp.idno,
        emp.lastname,
        emp.firstname,
        emp.middlename || '-',
        emp.region || '-',
        emp.branch || '-',
        `${emp.service_years || 0} year(s)`
      ];

      fields.forEach((value) => {
        const td = document.createElement('td');
        td.textContent = value || '-';
        row.appendChild(td);
      });

      const tdSelect = document.createElement('td');
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'btn btn-outline-primary btn-sm';
      btn.textContent = 'Select';
      tdSelect.appendChild(btn);
      row.appendChild(tdSelect);

      row.addEventListener('click', (e) => {
        if (e.target.tagName !== 'BUTTON') {
          selectComaker(emp);
        }
      });

      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        selectComaker(emp);
      });

      resultsBody.appendChild(row);
    });
  }

  function updateComakerPaginationControls() {
    const currentPage = comakerSearchData.currentPage;
    const totalPages = comakerSearchData.totalPages;

    const prevBtn = document.getElementById('comakerPrevPage');
    const nextBtn = document.getElementById('comakerNextPage');
    const pageNumbers = document.getElementById('comakerPageNumbers');

    prevBtn.disabled = currentPage <= 1;
    nextBtn.disabled = currentPage >= totalPages;

    let pageNumbersHtml = '';
    const maxVisiblePages = 5;
    let startPage = Math.max(1, currentPage - Math.floor(maxVisiblePages / 2));
    let endPage = Math.min(totalPages, startPage + maxVisiblePages - 1);

    if (endPage - startPage < maxVisiblePages - 1) {
      startPage = Math.max(1, endPage - maxVisiblePages + 1);
    }

    if (startPage > 1) {
      pageNumbersHtml += `<span class="px-1">...</span>`;
    }

    for (let i = startPage; i <= endPage; i++) {
      const activeClass = i === currentPage ? 'fw-bold text-primary' : '';
      pageNumbersHtml += `<span class="px-1 ${activeClass}" style="cursor:pointer" data-page="${i}">${i}</span>`;
    }

    if (endPage < totalPages) {
      pageNumbersHtml += `<span class="px-1">...</span>`;
    }

    pageNumbers.innerHTML = pageNumbersHtml;

    pageNumbers.querySelectorAll('span[data-page]').forEach(el => {
      el.addEventListener('click', () => {
        const page = parseInt(el.dataset.page);
        if (page !== currentPage) {
          comakerSearchData.currentPage = page;
          performComakerSearch();
        }
      });
    });
  }

