<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>{{title}}</title>

  <!-- Bootstrap -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

  <!-- Type -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Lora:wght@500;600;700&display=swap" rel="stylesheet">

  <!-- Your custom styles -->
  <link rel="stylesheet" href="/css/styles.css">

  <style>
    :root{
      --nla-navy: #16304A;
      --nla-navy-deep: #0F2233;
      --nla-blue: #2E6F9E;
      --nla-teal: #1F7A6C;
      --nla-gold: #A8762A;
      --nla-bg: #F6F7F9;
      --nla-surface: #FFFFFF;
      --nla-border: #E3E6EB;
      --nla-muted: #6B7686;
      --nla-danger: #C1483D;
      --nla-slate: #64748B;
      --nla-violet: #7C5CBF;
      --nla-rust: #C2703D;
      --nla-indigo: #4F6FBA;
    }

    .main-content{
      font-family:'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
      background:var(--nla-bg);
    }

    .main-content .nla-page-head{
      display:flex;
      align-items:flex-end;
      justify-content:space-between;
      flex-wrap:wrap;
      gap:.75rem;
      margin-bottom:1.75rem;
    }
    .main-content .nla-eyebrow{
      text-transform:uppercase;
      letter-spacing:.08em;
      font-size:.72rem;
      font-weight:600;
      color:var(--nla-blue);
      margin:0 0 .25rem;
    }
    .main-content .nla-title{
      font-size:1.65rem;
      font-weight:700;
      color:var(--nla-navy-deep);
      margin:0;
      display:flex;
      align-items:center;
      gap:.6rem;
    }
    .main-content .nla-title i{ color:var(--nla-blue); }
    .main-content .nla-subtitle{
      margin:.35rem 0 0;
      color:var(--nla-muted);
      font-size:.92rem;
    }

    /* ---- Workflow cards ---- */
    .main-content .nla-flow{
      display:flex;
      flex-direction:column;
      gap:1.25rem;
    }
    .main-content .nla-card{
      border:1px solid var(--nla-border);
      border-radius:.65rem;
      background:var(--nla-surface);
      box-shadow:0 1px 2px rgba(16,24,40,.04);
    }
    .main-content .nla-card .card-header{
      background:var(--nla-surface);
      border-bottom:1px solid var(--nla-border);
      padding:.65rem 1rem;
      display:flex;
      align-items:center;
      gap:.55rem;
      border-radius:.65rem .65rem 0 0;
    }
    .main-content .nla-card .card-header i{ color:var(--nla-blue); }
    .main-content .nla-card .card-header strong{
      color:var(--nla-navy-deep);
      font-weight:600;
      font-size:.92rem;
    }
    .main-content .nla-card .card-body{ padding:1rem; }

    .main-content .form-label{
      font-size:.75rem;
      font-weight:600;
      color:var(--nla-navy);
      margin-bottom:.25rem;
    }
    .main-content .form-select,
    .main-content .form-control{
      border-color:var(--nla-border);
      font-size:.875rem;
      padding:.35rem .65rem;
    }
    .main-content .form-select:focus,
    .main-content .form-control:focus{
      border-color:var(--nla-blue);
      box-shadow:0 0 0 .2rem rgba(46,111,158,.12);
    }
    .main-content .nla-help{
      font-size:.78rem;
      color:var(--nla-muted);
      margin:.4rem 0 0;
    }
    .main-content .nla-locked-hint{
  font-size:.7rem;
  font-weight:600;
  color:var(--nla-muted);
  background:var(--nla-bg);
  border:1px solid var(--nla-border);
  border-radius:1rem;
  padding:.2rem .6rem;
  display:inline-flex;
  align-items:center;
}

    /* ---- Employee profile (Step 2) ---- */
    .main-content .nla-profile{ display:flex; gap:.75rem; align-items:flex-start; }
    .main-content .nla-avatar{
      width:44px; height:44px; flex-shrink:0;
      border-radius:50%;
      background:linear-gradient(145deg, var(--nla-blue), var(--nla-navy));
      color:#fff;
      display:flex; align-items:center; justify-content:center;
      font-size:1.1rem;
    }
    .main-content .nla-profile-grid{
      flex:1;
      display:grid;
      grid-template-columns:repeat(4, minmax(100px,1fr));
      gap:.5rem 1rem;
    }
    .main-content .nla-field-label{
      display:block;
      font-size:.65rem;
      font-weight:600;
      text-transform:uppercase;
      letter-spacing:.04em;
      color:var(--nla-muted);
      margin-bottom:.1rem;
    }
    .main-content .nla-field-value{
      display:block;
      font-size:.88rem;
      font-weight:600;
      color:var(--nla-navy-deep);
    }
    @media (max-width:767px){
      .main-content .nla-profile-grid{ grid-template-columns:repeat(2,1fr); }
    }

    /* ---- Loan computation panel (Step 3) ---- */
    .main-content .nla-compute-panel{
      margin-top:.75rem;
      background:var(--nla-bg);
      border:1px solid var(--nla-border);
      border-radius:.5rem;
      padding:.75rem 1rem;
    }
    .main-content .nla-compute-row{
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:.75rem;
      padding:.2rem 0;
    }
    .main-content .nla-compute-label{
      font-size:.8rem;
      color:var(--nla-muted);
      font-weight:500;
    }
    .main-content .nla-compute-value{
      border:none !important;
      background:transparent !important;
      text-align:right;
      font-weight:600;
      font-size:.9rem;
      color:var(--nla-navy-deep);
      font-variant-numeric:tabular-nums;
      padding:0 !important;
      max-width:170px;
    }
    .main-content .nla-compute-value:focus{ box-shadow:none; }
    .main-content .nla-compute-divider{
      border-top:1px dashed var(--nla-border);
      margin:.35rem 0;
    }
    .main-content .nla-net-row .nla-compute-label{
      font-weight:700;
      color:var(--nla-navy-deep);
      font-size:.85rem;
    }
    .main-content .nla-net-value{
      border:none !important;
      background:transparent !important;
      text-align:right;
      font-family:'Lora', serif;
      font-weight:700;
      font-size:1.35rem;
      color:var(--nla-gold);
      font-variant-numeric:tabular-nums;
      padding:0 !important;
      max-width:200px;
    }
    .main-content .nla-net-value:focus{ box-shadow:none; }

    /* ---- Co-makers (Step 4) ---- */
    .main-content .nla-comaker-label{
      font-size:.75rem;
      font-weight:600;
      color:var(--nla-navy);
      margin-bottom:.2rem;
      display:block;
    }
    .main-content .nla-comaker-count{
      font-size:.72rem;
      font-weight:600;
      color:var(--nla-muted);
      background:var(--nla-bg);
      border:1px solid var(--nla-border);
      border-radius:1rem;
      padding:.15rem .6rem;
    }
    .main-content .comaker-field{ transition:opacity .2s ease; }
    .main-content .comaker-field.d-none{ display:none !important; }
    .main-content .comaker-field.nla-fade-init{ opacity:0; }
    .main-content .nla-comaker-remove{ color:var(--nla-muted); }
    .main-content .nla-comaker-remove:hover{ color:var(--nla-danger); }

    /* ---- Action bar ---- */
    .main-content .nla-action-bar{
      position:sticky;
      bottom:0;
      background:rgba(255,255,255,.97);
      border:1px solid var(--nla-border);
      border-radius:.65rem;
      padding:.75rem 1rem;
      box-shadow:0 -4px 16px rgba(16,24,40,.06);
      display:flex;
      align-items:center;
      justify-content:space-between;
      flex-wrap:wrap;
      gap:.65rem;
      margin-top:1.5rem !important;
    }
    .main-content .nla-quick-group{ display:flex; flex-wrap:wrap; align-items:center; gap:.5rem; }
    .main-content .nla-quick-label{
      font-size:.7rem;
      font-weight:600;
      text-transform:uppercase;
      letter-spacing:.04em;
      color:var(--nla-muted);
      margin-right:.25rem;
    }
    .main-content .nla-main-actions{ display:flex; gap:.5rem; flex-wrap:wrap; }
    .main-content .btn-nla-teal{
      background:var(--nla-teal); border-color:var(--nla-teal); color:#fff;
    }
    .main-content .btn-nla-teal:hover{ background:#176255; border-color:#176255; color:#fff; }
    .main-content .btn-nla-navy{
      background:var(--nla-navy); border-color:var(--nla-navy); color:#fff;
    }
    .main-content .btn-nla-navy:hover{ background:var(--nla-navy-deep); border-color:var(--nla-navy-deep); color:#fff; }

    /* ---- Dynamic bracket button ---- */
    .main-content .nla-bracket-btn-wrap{ display:flex; align-items:center; gap:.5rem; }
    #btnViewBracket{
      transition: opacity .2s ease, transform .15s ease;
    }
    #btnViewBracket.nla-btn-appear{
      animation: nla-pop-in .2s ease forwards;
    }
    @keyframes nla-pop-in{
      from{ opacity:0; transform:scale(.92); }
      to{ opacity:1; transform:scale(1); }
    }

    /* ---- Modals ---- */
    #employeeModal,
    #bracketModal{
      font-family:'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    }

    #employeeModal .modal-content,
    #bracketModal .modal-content{
      border-radius:.65rem;
      border:none;
      box-shadow: 0 12px 32px rgba(15,34,51,.18);
    }

    #employeeModal .modal-header,
    #bracketModal .modal-header{
      background-color:#fff !important;
      border-bottom:1px solid var(--nla-border) !important;
      padding:.85rem 1.15rem;
    }

    #employeeModal .modal-title,
    #bracketModal .modal-title{
      display:flex;
      align-items:center;
      gap:.55rem;
      color:var(--nla-navy-deep) !important;
      font-weight:600;
      font-size:1rem;
    }
    #employeeModal .modal-title i,
    #bracketModal .modal-title i{ color:var(--nla-blue) !important; }

    #employeeModal .modal-body,
    #bracketModal .modal-body{ padding:1.15rem; }

    #employeeModal .form-control,
    #employeeModal .input-group-text{
      border-color:var(--nla-border);
    }
    #employeeModal .form-control:focus{
      border-color:var(--nla-blue);
      box-shadow:0 0 0 .2rem rgba(46,111,158,.12);
    }

    #employeeModal .table,
    #bracketModal .table{
      --bs-table-border-color: var(--nla-border);
    }
    #employeeModal .table thead th,
    #bracketModal .table thead th{
      background:var(--nla-navy-deep);
      font-size:.7rem;
      text-transform:uppercase;
      letter-spacing:.04em;
      color:var(--nla-surface);
      border-bottom:1px solid var(--nla-border);
      font-weight:600;
      white-space:nowrap;
      position: sticky;   /* ← ADD */
      top: 0;              /* ← ADD */
      z-index: 1;           /* ← ADD — keeps header above scrolling body rows */
    }
    #employeeModal .table tbody td,
    #bracketModal .table tbody td{ vertical-align:middle; }
    #employeeModal .table tbody tr:hover,
    #bracketModal .table tbody tr:hover{ background:var(--nla-bg); }

    #employeeModal .btn-outline-primary{
      color:var(--nla-blue);
      border-color:var(--nla-blue);
    }
    #employeeModal .btn-outline-primary:hover{
      background:var(--nla-blue);
      border-color:var(--nla-blue);
      color:#fff;
    }

    /* Bracket modal specifics */
    #bracketModal .modal-dialog{ 
      max-width: 92%;
      width: 92%;
      margin: 1.75rem auto;
    }
    #bracketModal .nla-bracket-loading{
      display:flex;
      align-items:center;
      justify-content:center;
      gap:.6rem;
      padding:2rem;
      color:var(--nla-muted);
      font-size:.9rem;
    }
    #bracketModal .nla-bracket-error{
      padding:1.5rem;
      text-align:center;
      color:var(--nla-danger);
      font-size:.9rem;
    }
    #bracketModal .table-responsive{
      max-height:420px;
      overflow-y:auto;
      overflow-x: hidden;
    }
    #bracketModal .table tbody td{
      font-size:.85rem;
      font-variant-numeric:tabular-nums;
    }

    /* Sako Pettycash bracket: cell-level hover only, no row highlight */
#bracketModal table.nla-no-row-hover tbody tr:hover {
  background: transparent;
}
#bracketModal td.nla-bracket-cell:hover {
  background: var(--nla-blue);
  color: #fff;
  cursor: pointer;
}
    /* ---- Existing Loan / Eligibility Modal ---- */
    #existingLoanModal .modal-content{
      border-radius:.65rem;
      border:none;
      box-shadow:0 12px 32px rgba(15,34,51,.18);
      font-family:'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    }
    #existingLoanModal .modal-header{
      background:#fff !important;
      border-bottom:1px solid var(--nla-border) !important;
      padding:.85rem 1.15rem;
    }
    #existingLoanModal .modal-title{
      display:flex; align-items:center; gap:.55rem;
      color:var(--nla-navy-deep) !important;
      font-weight:600; font-size:1rem;
    }
    #existingLoanModal .modal-title i{ color:var(--nla-gold); }
    #existingLoanModal.is-not-eligible .modal-title i{ color:var(--nla-danger); }
    #existingLoanModal .modal-body{ padding:1.15rem; }

    #existingLoanModal .nla-alert-box{
      border-left:4px solid var(--nla-gold);
      border-radius:.55rem;
      background:#FBF3E8;
      font-size:.9rem;
      color:var(--nla-navy-deep);
      padding:.85rem 1rem;
    }
    #existingLoanModal.is-not-eligible .nla-alert-box{
      border-left-color:var(--nla-danger);
      background:#FBEDEB;
    }

    #existingLoanModal .nla-detail-card{
      border:1px solid var(--nla-border);
      border-radius:.65rem;
      background:var(--nla-surface);
      margin-top:1rem;
    }
    #existingLoanModal .nla-detail-card .card-header{
      background:#fff;
      border-bottom:1px solid var(--nla-border);
      padding:.7rem 1.05rem;
      border-radius:.65rem .65rem 0 0;
      display:flex; align-items:center; gap:.5rem;
    }
    #existingLoanModal .nla-detail-card .card-header strong{
      color:var(--nla-navy-deep); font-weight:600; font-size:.9rem;
    }
    #existingLoanModal .nla-detail-card .card-header i{ color:var(--nla-blue); }
    #existingLoanModal .nla-detail-card .card-body{ padding:1rem 1.05rem; }

    #existingLoanModal table td{ font-size:.85rem; padding:.35rem .25rem; }
    #existingLoanModal table td.fw-bold{
      color:var(--nla-muted); font-weight:600 !important;
      font-size:.78rem; text-transform:uppercase; letter-spacing:.03em;
    }
    #existingLoanModal table td:not(.fw-bold){ color:var(--nla-navy-deep); font-weight:600; }

    #existingLoanModal .badge{ font-weight:600; font-size:.72rem; padding:.3rem .6rem; border-radius:.4rem; }
    #existingLoanModal .badge.nla-badge-approved      { background:var(--nla-teal);   color:#fff; }
    #existingLoanModal .badge.nla-badge-cancelled     { background:var(--nla-gold);   color:#fff; }
    #existingLoanModal .badge.nla-badge-disapproved   { background:var(--nla-danger); color:#fff; }
    #existingLoanModal .badge.nla-badge-pending       { background:var(--nla-slate);  color:#fff; }
    #existingLoanModal .badge.nla-badge-signature     { background:var(--nla-violet); color:#fff; }
    #existingLoanModal .badge.nla-badge-hold          { background:var(--nla-rust);   color:#fff; }
    #existingLoanModal .badge.nla-badge-verification  { background:var(--nla-indigo); color:#fff; }
    #existingLoanModal .badge.nla-badge-not-eligible  { background:var(--nla-danger); color:#fff; }

    /* Pagination styles */
    #pageNumbers span {
      padding: 0.25rem 0.5rem;
      border-radius: 0.25rem;
      transition: all 0.2s ease;
    }
    #pageNumbers span:hover:not(.fw-bold) {
      background-color: var(--nla-bg);
    }
    #pageNumbers .fw-bold {
      background-color: var(--nla-blue);
      color: white !important;
    }
    #resultCount {
      font-size: 0.85rem;
    }

    #eligibilityErrorModal .modal-header {
      background: #dc3545 !important;
      color: white !important;
    }

    #eligibilityErrorModal .modal-header .modal-title {
      color: white !important;
    }

    #eligibilityErrorModal .btn-close-white {
      filter: brightness(0) invert(1);
    }

    #eligibilityErrorModal .alert-danger {
      background-color: #f8d7da;
      border-color: #f5c6cb;
      color: #721c24;
    }

    #eligibilityErrorModal .alert-danger p {
      margin-bottom: 0.5rem;
    }

    /* Co-maker search modal styles */
    #comakerSearchModal .modal-header {
      background-color: #f8f9fa;
    }

    #comakerSearchModal .table thead th {
      background: var(--nla-navy-deep);
      color: white;
      font-size: 0.72rem;
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }

    #comakerSearchModal .table tbody tr {
      cursor: pointer;
    }

    #comakerSearchModal .table tbody tr:hover {
      background-color: var(--nla-bg);
    }

    #comakerEligibilityErrorModal .modal-header {
      background: #dc3545 !important;
      color: white !important;
    }

    #comakerEligibilityErrorModal .modal-header .modal-title {
      color: white !important;
    }

    #comakerEligibilityErrorModal .btn-close-white {
      filter: brightness(0) invert(1);
    }

    /* Success Modal Styles */
    #successModal .modal-content {
      border: none;
      border-radius: 0.65rem;
      box-shadow: 0 12px 32px rgba(15, 34, 51, 0.18);
    }

    #successModal .modal-header {
      border-radius: 0.65rem 0.65rem 0 0;
    }

    #successModal .badge.bg-primary {
      background: var(--nla-blue) !important;
      font-weight: 600;
      padding: 0.5rem 1rem;
    }

    #successModal .card.bg-light {
      background: var(--nla-bg) !important;
      border-radius: 0.5rem;
    }

    #successModal .card-body {
      padding: 1rem;
    }

    #successModal .btn-success {
      background: var(--nla-teal);
      border-color: var(--nla-teal);
      min-width: 120px;
      padding: 0.5rem 2rem;
      font-weight: 600;
    }

    #successModal .btn-success:hover {
      background: #176255;
      border-color: #176255;
    }

    @keyframes nla-success-pop {
      0% {
        transform: scale(0.8);
        opacity: 0;
      }
      50% {
        transform: scale(1.05);
      }
      100% {
        transform: scale(1);
        opacity: 1;
      }
    }

    #successModal .fa-check-circle {
      animation: nla-success-pop 0.5s ease forwards;
    }

    /* Employee Search Modal - New styles */
    #employeeModal .search-filters .form-label {
      font-size: 0.7rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      color: var(--nla-muted);
      margin-bottom: 0.2rem;
    }

    #employeeModal .search-filters .form-control,
    #employeeModal .search-filters .form-select {
      font-size: 0.85rem;
      padding: 0.35rem 0.65rem;
      border-color: var(--nla-border);
    }

    #employeeModal .search-filters .form-control:focus,
    #employeeModal .search-filters .form-select:focus {
      border-color: var(--nla-blue);
      box-shadow: 0 0 0 0.2rem rgba(46, 111, 158, 0.12);
    }

    #employeeModal .search-filters .input-group-text {
      background: var(--nla-bg);
      border-color: var(--nla-border);
      font-size: 0.85rem;
    }

    #employeeModal .btn-nla-navy {
      background: var(--nla-navy);
      border: 1px solid var(--nla-navy);
      color: #fff;
      padding: 0.35rem 0.65rem;
      font-size: 0.875rem;
      border-radius: 0.375rem;
      font-weight: 500;
      transition: all 0.2s ease;
      height: 38px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.25rem;
    }

    #employeeModal .btn-nla-navy:hover {
      background: var(--nla-navy-deep);
      border-color: var(--nla-navy-deep);
      color: #fff;
    }

    #employeeModal .btn-nla-navy:focus {
      box-shadow: 0 0 0 0.2rem rgba(22, 48, 74, 0.25);
    }

    #employeeModal .btn-nla-navy i {
      font-size: 0.85rem;
    }

    #employeeModal .btn-link {
      color: var(--nla-muted);
      text-decoration: none;
      font-size: 0.8rem;
      padding: 0.25rem 0.5rem;
    }

    #employeeModal .btn-link:hover {
      color: var(--nla-navy);
      text-decoration: underline;
    }

    #employeeModal .form-label {
      font-size: 0.7rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      color: var(--nla-muted);
      margin-bottom: 0.2rem;
    }

    #employeeModal .form-control,
    #employeeModal .form-select {
      font-size: 0.85rem;
      padding: 0.35rem 0.65rem;
      border-color: var(--nla-border);
      border-radius: 0.375rem;
      height: 38px;
    }

    #employeeModal .form-control:focus,
    #employeeModal .form-select:focus {
      border-color: var(--nla-blue);
      box-shadow: 0 0 0 0.2rem rgba(46, 111, 158, 0.12);
    }

    #employeeModal .search-filters {
      background: var(--nla-bg);
      padding: 1rem;
      border-radius: 0.5rem;
      border: 1px solid var(--nla-border);
    }

    #employeeModal .search-filters .row {
      align-items: flex-end;
    }

    /* ---- Bonus Percentage Toggle ---- */
    .main-content #bonusPercentageRow{
      margin-top:.75rem;
    }
    .main-content #bonusPercentageRow .form-label{
      font-size:.75rem;
      font-weight:600;
      color:var(--nla-navy);
      margin-bottom:.4rem;
    }
    .main-content #bonusPercentageRow .btn-group{
      background:var(--nla-bg);
      border:1px solid var(--nla-border);
      border-radius:.55rem;
      padding:.25rem;
      gap:.25rem;
    }
    .main-content #bonusPercentageRow .btn-check + label.btn{
      border:1px solid transparent;
      border-radius:.4rem !important;
      background:transparent;
      color:var(--nla-muted);
      font-size:.85rem;
      font-weight:600;
      padding:.5rem .75rem;
      transition:all .18s ease;
      box-shadow:none !important;
    }
    .main-content #bonusPercentageRow .btn-check + label.btn:hover{
      background:rgba(46,111,158,.08);
      color:var(--nla-navy-deep);
    }
    .main-content #bonusPercentageRow .btn-check:checked + label.btn{
      background:var(--nla-navy);
      border-color:var(--nla-navy);
      color:#fff;
    }
    .main-content #bonusPercentageRow .btn-check:focus + label.btn{
      box-shadow:0 0 0 .2rem rgba(46,111,158,.18) !important;
    }
    /* Give the "Half (50%)" option a subtle gold accent when active, to visually distinguish it from Full */
    .main-content #bonusPercentageRow #bonusHalf:checked + label.btn{
      background:var(--nla-gold);
      border-color:var(--nla-gold);
    }
  </style>
</head>

<body>

<div class="dashboard-container">

  {{> header}}

  <div class="main-content">

    <div class="container-fluid px-4 py-3">

      <!-- PAGE HEADER -->
      <div class="nla-page-head">
        <div>
          <h1 class="nla-title"><i class="fas fa-hand-holding-usd"></i> New Loan Application</h1>
          <p class="nla-subtitle">Search the employee, review the computation, and save to print the application.</p>
        </div>
      </div>

      <div class="nla-flow">

        <!-- =========================
             STEP 1: SEARCH EMPLOYEE BUTTON
        ========================== -->
        <div class="card nla-card mb-0">
          <div class="card-header">
            <i class="fas fa-user-search"></i>
            <strong>Employee Selection</strong>
          </div>

          <div class="card-body">

            <div class="row g-2 align-items-end">
              <div class="col-md-12">
                <button type="button" class="btn btn-nla-navy" id="btnSearchEmployee">
                  <i class="fas fa-search me-1"></i> Search Employee
                </button>
                <p class="nla-help mt-2"><i class="fas fa-circle-info me-1"></i>Click the button to search for an employee by Office, Last Name, or First Name.</p>
              </div>
            </div>

          </div>
        </div>

        <!-- =========================
             STEP 2: EMPLOYEE INFO
        ========================== -->
        <div class="card nla-card mb-0">
          <div class="card-header">
            <i class="fas fa-id-badge"></i>
            <strong>Employee Information</strong>
          </div>

          <div class="card-body">

            <div class="nla-profile">

              <div class="nla-avatar"><i class="fas fa-user"></i></div>

              <div class="nla-profile-grid">

                <div>
                  <span class="nla-field-label">ID No.</span>
                  <span class="nla-field-value" id="empIdno">---</span>
                </div>

                <div>
                  <span class="nla-field-label">Last Name</span>
                  <span class="nla-field-value" id="empLast">---</span>
                </div>

                <div>
                  <span class="nla-field-label">First Name</span>
                  <span class="nla-field-value" id="empFirst">---</span>
                </div>

                <div>
                  <span class="nla-field-label">Middle Name</span>
                  <span class="nla-field-value" id="empMiddle">---</span>
                </div>

                <div>
                  <span class="nla-field-label">Region</span>
                  <span class="nla-field-value" id="empRegion">---</span>
                </div>

                <div>
                  <span class="nla-field-label">Area</span>
                  <span class="nla-field-value" id="empArea">---</span>
                </div>

                <div>
                  <span class="nla-field-label">Branch</span>
                  <span class="nla-field-value" id="empBranch">---</span>
                </div>

                <div>
                  <span class="nla-field-label">Length of Service</span>
                  <span class="nla-field-value" id="empLos">---</span>
                </div>

              </div>

            </div>

          </div>
        </div>

        <!-- =========================
             STEP 3: LOAN DETAILS
        ========================== -->
        <div class="card nla-card mb-0">
          <div class="card-header">
            <i class="fas fa-file-invoice-dollar"></i>
            <strong>Loan Details</strong>
          </div>

          <div class="card-body">

            <div class="row g-2">

              <div class="col-md-6">
                <label class="form-label">Loan Type</label>
                <select class="form-select" id="loanType" disabled>
                  <option value="">Select Loan Type</option>
                  {{#each loan_types}}
                    <option value="{{loanname}}">
                      {{loanname}}
                    </option>
                  {{/each}}
                </select>
              </div>

              <div class="col-md-6">
                <label class="form-label">Loan Amount</label>
                <div class="input-group">
                  <span class="input-group-text">₱</span>
                  <input type="text" class="form-control" id="loanAmount" placeholder="0.00" disabled>
                </div>
              </div>

            </div>
            <div class="row g-2 mt-2 d-none" id="bonusPercentageRow">
  <div class="col-12">
    <label class="form-label"><i class="fas fa-percent me-1"></i>Bonus Amount</label>
    <div class="btn-group w-100" role="group">
      <input type="radio" class="btn-check" name="bonusPercentage" id="bonusFull" value="0.80" checked>
      <label class="btn btn-outline-primary" for="bonusFull">Full Amount (80%)</label>
      <input type="radio" class="btn-check" name="bonusPercentage" id="bonusHalf" value="0.50">
      <label class="btn btn-outline-primary" for="bonusHalf">Half (50%)</label>
    </div>
  </div>
</div>

<div class="row g-2 mt-2 d-none" id="monthsToPayRow">
  <div class="col-12">
    <label class="form-label"><i class="fas fa-calendar-alt me-1"></i>Months to Pay</label>
    <select class="form-select" id="monthsToPay">
      <option value="">Select number of months</option>
    </select>
  </div>
</div>

            <div class="nla-compute-panel">

              <div class="nla-compute-row">
                <span class="nla-compute-label">Existing Loan</span>
                <input type="text" class="nla-compute-value" id="existingLoan">
              </div>

              <div class="nla-compute-row">
                <span class="nla-compute-label">Loan Deduction</span>
                <input type="text" class="nla-compute-value" id="loanDeduction">
              </div>

              <div class="nla-compute-divider"></div>

              <div class="nla-compute-row nla-net-row">
                <span class="nla-compute-label">Net Proceeds</span>
                <input type="text" class="nla-net-value" id="netProceeds" readonly>
              </div>

            </div>

          </div>
        </div>

        <!-- =========================
             STEP 4: COMAKERS
        ========================== -->
        <div class="card nla-card mb-0" id="comakerCard">
          <div class="card-header d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center gap-2">
              <i class="fas fa-user-friends"></i>
              <strong>Co-Makers</strong>
            </div>
            <span class="nla-comaker-count" id="comakerCount">0 of 4 added</span>
          </div>

          <div class="card-body">

            <div class="row g-3" id="comakerFields">

              <div class="col-md-3 comaker-field d-none">
                <label class="nla-comaker-label">Co-Maker 1</label>
                <div class="input-group">
                  <input class="form-control" placeholder="Click to search co-maker">
                  <button type="button" class="btn btn-outline-secondary nla-comaker-remove" aria-label="Remove Co-Maker 1">
                    <i class="fas fa-xmark"></i>
                  </button>
                </div>
              </div>

              <div class="col-md-3 comaker-field d-none">
                <label class="nla-comaker-label">Co-Maker 2</label>
                <div class="input-group">
                  <input class="form-control" placeholder="Click to search co-maker">
                  <button type="button" class="btn btn-outline-secondary nla-comaker-remove" aria-label="Remove Co-Maker 2">
                    <i class="fas fa-xmark"></i>
                  </button>
                </div>
              </div>

              <div class="col-md-3 comaker-field d-none">
                <label class="nla-comaker-label">Co-Maker 3</label>
                <div class="input-group">
                  <input class="form-control" placeholder="Click to search co-maker">
                  <button type="button" class="btn btn-outline-secondary nla-comaker-remove" aria-label="Remove Co-Maker 3">
                    <i class="fas fa-xmark"></i>
                  </button>
                </div>
              </div>

              <div class="col-md-3 comaker-field d-none">
                <label class="nla-comaker-label">Co-Maker 4</label>
                <div class="input-group">
                  <input class="form-control" placeholder="Click to search co-maker">
                  <button type="button" class="btn btn-outline-secondary nla-comaker-remove" aria-label="Remove Co-Maker 4">
                    <i class="fas fa-xmark"></i>
                  </button>
                </div>
              </div>

            </div>

            <button type="button" class="btn btn-outline-primary btn-sm mt-2" id="btnAddComaker" disabled>
              <i class="fas fa-plus me-1"></i> Add Co-Maker
            </button>

            <p class="nla-help mb-0">Add up to 4 co-makers for this loan. Click the <strong>×</strong> on a field to remove it.</p>

          </div>
        </div>

        <!-- =========================
             CO-MAKER SEARCH MODAL
        ========================== -->
        <div id="comakerSearchModal" class="modal fade" tabindex="-1" aria-hidden="true" aria-labelledby="comakerSearchModalLabel">
          <div class="modal-dialog modal-xl">
            <div class="modal-content">
              <div class="modal-header">
                <h5 class="modal-title" id="comakerSearchModalLabel">
                  <i class="fas fa-user-plus me-2"></i> Search Co-Maker
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
              </div>
              <div class="modal-body">
                <!-- Search Filters -->
                <div class="row g-2 mb-3">
                  <div class="col-md-3">
                    <label class="form-label small">Search By</label>
                    <select class="form-select form-select-sm" id="comakerSearchField">
                      <option value="all">All Fields</option>
                      <option value="idno">ID No.</option>
                      <option value="lastname" selected>Last Name</option>
                      <option value="firstname">First Name</option>
                    </select>
                  </div>
                  <div class="col-md-7">
                    <label class="form-label small">Search Query</label>
                    <input type="text" id="comakerSearchInput" class="form-control"
                           placeholder="Search by ID, Last Name, or First Name">
                  </div>
                  <div class="col-md-2 d-flex align-items-end">
                    <button class="btn btn-nla-navy w-100" id="comakerSearchBtn">
                      <i class="fas fa-search me-1"></i> Search
                    </button>
                  </div>
                </div>

                <div class="alert alert-info small">
                  <i class="fas fa-info-circle me-1"></i>
                  Co-maker must meet the same length of service requirements as the borrower.
                  The borrower (ID: <span id="comakerBorrowerId"></span>) 
                  will be excluded from search results.
                </div>

                <!-- Results count -->
                <div class="d-flex justify-content-between align-items-center mb-2">
                  <span id="comakerResultCount" class="text-muted small">0 results found</span>
                  <span id="comakerPageInfo" class="text-muted small"></span>
                </div>

                <!-- Results Table -->
                <div class="table-responsive">
                  <table class="table table-hover align-middle">
                    <thead>
                      <tr>
                        <th>ID No</th>
                        <th>Last Name</th>
                        <th>First Name</th>
                        <th>Middle Name</th>
                        <th>Region</th>
                        <th>Branch</th>
                        <th>Length of Service</th>
                        <th>Select</th>
                      </tr>
                    </thead>
                    <tbody id="comakerSearchResults">
                      <tr>
                        <td colspan="8" class="text-center text-muted py-3">
                          Type a search query and click Search to find co-makers.
                        </td>
                      </tr>
                    </tbody>
                  </table>
                </div>

                <!-- Pagination -->
                <div class="d-flex justify-content-between align-items-center mt-3">
                  <button class="btn btn-outline-secondary btn-sm" id="comakerPrevPage" disabled>
                    <i class="fas fa-chevron-left"></i> Previous
                  </button>
                  <span id="comakerPageNumbers" class="small"></span>
                  <button class="btn btn-outline-secondary btn-sm" id="comakerNextPage" disabled>
                    Next <i class="fas fa-chevron-right"></i>
                  </button>
                </div>
              </div>
            </div>
          </div>
        </div>

      </div>

      <!-- =========================
           ACTION BAR
      ========================== -->
      <div class="nla-action-bar mt-3">

        <!-- Dynamic bracket button -->
        <div class="nla-bracket-btn-wrap">
          <span class="nla-quick-label" id="bracketBtnLabel" style="display:none;">Loan Table</span>
          <button type="button" class="btn btn-outline-primary btn-sm d-none" id="btnViewBracket">
            <i class="fas fa-table me-1" id="bracketBtnIcon"></i>
            <span id="bracketBtnText">View Table</span>
          </button>
        </div>

        <div class="nla-main-actions">

          <button type="reset" class="btn btn-outline-secondary" id="btnClear">
            <i class="fas fa-eraser me-1"></i> Clear
          </button>

          <button type="button" class="btn btn-nla-navy" id="btnSavePrint" disabled="true">
            <i class="fas fa-print me-1"></i> Save / Print
          </button>

        </div>

      </div>

    </div>
  </div>
</div>

<!-- =========================
     EMPLOYEE SEARCH MODAL
========================== -->
<div id="employeeModal" class="modal fade" tabindex="-1" aria-hidden="true" aria-labelledby="employeeModalLabel">
  <div class="modal-dialog modal-xl">

    <div class="modal-content">

      <div class="modal-header">
        <h5 class="modal-title" id="employeeModalLabel">
          <i class="fas fa-magnifying-glass"></i> Search Employee
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>

      <div class="modal-body">

        <!-- Search Filters -->
        <div class="search-filters">
          <div class="row g-2 mb-3">
            <!-- Office Selection -->
            <div class="col-md-3">
              <label class="form-label">Office</label>
              <select class="form-select" id="officeSelectModal">
                <option value="" disabled selected>Select Office</option>
                {{#each offices}}
                  <option value="{{office_name}}">
                    {{office_name}}
                  </option>
                {{/each}}
              </select>
            </div>

            <!-- Last Name -->
            <div class="col-md-3">
              <label class="form-label">Last Name</label>
              <input type="text" id="searchLastName" class="form-control" placeholder="Enter last name">
            </div>

            <!-- First Name -->
            <div class="col-md-3">
              <label class="form-label">First Name</label>
              <input type="text" id="searchFirstName" class="form-control" placeholder="Enter first name">
            </div>

            <!-- Search Button -->
            <div class="col-md-3 d-flex align-items-end">
              <button class="btn btn-nla-navy w-100" id="btnSearch" style="height: 38px;">
                <i class="fas fa-search me-1"></i> Search
              </button>
            </div>
          </div>

          <!-- Clear filters link -->
          <div class="text-end mb-2">
            <button type="button" class="btn btn-link btn-sm text-muted" id="clearSearchFilters">
              <i class="fas fa-undo me-1"></i> Clear Filters
            </button>
          </div>
        </div>

        <!-- Results count -->
        <div class="d-flex justify-content-between align-items-center mb-2">
          <span id="resultCount" class="text-muted small">0 results found</span>
          <span id="pageInfo" class="text-muted small"></span>
        </div>

        <!-- Results Table -->
        <div class="table-responsive">
          <table class="table table-hover align-middle">
            <thead>
              <tr>
                <th>ID No</th>
                <th>Last Name</th>
                <th>First Name</th>
                <th>Branch</th>
                <th>Region</th>
                <th>Select</th>
              </tr>
            </thead>
            <tbody id="searchResults"></tbody>
          </table>
        </div>

        <!-- Pagination -->
        <div class="d-flex justify-content-between align-items-center mt-3">
          <button class="btn btn-outline-secondary btn-sm" id="prevPage" disabled>
            <i class="fas fa-chevron-left"></i> Previous
          </button>
          <span id="pageNumbers" class="small"></span>
          <button class="btn btn-outline-secondary btn-sm" id="nextPage" disabled>
            Next <i class="fas fa-chevron-right"></i>
          </button>
        </div>

      </div>

    </div>

  </div>
</div>

<!-- =========================
     LOAN BRACKET MODAL
========================== -->
<div id="bracketModal" class="modal fade" tabindex="-1" aria-hidden="true" aria-labelledby="bracketModalLabel">
  <div class="modal-dialog modal-xl">

    <div class="modal-content">

      <div class="modal-header">
        <h5 class="modal-title" id="bracketModalLabel">
          <i class="fas fa-table" id="bracketModalIcon"></i>
          <span id="bracketModalTitle">Loan Table</span>
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>

      <div class="modal-body">
        <div id="bracketModalBody">
          <!-- Populated dynamically -->
        </div>
      </div>

    </div>

  </div>
</div>

<!-- =========================
     EXISTING LOAN WARNING MODAL
========================== -->
<div id="existingLoanModal" class="modal fade" tabindex="-1" aria-hidden="true" aria-labelledby="existingLoanModalLabel">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">

      <div class="modal-header">
        <h5 class="modal-title" id="existingLoanModalLabel">
          <i class="fas fa-exclamation-triangle"></i>
          <span id="existingLoanWarningTitle">Loan Already Processed</span>
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>

      <div class="modal-body">

        <div class="nla-alert-box" role="alert">
          <i class="fas fa-circle-info me-2"></i>

          <span id="warningExistingMsg">
            <strong id="warningEmployeeName">Employee Name</strong> already has a
            <strong id="warningLoanType">Loan Type</strong> loan on file.
          </span>

          <span id="warningNotEligibleMsg" class="d-none">
            <strong id="neEmployeeName">Employee Name</strong> is not eligible for
            <strong id="neLoanType">Loan Type</strong>.
            <div class="mt-2">
              <strong>Length of service:</strong> <span id="neServiceYears">0</span> year(s)
              &nbsp;·&nbsp;
              <strong>Required:</strong> <span id="neRequiredYears">0</span> year(s) minimum
            </div>
          </span>
        </div>

        <div class="nla-detail-card">
          <div class="card-header">
  <i class="fas fa-file-invoice-dollar"></i>
  <strong>Loan Details</strong>
  <span class="nla-locked-hint ms-2" id="loanDetailsHint">
    <i class="fas fa-lock me-1"></i>Select an employee first
  </span>
</div>
          <div class="card-body">
            <div class="row">
              <div class="col-md-6">
                <table class="table table-sm table-borderless mb-0">
                  <tr><td class="fw-bold" style="width:40%;">Control No.</td><td id="existingControlNo">---</td></tr>
                  <tr><td class="fw-bold">Employee</td><td id="existingEmployeeName">---</td></tr>
                  <tr><td class="fw-bold">Loan Type</td><td id="existingLoanTypeDisplay">---</td></tr>
                  <tr><td class="fw-bold">Loan Amount</td><td id="existingLoanAmount">---</td></tr>
                  <tr><td class="fw-bold">Monthly Deduction</td><td id="existingLoanDeduction">---</td></tr>
                </table>
              </div>
              <div class="col-md-6">
                <table class="table table-sm table-borderless mb-0">
                  <tr><td class="fw-bold" style="width:40%;">Date Processed</td><td id="existingDateReceived">---</td></tr>
                  <tr><td class="fw-bold">Date Approved</td><td id="existingDateApproved">---</td></tr>
                  <tr><td class="fw-bold">Status</td><td><span class="badge nla-badge-approved" id="existingStatus">Approved</span></td></tr>
                  <tr><td class="fw-bold">Prepared By</td><td id="existingPreparedBy">---</td></tr>
                  <tr><td class="fw-bold">Co-Makers</td><td id="existingCoMakers">None</td></tr>
                </table>
              </div>
            </div>
          </div>
        </div>

        <div class="mt-4 d-flex justify-content-end gap-2">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
            <i class="fas fa-times me-1"></i> Close
          </button>
          <button type="button" class="btn btn-nla-navy" id="btnViewExistingLoan">
            <i class="fas fa-eye me-1"></i> View Full Details
          </button>
        </div>

      </div>
    </div>
  </div>
</div>

<!-- =========================
     SUCCESS MODAL
========================== -->
<div id="successModal" class="modal fade" tabindex="-1" aria-hidden="true" aria-labelledby="successModalLabel" data-bs-backdrop="static">
  <div class="modal-dialog modal-md modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header" style="background: #28a745; color: white; border-radius: 0.65rem 0.65rem 0 0;">
        <h5 class="modal-title" id="successModalLabel">
          <i class="fas fa-check-circle me-2"></i> Loan Saved Successfully!
        </h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <!-- Success Icon -->
        <div class="text-center mb-3">
          <i class="fas fa-check-circle" style="font-size: 64px; color: #28a745;"></i>
        </div>
        
        <!-- Control Number -->
        <div class="text-center mb-3">
          <span class="badge bg-primary fs-6 p-2">
            <i class="fas fa-hashtag me-1"></i> Control No: <strong id="successControlNo">---</strong>
          </span>
        </div>
        
        <!-- Loan Details -->
        <div class="card border-0 bg-light">
          <div class="card-body">
            <div class="row g-2">
              <div class="col-6">
                <small class="text-muted d-block">Loan Type</small>
                <strong id="successLoanType">---</strong>
              </div>
              <div class="col-6">
                <small class="text-muted d-block">Loan Amount</small>
                <strong id="successLoanAmount">---</strong>
              </div>
              <div class="col-6">
                <small class="text-muted d-block">Employee Name</small>
                <strong id="successEmployeeName">---</strong>
              </div>
              <div class="col-6">
                <small class="text-muted d-block">Net Proceeds</small>
                <strong id="successNetProceeds" style="color: #28a745;">---</strong>
              </div>
              <div class="col-12">
                <small class="text-muted d-block">Prepared By</small>
                <strong id="successPreparedBy">---</strong>
              </div>
              <div class="col-12">
                <small class="text-muted d-block">Date</small>
                <strong id="successDate">---</strong>
              </div>
            </div>
          </div>
        </div>
        
        <!-- Co-makers (if any) -->
        <div id="successCoMakersContainer" class="mt-2" style="display: none;">
