  // ─────────────────────────────────────────────
  // 3. CALCULATE EXISTING LOAN TOTAL
  // ─────────────────────────────────────────────
  function calculateExistingLoanTotal(payrollRecords, loanType = null) {
    console.log('💰 calculateExistingLoanTotal called with:', {
      recordCount: payrollRecords?.length || 0,
      loanType: loanType
    });

    if (!payrollRecords || payrollRecords.length === 0) {
      console.log('⚠️ No payroll records found');
      return 0;
    }

    // ── NEW: Sako loans never carry an existing-loan balance ──
  if (loanType && String(loanType).toLowerCase().includes('sako')) {
    console.log('💰 Sako loan type detected — existing loan forced to 0');
    return 0;
  }

    const LOAN_FIELDS = {
      'ml fund regular': ['mlfund_regular'],
      'ml fund regular reloan': ['mlfund_regular'],
      'ml fund pettycash': ['mlfund_pcl'],
      'ml fund pettycash reloan': ['mlfund_pcl'],
      'ml fund jewelry loan': ['mlfund_jewelry'],
      'ml fund o.p.i.': ['mlfund_opi'],
      'ml fund a.l.l. bonus': ['mlfund_all_buyout'],
      'ml fund 13th month': ['mlfund_13th_month'],
      'ml lending motor loan': ['motor_loan'], // NEW
      'ml fund emergency': ['mlfund_emergency'],
            'sako maxi': ['sako'],
      'sako pettycash': ['sako'],
      'sako emergency': ['sako'],
      'sako preferential': ['sako'],
      'sako commodity': ['sako'],
      'sako retirement': ['sako'],
      'sako 13th month': ['sako'],
      'sako a.l.l. bonus': ['sako'],
      'sss': ['sssloan'],
      'pagibig': ['pagibigloan']
    };

    let fieldsToSum = [];
    
    if (loanType) {
      const normalizedType = loanType.toLowerCase().trim();
      
      if (LOAN_FIELDS[normalizedType]) {
        fieldsToSum = LOAN_FIELDS[normalizedType];
      } else {
        if (normalizedType.includes('ml fund')) {
          const matchedKey = Object.keys(LOAN_FIELDS).find(key => 
            normalizedType.includes(key.replace('ml fund', '').trim()) || 
            key === normalizedType
          );
          if (matchedKey) {
            fieldsToSum = LOAN_FIELDS[matchedKey];
          } else {
            fieldsToSum = ['mlfund_total'];
          }
        } else if (normalizedType.includes('sako')) {
          fieldsToSum = ['sako'];
        } else {
          console.warn('⚠️ Unknown loan type for existing loan calculation:', loanType);
          return 0;
        }
      }
    } else {
      console.log('ℹ️ No loan type specified for existing loan calculation');
      return 0;
    }

    console.log('📊 Fields to sum for loan type "' + loanType + '":', fieldsToSum);

    let totalExistingLoan = 0;
    
    payrollRecords.forEach((record, index) => {
      const recordTotal = fieldsToSum.reduce((sum, field) => {
        const value = parseFloat(record[field]) || 0;
        return sum + value;
      }, 0);

      console.log(`  - Record ${index + 1}: ${fieldsToSum.join(' + ')} = ${recordTotal}`);
      totalExistingLoan += recordTotal;
    });

    console.log(`💰 Total existing loan for "${loanType}":`, totalExistingLoan);
    return totalExistingLoan;
  }

