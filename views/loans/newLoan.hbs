    <div class="alert alert-danger text-start mb-0">
      <p class="mb-0"><strong>Length of Service:</strong> ${los} year(s) — minimum required: 5 years</p>
    </div>
  `;

  bootstrap.Modal.getOrCreateInstance(modalEl).show();
}
}); // END DOMContentLoaded
</script>

