      addBtn.classList.toggle('d-none', count >= maxFields);
    }

    function revealNext() {
      var next = fields.filter(function (f) { return f.classList.contains('d-none'); })[0];
      if (!next) return;

      next.classList.remove('d-none');
      next.classList.add('nla-fade-init');

      requestAnimationFrame(function () {
        requestAnimationFrame(function () {
          next.classList.remove('nla-fade-init');
        });
      });

      var input = next.querySelector('input');
      if (input) input.focus();

      refreshUI();
    }

    function hideField(field) {
      var input = field.querySelector('input');
      if (input) input.value = '';
      field.classList.add('d-none');
      refreshUI();
    }

    addBtn.addEventListener('click', revealNext);

    fields.forEach(function (field) {
      var removeBtn = field.querySelector('.nla-comaker-remove');
      if (removeBtn) {
        removeBtn.addEventListener('click', function () { hideField(field); });
      }
    });

    refreshUI();
  }

