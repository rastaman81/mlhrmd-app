  async function handleMLFundMonthsBased(employeeData, loanAmount) {
  const loanType = document.getElementById('loanType').value;
  const monthsSelect = document.getElementById('monthsToPay');
  const months = parseFloat(monthsSelect?.value);

  if (!months || months < 1) {
    return {
      success: false,
      needsMonths: true,
      message: 'Please select the number of months to pay.',
      data: null
    };
  }

  // Get loan type configuration from database
  const config = await getLoanTypeConfig(loanType);
  const monthlyDeductionCount = config.monthly_deduction_count || 2;
  const interestRate = parseFloat(config.interest_rate) || 0;

  // Respect a manually-edited existing loan
  let existingLoanForType = 0;
  const existingLoanInput = document.getElementById('existingLoan');
  if (existingLoanInput) {
    const parsed = parseLoanAmount(existingLoanInput.value);
    if (!isNaN(parsed) && parsed > 0) {
      existingLoanForType = parsed;
    }
  }
  if (existingLoanForType === 0) {
    existingLoanForType = calculateExistingLoanTotal(
      employeeData.payrollRecords,
      loanType.toLowerCase()
    );
  }

  selectedEmployeeData.existingLoanTotal = existingLoanForType;
  document.getElementById('existingLoan').value = formatCurrencyDisplay(existingLoanForType);

  const loanComputation = employeeData.loanComputation || {};
  const netpay1 = loanComputation.firstCycleNetPay || 0;
  const netpay2 = loanComputation.secondCycleNetPay || 0;
  const totalNetPay = netpay1 + netpay2;
  const percent35 = loanComputation.percentage || 0;

  // ─── CALCULATE LOAN DEDUCTION ───
  let perPeriodDeduction = 0;
  const loanTypeLower = loanType.toLowerCase();

  // Check if it's a pettycash type (with or without reloan)
  if (loanTypeLower === 'ml fund pettycash' || loanTypeLower === 'ml fund pettycash reloan') {
    // ML Fund Pettycash & Pettycash Reloan
    // Formula: loanAmount / months
    // This gives the total deduction for both cycles combined
    perPeriodDeduction = round2(loanAmount / months);
  } else {
    // ML Fund Jewelry Loan, ML Fund O.P.I., and other interest-bearing loans
    // Formula: (loanAmount * (1 + interestRate * months)) / months
    // This gives the total deduction for both cycles combined
    const effectiveInterestRate = interestRate > 0 ? interestRate : 0.01;
    perPeriodDeduction = round2((loanAmount * (1 + effectiveInterestRate * months)) / months);
  }

  // The perPeriodDeduction is the total deduction for both cycles combined
  // The monthly_deduction_count determines how many cycles per month
  // So the deduction per cycle is: perPeriodDeduction / monthly_deduction_count
  const deductionPerCycle = round2(perPeriodDeduction / monthlyDeductionCount);

  // Net proceeds calculation
  //const netProceeds = (totalNetPay + existingLoanForType) - percent35 - perPeriodDeduction;
  const netProceeds = (totalNetPay + (existingLoanForType * monthlyDeductionCount)) - percent35 - perPeriodDeduction;
  

  document.getElementById('loanDeduction').value = formatCurrencyDisplay(perPeriodDeduction);
  document.getElementById('netProceeds').value = formatCurrencyDisplay(netProceeds);

  return {
    success: true,
    message: `✅ ${loanType} calculated. Net proceeds: ${formatCurrencyDisplay(netProceeds)}`,
    data: {
      netProceeds: parseFloat(netProceeds.toFixed(2)),
      loanAmount: parseFloat(loanAmount),
      loanDeduction: deductionPerCycle,
      monthlyDeduction: perPeriodDeduction,
      existingLoan: parseFloat(existingLoanForType),
      percent35: parseFloat(percent35),
      months: months,
      monthlyDeductionCount: monthlyDeductionCount,
      interestRate: interestRate,
      loanType: loanType
    }
  };
}

