function isBonusLoanType(loanType) {
  const bonusLoanTypes = [
    'ml fund 13th month',
    'ml fund a.l.l. bonus',
    'sako 13th month',
    'sako a.l.l. bonus'
  ];
  return bonusLoanTypes.includes(loanType.toLowerCase());
}

function getBonusMaxAmount(loanType, employeeData, percentage = 0.80) {
  const monthlyRate = parseFloat(employeeData.monthly_rate) || 0;
  const los = employeeData.service_years || 0;
  const currentMonth = new Date().getMonth() + 1;

  switch (loanType.toLowerCase()) {
    case 'ml fund a.l.l. bonus':
      if (los < 5) return { max: 0, eligible: false, los };
      return { max: round2(monthlyRate * percentage), eligible: true };

    case 'ml fund 13th month':
      return {
        max: los < 5
          ? round2(((monthlyRate * percentage) / 12) * currentMonth)
          : round2(monthlyRate * percentage),
        eligible: true
      };

    case 'sako a.l.l. bonus':
    case 'sako 13th month':
      return {
        max: los < 5 ? round2(monthlyRate * 0.50) : round2(monthlyRate * percentage),
        eligible: true
      };

    default:
      return { max: 0, eligible: true };
  }
}

const loanTypeConfigCache = {};

async function getLoanTypeConfig(loanType) {
  const key = loanType.toLowerCase();
  if (loanTypeConfigCache[key]) return loanTypeConfigCache[key];

  try {
    const url = new URL('/loan/loan-type-config', window.location.origin);
    url.searchParams.append('loanType', loanType);
    const res = await fetch(url);
    const data = await res.json();
    if (data.success) {
      loanTypeConfigCache[key] = data.config;
      return data.config;
    }
  } catch (err) {
    console.error('Error fetching loan type config:', err);
  }
  return { monthly_deduction_count: 2, interest_rate: 0.01, formula_type: 'input_based' };
}

function showMonthsToPayRow(show) {
  const row = document.getElementById('monthsToPayRow');
  if (row) row.classList.toggle('d-none', !show);
}

function populateMonthsToPay(loanType) {
  const sel = document.getElementById('monthsToPay');
  if (!sel) return;

  const config = MONTHS_BASED_LOAN_CONFIG[loanType.toLowerCase()];
  const options = config ? config.options : [];

  sel.innerHTML = '<option value="">Select number of months</option>';
  options.forEach((m) => {
    const opt = document.createElement('option');
    opt.value = m;
    opt.textContent = `${m} Month${m === 1 ? '' : 's'}`;
    sel.appendChild(opt);
  });
}

function resetMonthsToPay() {
  const sel = document.getElementById('monthsToPay');
  if (sel) sel.value = '';
}

function getSelectedBonusPercentage() {
  const checked = document.querySelector('input[name="bonusPercentage"]:checked');
  return checked ? parseFloat(checked.value) : 0.80;
}

function resetBonusPercentageToggle() {
  const fullOption = document.getElementById('bonusFull');
  if (fullOption) fullOption.checked = true;
}

function showBonusPercentageRow(show) {
  const row = document.getElementById('bonusPercentageRow');
  if (row) row.classList.toggle('d-none', !show);
}

function round2(n) {
  return Math.round(n * 100) / 100;
}

function showBonusAmountExceededModal(enteredAmount, maxAmount, loanType) {
  let modalEl = document.getElementById('bonusAmountExceededModal');

  if (!modalEl) {
    modalEl = document.createElement('div');
    modalEl.id = 'bonusAmountExceededModal';
    modalEl.className = 'modal fade';
    modalEl.tabIndex = '-1';
    modalEl.setAttribute('aria-hidden', 'true');
    modalEl.innerHTML = `
      <div class="modal-dialog modal-md modal-dialog-centered">
        <div class="modal-content">
          <div class="modal-header" style="background: #ffc107; color: #212529;">
            <h5 class="modal-title">
              <i class="fas fa-exclamation-triangle me-2"></i>Amount Exceeds Limit
            </h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
          </div>
          <div class="modal-body text-center" id="bonusAmountExceededBody">
            <!-- populated dynamically -->
          </div>
          <div class="modal-footer justify-content-center">
            <button type="button" class="btn btn-nla-navy px-4" data-bs-dismiss="modal">
              <i class="fas fa-check me-1"></i> OK
            </button>
          </div>
        </div>
      </div>
    `;
    document.body.appendChild(modalEl);
  }

  const body = modalEl.querySelector('#bonusAmountExceededBody');
  body.innerHTML = `
    <i class="fas fa-hand-holding-usd mb-3" style="font-size: 48px; color: #ffc107;"></i>
    <h6 class="mb-3">The amount you entered exceeds the maximum allowed for <strong>${escapeHtml(loanType)}</strong>.</h6>
    <div class="alert alert-warning text-start mb-0">
      <p class="mb-1"><strong>Entered Amount:</strong> ${formatCurrencyDisplay(enteredAmount)}</p>
      <p class="mb-0"><strong>Maximum Allowed:</strong> ${formatCurrencyDisplay(maxAmount)}</p>
    </div>
    <p class="text-muted small mt-3 mb-0">The amount has been adjusted to the maximum allowed.</p>
  `;

  const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
  modal.show();
}

function updateExistingLoanEditable(loanType) {
  const existingLoanInput = document.getElementById('existingLoan');
  if (!existingLoanInput) return;

  const isBonus = EXISTING_LOAN_MODAL_TYPES.includes(loanType.toLowerCase());

  if (isBonus) {
    existingLoanInput.setAttribute('readonly', true);
    existingLoanInput.style.backgroundColor = 'transparent';
    existingLoanInput.style.cursor = 'default';
    existingLoanInput.value = formatCurrencyDisplay(0);
  } else {
    existingLoanInput.removeAttribute('readonly');
    existingLoanInput.style.backgroundColor = '#fff';
    existingLoanInput.style.cursor = 'text';
  }
}

function showBonusNotEligibleModal(loanType, los) {
  let modalEl = document.getElementById('bonusNotEligibleModal');

  if (!modalEl) {
    modalEl = document.createElement('div');
    modalEl.id = 'bonusNotEligibleModal';
    modalEl.className = 'modal fade';
    modalEl.tabIndex = '-1';
    modalEl.setAttribute('aria-hidden', 'true');
    modalEl.innerHTML = `
      <div class="modal-dialog modal-md modal-dialog-centered">
        <div class="modal-content">
          <div class="modal-header" style="background: #dc3545; color: white;">
            <h5 class="modal-title">
              <i class="fas fa-exclamation-circle me-2"></i>Not Eligible
            </h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
          </div>
          <div class="modal-body text-center" id="bonusNotEligibleBody"></div>
          <div class="modal-footer justify-content-center">
            <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">
              <i class="fas fa-times me-1"></i> Close
            </button>
          </div>
        </div>
      </div>
    `;
    document.body.appendChild(modalEl);
  }

  const body = modalEl.querySelector('#bonusNotEligibleBody');
