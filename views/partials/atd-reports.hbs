async function generateExcelMlFund(results) {
  if (typeof XLSX === 'undefined') {
    await loadScript('https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js');
  }

  const wb = XLSX.utils.book_new();
  const groupedData = {};

  // Define headers
  const headers = [
    'REGION CODE', 
    'REGION DESCRIPTION', 
    '#', 
    'IDNO', 
    'EMPLOYEE NAME', 
    'AMOUNT'
  ];

  // Group data by region_description
  results.forEach(employee => {
    if (!groupedData[employee.region]) {
      groupedData[employee.region] = {};
    }
    if (!groupedData[employee.region][employee.department]) {
      groupedData[employee.region][employee.department] = [];
    }
    groupedData[employee.region][employee.department].push(employee);
  });

  // Sort regions alphabetically
  const sortedRegionDescriptions = Object.keys(groupedData).sort();

  sortedRegionDescriptions.forEach(regionDescription => {
    const regionData = groupedData[regionDescription];
    const wsData = [];
    let columnWidths = headers.map(header => header.length); // Initialize with header widths
    let rowIndex = 1;

    // Add report headers
    wsData.push([`Payroll Date: ${formatDate(results[0].enddate)}`]);
    wsData.push(['ML FUND DEDUCTION']);
    wsData.push(headers); // This is row 3 (0-based index 2)

    // Process each department
    Object.keys(regionData).forEach(department => {
      const departmentEmployees = regionData[department];

      departmentEmployees.forEach(emp => {
        const row = [
          emp.region_code || '',
          emp.region_description || '',
          rowIndex++,
          emp.idno || '',
          emp.employee || '',
          Number(emp.mlfund) || 0
        ];

        // Update column widths based on content
        row.forEach((cell, index) => {
          const cellWidth = String(cell).length;
          if (cellWidth > columnWidths[index]) {
            columnWidths[index] = cellWidth;
          }
        });

        wsData.push(row);
      });

      // Add department summary
      const totals = Array(headers.length).fill(0);
      const numericColumns = [5];
      departmentEmployees.forEach(emp => {
        numericColumns.forEach(col => {
          totals[col] += parseFloat(emp.mlfund) || 0;
        });
      });

      const summaryRow = new Array(headers.length).fill('');
      summaryRow[0] = 'TOTAL EMPLOYEES:';
      summaryRow[2] = departmentEmployees.length;
      numericColumns.forEach(col => {
        summaryRow[col] = totals[col];
      });

      // Update widths for summary row
      summaryRow.forEach((cell, index) => {
        const cellWidth = String(cell).length;
        if (cellWidth > columnWidths[index]) {
          columnWidths[index] = cellWidth;
        }
      });

      wsData.push(summaryRow);
      wsData.push([]); // Empty row between departments
    });

    // Create worksheet
    const ws = XLSX.utils.aoa_to_sheet(wsData);
    
    // Set column widths based on widest content (headers + data)
    ws['!cols'] = columnWidths.map(width => ({
      wch: Math.min(width + 2, 50) // Add 2 chars padding, max 50 chars wide
    }));

    // Format numeric columns
    Object.keys(ws).forEach(cellAddress => {
      const cell = ws[cellAddress];
      const colIndex = XLSX.utils.decode_cell(cellAddress).c;
      
      // Format amount column (5th column)
      if (colIndex === 5) {
        cell.z = '#,##0.00';
      }
      
      // Style header row (row 3 in 0-based index)
      if (XLSX.utils.decode_cell(cellAddress).r === 2) {
        cell.s = {
          font: { bold: true },
          fill: { fgColor: { rgb: "D3D3D3" } } // Light gray background
        };
      }
      
      // Style totals row
      const lastDataRow = wsData.length - 2; // -2 because we added empty row
      if (XLSX.utils.decode_cell(cellAddress).r === lastDataRow) {
        cell.s = {
          font: { bold: true },
          border: { top: { style: 'thin', color: { rgb: '000000' } } }
        };
      }
    });

    // Add worksheet to workbook
    const sheetName = regionDescription.substring(0, 31).replace(/[\\/*[\]:?]/g, '');
    XLSX.utils.book_append_sheet(wb, ws, sheetName);
  });

  // Generate filename with current date
  const date = new Date().toISOString().slice(0, 10);
  XLSX.writeFile(wb, `MLFund_Report_${date}.xlsx`);
}

async function generatePdfReport(results, type, category, region, office) {
  console.log('new approach', region, office);
  
  try {
    const endDate = results[0]?.enddate;

    // Construct the base filename
    let filename = `${capitalizeFirstLetter(type)}_${capitalizeFirstLetter(category)}_Report_${formatDateString(endDate)}.pdf`;


    // If region is provided and not empty, add it to the filename
    if (typeof region === 'string' && region.trim() !== "") {
    filename = `${capitalizeFirstLetter(type)}_${capitalizeFirstLetter(category)}_Report_${capitalizeFirstLetter(region)}_${formatDateString(endDate)}.pdf`;
}

    const response = await fetch('/payroll/reports/generate-pdf', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ 
        reportData: results,
        reportType: type,
        category: category,
        office: office
      })
    });

    if (response.ok) {
      const blob = await response.blob();
      const url = window.URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = filename;  // Use the constructed filename
      a.click();
      window.URL.revokeObjectURL(url);
    } else {
      throw new Error('Failed to generate PDF');
    }
  } catch (error) {
    console.error('Error generating PDF:', error);
    alert('Failed to generate PDF. Please try again.');
  }
}

function capitalizeFirstLetter(word) {
  if (typeof word === 'string' && word.length > 0) {
    return word.charAt(0).toUpperCase() + word.slice(1).toLowerCase();
  }
  return word; // In case the input is not a valid string
}

const formatDateString = (dateString) => {
  if (!dateString) return "N/A";
  const date = new Date(dateString);
  return date.toLocaleDateString("en-US", {
    year: "numeric",
    month: "2-digit",
    day: "2-digit",
  });
};

async function generatePdfMlFund1(results) {
  try {
    // Load required libraries
    if (typeof jsPDF === 'undefined') {
      await new Promise((resolve, reject) => {
        const script1 = document.createElement('script');
        script1.src = 'https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js';
        script1.onload = () => {
          const script2 = document.createElement('script');
          script2.src = 'https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.28/jspdf.plugin.autotable.min.js';
          script2.onload = () => {
            window.jsPDF = window.jspdf.jsPDF;
            resolve();
          };
          script2.onerror = reject;
          document.head.appendChild(script2);
        };
        script1.onerror = reject;
        document.head.appendChild(script1);
      });
    }

    // Group data by region and department
    const groupedData = {};
    results.forEach(employee => {
      if (!groupedData[employee.region]) {
        groupedData[employee.region] = {};
      }
      if (!groupedData[employee.region][employee.department]) {
        groupedData[employee.region][employee.department] = [];
      }
      groupedData[employee.region][employee.department].push(employee);
    });

    // Sort regions alphabetically
    const sortedRegions = Object.keys(groupedData).sort();

    // Create PDF document (letter size, portrait)
    const doc = new jsPDF({
      orientation: 'portrait',
      unit: 'in',
      format: 'letter'
    });

    // Define styles
    const styles = {
      header: {
        fontSize: 12,
        bold: true,
        textColor: [0, 0, 0],
        fillColor: [211, 211, 211],
        halign: 'left'
      },
      subHeader: {
        fontSize: 11,
        bold: true,
        halign: 'left'
      },
      tableHeader: {
        fontSize: 10,
        bold: true,
        fillColor: [211, 211, 211],
        textColor: [0, 0, 0],
        halign: 'center'
      },
      tableBody: {
        fontSize: 9,
        textColor: [0, 0, 0],
        halign: 'left'
      },
      tableNumber: {
        fontSize: 9,
        halign: 'right'
      },
      totalRow: {
        fontSize: 10,
        bold: true,
        textColor: [0, 0, 0],
        lineWidth: 0,
        lineColor: [255, 255, 255]
      },
      regionHeader: {
        fontSize: 11,
        bold: true,
        textColor: [0, 0, 0],
        halign: 'left'
      }
    };

    // Process each region
    for (let regionIndex = 0; regionIndex < sortedRegions.length; regionIndex++) {
      const region = sortedRegions[regionIndex];
      
      // Add new page for each region except the first
      if (regionIndex > 0) {
        doc.addPage();
      }

      let startY = 0.5;
      
      // Add report header FOR EACH REGION
      doc.setFontSize(styles.header.fontSize);
      doc.setFont(undefined, 'bold');
      doc.text('ML FUND DEDUCTION', 0.5, startY, { align: 'left' });
      
      doc.setFontSize(styles.subHeader.fontSize);
      doc.text(`Payroll Date: ${formatDate(results[0].enddate)}`, 0.5, startY + 0.3);
      startY += 0.6;

      {{!-- // Add region header
      doc.setFontSize(styles.regionHeader.fontSize);
      doc.setFont(undefined, 'bold');
      doc.text(`Region: ${region}`, 0.5, startY);
      startY += 0.3; --}}

      // Process departments in this region
      const departments = Object.keys(groupedData[region]);
      for (const dept of departments) {
        const employees = groupedData[region][dept];
        const tableData = [];

        // Add employee rows
        employees.forEach((emp, empIndex) => {
          tableData.push([
            emp.region_code || '',
            emp.region_description || '',
            empIndex + 1,
            emp.idno || '',
            emp.employee || '',
            { 
              content: formatNumber(emp.mlfund), 
              styles: styles.tableNumber 
            }
          ]);
        });

        // Add department total
        const deptTotal = employees.reduce((sum, emp) => sum + (parseFloat(emp.mlfund) || 0), 0);
        tableData.push([
          { content: 'TOTAL EMPLOYEES:', colSpan: 2, styles: styles.totalRow },
          { content: employees.length, styles: styles.totalRow },
          { content: '', styles: styles.totalRow },
          { content: '', styles: styles.totalRow },
          { 
            content: formatNumber(deptTotal), 
            styles: { ...styles.totalRow, halign: 'right' } 
          }
        ]);

        // Add empty row between departments
        tableData.push([{ content: '', colSpan: 6 }]);

        // Generate table
        doc.autoTable({
          head: [['REGION CODE', 'REGION DESC', '#', 'IDNO', 'EMPLOYEE NAME', 'AMOUNT']],
          body: tableData,
          startY: startY,
          margin: { left: 0.5, right: 0.5 },
          headStyles: styles.tableHeader,
          bodyStyles: styles.tableBody,
          columnStyles: {
            0: { cellWidth: 0.8 },
            1: { cellWidth: 1.2 },
            2: { cellWidth: 0.5 },
            3: { cellWidth: 0.8 },
            4: { cellWidth: 2.5 },
            5: { cellWidth: 1.0 }
          },
          styles: {
            cellPadding: 0.05,
            fontSize: 10,
            overflow: 'linebreak'
          }
        });

        startY = doc.lastAutoTable.finalY + 0.2;
      }
    }

    // Save the PDF
    const date = new Date().toISOString().slice(0, 10);
    doc.save(`MLFund_Report_${date}.pdf`);

  } catch (error) {
    console.error('Error generating PDF:', error);
    alert('Failed to generate PDF. Please try again or check console for details.');
  }
}


async function loadScripts(urls) {
  const promises = urls.map(url => {
    return new Promise((resolve, reject) => {
      if (document.querySelector(`script[src="${url}"]`)) {
        resolve();
        return;
      }
      
      const script = document.createElement('script');
      script.src = url;
      script.onload = resolve;
      script.onerror = () => reject(new Error(`Failed to load script: ${url}`));
      document.head.appendChild(script);
    });
  });
  
  await Promise.all(promises);
}

