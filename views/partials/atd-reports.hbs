<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Payroll Reports</title>
    
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
    />
    <link rel="stylesheet" href="/css/styles.css" />
    <!-- Add datepicker CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
  </head>
  <body>
    <!-- Dashboard Container -->
    <div class="dashboard-container">
      <!-- Navbar Section (Top Bar) -->
      {{> header}}

      <!-- Main Content Section -->
      <div class="main-content">
        <!-- Payroll Utilities Card -->
        <div class="search-card">
          <h2>
            <i class="fas fa-calculator me-2"></i>
            Payroll Reports
          </h2>

          <!-- Payroll Utilities Form -->
          <form id="payrollReportsForm">
            <div class="row g-3 mb-3">
              <!-- Date Range Picker -->
              <div class="col-md-3">
                <label for="dateRange" class="form-label">Date Range</label>
                <input
                  type="text"
                  id="dateRange"
                  class="form-control datepicker"
                  placeholder="Select date range"
                  readonly
                />
              </div>

              <!-- Office Selection -->
              <div class="col-md-3">
                <label for="officeSelect" class="form-label">Office</label>
                <select
                  name="office"
                  id="officeSelect"
                  class="form-select"
                >
                  <option value="" disabled selected>Select Office</option>
                  {{#each offices}}
                    <option value="{{this.office_name}}">
                      {{this.office_name}}
                    </option>
                  {{/each}}
                </select>
              </div>

              <!-- Region Selection -->
              <div class="col-md-3">
                <label for="regionSelect" class="form-label">Region</label>
                <select
                  name="region"
                  id="regionSelect"
                  class="form-select"
                >
                  <option value="" selected>All Regions</option>
                  {{#each regions}}
                    <option value="{{this.region_name}}">
                      {{this.region_name}}
                    </option>
                  {{/each}}
                  
                </select>
              </div>

              <!-- Report Type -->
              <div class="col-md-3">
                <label for="reportType" class="form-label">Report Type</label>
                <select
                  name="reportType"
                  id="reportType"
                  class="form-select"
                >
                  <option value="" disabled selected>Select Report</option>
                  {{#each reportTypes}}
                    <option value="{{this.reporttype}}">
                      {{this.reporttype}}
                    </option>
                  {{/each}}
                  
                </select>
              </div>
            </div>

            <div class="row g-3 mb-3 justify-content-center" >
              <!-- Income Type -->
              <div class="col-md-4">
    <label for="incomeType" class="form-label">Income Type</label>
    <select
      name="incomeType"
      id="incomeType"
      class="form-select" disabled
    >
      <option value="" disabled selected>Select Income Type</option>
      {{#each incomeTypes}}
        <option value="{{this.income_name}}">
          {{this.income_description}}
        </option>
      {{/each}}
    </select>
  </div>

              <!-- Deduction Type -->
              <div class="col-md-4">
              <label for="deductionType" class="form-label">Deduction Type</label>
    <select
      name="deductionType"
      id="deductionType"
      class="form-select" disabled
    >
      <option value="" disabled selected>Select Deduction Type</option>
      {{#each deductionTypes}}
        <option value="{{this.deduction_name}}">
          {{this.deduction_description}}
        </option>
      {{/each}}
    </select>
  </div>

              <!-- Action Buttons -->
              <div class="col-md-4 d-flex align-items-end">
                <button
                  type="submit"
                  class="btn btn-primary me-2 flex-grow-1"
                >
                  <i class="fas fa-file-export me-2"></i>Generate Report
                </button>
                <button
                  type="button"
                  class="btn btn-secondary flex-grow-1"
                  id="resetBtn"
                >
                  <i class="fas fa-redo me-2"></i>Reset
                </button>
              </div>
            </div>
          </form>
        </div>

        <!-- Report Results Container -->
        <div class="table-container mt-4" id="reportResults" style="display: none;">
          <div class="d-flex justify-content-between align-items-center mb-3">
            <h3>Report Results</h3>
            <button class="btn btn-sm btn-outline-secondary" id="exportBtn">
              <i class="fas fa-download me-1"></i>Export to Excel
            </button>
          </div>
          
          <div class="table-responsive">
            <table id="report-table" class="table table-striped">
              <thead>
                <tr>
                  <th>Employee ID</th>
                  <th>Name</th>
                  <th>Office</th>
                  <th>Region</th>
                  <th>Gross Pay</th>
                  <th>Deductions</th>
                  <th>Net Pay</th>
                </tr>
              </thead>
              <tbody>
                <!-- Report data will be populated here -->
              </tbody>
            </table>
          </div>

          <!-- Loading and Error Messages -->
          <div id="report-loading" class="text-center my-5" style="display: none">
            <div class="spinner-border text-primary" role="status">
              <span class="visually-hidden">Loading...</span>
            </div>
            <p class="mt-2 text-muted">Generating report...</p>
          </div>
        </div>

        <!-- Error Message -->
        <div
          id="error-message"
          class="alert alert-danger mt-4"
          style="display: none"
        ></div>
      </div>
    </div>

    <!-- Bootstrap JS (required for dropdown functionality) -->
    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
    ></script>
    <!-- Datepicker JS -->
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
