// Utility function to replace Ñ with N in the lastName field only
function sanitizeLastName(str) {
  if (str) {
    console.log('Sanitizing:', str); 
    return str.replace(/[Ññ]/g, 'N');
  }
  return str;
}

// Utility function to convert JSON data to CSV format
function convertToCSV(data) {
  // Check if data is not empty
  if (data.length === 0) {
    return '';
  }

  // Get all keys (columns) from the first object (assuming all objects have the same structure)
  const header = Object.keys(data[0]);

  // Map data to CSV, only sanitize the lastName field
  const rows = data.map(item => 
    header.map(field => {
      // Sanitize only lastName field
      
      if (field.toLowerCase() === 'last name') {
        return `"${sanitizeLastName(item[field] || "")}"`;
      }
      return `"${item[field] || ""}"`; // No sanitization for other fields
    }).join(",")
  );

  // Return the CSV string: header + rows
  return [header.join(","), ...rows].join("\n");
}

// Utility function to trigger the CSV file download with UTF-8 encoding
function downloadCSV(content, fileName) {
  const blob = new Blob([content], { type: 'text/csv;charset=utf-8;' });

  const link = document.createElement("a");
  if (link.download !== undefined) { // Check if the browser supports the download attribute
    const url = URL.createObjectURL(blob);
    link.setAttribute("href", url);
    link.setAttribute("download", fileName);
    link.style.visibility = 'hidden';
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
  }
}

// getting the dates ----- start
function getDates(dateRange) {
  let startDate = null;
  let endDate = null;

  if (dateRange && dateRange.includes(" to ")) {
    [startDate, endDate] = dateRange.split(" to ");
    const start = new Date(startDate);
    const end = new Date(endDate);

    if (!isNaN(start.getTime()) && !isNaN(end.getTime())) {
      startDate = start.toISOString().split("T")[0];
      endDate = end.toISOString().split("T")[0];
    } else {
      startDate = null;
      endDate = null;
    }
  }

  return { startDate, endDate };
}
