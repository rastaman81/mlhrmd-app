<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>{{title}}</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/styles.css">
  <style>
    :root{
      --ii-navy:      #16304A;
      --ii-navy-deep: #0F2233;
      --ii-blue:      #2E6F9E;
      --ii-teal:      #1F7A6C;
      --ii-gold:      #A8762A;
      --ii-bg:        #F6F7F9;
      --ii-surface:   #FFFFFF;
      --ii-border:    #E3E6EB;
      --ii-muted:     #6B7686;
      --ii-danger:    #C1483D;
    }

    .main-content{
      font-family:'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
      background:var(--ii-bg);
    }

    /* ---- Page header ---- */
    .ii-title{
      font-size:1.65rem;
      font-weight:700;
      color:var(--ii-navy-deep);
      display:flex;
      align-items:center;
      gap:.6rem;
      margin:0;
    }
    .ii-title i{ color:var(--ii-blue); }
    .ii-subtitle{ color:var(--ii-muted); font-size:.92rem; margin:.35rem 0 0; }

    /* ---- Buttons ---- */
    .btn-ii-teal{
      background:var(--ii-teal); border-color:var(--ii-teal); color:#fff; font-weight:500;
    }
    .btn-ii-teal:hover{ background:#176255; border-color:#176255; color:#fff; }
    .btn-ii-blue{
      background:var(--ii-blue); border-color:var(--ii-blue); color:#fff; font-weight:500;
    }
    .btn-ii-blue:hover{ background:#255e87; border-color:#255e87; color:#fff; }
    .btn-ii-outline{
      background:var(--ii-surface); border-color:var(--ii-border); color:var(--ii-navy-deep);
    }
    .btn-ii-outline:hover{ background:var(--ii-bg); border-color:var(--ii-muted); color:var(--ii-navy-deep); }

    .filter-section {
      background: var(--ii-surface);
      border: 1px solid var(--ii-border);
      border-radius: .45rem;
      padding: 1rem;
    }
    .stat-box {
      background: var(--ii-surface);
      border: 1px solid var(--ii-border);
      border-radius: .5rem;
      padding: .75rem 1rem;
      text-align: center;
    }
    .stat-box .number {
      font-size: 1.5rem;
      font-weight: 700;
    }
    .stat-box .label {
      font-size: .75rem;
      color: var(--ii-muted);
      text-transform: uppercase;
    }
    .stat-box.pending .number { color: var(--ii-gold); }
    .stat-box.approved .number { color: var(--ii-teal); }
    .stat-box.rejected .number { color: var(--ii-danger); }
    .stat-box.total .number { color: var(--ii-blue); }
    
    /* ---- Data card ---- */
    .ii-card{
      border:1px solid var(--ii-border);
      border-radius:.65rem;
      background:var(--ii-surface);
      box-shadow:0 1px 2px rgba(16,24,40,.04);
      overflow:hidden;
    }
    .ii-card-header{
      padding:.85rem 1.15rem;
      border-bottom:1px solid var(--ii-border);
      display:flex;
      align-items:center;
      gap:.45rem;
    }
    .ii-card-header i{ color:var(--ii-blue); }
    .ii-card-header .ii-card-title{
      color:var(--ii-navy-deep);
      font-weight:600;
      font-size:.97rem;
    }
    .ii-card-header .ii-item-count{
      color:var(--ii-muted);
      font-weight:400;
      font-size:.85rem;
    }

    /* ---- Table ---- */
    .ii-card .table{ margin:0; font-size:.9rem; }
    .ii-card .table thead th{
      background:var(--ii-navy) !important;
      color:#fff !important;
      font-size:.72rem;
      text-transform:uppercase;
      letter-spacing:.04em;
      font-weight:600;
      border-color:#1e3e5e;
      padding:.75rem 1rem;
      white-space:nowrap;
    }
    .ii-card .table tbody td{
      padding:.65rem 1rem;
      vertical-align:middle;
      border-color:var(--ii-border);
      color:var(--ii-navy-deep);
    }
    .ii-card .table tbody tr:hover{ background:var(--ii-bg); }

    /* ---- Status badges ---- */
    .status-badge {
      padding: .2rem .65rem;
      border-radius: 1rem;
      font-size: .7rem;
      font-weight: 600;
      text-transform: uppercase;
    }
    .status-pending { background: rgba(168,118,42,.12); color: var(--ii-gold); }
    .status-approved { background: rgba(31,122,108,.12); color: var(--ii-teal); }
    .status-rejected { background: rgba(193,72,61,.12); color: var(--ii-danger); }
    .status-cancelled { background: rgba(108,117,125,.12); color: var(--ii-muted); }

    /* ---- Distribution cards ---- */
    .ii-distribution-card{
      border:1px solid var(--ii-border);
      border-radius:.65rem;
      background:var(--ii-surface);
      overflow:hidden;
    }
    .ii-distribution-header{
      border-bottom:1px solid var(--ii-border);
      padding:.75rem 1rem;
    }
    .ii-distribution-header strong{
      color:var(--ii-navy-deep);
      font-size:.9rem;
    }
    .ii-distribution-body{
      padding:.75rem 1rem;
    }
    .ii-distribution-item{
      display:flex;
      justify-content:space-between;
      align-items:center;
      padding:.3rem 0;
      border-bottom:1px solid #f0f0f0;
    }
    .ii-distribution-item:last-child{
      border-bottom:none;
    }

    /* ---- Empty state ---- */
    .ii-empty{
      text-align:center;
      color:var(--ii-muted);
      padding:2.5rem 1rem;
    }
    .ii-empty i{
      color:var(--ii-border);
      font-size:1.5rem;
      display:block;
      margin-bottom:.5rem;
    }

    /* ---- Scrollable container ---- */
    .ii-scroll{
      max-height:300px;
      overflow-y:auto;
    }
    .ii-scroll::-webkit-scrollbar {
      width: 6px;
    }
    .ii-scroll::-webkit-scrollbar-track {
      background: var(--ii-bg);
    }
    .ii-scroll::-webkit-scrollbar-thumb {
      background: var(--ii-border);
      border-radius: 3px;
    }
    .ii-scroll::-webkit-scrollbar-thumb:hover {
      background: var(--ii-muted);
    }
  </style>
</head>
<body>

<div class="dashboard-container">
  {{> header}}

  <div class="main-content">
    <div class="container-fluid px-4 py-4">

      <!-- Page Header -->
      <div class="d-flex justify-content-between align-items-end flex-wrap gap-3 mb-4">
        <div>
          <h1 class="ii-title">
            <i class="fas fa-clipboard-list"></i> Request Summary Report
          </h1>
          <p class="ii-subtitle">Overview of all item requests with filtering options.</p>
        </div>
        <a href="/inventory/reports" class="btn btn-ii-outline">
          <i class="fas fa-arrow-left me-1"></i> Back to Reports
        </a>
      </div>

      <!-- Filters -->
      <div class="filter-section mb-4">
        <form method="GET" action="/inventory/reports/request-summary" class="row g-3 align-items-end">
          <div class="col-md-3">
            <label style="font-size:.8rem; font-weight:600; color:var(--ii-navy); display:block; margin-bottom:.35rem;">From Date</label>
            <input type="date" name="startDate" class="form-control" value="{{filters.startDate}}" style="border-color:var(--ii-border);">
          </div>
          <div class="col-md-3">
            <label style="font-size:.8rem; font-weight:600; color:var(--ii-navy); display:block; margin-bottom:.35rem;">To Date</label>
            <input type="date" name="endDate" class="form-control" value="{{filters.endDate}}" style="border-color:var(--ii-border);">
          </div>
          <div class="col-md-2">
            <label style="font-size:.8rem; font-weight:600; color:var(--ii-navy); display:block; margin-bottom:.35rem;">Status</label>
            <select name="status" class="form-select" style="border-color:var(--ii-border);">
              <option value="">All Status</option>
              <option value="pending" {{#if (eq filters.status "pending")}}selected{{/if}}>Pending</option>
              <option value="approved" {{#if (eq filters.status "approved")}}selected{{/if}}>Approved</option>
              <option value="rejected" {{#if (eq filters.status "rejected")}}selected{{/if}}>Rejected</option>
            </select>
          </div>
          <div class="col-md-2">
            <label style="font-size:.8rem; font-weight:600; color:var(--ii-navy); display:block; margin-bottom:.35rem;">Requester</label>
            <select name="userId" class="form-select" style="border-color:var(--ii-border);">
              <option value="">All Users</option>
              {{#each users}}
                <option value="{{this.user_id}}" {{#if (eq ../filters.userId this.user_id)}}selected{{/if}}>
                  {{this.first_name}} {{this.last_name}} ({{this.idno}})
                </option>
              {{/each}}
            </select>
          </div>
          <div class="col-md-2 d-flex gap-2">
            <button type="submit" class="btn btn-ii-blue" style="flex:1;">
              <i class="fas fa-filter me-1"></i> Generate
            </button>
            <a href="/inventory/reports/request-summary" class="btn btn-ii-outline">
              <i class="fas fa-times"></i>
            </a>
          </div>
        </form>
      </div>

      <!-- Summary Statistics -->
      <div class="row g-3 mb-4">
        <div class="col-md-3">
          <div class="stat-box total">
            <div class="number">{{report.totalRequests}}</div>
            <div class="label">Total Requests</div>
          </div>
        </div>
        <div class="col-md-3">
          <div class="stat-box pending">
            <div class="number">
              {{#each report.statusSummary}}
                {{#if (eq this.status "pending")}}{{this.count}}{{/if}}
              {{/each}}
            </div>
            <div class="label">Pending</div>
          </div>
        </div>
        <div class="col-md-3">
          <div class="stat-box approved">
            <div class="number">
              {{#each report.statusSummary}}
                {{#if (eq this.status "approved")}}{{this.count}}{{/if}}
              {{/each}}
            </div>
            <div class="label">Approved</div>
          </div>
        </div>
        <div class="col-md-3">
          <div class="stat-box rejected">
            <div class="number">
              {{#each report.statusSummary}}
                {{#if (eq this.status "rejected")}}{{this.count}}{{/if}}
              {{/each}}
            </div>
            <div class="label">Rejected</div>
          </div>
        </div>
      </div>

      <!-- Status Distribution -->
      <div class="row g-3 mb-4">
        <div class="col-md-6">
          <div class="ii-distribution-card">
            <div class="ii-distribution-header">
              <strong>Status Distribution</strong>
            </div>
            <div class="ii-distribution-body">
              {{#each report.statusSummary}}
                <div class="ii-distribution-item">
                  <span>
                    <span class="status-badge status-{{this.status}}">{{this.status}}</span>
                  </span>
                  <span>
                    <strong>{{this.count}}</strong> requests
                    <span style="color:var(--ii-muted); font-size:.78rem;">({{this.total_items}} items)</span>
                  </span>
                </div>
              {{else}}
                <div class="ii-empty" style="padding:1rem 0;">
                  No data available
                </div>
              {{/each}}
            </div>
          </div>
        </div>
        <div class="col-md-6">
          <div class="ii-distribution-card">
            <div class="ii-distribution-header">
              <strong>Daily Request Trend (Last 30 Days)</strong>
            </div>
            <div class="ii-distribution-body ii-scroll">
              {{#each report.dailyTrend}}
                <div class="ii-distribution-item">
                  <span style="font-size:.85rem; color:var(--ii-navy-deep);">{{this.date}}</span>
                  <span>
                    <strong>{{this.request_count}}</strong> requests
                    <span style="color:var(--ii-muted); font-size:.78rem;">({{this.items_count}} items)</span>
                  </span>
                </div>
              {{else}}
                <div class="ii-empty" style="padding:1rem 0;">
                  No data available
                </div>
              {{/each}}
            </div>
          </div>
        </div>
      </div>

      <!-- Top Requested Items -->
      <div class="ii-card mb-4">
        <div class="ii-card-header">
          <i class="fas fa-trophy"></i>
          <span class="ii-card-title">Top Requested Items</span>
        </div>
        <div class="table-responsive">
          <table class="table table-sm mb-0">
            <thead>
              <tr>
                <th>#</th>
                <th>Item</th>
                <th>Code</th>
                <th class="text-center">Requests</th>
                <th class="text-center">Total Quantity</th>
                <th class="text-center">Avg / Request</th>
              </tr>
            </thead>
            <tbody>
              {{#each report.topItems}}
                <tr>
                  <td style="color:var(--ii-muted); font-weight:500;">{{add @index 1}}</td>
                  <td style="font-weight:500; color:var(--ii-navy-deep);">{{this.item_name}}</td>
                  <td><span style="color:var(--ii-muted); font-size:.82rem;">{{this.item_code}}</span></td>
                  <td class="text-center" style="font-weight:600; color:var(--ii-navy-deep);">{{this.request_count}}</td>
                  <td class="text-center"><strong>{{this.total_requested}}</strong> {{this.item_unit}}</td>
                  <td class="text-center">{{this.avg_quantity}} {{this.item_unit}}</td>
                </tr>
              {{else}}
                <tr>
                  <td colspan="6" class="ii-empty">
                    <i class="fas fa-box-open"></i>
                    No data available
                  </td>
                </tr>
              {{/each}}
            </tbody>
          </table>
        </div>
      </div>

      <!-- Requester Summary -->
      <div class="ii-card">
        <div class="ii-card-header">
          <i class="fas fa-users"></i>
          <span class="ii-card-title">Requester Activity</span>
        </div>
        <div class="table-responsive">
          <table class="table table-sm mb-0">
            <thead>
              <tr>
                <th>#</th>
                <th>Requester</th>
                <th>ID No.</th>
                <th>Designation</th>
                <th class="text-center">Requests</th>
                <th class="text-center">Total Items</th>
              </tr>
            </thead>
            <tbody>
              {{#each report.requesterSummary}}
                <tr>
                  <td style="color:var(--ii-muted); font-weight:500;">{{add @index 1}}</td>
                  <td style="font-weight:500; color:var(--ii-navy-deep);">{{this.first_name}} {{this.last_name}}</td>
                  <td><span style="color:var(--ii-muted); font-size:.82rem;">{{this.idno}}</span></td>
                  <td>{{this.designation}}</td>
                  <td class="text-center" style="font-weight:600; color:var(--ii-navy-deep);">{{this.request_count}}</td>
                  <td class="text-center"><strong style="color:var(--ii-navy-deep);">{{this.total_items}}</strong></td>
                </tr>
              {{else}}
                <tr>
                  <td colspan="6" class="ii-empty">
                    <i class="fas fa-users"></i>
                    No data available
                  </td>
                </tr>
              {{/each}}
            </tbody>
          </table>
        </div>
      </div>

    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>