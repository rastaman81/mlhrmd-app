<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>{{title}}</title>

  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/styles.css">

  <style>
    :root{
      --pr-navy:      #16304A;
      --pr-navy-deep: #0F2233;
      --pr-blue:      #2E6F9E;
      --pr-teal:      #1F7A6C;
      --pr-gold:      #A8762A;
      --pr-bg:        #F6F7F9;
      --pr-surface:   #FFFFFF;
      --pr-border:    #E3E6EB;
      --pr-muted:     #6B7686;
      --pr-danger:    #C1483D;
    }

    .main-content{
      font-family:'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
      background:var(--pr-bg);
    }

    /* ---- Page header ---- */
    .pr-title{
      font-size:1.65rem;
      font-weight:700;
      color:var(--pr-navy-deep);
      display:flex;
      align-items:center;
      gap:.6rem;
      margin:0;
    }
    .pr-title i{ color:var(--pr-gold); }
    .pr-subtitle{ color:var(--pr-muted); font-size:.92rem; margin:.35rem 0 0; }

    /* ---- Buttons ---- */
    .btn-pr-blue{
      background:var(--pr-blue); border-color:var(--pr-blue); color:#fff; font-weight:500;
    }
    .btn-pr-blue:hover{ background:#255e87; border-color:#255e87; color:#fff; }
    .btn-pr-outline{
      background:var(--pr-surface); border-color:var(--pr-border); color:var(--pr-navy-deep); font-weight:500;
    }
    .btn-pr-outline:hover{ background:var(--pr-bg); border-color:var(--pr-muted); color:var(--pr-navy-deep); }

    /* ---- Status badge ---- */
    .status-badge{
      padding:.25rem .75rem;
      border-radius:1rem;
      font-size:.72rem;
      font-weight:600;
      text-transform:uppercase;
      display:inline-block;
    }
    .status-pending{ background:rgba(168,118,42,.12); color:var(--pr-gold); }

    /* ---- Filter card ---- */
    .pr-filter{
      background:var(--pr-surface);
      border:1px solid var(--pr-border);
      border-radius:.65rem;
      padding:1.1rem 1.15rem;
      box-shadow:0 1px 2px rgba(16,24,40,.04);
      margin-bottom:1.25rem;
    }
    .pr-filter .form-label{
      font-size:.8rem;
      font-weight:600;
      color:var(--pr-navy);
      margin-bottom:.35rem;
    }
    .pr-filter .form-control{
      border-color:var(--pr-border);
    }
    .pr-filter .form-control:focus{
      border-color:var(--pr-blue);
      box-shadow:0 0 0 .2rem rgba(46,111,158,.12);
    }

    /* ---- Data card ---- */
    .pr-card{
      border:1px solid var(--pr-border);
      border-radius:.65rem;
      background:var(--pr-surface);
      box-shadow:0 1px 2px rgba(16,24,40,.04);
      overflow:hidden;
    }
    .pr-card-header{
      padding:.85rem 1.15rem;
      border-bottom:1px solid var(--pr-border);
      display:flex;
      align-items:center;
      gap:.45rem;
    }
    .pr-card-header i{ color:var(--pr-blue); }
    .pr-card-header .pr-card-title{ color:var(--pr-navy-deep); font-weight:600; font-size:.97rem; }
    .pr-card-header .pr-count{ color:var(--pr-muted); font-weight:400; font-size:.85rem; }

    /* ---- Table ---- */
    .pr-card .table{ margin:0; }
    .pr-card .table thead th{
      background:var(--pr-navy) !important;
      color:#fff !important;
      font-size:.72rem;
      text-transform:uppercase;
      letter-spacing:.04em;
      font-weight:600;
      border-color:#1e3e5e;
      padding:.75rem 1rem;
      white-space:nowrap;
    }
    .pr-card .table tbody td{
      padding:.65rem 1rem;
      vertical-align:middle;
      border-color:var(--pr-border);
      color:var(--pr-navy-deep);
    }
    .pr-card .table tbody tr:hover{ background:var(--pr-bg); }

    .pr-requester-name{ font-weight:600; }
    .pr-requester-meta{ font-size:.78rem; color:var(--pr-muted); }

    /* ---- Empty state ---- */
    .pr-empty{
      text-align:center;
      color:var(--pr-muted);
      padding:3rem 1rem;
    }
    .pr-empty i{
      font-size:2rem;
      display:block;
      margin-bottom:.5rem;
    }

    /* ---- Pagination ---- */
    .pr-pagination-bar{
      border-top:1px solid var(--pr-border);
      padding:.85rem 1.15rem;
      display:flex;
      justify-content:space-between;
      align-items:center;
      flex-wrap:wrap;
      gap:.75rem;
    }
    .pr-page-info{ color:var(--pr-muted); font-size:.85rem; }
    .pagination .page-link{ color:var(--pr-blue); border-color:var(--pr-border); }
    .pagination .page-item.active .page-link{
      background:var(--pr-navy); border-color:var(--pr-navy); color:#fff;
    }
    .pagination .page-item:not(.active) .page-link:hover{
      background:var(--pr-bg); color:var(--pr-navy-deep);
    }
  </style>
</head>
<body>

<div class="dashboard-container">
  {{> header}}

  <div class="main-content">
    <div class="container-fluid px-4 py-4">

      <!-- Page Header -->
      <div class="d-flex justify-content-between align-items-end flex-wrap gap-3 mb-4">
        <div>
          <h1 class="pr-title">
            <i class="fas fa-clock"></i> Pending Requests
          </h1>
          <p class="pr-subtitle">All pending requests waiting for approval.</p>
        </div>
        <a href="/inventory/approval" class="btn btn-pr-outline">
          <i class="fas fa-arrow-left me-1"></i> Dashboard
        </a>
      </div>

      <!-- Filters -->
      <div class="pr-filter">
        <form method="GET" action="/inventory/approval/pending" class="row g-3 align-items-end">

          <div class="col-md-4">
            <label class="form-label">Search</label>
            <input
              type="text"
              name="search"
              class="form-control"
              placeholder="Request #, item, or requester..."
              value="{{filters.search}}"
            >
          </div>

          <div class="col-md-3">
            <label class="form-label">From Date</label>
            <input type="date" name="startDate" class="form-control" value="{{filters.startDate}}">
          </div>

          <div class="col-md-3">
            <label class="form-label">To Date</label>
            <input type="date" name="endDate" class="form-control" value="{{filters.endDate}}">
          </div>

          <div class="col-md-2 d-flex gap-2">
            <button type="submit" class="btn btn-pr-blue flex-grow-1">
              <i class="fas fa-filter me-1"></i> Filter
            </button>
            <a href="/inventory/approval/pending" class="btn btn-pr-outline" title="Clear filters">
              <i class="fas fa-times"></i>
            </a>
          </div>

        </form>
      </div>

      <!-- Requests Table -->
      <div class="pr-card">

        <div class="pr-card-header">
          <i class="fas fa-list"></i>
          <span class="pr-card-title">
            Pending Requests
            <span class="pr-count">({{pagination.totalItems}} pending)</span>
          </span>
        </div>

        <div class="table-responsive">
          <table class="table">
            <thead>
              <tr>
                <th>#</th>
                <th>Request #</th>
                <th>Requester</th>
                <th>Items</th>
                <th class="text-center">Total</th>
                <th>Date</th>
                <th class="text-center">Action</th>
              </tr>
            </thead>
            <tbody>
              {{#if requests.length}}
                {{#each requests}}
                  <tr>

                    <td style="color:var(--pr-muted); font-weight:600;">{{add @index 1}}</td>

                    <td style="font-weight:600; font-size:.85rem;">{{this.request_number}}</td>

                    <td>
                      <div class="pr-requester-name">{{this.first_name}} {{this.last_name}}</div>
                      <div class="pr-requester-meta">{{this.idno}} | {{this.designation}}</div>
                    </td>

                    <td style="font-size:.82rem; color:var(--pr-muted);">{{this.items_summary}}</td>

                    <td class="text-center" style="font-weight:600;">{{this.total_items}}</td>

                    <td style="font-size:.82rem; color:var(--pr-muted);">{{formatDate this.created_at}}</td>

                    <td class="text-center">
                      <a href="/inventory/approval/{{this.request_id}}" class="btn btn-sm btn-pr-blue">
                        <i class="fas fa-eye me-1"></i> Review
                      </a>
                    </td>

                  </tr>
                {{/each}}
              {{else}}
                <tr>
                  <td colspan="7" class="pr-empty">
                    <i class="fas fa-check-circle" style="color:var(--pr-teal);"></i>
                    No pending requests found.
                  </td>
                </tr>
              {{/if}}
            </tbody>
          </table>
        </div>

        <!-- Pagination -->
        {{#if (gt pagination.totalPages 1)}}
          <div class="pr-pagination-bar">
            <div class="pr-page-info">
              Page {{pagination.currentPage}} of {{pagination.totalPages}}
            </div>
            <nav>
              <ul class="pagination pagination-sm mb-0">

                <li class="page-item {{#if (eq pagination.currentPage 1)}}disabled{{/if}}">
                  <a class="page-link" href="?page={{dec pagination.currentPage 1}}&search={{filters.search}}&startDate={{filters.startDate}}&endDate={{filters.endDate}}">
                    Previous
                  </a>
                </li>

                {{#each (range 1 pagination.totalPages)}}
                  <li class="page-item {{#if (eq this ../pagination.currentPage)}}active{{/if}}">
                    <a class="page-link" href="?page={{this}}&search={{../filters.search}}&startDate={{../filters.startDate}}&endDate={{../filters.endDate}}">
                      {{this}}
                    </a>
                  </li>
                {{/each}}

                <li class="page-item {{#if (eq pagination.currentPage pagination.totalPages)}}disabled{{/if}}">
                  <a class="page-link" href="?page={{inc pagination.currentPage 1}}&search={{filters.search}}&startDate={{filters.startDate}}&endDate={{filters.endDate}}">
                    Next
                  </a>
                </li>

              </ul>
            </nav>
          </div>
        {{/if}}

      </div>

    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
