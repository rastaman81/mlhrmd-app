<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>{{title}}</title>

  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
  <link rel="stylesheet" href="/css/styles.css">

  <style>
    :root{
      --ii-navy:      #16304A;
      --ii-navy-deep: #0F2233;
      --ii-blue:      #2E6F9E;
      --ii-teal:      #1F7A6C;
      --ii-gold:      #A8762A;
      --ii-bg:        #F6F7F9;
      --ii-surface:   #FFFFFF;
      --ii-border:    #E3E6EB;
      --ii-muted:     #6B7686;
      --ii-danger:    #C1483D;
    }

    .main-content{
      font-family:'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
      background:var(--ii-bg);
    }

    /* ---- Page header ---- */
    .ii-title{
      font-size:1.65rem;
      font-weight:700;
      color:var(--ii-navy-deep);
      display:flex;
      align-items:center;
      gap:.6rem;
      margin:0;
    }
    .ii-title i{ color:var(--ii-blue); }
    .ii-subtitle{ color:var(--ii-muted); font-size:.92rem; margin:.35rem 0 0; }

    /* ---- Buttons ---- */
    .btn-ii-teal{
      background:var(--ii-teal); border-color:var(--ii-teal); color:#fff; font-weight:500;
    }
    .btn-ii-teal:hover{ background:#176255; border-color:#176255; color:#fff; }
    .btn-ii-blue{
      background:var(--ii-blue); border-color:var(--ii-blue); color:#fff; font-weight:500;
    }
    .btn-ii-blue:hover{ background:#255e87; border-color:#255e87; color:#fff; }
    .btn-ii-outline{
      background:var(--ii-surface); border-color:var(--ii-border); color:var(--ii-navy-deep);
    }
    .btn-ii-outline:hover{ background:var(--ii-bg); border-color:var(--ii-muted); color:var(--ii-navy-deep); }

    /* ---- Search bar ---- */
    .ii-search-bar .form-control{
      border-color:var(--ii-border);
    }
    .ii-search-bar .form-control:focus{
      border-color:var(--ii-blue);
      box-shadow:0 0 0 .2rem rgba(46,111,158,.12);
    }

    /* ---- Data card ---- */
    .ii-card{
      border:1px solid var(--ii-border);
      border-radius:.65rem;
      background:var(--ii-surface);
      box-shadow:0 1px 2px rgba(16,24,40,.04);
      overflow:hidden;
    }
    .ii-card-header{
      padding:.85rem 1.15rem;
      border-bottom:1px solid var(--ii-border);
      display:flex;
      align-items:center;
      gap:.45rem;
    }
    .ii-card-header i{ color:var(--ii-blue); }
    .ii-card-header .ii-card-title{
      color:var(--ii-navy-deep);
      font-weight:600;
      font-size:.97rem;
    }
    .ii-card-header .ii-item-count{
      color:var(--ii-muted);
      font-weight:400;
      font-size:.85rem;
    }

    /* ---- Table ---- */
    .ii-card .table{ margin:0; font-size:.9rem; }
    .ii-card .table thead th{
      background:var(--ii-navy) !important;
      color:#fff !important;
      font-size:.72rem;
      text-transform:uppercase;
      letter-spacing:.04em;
      font-weight:600;
      border-color:#1e3e5e;
      padding:.75rem 1rem;
      white-space:nowrap;
    }
    .ii-card .table tbody td{
      padding:.65rem 1rem;
      vertical-align:middle;
      border-color:var(--ii-border);
      color:var(--ii-navy-deep);
    }
    .ii-card .table tbody tr:hover{ background:var(--ii-bg); }

    /* ---- Stock indicator ---- */
    .ii-stock-low{ color:var(--ii-danger); font-weight:600; }
    .ii-stock-ok { color:var(--ii-navy-deep); font-weight:600; }

    /* ---- Status badges ---- */
    .ii-badge-active{
      background:rgba(31,122,108,.12);
      color:var(--ii-teal);
      padding:.25rem .75rem;
      border-radius:1rem;
      font-size:.72rem;
      font-weight:600;
      text-transform:uppercase;
    }
    .ii-badge-inactive{
      background:rgba(193,72,61,.12);
      color:var(--ii-danger);
      padding:.25rem .75rem;
      border-radius:1rem;
      font-size:.72rem;
      font-weight:600;
      text-transform:uppercase;
    }

    /* ---- Empty state ---- */
    .ii-empty{
      text-align:center;
      color:var(--ii-muted);
      padding:2.5rem 1rem;
    }
    .ii-empty i{
      color:var(--ii-border);
      font-size:1.5rem;
      display:block;
      margin-bottom:.5rem;
    }
    .ii-empty a{ color:var(--ii-blue); }

    /* ---- Pagination ---- */
    .ii-pagination-bar{
      border-top:1px solid var(--ii-border);
      padding:.85rem 1.15rem;
      display:flex;
      justify-content:space-between;
      align-items:center;
      flex-wrap:wrap;
      gap:.75rem;
    }
    .ii-pagination-bar .ii-page-info{
      color:var(--ii-muted);
      font-size:.85rem;
    }
    .pagination .page-link{
      color:var(--ii-blue);
      border-color:var(--ii-border);
    }
    .pagination .page-item.active .page-link{
      background:var(--ii-navy);
      border-color:var(--ii-navy);
      color:#fff;
    }
    .pagination .page-item:not(.active) .page-link:hover{
      background:var(--ii-bg);
      color:var(--ii-navy-deep);
    }
  </style>
</head>
<body>

<div class="dashboard-container">
  {{> header}}

  <div class="main-content">
    <div class="container-fluid px-4 py-4">

      <!-- Page Header -->
      <div class="d-flex justify-content-between align-items-end flex-wrap gap-3 mb-4">
        <div>
          <h1 class="ii-title">
            <i class="fas fa-warehouse"></i> Inventory Items
          </h1>
          <p class="ii-subtitle">Manage your inventory items.</p>
        </div>
        <a href="/inventory/items/new" class="btn btn-ii-teal">
          <i class="fas fa-plus me-1"></i> Add New Item
        </a>
      </div>

      <!-- Search -->
      <div class="mb-3 ii-search-bar">
        <form method="GET" action="/inventory/items" class="d-flex gap-2">
          <input
            type="text"
            name="search"
            class="form-control"
            placeholder="Search items..."
            value="{{search}}"
          >
          <button type="submit" class="btn btn-ii-blue">
            <i class="fas fa-search"></i>
          </button>
          {{#if search}}
            <a href="/inventory/items" class="btn btn-ii-outline">Clear</a>
          {{/if}}
        </form>
      </div>

      <!-- Items Table -->
      <div class="ii-card">

        <div class="ii-card-header">
          <i class="fas fa-list"></i>
          <span class="ii-card-title">
            All Items
            <span class="ii-item-count">({{pagination.totalItems}} items)</span>
          </span>
        </div>

        <div class="table-responsive">
          <table class="table">
            <thead>
              <tr>
                <th>#</th>
                <th>Code</th>
                <th>Name</th>
                <th>Description</th>
                <th class="text-center">Unit</th>
                <th class="text-center">Stock</th>
                <th class="text-center">Reorder Level</th>
                <th class="text-center">Status</th>
                <th class="text-center">Actions</th>
              </tr>
            </thead>
            <tbody>
              {{#if items.length}}
                {{#each items}}
                  <tr>

                    <td style="color:var(--ii-muted); font-weight:500;">{{add @index 1}}</td>

                    <td style="font-weight:600;">{{this.item_code}}</td>

                    <td style="font-weight:500;">{{this.item_name}}</td>

                    <td style="color:var(--ii-muted);">{{this.item_description}}</td>

                    <td class="text-center">{{this.item_unit}}</td>

                    <td class="text-center">
                      {{#if (lt this.stock this.item_order_level)}}
                        <span class="ii-stock-low">
                          {{this.stock}}
                          <i class="fas fa-exclamation-circle ms-1" title="Low stock"></i>
                        </span>
                      {{else}}
                        <span class="ii-stock-ok">{{this.stock}}</span>
                      {{/if}}
                    </td>

                    <td class="text-center">{{this.item_order_level}}</td>

                    <td class="text-center">
                      {{#if this.is_active}}
                        <span class="ii-badge-active">Active</span>
                      {{else}}
                        <span class="ii-badge-inactive">Inactive</span>
                      {{/if}}
                    </td>

                    <td class="text-center">
                      <div class="d-flex justify-content-center gap-1">
                        <a
                          href="/inventory/items/{{this.item_id}}/edit"
                          class="btn btn-sm btn-ii-blue"
                          title="Edit"
                        >
                          <i class="fas fa-edit"></i>
                        </a>
                        <button
                          onclick="deleteItem({{this.item_id}}, '{{this.item_name}}')"
                          class="btn btn-sm"
                          style="background:var(--ii-danger); border-color:var(--ii-danger); color:#fff;"
                          title="Deactivate"
                        >
                          <i class="fas fa-trash"></i>
                        </button>
                      </div>
                    </td>

                  </tr>
                {{/each}}
              {{else}}
                <tr>
                  <td colspan="9" class="ii-empty">
                    <i class="fas fa-box-open"></i>
                    No items found.
                    <a href="/inventory/items/new">Add your first item</a>
                  </td>
                </tr>
              {{/if}}
            </tbody>
          </table>
        </div>

        <!-- Pagination -->
        {{#if (gt pagination.totalPages 1)}}
          <div class="ii-pagination-bar">
            <div class="ii-page-info">
              Showing page {{pagination.currentPage}} of {{pagination.totalPages}}
            </div>
            <nav>
              <ul class="pagination pagination-sm mb-0">

                <li class="page-item {{#if (eq pagination.currentPage 1)}}disabled{{/if}}">
                  <a class="page-link" href="?page={{dec pagination.currentPage 1}}&search={{search}}">
                    Previous
                  </a>
                </li>

                {{#each (range 1 pagination.totalPages)}}
                  <li class="page-item {{#if (eq this ../pagination.currentPage)}}active{{/if}}">
                    <a class="page-link" href="?page={{this}}&search={{../search}}">{{this}}</a>
                  </li>
                {{/each}}

                <li class="page-item {{#if (eq pagination.currentPage pagination.totalPages)}}disabled{{/if}}">
                  <a class="page-link" href="?page={{inc pagination.currentPage 1}}&search={{search}}">
                    Next
                  </a>
                </li>

              </ul>
            </nav>
          </div>
        {{/if}}

      </div>

    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
  // =============================================
  // DELETE / DEACTIVATE ITEM
  // =============================================

  async function deleteItem(itemId, itemName) {
    const result = await Swal.fire({
      title: 'Deactivate Item?',
      html: `<span style="color:#6B7686;">This will deactivate <strong style="color:#0F2233;">${itemName}</strong>. It will no longer appear in active inventory.</span>`,
      icon: 'warning',
      showCancelButton: true,
      confirmButtonText: 'Yes, deactivate',
      cancelButtonText: 'Cancel',
      confirmButtonColor: '#C1483D',
      cancelButtonColor: '#6B7686',
    });

    if (!result.isConfirmed) return;

    try {
      const response = await fetch(`/inventory/items/${itemId}/delete`, {
        method: 'DELETE'
      });

      const data = await response.json();

      if (data.success) {
        await Swal.fire({
          title: 'Deactivated',
          text: data.message || 'Item has been deactivated.',
          icon: 'success',
          confirmButtonColor: '#1F7A6C',
          timer: 2000,
          showConfirmButton: false,
        });
        window.location.reload();
      } else {
        Swal.fire({
          title: 'Error',
          text: data.message || 'Failed to deactivate item.',
          icon: 'error',
          confirmButtonColor: '#C1483D',
        });
      }

    } catch (error) {
      console.error('Delete error:', error);
      Swal.fire({
        title: 'Error',
        text: 'Failed to deactivate item. Please try again.',
        icon: 'error',
        confirmButtonColor: '#C1483D',
      });
    }
  }
</script>

</body>
</html>
