// ── PAGIBIG FINAL ───────────────────────────────────────────────────────────
async function generatePagibigContributionFinalExcel(results, office, region, endDate) {
  const ExcelJS = window.ExcelJS;
  const workbook = new ExcelJS.Workbook();
  const grouped = groupByRegion(results);

  for (const [reg, employees] of Object.entries(grouped)) {
    const worksheet = workbook.addWorksheet(reg.substring(0, 31));
    
    worksheet.addRow(['PAGIBIG CONTRIBUTION']);
    worksheet.addRow([`${reg} - ${endDate}`]);
    worksheet.addRow(['DIVISION/AREA', 'IDNO', 'LAST NAME', 'FIRST NAME', 'M.I.', 'ER', 'EE', 'TOTAL', 'PAGIBIG NO.', 'BIRTH DATE']);
    worksheet.addRow([]);

    employees.forEach((e) => {
      const ee = parseFloat(e.pagibigcontri) || 0;
      worksheet.addRow([
        e.department,
        e.idno,
        e.lastname,
        e.firstname,
        e.middlename,
        PAGIBIG_ER,
        ee,
        PAGIBIG_ER + ee,
        e.pagibigno || '',
        formatDate(e.birthdate)
      ]);
    });

    applyCalibriFont(worksheet);

    [5, 6, 7].forEach(col => {
      const column = worksheet.getColumn(col + 1);
      column.numFmt = '#,##0.00';
    });
  }

  const buffer = await workbook.xlsx.writeBuffer();
  const blob = new Blob([buffer], { type: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' });
  const link = document.createElement('a');
  link.href = URL.createObjectURL(blob);
  link.download = buildFileName('Pagibig Final', office, region, endDate);
  link.click();
  URL.revokeObjectURL(link.href);
}

// ── PHILHEALTH ──────────────────────────────────────────────────────────────
async function generatePhilhealthContributionExcel(results, office, region, endDate) {
  const ExcelJS = window.ExcelJS;
  const workbook = new ExcelJS.Workbook();
  const grouped = groupByRegion(results);

  for (const [reg, employees] of Object.entries(grouped)) {
    const worksheet = workbook.addWorksheet(reg.substring(0, 31));
    
    worksheet.addRow(['PHILHEALTH CONTRIBUTION']);
    worksheet.addRow([`${reg} - ${endDate}`]);
    worksheet.addRow(['DIVISION/AREA', 'IDNO', 'LAST NAME', 'FIRST NAME', 'M.I.', 'ER', 'EE', 'TOTAL']);
    worksheet.addRow([]);

    let er = 0, ee = 0;

    employees.forEach((e) => {
      const ph = parseFloat(e.philhealth) || 0;
      er += ph;
      ee += ph;
      worksheet.addRow([e.department, e.idno, e.lastname, e.firstname, e.middlename, ph, ph, ph * 2]);
    });

    worksheet.addRow([`Employees:`, `${employees.length}`, '', 'TOTAL', '', er, ee, er + ee]);

    applyCalibriFont(worksheet);

    [5, 6, 7].forEach(col => {
      const column = worksheet.getColumn(col + 1);
      column.numFmt = '#,##0.00';
    });
  }

  const buffer = await workbook.xlsx.writeBuffer();
  const blob = new Blob([buffer], { type: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' });
  const link = document.createElement('a');
  link.href = URL.createObjectURL(blob);
  link.download = buildFileName('Philhealth', office, region, endDate);
  link.click();
  URL.revokeObjectURL(link.href);
}


