<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>{{title}}</title>

  <link rel="stylesheet" href="/css/style.css" />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
    />
    <link rel="stylesheet" href="/css/styles.css" />
</head>

<body>
  {{> header}}

  <div class="container d-flex align-items-center justify-content-center" style="min-height: 70vh;">
    <div class="row justify-content-center w-100">
      <div class="col-lg-6 col-md-8">
        <div class="card border-0 shadow-lg rounded-4">
          <div class="card-body text-center p-5">

            <div class="mb-4">
              <div
                class="d-inline-flex align-items-center justify-content-center rounded-circle bg-danger bg-opacity-10"
                style="width: 90px; height: 90px;"
              >
                <i class="fas fa-lock text-danger" style="font-size: 42px;"></i>
              </div>
            </div>

            <h1 class="fw-bold text-danger mb-2" style="font-size: 64px;">403</h1>

            <h4 class="fw-semibold mb-3">Access Denied</h4>

            <p class="text-muted mb-4">
              {{#if message}}
                {{message}}
              {{else}}
                You do not have permission to access this page or module.
              {{/if}}
            </p>

            <div class="d-flex justify-content-center gap-2 flex-wrap">
              <a href="/dashboard" class="btn btn-primary px-4">
                <i class="fas fa-home me-1"></i>
                Return to Dashboard
              </a>

              <button type="button" onclick="history.back()" class="btn btn-outline-secondary px-4">
                <i class="fas fa-arrow-left me-1"></i>
                Go Back
              </button>
            </div>

          </div>
        </div>

        <p class="text-center text-muted mt-3 small">
          HRIS Employee Records Management System
        </p>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>