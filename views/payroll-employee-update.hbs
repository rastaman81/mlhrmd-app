  function populateEmployeeStatus() {
  console.log("=== populateEmployeeStatus DEBUG ===");
  console.log("Current employee status:", currentEmployeeStatus);
  console.log("Employee status data:", employeeStatus);
  
  // Clear the select
  employeeStatusSelect.innerHTML = '';
  
  // Check if employeeStatus data exists and is an array
  if (!Array.isArray(employeeStatus)) {
    console.error('Employee status data is not an array:', employeeStatus);
    
    // Add fallback option
    if (currentEmployeeStatus) {
      const fallbackOption = new Option(currentEmployeeStatus, currentEmployeeStatus, true, true);
      employeeStatusSelect.add(fallbackOption);
    }
    return;
  }

  let hasSelectedOption = false;

  // Add each status option to the dropdown
  employeeStatus.forEach(status => {
    // Use consistent property access
    const statusValue = status.status_name || status.value || status.status_value;
    const statusName = status.status_name || status.name || statusValue;
    
    if (!statusValue || !statusName) {
      console.warn('Invalid status object:', status);
      return;
    }

    const isSelected = statusValue === currentEmployeeStatus;
    if (isSelected) {
      hasSelectedOption = true;
    }
    
    console.log(`Adding option: ${statusValue}, selected: ${isSelected}`);
    
    const option = new Option(statusName, statusValue, isSelected, isSelected);
    employeeStatusSelect.add(option);
  });

  // DEBUG: Verify what was actually added to the select
  console.log("Final select options:");
  for (let i = 0; i < employeeStatusSelect.options.length; i++) {
    const option = employeeStatusSelect.options[i];
    console.log(`  [${i}] value="${option.value}", text="${option.text}", selected=${option.selected}`);
  }

  // Fallback if current status isn't in the options
  if (currentEmployeeStatus && !hasSelectedOption) {
    console.log(`Adding fallback option for: ${currentEmployeeStatus}`);
    const fallbackOption = new Option(
      currentEmployeeStatus, 
      currentEmployeeStatus, 
      true, 
      true
    );
    fallbackOption.disabled = true;
    employeeStatusSelect.add(fallbackOption);
  }

  // DEBUG: Check the final state
  console.log("Select value after population:", employeeStatusSelect.value);
  console.log("Select selectedIndex:", employeeStatusSelect.selectedIndex);
  console.log("Select name attribute:", employeeStatusSelect.getAttribute('name'));
  
  // CRITICAL: Ensure the select has a name attribute
  if (!employeeStatusSelect.getAttribute('name')) {
    console.error('WARNING: Select element has no name attribute!');
    employeeStatusSelect.setAttribute('name', 'compstat');
    console.log('Added name="compstat" attribute to select');
  }
}

  function populateDesignations() {
    designationSelect.innerHTML = '';
    
    const currentRegion = getCurrentRegion();
    // Determine which group to show based on employee's region
    let groupToMatch = 'operations'; // default
    if (currentRegion === 'support') {
      groupToMatch = 'support';
    } else if (currentRegion === 'mancomm') {
      groupToMatch = 'mancomm';
    }

    // Filter and sort designations
    const filteredDesignations = (designations || [])
      .filter(d => d.designation_group?.toLowerCase() === groupToMatch)
      .sort((a, b) => a.designation.localeCompare(b.designation));

    // Add options to select
    filteredDesignations.forEach(d => {
      const isSelected = d.designation === currentDesignation;
      const option = new Option(d.designation, d.designation, isSelected, isSelected);
      designationSelect.add(option);
    });

    // Fallback for current designation if not found in the group
    if (currentDesignation && !filteredDesignations.some(d => d.designation === currentDesignation)) {
      const fallbackOption = new Option(currentDesignation, currentDesignation, true, true);
      fallbackOption.disabled = true;
      designationSelect.add(fallbackOption);
    }
  }

  // Function to populate regions dropdown
function populateRegions() {
  // Clear existing options
  regionSelect.innerHTML = '';
  
  // Check if regions data exists and is an array
  if (!Array.isArray(regions)) {
    console.error('Regions data is not an array:', regions);
    return;
  }

  // Add each region as an option
  regions.forEach(region => {
    // Handle different possible property names for region value/name
    const regionValue = region.region_name || region.value || region.id;
    const regionName = region.region_name || region.name || regionValue;
    
    if (!regionValue || !regionName) {
      console.warn('Invalid region object:', region);
      return;
    }

    // Check if this is the employee's current region
    const isSelected = regionValue.toLowerCase() === '{{employee.region}}'.toLowerCase();
    
    // Create and add the option
    const option = new Option(
      regionName, 
      regionValue, 
      isSelected, 
      isSelected
    );
    regionSelect.add(option);
  });

  

  // Fallback if current region isn't in the options
  const currentRegion = '{{employee.region}}';
  if (currentRegion && 
      !regions.some(r => (r.value || r.region_name || r.id) === currentRegion)) {
    const fallbackOption = new Option(
      currentRegion, 
      currentRegion, 
      true, 
      true
    );
    fallbackOption.disabled = true;
    regionSelect.add(fallbackOption);
  }
}

function populateDepartments() {
  const currentRegion = getCurrentRegion();
  departmentSelect.innerHTML = ''; // Clear existing
  
  const filteredDepartments = branchesToUse
    .filter(branch => branch.B_SOURCE?.toLowerCase() === currentRegion)
    .map(branch => branch.B_AREA);

  const uniqueDepartments = [...new Set(filteredDepartments)]
    .filter(Boolean)
    .sort((a, b) => a.localeCompare(b));

  // Add default option if no departments
  if (uniqueDepartments.length === 0) {
    departmentSelect.add(new Option('No departments available', ''));
    return;
  }

  // Add all department options
  uniqueDepartments.forEach(dept => {
    const isSelected = dept === currentDept;
    const option = new Option(dept, dept, isSelected, isSelected);
    departmentSelect.add(option);
  });

  

  // Always trigger branch population after departments load
  populateBranches();
}
