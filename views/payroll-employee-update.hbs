  document.getElementById('updateEmployeeForm').addEventListener('submit', async function (e) {
  e.preventDefault();

  // Convert empty date values to null
  const dateInputs = document.querySelectorAll('input[type="date"]');
  dateInputs.forEach(input => {
    if (!input.value) input.value = '';
  });
  
  // Get the submit button by ID
  const saveBtn = document.getElementById('saveEmployeeBtn');
  
  if (!saveBtn) {
    console.error('Submit button not found - check button ID and form structure');
    alert('System error - please refresh the page and try again');
    return;
  }

  // Show loading state
  const originalBtnText = saveBtn.innerHTML;
  saveBtn.disabled = true;
  saveBtn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Saving...';

  try {
    // Collect form data and send to server
    const formData = new FormData(this);
    const employeeData = Object.fromEntries(formData.entries());

    // DEBUG: Check the compstat value before sending
  console.log("compstat before send:", employeeData.compstat);
  console.log("compstat type:", typeof employeeData.compstat);
  console.log("compstat length:", employeeData.compstat?.length);
    
    // Add additional fields
    // Get the checkbox element
const transferredSwitch = document.getElementById('transferredSwitch');

// Get the value (true if checked, false if not)
const isTransferred = transferredSwitch.checked;

    console.log(isTransferred); // true if checked, false if not
    console.log(regionSelect.value)
    console.log(document.getElementById('employeeRegion').value)
    employeeData.region = regionSelect.value;//document.getElementById('employeeRegion').value;
    employeeData.originalRegion = document.getElementById('employeeRegion').value;
    employeeData.office = document.getElementById('employeeOffice').value;
    employeeData.isTransferred = isTransferred;
    
    console.log(employeeData)
    // Send to server
    const response = await fetch('/payroll/employee-update', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(employeeData)
    });

    const result = await response.json();
    
    if (result.success) {
      alert('Employee updated successfully!');
      window.location.href = '/payroll/employee-edit';
    } else {
      throw new Error(result.message || 'Update failed');
    }
  } catch (error) {
    console.error('Update error:', error);
    alert(`Error: ${error.message}`);
  } finally {
    if (saveBtn) {
      saveBtn.disabled = false;
      saveBtn.innerHTML = originalBtnText;
    }
  }
});

  
  
});

