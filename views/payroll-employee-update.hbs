      // Toggle display between 'none' and 'block'
      if (deductionGroup.style.display === "none" || deductionGroup.style.display === "") {
        deductionGroup.style.display = "block";
      } else {
        deductionGroup.style.display = "none";
      }
    });

  const numberFields = document.querySelectorAll('input[type="number"]');
  
  numberFields.forEach(function (field) {
    // Ensure the field shows 0.00 if it's empty or 0
    if (field.value === "" || field.value === "0") {
      field.value = "0.00";
    }

    // Format the value to always show 2 decimal places
    field.addEventListener("blur", function () {
      let value = parseFloat(field.value);
      if (isNaN(value) || value === 0) {
        field.value = "0.00";
      } else {
        field.value = value.toFixed(2); // Always show two decimal places
      }
    });

    // On focus, remove 0.00 if the user wants to edit
    field.addEventListener("focus", function () {
      if (field.value === "0.00") {
        field.value = "";
      }
    });
  });

