function populateBranches() {
  const selectedDept = departmentSelect.value;
  const selectedReg = getCurrentRegion().toLowerCase();
  console.log(selectedDept, employeeRegion.value)
  branchSelect.innerHTML = '';

  const filteredBranches = branchesToUse.filter(branch =>
    branch.B_SOURCE?.toLowerCase() === selectedReg &&
    branch.B_AREA === selectedDept
  );

  // Sort branches alphabetically by description
  filteredBranches.sort((a, b) => a.B_DESCRIPTION.localeCompare(b.B_DESCRIPTION));

  filteredBranches.forEach(branch => {
    const shouldSelect = isInitialLoad && branch.B_DESCRIPTION === currentBranch;
    const option = new Option(branch.B_DESCRIPTION, branch.B_DESCRIPTION, shouldSelect, shouldSelect);
    branchSelect.add(option);
  });

  if (
    isInitialLoad &&
    currentBranch &&
    !filteredBranches.some(branch => branch.B_DESCRIPTION === currentBranch)
  ) {
    const fallbackOption = new Option(currentBranch + ' (invalid)', currentBranch, true, true);
    fallbackOption.disabled = true;
    branchSelect.add(fallbackOption);
  }

  isInitialLoad = false;
}
